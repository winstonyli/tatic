+/// The join records the terms it examined (`Fired::Join`), so a candidate that could change a joined law is seen: in the join a
+/// rule acts wherever either usable side matches, here at the commuted left side, a term no rewrite of the two sides asks about.
+#[test]
+fn join_traces_the_terms_it_examines() {
+    let (a, b) = (parse_term("add(add(z, y), sub(x, -1))"), parse_term("add(sub(add(x, y), -1), z)"));
+    let rule = parse_rules("add(sub(x, -1), add(y, z)) -> add(sub(add(x, y), -1), z)\n")[0];
+    RULE_TRACE.with(|t| *t.borrow_mut() = Some(vec![]));
+    join_eq(4, 3, &a, &b);
+    let joined = Trace::new(RULE_TRACE.with(|t| t.borrow_mut().take()).unwrap());
+    let sides = Trace::new(vec![(a, Fired::None), (b, Fired::None)]);
+    assert!(!sides.touched_by(&rule, |_| true), "the rule's left side matches neither side");
+    assert!(joined.touched_by(&rule, |_| true), "the join examined a term the rule's left side matches");
+    let back = (parse_term("and(x, or(y, z))"), rule.0);
+    assert!(joined.touched_by(&back, |_| true), "a rule whose right side matches there acts backward");
+    assert!(!Trace::new(joined.items().iter().map(|(t, _)| (*t, Fired::None)).collect()).touched_by(&back, |_| true), "but not in a rewrite");
+    assert!(!joined.touched_by(&parse_rules("or(x, and(x, y)) -> x\n")[0], |_| true), "no or anywhere, and x cannot be a step's start");
