+
+/// Probe: mimalloc, counting live bytes and their peak since the last `mem_line`.
+pub struct Counting;
+static LIVE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static PEAK: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+fn grew(n: usize) {
+    let now = LIVE.fetch_add(n, std::sync::atomic::Ordering::Relaxed) + n;
+    PEAK.fetch_max(now, std::sync::atomic::Ordering::Relaxed);
+}
+unsafe impl std::alloc::GlobalAlloc for Counting {
+    unsafe fn alloc(&self, l: std::alloc::Layout) -> *mut u8 {
+        let p = unsafe { mimalloc::MiMalloc.alloc(l) };
+        if !p.is_null() {
+            grew(l.size());
+        }
+        p
+    }
+    unsafe fn alloc_zeroed(&self, l: std::alloc::Layout) -> *mut u8 {
+        let p = unsafe { mimalloc::MiMalloc.alloc_zeroed(l) };
+        if !p.is_null() {
+            grew(l.size());
+        }
+        p
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: std::alloc::Layout) {
+        unsafe { mimalloc::MiMalloc.dealloc(p, l) };
+        LIVE.fetch_sub(l.size(), std::sync::atomic::Ordering::Relaxed);
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: std::alloc::Layout, new: usize) -> *mut u8 {
+        let q = unsafe { mimalloc::MiMalloc.realloc(p, l, new) };
+        if !q.is_null() {
+            LIVE.fetch_sub(l.size(), std::sync::atomic::Ordering::Relaxed);
+            grew(new);
+        }
+        q
+    }
+}
+
+/// Probe: live MB now, their peak since the last call, and the process's commit and peak commit.
+pub fn mem_line() -> String {
+    #[repr(C)]
+    #[derive(Default)]
+    struct Pmc { cb: u32, faults: u32, peak_ws: usize, ws: usize, qpp: usize, qp: usize, qpnp: usize, qnp: usize, pagefile: usize, peak_pagefile: usize }
+    unsafe extern "system" {
+        fn GetCurrentProcess() -> isize;
+        fn K32GetProcessMemoryInfo(h: isize, p: *mut Pmc, cb: u32) -> i32;
+    }
+    let mut m = Pmc { cb: std::mem::size_of::<Pmc>() as u32, ..Default::default() };
+    unsafe { K32GetProcessMemoryInfo(GetCurrentProcess(), &mut m, m.cb) };
+    let live = LIVE.load(std::sync::atomic::Ordering::Relaxed);
+    let peak = PEAK.swap(live, std::sync::atomic::Ordering::Relaxed);
+    let (sum, max, n) = (STACK_SUM.swap(0, std::sync::atomic::Ordering::Relaxed), STACK_MAX.swap(0, std::sync::atomic::Ordering::Relaxed), STACK_N.swap(0, std::sync::atomic::Ordering::Relaxed));
+    format!("live {} MB, phase peak {} MB, commit {} MB, peak commit {} MB, stacks of {n} exited threads {} KB (max {} KB)", live >> 20, peak >> 20, m.pagefile >> 20, m.peak_pagefile >> 20, sum >> 10, max >> 10)
+}
+
+static STACK_SUM: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static STACK_MAX: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static STACK_N: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+/// Probe: the committed bytes of this thread's stack, added to the next `mem_line`; call as a thread ends.
+pub fn note_stack() {
+    #[repr(C)]
+    #[derive(Default)]
+    struct Mbi { base: usize, alloc_base: usize, alloc_protect: u32, partition: u16, _p: u16, size: usize, state: u32, protect: u32, ty: u32, _q: u32 }
+    unsafe extern "system" {
+        fn GetCurrentThreadStackLimits(low: *mut usize, high: *mut usize);
+        fn VirtualQuery(a: usize, m: *mut Mbi, n: usize) -> usize;
+    }
+    let (mut low, mut high) = (0usize, 0usize);
+    unsafe { GetCurrentThreadStackLimits(&mut low, &mut high) };
+    let (mut a, mut committed) = (low, 0usize);
+    while a < high {
+        let mut m = Mbi::default();
+        if unsafe { VirtualQuery(a, &mut m, std::mem::size_of::<Mbi>()) } == 0 || m.size == 0 {
+            break;
+        }
+        if m.state == 0x1000 {
+            committed += m.size.min(high - a);
+        }
+        a = m.base + m.size;
+    }
+    STACK_SUM.fetch_add(committed, std::sync::atomic::Ordering::Relaxed);
+    STACK_MAX.fetch_max(committed, std::sync::atomic::Ordering::Relaxed);
+    STACK_N.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
