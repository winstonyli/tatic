diff --git a/tests/church_bv/rewrite.rs b/tests/church_bv/rewrite.rs
index 6c2bf5c..ae44e46 100644
--- a/tests/church_bv/rewrite.rs
+++ b/tests/church_bv/rewrite.rs
@@ -574,6 +574,18 @@ const SCREEN_INPUTS: usize = 204;
 /// fixed pseudo-random inputs.
 static SCREENS: crate::task::SharedMemo<(usize, usize), ValueMemo<u128>> = crate::task::SharedMemo::new();
 
+/// Probe: the screen memos' vectors and bytes, per (width, variables) and in all.
+pub fn screen_stats() -> String {
+    let (mut parts, mut total) = (vec![], 0usize);
+    SCREENS.each(|(n, k), m| {
+        let bytes = m.blocks.iter().map(|b| b.capacity() * 16).sum::<usize>();
+        total += bytes;
+        parts.push(format!("w{n}k{k} {} vectors {} MB", m.ids.len(), bytes >> 20));
+    });
+    parts.sort();
+    format!("screen {} MB [{}]", total >> 20, parts.join(", "))
+}
+
 /// `f` on the screen's value memo for width `n` and `k` variables.
 fn with_screen<R>(n: usize, k: usize, f: impl FnOnce(&mut ValueMemo<u128>) -> R) -> R {
     SCREENS.with((n, k), || ValueMemo::screen(n, k), f)
