+        println!(
+            "ROUND {round}: key {} ({bytes} bytes per class), classes {} ({} lt) truncated {}, merges {}, sampled {}, refuted {refuted} ({refuted_lt} lt), inputs added {} (width 8: {}), build {build_ms} ms, round {} ms",
+            describe(&sets),
