+/// A class table's key inputs: per width, tuples of the three variables (docs/tier-cycle.md, "A learned table of
+/// representatives").
+type CtSets = Vec<(usize, Vec<[u128; 3]>)>;
+/// A term's values on each set of a key, one byte per input.
+type CtVals = Vec<Vec<u8>>;
+
+fn ct_leaf(sets: &CtSets, t: &Term) -> CtVals {
+    sets.iter()
+        .map(|(w, ins)| {
+            ins.iter()
+                .map(|x| match *t.node() {
+                    Node::V(v) => x[v] as u8,
+                    Node::Zero => 0,
+                    Node::Ones => low_bits(*w) as u8,
+                    _ => unreachable!(),
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn ct_zip(sets: &CtSets, o: usize, a: &CtVals, b: &CtVals) -> CtVals {
+    let f = OP_INFO[o].word;
+    sets.iter().zip(a.iter().zip(b)).map(|((w, _), (x, y))| x.iter().zip(y).map(|(p, q)| f(*p as u128, *q as u128, low_bits(*w)) as u8).collect()).collect()
+}
+
+fn ct_hash(v: &CtVals, bool_sort: bool) -> (u64, u64) {
+    use std::hash::{Hash, Hasher};
+    let (mut h1, mut h2) = (std::collections::hash_map::DefaultHasher::new(), std::collections::hash_map::DefaultHasher::new());
+    (bool_sort, v).hash(&mut h1);
+    (0xa5u8, v, bool_sort).hash(&mut h2);
+    (h1.finish(), h2.finish())
+}
+
+fn ct_vals(sets: &CtSets, t: Term, memo: &mut hashbrown::HashMap<Term, CtVals>) -> CtVals {
+    if let Some(v) = memo.get(&t) {
+        return v.clone();
+    }
+    let v = match *t.node() {
+        Node::Op(o, a, b) => {
+            let (va, vb) = (ct_vals(sets, a, memo), ct_vals(sets, b, memo));
+            ct_zip(sets, o, &va, &vb)
+        }
+        _ => ct_leaf(sets, &t),
+    };
+    memo.insert(t, v.clone());
+    v
+}
+
+/// `t` at one width-`w` input.
+fn ct_eval(t: Term, w: usize, x: &[u128; 3]) -> u128 {
+    match *t.node() {
+        Node::V(v) => x[v],
+        Node::Zero => 0,
+        Node::Ones => low_bits(w),
+        Node::Op(o, a, b) => (OP_INFO[o].word)(ct_eval(a, w, x), ct_eval(b, w, x), low_bits(w)),
+    }
+}
+
+/// The process's commit now and at its peak, in MB (`K32GetProcessMemoryInfo`).
+fn ct_commit_mb() -> (usize, usize) {
+    #[repr(C)]
+    #[derive(Default)]
+    struct Pmc {
+        cb: u32,
+        faults: u32,
+        peak_ws: usize,
+        ws: usize,
+        qpp_peak: usize,
+        qpp: usize,
+        qnp_peak: usize,
+        qnp: usize,
+        pagefile: usize,
+        peak_pagefile: usize,
+    }
+    unsafe extern "system" {
+        fn GetCurrentProcess() -> isize;
+        fn K32GetProcessMemoryInfo(h: isize, p: *mut Pmc, cb: u32) -> i32;
+    }
+    let mut p = Pmc { cb: std::mem::size_of::<Pmc>() as u32, ..Default::default() };
+    unsafe { K32GetProcessMemoryInfo(GetCurrentProcess(), &mut p, p.cb) };
+    (p.pagefile >> 20, p.peak_pagefile >> 20)
+}
