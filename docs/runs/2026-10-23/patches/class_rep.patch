+                    if none <= 20 {
+                        println!("SHR {v}: {} = {}", u.show(), r.show());
+                    }
+                }
+            }
+            let mut tally: Vec<_> = tally.into_iter().collect();
+            tally.sort();
+            println!("SHR VERDICTS {tally:?}, refuted {wrong}, {} ms", t0.elapsed().as_millis());
+        });
+    }
+    // bottom-up normalisation by the final table
+    let mut vals: hashbrown::HashMap<Term, CtVals> = Default::default();
+    let mut memo: hashbrown::HashMap<Term, Term> = Default::default();
+    let mut pairs: Vec<(Term, Term)> = vec![];
+    let mut seen: hashbrown::HashSet<(Term, Term)> = Default::default();
+    fn norm(t: Term, memo: &mut hashbrown::HashMap<Term, Term>, f: &mut dyn FnMut(Term) -> Term) -> Term {
+        if let Some(n) = memo.get(&t) {
+            return *n;
+        }
+        let u = match *t.node() {
+            Node::Op(o, a, b) => {
+                let (na, nb) = (norm(a, memo, f), norm(b, memo, f));
+                f(Term::op(o, na, nb))
+            }
+            _ => f(t),
+        };
+        memo.insert(t, u);
+        u
+    }
+    let mut lookup = |u: Term| -> Term {
+        let v = ct_vals(&sets, u, &mut vals);
+        match table.map.get(&ct_hash(&v, matches!(*u.node(), Node::Op(LT, ..)))) {
+            Some(r) if *r != u => {
+                if seen.insert((u, *r)) {
+                    pairs.push((u, *r));
+                }
+                *r
+            }
+            _ => u,
+        }
+    };
+    for path in env("PROBE_LAWFILES").unwrap_or_default().split(';').filter(|p| !p.is_empty()) {
+        let text = std::fs::read_to_string(path).unwrap_or_else(|e| panic!("{path}: {e}"));
+        let (mut laws, mut met) = (0usize, 0usize);
+        for line in text.lines().filter(|l| l.contains(" = ")) {
+            let (l, r) = line.split_once(" = ").unwrap();
+            let (nl, nr) = (norm(parse_term(l.trim()), &mut memo, &mut lookup), norm(parse_term(r.trim()), &mut memo, &mut lookup));
+            laws += 1;
+            met += (nl == nr) as usize;
+        }
+        println!("LAWS {path}: {met} of {laws} meet");
+    }
+    refuter.clear();
+    let suspect: Vec<bool> = pairs.iter().map(|(u, r)| refuter.refute(u, r).is_some()).collect();
+    println!("MERGES {} distinct replacements, {} suspect", pairs.len(), suspect.iter().filter(|s| **s).count());
+    if env("PROBE_PROVE").as_deref() == Some("1") {
+        let job = &mut Job::new(Setup::process());
+        tatic::kernel::scoped(|| {
+            let (mut machine, mut bitwise, mut none) = (0, 0, 0);
+            for ((u, r), sus) in pairs.iter().zip(&suspect) {
+                if *sus {
+                    continue;
+                }
+                match prove_checked(job, 4, 3, "replacement", u, r).verdict {
+                    crate::machine::Verdict::Proved => machine += 1,
+                    crate::machine::Verdict::CarryFree if u.add_free() && r.add_free() => {
+                        let (p, s) = bitwise_law_k(4, 3, u, r);
+                        job.lemmas.ck("replacement", &p, &s);
+                        bitwise += 1;
+                    }
+                    _ => {
+                        none += 1;
+                        println!("UNPROVED {} = {} (over atoms: {})", u.show(), r.show(), ct_verdict(job, u, r));
+                    }
+                }
+            }
+            println!("PROVED machine {machine}, bitwise {bitwise}, no proof {none}");
+        });
+    }
+}
