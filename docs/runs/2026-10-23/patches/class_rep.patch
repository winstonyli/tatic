+        std::fs::write(out, lines).unwrap();
+    }
+    // the final round's sampled merges that involve shr1: refuted on the refuter, then proved as the replacements are
+    fn has_shr(t: Term) -> bool {
+        match *t.node() {
+            Node::Op(o, a, b) => o == SHR1 || has_shr(a) || has_shr(b),
+            _ => false,
+        }
+    }
+    let shr: Vec<(Term, Term)> = table.sample.iter().filter(|(u, r)| has_shr(*u) || has_shr(*r)).cloned().collect();
+    let reps_shr = table.reps.iter().flatten().filter(|t| has_shr(**t)).count();
+    println!(
+        "REP displaced {}; class representatives with shr1 {} of {}",
+        table.displaced,
+        table.map.values().filter(|t| has_shr(**t)).count(),
+        table.map.len()
+    );
+    println!("SHR classes {reps_shr} bit-vector reps with shr1 of {}; sampled merges with shr1 {} of {}", table.reps.iter().map(|r| r.len()).sum::<usize>(), shr.len(), table.sample.len());
+    if env("PROBE_SHR").as_deref() == Some("1") {
+        refuter.clear();
+        let job = &mut Job::new(Setup::process());
+        tatic::kernel::scoped(|| {
+            let (mut none, mut wrong) = (0, 0);
+            let mut tally: hashbrown::HashMap<&str, usize> = Default::default();
+            let t0 = Instant::now();
+            for (n, (u, r)) in shr.iter().enumerate() {
+                if n % 1000 == 0 {
