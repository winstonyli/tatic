+/// A replacement's verdict as the spec (decision 3) would decide it: at width 4 over x, y, z; else over atoms, each
+/// `shr1` node (outermost) a fresh variable from 3 on, the same on both sides.
+fn ct_verdict(job: &mut Job, u: &Term, r: &Term) -> &'static str {
+    fn plain(job: &mut Job, k: usize, u: &Term, r: &Term) -> bool {
+        match prove_checked(job, 4, k, "replacement", u, r).verdict {
+            crate::machine::Verdict::Proved => true,
+            crate::machine::Verdict::CarryFree if u.add_free() && r.add_free() => {
+                // the kernel decides: over atoms a carry-free pair may be false
+                let (p, s) = bitwise_law_k(4, k, u, r);
+                job.lemmas.holds(&p, &s).is_ok()
+            }
+            _ => false,
+        }
+    }
+    fn atomize(t: Term, atoms: &mut Vec<Term>) -> Term {
+        match *t.node() {
+            Node::Op(SHR1, ..) => {
+                let i = atoms.iter().position(|a| *a == t).unwrap_or_else(|| {
+                    atoms.push(t);
+                    atoms.len() - 1
+                });
+                Term::v(3 + i)
+            }
+            Node::Op(o, a, b) => Term::op(o, atomize(a, atoms), atomize(b, atoms)),
+            _ => t,
+        }
+    }
+    if plain(job, 3, u, r) {
+        return "plain";
+    }
+    let mut atoms = vec![];
+    let (u2, r2) = (atomize(*u, &mut atoms), atomize(*r, &mut atoms));
+    if atoms.is_empty() {
+        "none (no shr1)"
+    } else if u2 == r2 {
+        "atoms: equal terms"
+    } else if u2.differs_in(&r2, 4, 3 + atoms.len(), SCREEN_INPUTS) {
+        "none: false over atoms"
+    } else if plain(job, 3 + atoms.len(), &u2, &r2) {
+        "atoms: proved"
+    } else {
+        "none over atoms"
+    }
+}
+struct CtTable {
+    map: hashbrown::HashMap<(u64, u64), Term>,
+    /// per size, the bit-vector representatives (`lt` ones are a second sort no operator consumes)
+    reps: Vec<Vec<Term>>,
+    lts: usize,
+    truncated: bool,
+    /// merges the key proposed (a new term whose key a representative already has), and a uniform sample of them
+    merges: usize,
+    sample: Vec<(Term, Term)>,
+    /// representatives replaced by a later member the machine parses (`PROBE_REP=parse`)
+    displaced: usize,
+}
+
+/// The table to `max_size` under `sets`: terms over x, y, z, 0, -1 and add, and, or, xor, sub, shl1, plus `lt`, built from
+/// representatives only; the first (smallest) of a class is its representative.
+fn ct_build(sets: &CtSets, max_size: usize, max_classes: usize, sample_n: usize, mut seed: u128) -> CtTable {
+    // shl1 and shr1 are unary: enumerated only with the second operand 0
+    const OPS: [usize; 8] = [ADD, AND, OR, XOR, SUB, SHL1, SHR1, LT];
+    let mut t = CtTable { map: Default::default(), reps: vec![vec![]; max_size + 1], lts: 0, truncated: false, merges: 0, sample: vec![], displaced: 0 };
+    // PROBE_REP=parse: a class's representative is its smallest member `Machine::parse` takes, else its smallest
+    let parse_first = std::env::var("PROBE_REP").as_deref() == Ok("parse");
+    let mut moved: hashbrown::HashMap<Term, Term> = Default::default();
+    let mut vals: Vec<Vec<CtVals>> = vec![vec![]; max_size + 1];
+    for leaf in [Term::v(0), Term::v(1), Term::v(2), Term::ZERO, Term::ONES] {
+        let v = ct_leaf(sets, &leaf);
+        if t.map.insert(ct_hash(&v, false), leaf).is_none() {
+            t.reps[1].push(leaf);
+            vals[1].push(v);
+        }
+    }
+    'sizes: for s in (3..=max_size).step_by(2) {
+        for sa in (1..s - 1).step_by(2) {
+            let sb = s - 1 - sa;
+            for i in 0..t.reps[sa].len() {
+                for j in 0..t.reps[sb].len() {
+                    for o in OPS {
+                        if (o == SHL1 || o == SHR1) && t.reps[sb][j] != Term::ZERO {
+                            continue;
+                        }
+                        let v = ct_zip(sets, o, &vals[sa][i], &vals[sb][j]);
+                        let k = ct_hash(&v, o == LT);
+                        let (ra, rb) = (t.reps[sa][i], t.reps[sb][j]);
+                        let term = || Term::op(o, ra, rb);
+                        if let Some(&rep) = t.map.get(&k) {
+                            if parse_first && Machine::parse(&rep).is_none() && Machine::parse(&term()).is_some() {
+                                t.map.insert(k, term());
+                                moved.insert(rep, term());
+                                t.displaced += 1;
+                            }
+                            t.merges += 1;
+                            seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                            let slot = if t.sample.len() < sample_n { Some(t.sample.len()) } else { Some((seed >> 64) as usize % t.merges).filter(|&x| x < sample_n) };
+                            if let Some(x) = slot {
+                                let c = (term(), rep);
+                                if x == t.sample.len() {
+                                    t.sample.push(c);
+                                } else {
+                                    t.sample[x] = c;
+                                }
+                            }
+                        } else {
+                            let n = term();
+                            t.map.insert(k, n);
+                            if o == LT {
+                                t.lts += 1;
+                            } else {
+                                t.reps[s].push(n);
+                                vals[s].push(v);
+                            }
+                            if t.map.len() >= max_classes {
+                                t.truncated = true;
+                                break 'sizes;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // a sampled pair's representative as the table ends; a displaced representative is now a member
+    for (u, r) in t.sample.iter_mut() {
+        if let Some(&n) = moved.get(r) {
+            (*u, *r) = if *u == n { (*r, n) } else { (*u, n) };
+        }
+    }
+    t
+}
+
+/// The refuter: 4096 random width-8 inputs, every width-4 input, the screen's width-8 inputs, in that order.
+struct CtRefuter {
+    tvars: Vec<Box<[u8]>>,
+    r8: ValueMemo<u8>,
+    e4: ValueMemo<u8>,
+}
+
+impl CtRefuter {
+    const TESTS: usize = 4096;
+    fn new() -> Self {
+        let mut seed = 0x6a09_e667_f3bc_c908u128;
+        let tvars: Vec<Box<[u8]>> = (0..3)
+            .map(|_| {
+                (0..Self::TESTS)
+                    .map(|_| {
+                        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                        (seed >> 40) as u8
+                    })
+                    .collect()
+            })
+            .collect();
+        let r8 = ValueMemo::<u8>::new(8, Self::TESTS, tvars.clone());
+        CtRefuter { tvars, r8, e4: ValueMemo::exhaustive(4, 3) }
+    }
+    /// Drop the memos' vectors (they grow with every term seen).
+    fn clear(&mut self) {
+        self.r8 = ValueMemo::<u8>::new(8, Self::TESTS, self.tvars.clone());
+        self.e4 = ValueMemo::exhaustive(4, 3);
+    }
+    /// An input on which `a` and `b` differ: (width, tuple).
+    fn refute(&mut self, a: &Term, b: &Term) -> Option<(usize, [u128; 3])> {
+        let tuple = |v: Vec<u128>| [v[0], v[1], v[2]];
+        if let Some(i) = self.r8.first_difference(a, b, Self::TESTS) {
+            return Some((8, tuple(self.r8.input(i))));
+        }
+        if let Some(i) = self.e4.first_difference(a, b, 1 << 12) {
+            return Some((4, tuple(self.e4.input(i))));
+        }
+        with_screen(8, 3, |m| m.first_difference(a, b, SCREEN_INPUTS).map(|i| (8, tuple(m.input(i)))))
+    }
+}
