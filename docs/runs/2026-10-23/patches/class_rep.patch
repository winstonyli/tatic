+/// Interned `Op` nodes so far, and the interner's cells (probe: the class table's memory).
+fn ct_interned() -> (usize, usize) {
+    (0..SHARDS).map(|s| (*TABLE[s].1.lock().unwrap(), cells(s).map_or(0, |c| c.cells.len()))).fold((0, 0), |a, b| (a.0 + b.0, a.1 + b.1))
+}
