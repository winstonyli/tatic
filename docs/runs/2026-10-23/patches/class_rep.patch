+/// Probe (docs/tier-cycle.md, "A key refined by counterexamples"): start the class table's key from `PROBE_KEY` (`exh`:
+/// every input at widths 3 and 4; a count: that many pseudo-random width-8 tuples plus the 8 tuples of 0s and 1s), then per
+/// round build the table to `PROBE_SIZE`, sample `PROBE_CLAIMS` of the merges it proposes, refute them (`CtRefuter`), and
+/// add to the key, greedily, one refuting input per refuted merge that the inputs added this round do not already
+/// separate; stop when a round's sample has no refuted merge or after `PROBE_ROUNDS`. Then normalise the laws in
+/// `PROBE_LAWFILES` by the final table, count suspect replacements and, with `PROBE_PROVE=1`, prove the others.
+#[test]
+#[ignore]
+fn key_refine_probe() {
+    let env = |k: &str| std::env::var(k).ok();
+    let max_size: usize = env("PROBE_SIZE").map_or(9, |v| v.parse().unwrap());
+    let max_classes: usize = env("PROBE_MAX").map_or(400000, |v| v.parse().unwrap());
+    let claims_n: usize = env("PROBE_CLAIMS").map_or(20000, |v| v.parse().unwrap());
+    let rounds: usize = env("PROBE_ROUNDS").map_or(20, |v| v.parse().unwrap());
+    let start = env("PROBE_KEY").unwrap_or("0".into());
+    let mut sets: CtSets = if start == "file" {
+        // PROBE_KEYIN: one input per line, `<width> <x> <y> <z>`
+        let text = std::fs::read_to_string(env("PROBE_KEYIN").unwrap()).unwrap();
+        let mut sets: CtSets = vec![];
+        for l in text.lines().filter(|l| !l.trim().is_empty()) {
+            let f: Vec<u128> = l.split_whitespace().map(|x| x.parse().unwrap()).collect();
+            let (w, x) = (f[0] as usize, [f[1], f[2], f[3]]);
+            match sets.iter_mut().find(|s| s.0 == w) {
+                Some(s) => s.1.push(x),
+                None => sets.push((w, vec![x])),
+            }
+        }
+        sets
+    } else if start == "exh" {
+        [3usize, 4].iter().map(|&w| (w, (0..1usize << (3 * w)).map(|i| [0, 1, 2].map(|v| (i >> (w * v) & ((1 << w) - 1)) as u128)).collect())).collect()
+    } else {
+        let mut seed = 0x2545_f491_4f6c_dd1du128;
+        let mut ins: Vec<[u128; 3]> = (0..8).map(|i| [0, 1, 2].map(|v| (i >> v & 1) as u128)).collect();
+        for _ in 0..start.parse::<usize>().unwrap() {
+            ins.push([0, 1, 2].map(|_| {
+                seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                (seed >> 40) & 0xff
+            }));
+        }
+        vec![(8, ins)]
+    };
+    let describe = |sets: &CtSets| sets.iter().map(|(w, ins)| format!("{} at width {w}", ins.len())).collect::<Vec<_>>().join(", ");
+    println!("MEM start: commit {} MB, interned {:?}", ct_commit_mb().0, ct_interned());
+    let mut refuter = CtRefuter::new();
+    let mut table = None;
+    // PROBE_ADD: `refuted` (default) adds refuting inputs; `none` keeps the key; a count adds that many random width-8
+    // inputs per round. PROBE_REFUTE=0 skips the refutation loop. Either change means no early stop.
+    let add_mode = env("PROBE_ADD").unwrap_or("refuted".into());
+    let do_refute = env("PROBE_REFUTE").map_or(true, |v| v != "0");
+    let mut gseed = 0x9e37_79b9_7f4a_7c15u128;
+    for round in 0..rounds {
+        let (before, nodes0) = (ct_commit_mb().0, ct_interned());
+        let t0 = Instant::now();
+        let t = ct_build(&sets, max_size, max_classes, claims_n, 0x51ed_270b_27a3_c1f5 + round as u128);
+        let build_ms = t0.elapsed().as_millis();
+        let (now, peak) = ct_commit_mb();
+        let nodes1 = ct_interned();
+        let bv: usize = t.reps.iter().map(|r| r.len()).sum();
+        let key_bytes: usize = sets.iter().map(|s| s.1.len()).sum();
+        println!(
+            "MEM detail round {round}: commit {before} MB before build; interned nodes {} -> {} (cells {} -> {}); map capacity {}; bit-vector reps {bv}; value bytes per rep {key_bytes} in {} vectors",
+            nodes0.0, nodes1.0, nodes0.1, nodes1.1, t.map.capacity(), sets.len()
+        );
+        println!("MEM round {round}: commit {now} MB after build, peak {peak} MB");
+        let (mut refuted, mut refuted_lt) = (0usize, 0usize);
+        let mut added: Vec<(usize, [u128; 3])> = vec![];
+        for (n, (u, r)) in t.sample.iter().enumerate().filter(|_| do_refute) {
+            if n % 1000 == 0 {
+                refuter.clear();
+            }
+            if let Some(cex) = refuter.refute(u, r) {
