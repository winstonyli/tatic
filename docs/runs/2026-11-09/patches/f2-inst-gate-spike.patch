+/// f2 spike: INST_GATE = s<k> (shared and height > k) or a<k> (any node with height > k); k = -1 means no cutoff.
+fn spike_gate(s: &Spaces, x: &Expr) -> bool {
+    static G: std::sync::OnceLock<(bool, i32)> = std::sync::OnceLock::new();
+    let &(sh, cut) = G.get_or_init(|| {
+        let v = std::env::var("INST_GATE").unwrap_or_else(|_| "s2".into());
+        (v.starts_with('s'), v[1..].parse().unwrap())
+    });
+    (!sh || s.shared(x)) && s.height(x) as i32 > cut
+}
