+/// SPIKE b3 (throwaway): doubling(d) for d in 6..=13 under `hc::uses` mode MASK (0 exact, 1 asserted, 2 mask): work,
+/// check ms and the d + m histogram.
+#[test]
+#[ignore]
+fn spike_mask() {
+    let mode: u8 = std::env::var("MASK").expect("MASK").parse().unwrap();
+    for d in 6..=13u32 {
+        std::thread::Builder::new()
+            .stack_size(256 << 20)
+            .spawn(move || {
+                tatic_kernel::mask_mode(mode);
+                let (s, h, frag) = compiled(&move |s: &mut TermStore| doubling(s, d));
+                tatic_kernel::scoped(|| {
+                    let (p, st) = statement(&s, h, 1, frag.entry(), 1);
+                    let _ = tatic_kernel::mask_stats();
+                    let w0 = tatic_kernel::work();
+                    let t = std::time::Instant::now();
+                    assert!(tatic_wasm::encoding::holds(&p, &st).is_ok());
+                    let ms = t.elapsed().as_secs_f64() * 1e3;
+                    let h = tatic_kernel::mask_stats();
+                    let calls: u64 = h[..65].iter().sum();
+                    let hist: Vec<String> = h[..65].iter().enumerate().filter(|(_, c)| **c > 0).map(|(k, c)| format!("{k}:{c}")).collect();
+                    println!("d={d} mode={mode} work={} ms={ms:.1} uses={calls} inexact={} hist {}", tatic_kernel::work() - w0, h[65], hist.join(" "));
+                });
+            })
+            .unwrap()
+            .join()
+            .unwrap();
+    }
+}
