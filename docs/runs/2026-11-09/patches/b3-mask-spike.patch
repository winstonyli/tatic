+/// SPIKE b3: sets `hc::uses`' mode (0 exact, 1 both asserted, 2 mask).
+pub fn mask_mode(m: u8) {
+    hc::MASK_MODE.with(|c| c.set(m));
+}
+/// SPIKE b3: `uses` calls by d + m, then inexact masks; resets them.
+pub fn mask_stats() -> [u64; 66] {
+    hc::MASK_STATS.with(|s| std::mem::replace(&mut *s.borrow_mut(), [0; 66]))
+}
+
+#[cfg(test)]
+mod mask_spike {
+    use super::*;
+    /// SPIKE b3: the mask's answer equals the exact walk on random terms with Vars up to 80 under up to ~12 binders.
+    #[test]
+    fn mask_matches_exact_uses() {
+        let mut rng = tatic_rng::SplitMix64::new(7);
+        fn rand_term(r: &mut tatic_rng::SplitMix64, depth: u32) -> Expr {
+            match if depth == 0 { r.below(2) } else { r.below(5) } {
+                0 => var(if r.below(4) == 0 { r.below(80) } else { r.below(8) }),
+                1 => sort(r.below(2)),
+                2 => pi(rand_term(r, depth - 1), rand_term(r, depth - 1)),
+                3 => lam(rand_term(r, depth - 1), rand_term(r, depth - 1)),
+                _ => app(rand_term(r, depth - 1), rand_term(r, depth - 1)),
+            }
+        }
+        mask_mode(1);
+        let mut n = 0;
+        scoped(|| {
+            for _ in 0..20000 {
+                let depth = 1 + rng.below(9);
+                let e = rand_term(&mut rng, depth);
+                for _ in 0..8 {
+                    let (d, m) = (rng.below(70), rng.below(70));
+                    with_spaces(|s| hc::uses(s, &e, d, m));
+                    n += 1;
+                }
+            }
+        });
+        let st = mask_stats();
+        mask_mode(0);
+        println!("queries {n}, inexact {}", st[65]);
+    }
+}
