 /// variable from `d`, which one (node, depth) entry answers for every `m` outside them; a walk
 /// that still stops at its first hit narrows them (doc section "The slot in front of bounds").
 pub fn uses(s: &Spaces, x: &Expr, d: u32, m: u32) -> bool {
+    let mask = s.mask(x);
+    let f = mask >> 56;
+    let exact = f == 255 || (d + m) as u64 <= f.min(56) || s.loose(x) <= d || s.loose(x) <= f.min(56) as u32;
+    MASK_STATS.with(|st| {
+        let mut st = st.borrow_mut();
+        st[((d + m) as usize).min(64)] += 1;
+        st[65] += !exact as u64;
+    });
+    let by_mask = || {
+        let lo = d.min(56);
+        let hi = (d + m).min(56);
+        let range = if hi > lo { ((1u64 << (hi - lo)) - 1) << lo } else { 0 };
+        mask & range != 0
+    };
+    match MASK_MODE.with(|c| c.get()) {
+        2 if exact => by_mask(),
+        1 => {
+            let r = uses_exact(s, x, d, m);
+            if exact {
+                assert_eq!(r, by_mask(), "mask disagrees: d={d} m={m} mask={mask:#x}");
+            }
+            r
+        }
+        _ => uses_exact(s, x, d, m),
+    }
+}
