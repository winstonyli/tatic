+/// PROBE (a1): region nodes and work of `doubling(GATE_D)`'s check, split into typing the claim, `conv`, and the rest.
+#[test]
+#[ignore]
+fn probe_phases() {
+    let d: u32 = std::env::var("GATE_D").unwrap().parse().unwrap();
+    std::thread::Builder::new()
+        .stack_size(256 << 20)
+        .spawn(move || {
+            let (s, h, frag) = compiled(&move |s: &mut TermStore| doubling(s, d));
+            tatic_kernel::scoped(|| {
+                let (p, st) = statement(&s, h, 1, frag.entry(), 1);
+                let (n0, w0, p0) = (tatic_kernel::region_len(), tatic_kernel::work(), tatic_kernel::phases());
+                assert!(tatic_wasm::encoding::holds(&p, &st).is_ok());
+                let (n, w, p1) = (tatic_kernel::region_len() - n0, tatic_kernel::work() - w0, tatic_kernel::phases());
+                let q: Vec<u64> = (0..4).map(|i| p1[i] - p0[i]).collect();
+                println!("d={d} total nodes {n} work {w} | claim nodes {} work {} | conv nodes {} work {} | rest nodes {} work {}",
+                    q[0], q[1], q[2], q[3], n - q[0] - q[2], w - q[1] - q[3]);
+            });
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
