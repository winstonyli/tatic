diff --git a/crates/tatic-kernel/src/stack.rs b/crates/tatic-kernel/src/stack.rs
index a8fc7f3..ce65063 100644
--- a/crates/tatic-kernel/src/stack.rs
+++ b/crates/tatic-kernel/src/stack.rs
@@ -61,9 +61,33 @@ fn stack_ok() -> bool {
 /// heap, not native stack.
 #[inline(always)]
 pub fn grow<R>(f: impl FnOnce() -> R) -> R {
+    PROBE_MIN.with(|m| {
+        let a = stack_addr();
+        if a < m.get() {
+            m.set(a)
+        }
+    });
     if stack_ok() { f() } else { grow_slow(f) }
 }
 
+thread_local! {
+    static PROBE_MIN: std::cell::Cell<usize> = const { std::cell::Cell::new(usize::MAX) };
+}
+
+/// PROBE: on_segment, reachable from the tatic crate.
+pub fn probe_on_segment<R>(size: usize, f: impl FnOnce() -> R) -> R {
+    on_segment(size, f)
+}
+
+/// PROBE: whether this thread runs on a large segment.
+pub static PROBE_REUSE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+thread_local! {
+    static PROBE_ON_BIG: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+pub fn probe_on_big() -> bool {
+    PROBE_REUSE.load(std::sync::atomic::Ordering::Relaxed) && PROBE_ON_BIG.with(|b| b.get())
+}
+
 /// [`grow`]'s slow path: the first check on a thread (`FLOOR` unknown),
 /// or a segment genuinely running low.
 #[cold]
@@ -119,7 +143,23 @@ pub(super) fn on_segment<R>(size: usize, f: impl FnOnce() -> R) -> R {
     }
     stacker::grow(size, || {
         let _restore = Restore(FLOOR.with(|f| f.replace(floor_here().unwrap_or(usize::MAX))));
-        f()
+        let top = stack_addr();
+        let old = PROBE_MIN.with(|m| m.replace(usize::MAX));
+        let was_big = PROBE_ON_BIG.with(|b| b.replace(size >= CHECK_SEGMENT));
+        let sw0 = segment_switches();
+        let r = f();
+        PROBE_ON_BIG.with(|b| b.set(was_big));
+        let min = PROBE_MIN.with(|m| m.replace(old));
+        if size >= CHECK_SEGMENT {
+            let depth = top.saturating_sub(min);
+            eprintln!(
+                "SEG size={size} top={top:#x} depth_bytes={depth} lines={} pages={} nested_switches={}",
+                depth / 64,
+                depth / 4096,
+                segment_switches() - sw0
+            );
+        }
+        r
     })
 }
 
