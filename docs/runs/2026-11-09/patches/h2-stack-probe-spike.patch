+#[cfg(windows)]
+fn page_faults() -> u64 {
+    #[repr(C)]
+    struct Counters {
+        cb: u32,
+        page_fault_count: u32,
+        rest: [usize; 8],
+    }
+    #[link(name = "kernel32")]
