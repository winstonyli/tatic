+    /// The inverse of `tag_leaf` and `for_kids`: the node with tag `tag`, leaf `leaf` (for a leaf tag) and children
+    /// `k` in field order (only the first as many as the constructor has are read).
+    #[inline(always)]
+    pub fn from_tag(tag: u8, leaf: u32, k: [C; 5]) -> Node<C>
+    where
+        C: Copy,
+    {
+        use Node::*;
+        match tag {
+            0 => Var(leaf),
+            1 => Sort(leaf),
+            2 => Const(leaf),
+            3 => Free(leaf),
+            4 => Pi(k[0], k[1]),
+            5 => Lam(k[0], k[1]),
+            6 => App(k[0], k[1]),
+            7 => Id(k[0], k[1], k[2]),
+            8 => Refl(k[0]),
+            9 => J { motive: k[0], base: k[1], a: k[2], b: k[3], p: k[4] },
+            10 => W(k[0], k[1]),
+            11 => Sup(k[0], k[1]),
+            12 => WRec { motive: k[0], children_ty: k[1], step: k[2], target: k[3] },
+            13 => Sigma(k[0], k[1]),
+            14 => Pair(k[0], k[1], k[2]),
+            _ => SigRec { motive: k[0], step: k[1], target: k[2] },
+        }
+    }
+
     /// Whether `self` and `other` have the same outermost constructor (and index, for `Var`/`Sort`/`Const`/`Free`)
     /// and `c` holds of each pair of children, in field order, stopping at the first that fails. Syntactic equality
     /// and `conv_whnf` are both this with a different `c`.
