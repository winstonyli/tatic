+    /// PROBE (y1, not for commit): [region nodes, region bytes, persistent bytes, memo bytes], by capacity.
+    pub(crate) fn footprint(&self) -> [usize; 4] {
+        use std::mem::size_of;
+        fn space(s: &Space) -> usize {
+            s.nodes.capacity() * size_of::<Node<Ref>>()
+                + (s.loose.capacity() + s.free.capacity() + s.uses.capacity()) * 4
+                + s.parents.capacity()
+                + s.height.capacity()
+                + s.table.capacity() * 9
+        }
+        fn map<K, V>(m: &IdMap<K, V>) -> usize {
+            m.capacity() * (size_of::<(K, V)>() + 1)
+        }
+        let i = self.get();
+        let m = self.memos.borrow();
+        let memo = map(&m.inst) + map(&m.shifts) + map(&m.whnf) + map(&m.hnf) + map(&m.nf) + map(&m.spine) + map(&m.arg_sets) + map(&m.bounds);
+        [i.region.nodes.len(), space(&i.region), space(&i.persistent), memo]
+    }
+
+    /// PROBE (z1 survey): each region array and memo as `name len cap bytes`.
+    pub(crate) fn footprint_detail(&self) -> String {
+        use std::mem::size_of;
