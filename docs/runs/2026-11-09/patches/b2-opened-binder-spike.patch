+/// SPIKE b2 (throwaway): doubling(GATE_D) checked under Var binders (OPEN=0, the gate) or with the law telescope
+/// opened onto postulated constants (OPEN=1). Prints work, region nodes and the memo table sizes after the check.
+#[test]
+#[ignore]
+fn spike_opened() {
+    use tatic_kernel::{app, lam, whnf, Node, Postulates};
+    let d: u32 = std::env::var("GATE_D").expect("GATE_D").parse().unwrap();
+    let open = std::env::var("OPEN").as_deref() == Ok("1");
+    std::thread::Builder::new()
+        .stack_size(256 << 20)
+        .spawn(move || {
+            let (s, h, frag) = compiled(&move |s: &mut TermStore| doubling(s, d));
+            tatic_kernel::scoped(|| {
+                let (mut p, mut st) = statement(&s, h, 1, frag.entry(), 1);
+                let mut ps = Postulates::new();
+                let mut n = 0;
+                if open {
+                    while let (Node::Pi(a, cod), Node::Lam(_, body)) = (st.node(), p.node()) {
+                        let pos = ps.push(a);
+                        let c = ps.get(pos);
+                        st = whnf(&app(lam(a, cod), c));
+                        p = whnf(&app(lam(a, body), c));
+                        n += 1;
+                    }
+                }
+                let w0 = tatic_kernel::work();
+                let r0 = tatic_kernel::footprint()[0];
+                let t = std::time::Instant::now();
+                let ok = if open { ps.check(&p, &st) } else { tatic_wasm::encoding::holds(&p, &st) };
+                let ms = t.elapsed().as_secs_f64() * 1e3;
+                println!("d={d} open={open} binders={n} ok={} check_ms={ms:.1} work={} region_before={r0}", ok.is_ok(), tatic_kernel::work() - w0);
+                if let Err(e) = ok { println!("err: {}", e.chars().take(300).collect::<String>()); }
+                print!("{}", tatic_kernel::footprint_detail());
+            });
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
