+        row("shifts", m.shifts.len(), m.shifts.capacity(), per(&m.shifts));
+        row("whnf", m.whnf.len(), m.whnf.capacity(), per(&m.whnf));
+        row("hnf", m.hnf.len(), m.hnf.capacity(), per(&m.hnf));
