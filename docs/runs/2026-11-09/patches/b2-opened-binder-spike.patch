+/// PROBE (y1, not for commit): one `doubling(PROBE_D)`, built, and checked when PROBE_CHECK=1; for cachegrind, which
+/// counts the whole process, so the check's misses are the difference of the two.
+#[test]
+#[ignore]
+fn probe_cg() {
+    let d: u32 = std::env::var("PROBE_D").unwrap().parse().unwrap();
+    let check = std::env::var("PROBE_CHECK").as_deref() == Ok("1");
+    std::thread::Builder::new()
+        .stack_size(256 << 20)
+        .spawn(move || {
+            let (s, h, frag) = compiled(&move |s: &mut TermStore| doubling(s, d));
+            tatic_kernel::scoped(|| {
+                let (p, st) = statement(&s, h, 1, frag.entry(), 1);
+                if check {
+                    assert!(tatic_wasm::encoding::holds(&p, &st).is_ok());
+                }
+                println!("d={d} check={check} work={}", tatic_kernel::work());
+            });
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
