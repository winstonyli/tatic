+        row("loose", s.loose.len(), s.loose.capacity(), 4);
+        row("free", s.free.len(), s.free.capacity(), 4);
+        row("uses", s.uses.len(), s.uses.capacity(), 4);
+        row("parents", s.parents.len(), s.parents.capacity(), 1);
+        row("height", s.height.len(), s.height.capacity(), 1);
+        row("table", s.table.len(), s.table.capacity(), 9);
+        row("copies", i.copies.len(), i.copies.capacity(), 4);
+        row("twins", i.twins.len(), i.twins.capacity(), size_of::<Ref>());
+        fn per<K, V>(_: &IdMap<K, V>) -> usize {
