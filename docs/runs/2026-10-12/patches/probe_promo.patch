+/// The term order that sorts commutative operands and orients permutative instances (temporary probe: `ORDER=rev` reverses
+/// the `show()` order, `ORDER=size` compares size first).
+pub fn term_lt(a: &Term, b: &Term) -> bool {
+    match std::env::var("ORDER").as_deref() {
+        Ok("rev") => a.show() > b.show(),
+        Ok("size") => (a.size(), a.show()) < (b.size(), b.show()),
+        _ => a.show() < b.show(),
+    }
+}
