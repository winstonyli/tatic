+/// FLOOR PROBE: rank of a leaf or head in the path order (leaves under all operators, operators by precedence then index).
+fn lpo_rank(t: &Term) -> (i32, i64) {
+    match *t.node() {
+        Node::Zero => (-3, 0),
+        Node::Ones => (-2, 0),
+        Node::V(i) => (-1, i as i64),
+        Node::Op(o, ..) => (OP_INFO[o].prec as i32, o as i64),
+    }
+}
+
+/// FLOOR PROBE: `s > t` in the lexicographic path order with `lpo_rank`'s total precedence (the deleted section 89 order).
+pub fn lpo_greater(s: &Term, t: &Term) -> bool {
+    let Node::Op(_, sa, sb) = *s.node() else {
+        return !matches!(*t.node(), Node::Op(..)) && lpo_rank(s) > lpo_rank(t);
+    };
+    if [sa, sb].into_iter().any(|x| x == *t || lpo_greater(&x, t)) {
+        return true;
+    }
+    let Node::Op(_, ta, tb) = *t.node() else { return true };
+    let (rs, rt) = (lpo_rank(s), lpo_rank(t));
+    if rs > rt {
+        return lpo_greater(s, &ta) && lpo_greater(s, &tb);
+    }
+    if rs < rt {
+        return false;
+    }
+    if sa != ta {
+        lpo_greater(&sa, &ta) && lpo_greater(s, &tb)
+    } else {
+        lpo_greater(&sb, &tb)
+    }
+}
