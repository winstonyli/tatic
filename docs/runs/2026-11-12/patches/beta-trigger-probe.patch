+//! PROBE (worktree only, never merged): what triggers each beta reduction in whnf, whether the same redexes repeat,
+//! and which checker binder owns the loose variables of the beta's lambda. Counting never ticks `work` and builds no node.
+use super::*;
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, HashSet};
+use std::hash::{Hash, Hasher};
+
+pub const SITES: [&str; 4] = ["beta_spine", "closed_prefix_spine", "single_beta", "hnf_rc(subst_top)"];
+pub const BS_SPINE: usize = 0;
+pub const BS_CLOSED: usize = 1;
+pub const BS_SINGLE: usize = 2;
+pub const BS_HNF: usize = 3;
+
+#[derive(Clone, Copy, Default)]
+struct Trig {
+    caller: &'static str,
+    kind: &'static str,
+    check_from: &'static str,
+    conv_depth: u32,
+    side: u8,
+}
+
+thread_local! {
+    static CALLER: Cell<&'static str> = const { Cell::new("other") };
+    static CHECKFROM: Cell<&'static str> = const { Cell::new("none") };
+    static KIND: Cell<&'static str> = const { Cell::new("top") };
+    static WDEPTH: Cell<u32> = const { Cell::new(0) };
+    static TRIG: Cell<Option<Trig>> = const { Cell::new(None) };
+    static CONV: Cell<(u32, u8)> = const { Cell::new((0, 0)) };
+    static OPENED: RefCell<Vec<&'static str>> = const { RefCell::new(Vec::new()) };
+    static ORIGINS: RefCell<Vec<(u8, &'static str, u32)>> = const { RefCell::new(Vec::new()) };
+    static NEXT_ORIGIN: Cell<(&'static str, u32)> = const { Cell::new(("unlabelled", 0)) };
+    static CHAIN: Cell<Option<u32>> = const { Cell::new(None) };
+    static STAGE_: Cell<u8> = const { Cell::new(0) };
+    static EVENTS: RefCell<Vec<Ev>> = const { RefCell::new(Vec::new()) };
+    static TRIGTAB: RefCell<BTreeMap<(String, usize), (u64, u64, u64)>> = const { RefCell::new(BTreeMap::new()) };
+    static OWN_LOW: RefCell<BTreeMap<String, (u64, u64, u64)>> = const { RefCell::new(BTreeMap::new()) };
+    static OWN_DEEP: RefCell<BTreeMap<String, (u64, u64, u64)>> = const { RefCell::new(BTreeMap::new()) };
+    static DEPTHTAB: RefCell<BTreeMap<(usize, usize), (u64, u64, u64)>> = const { RefCell::new(BTreeMap::new()) };
+    static FV: RefCell<std::collections::HashMap<u32, u128>> = RefCell::new(Default::default());
+    static TOT: Cell<(u64, u64)> = const { Cell::new((0, 0)) };
+}
+
+struct Ev {
+    site: usize,
+    lam: u32,
+    red: u64,
+    inp: u32,
+    lam_canon: u64,
+    red_canon: u64,
+    sh: u64,
+    inst: u64,
+    lam_loose: bool,
+    nargs: usize,
+    taken_lams: usize,
+    d: usize,
+    c: usize,
+    trig: String,
+    low: String,
+    mask: u128,
+}
+
+pub fn reset() {
+    CALLER.with(|c| c.set("other"));
+    CHECKFROM.with(|c| c.set("none"));
+    KIND.with(|c| c.set("top"));
+    WDEPTH.with(|c| c.set(0));
+    TRIG.with(|c| c.set(None));
+    CONV.with(|c| c.set((0, 0)));
+    OPENED.with(|c| c.borrow_mut().clear());
+    ORIGINS.with(|c| c.borrow_mut().clear());
+    CHAIN.with(|c| c.set(None));
+    STAGE_.with(|c| c.set(0));
+    EVENTS.with(|c| c.borrow_mut().clear());
+    TRIGTAB.with(|c| c.borrow_mut().clear());
+    OWN_LOW.with(|c| c.borrow_mut().clear());
+    OWN_DEEP.with(|c| c.borrow_mut().clear());
+    DEPTHTAB.with(|c| c.borrow_mut().clear());
+    FV.with(|c| c.borrow_mut().clear());
+    TOT.with(|c| c.set((0, 0)));
+}
+
+/// Called by `prof::add` for every Shift / Inst tick.
+pub fn tick(shift: bool, n: u64) {
+    TOT.with(|c| {
+        let (a, b) = c.get();
+        c.set(if shift { (a + n, b) } else { (a, b + n) })
+    });
+}
+fn totals() -> (u64, u64) {
+    TOT.with(|c| c.get())
+}
+
+// ---- trigger context ----
+pub struct Restore<T: Copy + 'static>(&'static std::thread::LocalKey<Cell<T>>, T);
+impl<T: Copy + 'static> Drop for Restore<T> {
+    fn drop(&mut self) {
+        self.0.with(|c| c.set(self.1));
+    }
+}
+fn setting<T: Copy + 'static>(k: &'static std::thread::LocalKey<Cell<T>>, v: T) -> Restore<T> {
+    Restore(k, k.with(|c| c.replace(v)))
+}
+/// The label of the nearest enclosing external caller of whnf / def_eq / nf.
+pub fn caller(label: &'static str) -> Restore<&'static str> {
+    setting(&CALLER, label)
+}
+/// Which `check` call site asked (for the check's own `def_eq(inferred, expected)`).
+pub fn checkfrom(label: &'static str) -> Restore<&'static str> {
+    setting(&CHECKFROM, label)
+}
+pub fn kind(label: &'static str) -> Restore<&'static str> {
+    setting(&KIND, label)
+}
+
+pub struct ConvGuard(Option<(u32, u8)>);
+pub fn conv_enter() -> ConvGuard {
+    let p = CONV.with(|c| {
+        let p = c.get();
+        c.set((p.0 + 1, p.1));
+        p
+    });
+    ConvGuard(Some(p))
+}
+impl Drop for ConvGuard {
+    fn drop(&mut self) {
+        if let Some(p) = self.0 {
+            CONV.with(|c| c.set(p));
+        }
+    }
+}
+/// Which side of the conv's pair is being whnf'd (0 = a, 1 = b).
+pub fn side(s: u8) -> ConvGuard {
+    let p = CONV.with(|c| {
+        let p = c.get();
+        c.set((p.0, s));
+        p
+    });
+    ConvGuard(Some(p))
+}
+
+pub struct WGuard;
+/// Entered on every whnf_in miss; the outermost one captures the trigger.
+pub fn whnf_enter() -> WGuard {
+    let d = WDEPTH.with(|c| {
+        let d = c.get();
+        c.set(d + 1);
+        d
+    });
+    if d == 0 {
+        let (conv_depth, side) = CONV.with(|c| c.get());
+        TRIG.with(|t| {
+            t.set(Some(Trig {
+                caller: CALLER.with(|c| c.get()),
+                kind: KIND.with(|c| c.get()),
+                check_from: CHECKFROM.with(|c| c.get()),
+                conv_depth,
+                side,
+            }))
+        });
+    }
+    WGuard
+}
+impl Drop for WGuard {
+    fn drop(&mut self) {
+        WDEPTH.with(|c| c.set(c.get() - 1));
+    }
+}
+
+// ---- binders opened by traversals that carry no checker context ----
+pub struct OpenGuard(bool);
+pub fn open(label: &'static str, under: bool) -> OpenGuard {
+    if under {
+        OPENED.with(|o| o.borrow_mut().push(label));
+    }
+    OpenGuard(under)
+}
+impl Drop for OpenGuard {
+    fn drop(&mut self) {
+        if self.0 {
+            OPENED.with(|o| {
+                o.borrow_mut().pop();
+            });
+        }
+    }
+}
+
+// ---- checker context entries ----
+pub fn set_stage(s: u8) {
+    STAGE_.with(|c| c.set(s));
+}
+pub fn init_ctx(base: usize) {
+    ORIGINS.with(|o| *o.borrow_mut() = vec![(0, "base ctx", 0); base]);
+    CHAIN.with(|c| c.set(Some(0)));
+}
+pub fn next_origin(label: &'static str, ord: u32) {
+    NEXT_ORIGIN.with(|c| c.set((label, ord)));
+}
+pub fn push_origin() {
+    let (l, o) = NEXT_ORIGIN.with(|c| c.replace(("unlabelled", 0)));
+    ORIGINS.with(|v| v.borrow_mut().push((STAGE_.with(|c| c.get()), l, o)));
+}
+pub fn pop_origin() {
+    ORIGINS.with(|v| {
+        v.borrow_mut().pop();
+    });
+}
+/// A `check` Lam-against-Pi step: the proof's leading chain (ordinal k) or a deeper lambda.
+pub fn chain_step() {
+    let r = CHAIN.with(|c| {
+        let r = c.get();
+        if let Some(k) = r {
+            c.set(Some(k + 1));
+        }
+        r
+    });
+    match r {
+        Some(k) => next_origin("proof lead lambda vs stmt Pi", k),
+        None => next_origin("deeper proof lambda (check Lam)", 0),
+    }
+}
+pub fn chain_off() {
+    CHAIN.with(|c| c.set(None));
+}
+
+// ---- term helpers (read-only: no tick, no node built) ----
+fn fv(s: &Spaces, e: &Expr) -> u128 {
+    let k = s.key(e);
+    if let Some(m) = FV.with(|f| f.borrow().get(&k).copied()) {
+        return m;
+    }
+    let m = match s.node(e) {
+        Node::Var(i) => 1u128 << i.min(127),
+        n => {
+            let mut m = 0u128;
+            n.for_kids(|c, under| {
+                let cm = fv(s, c);
+                m |= if under { cm >> 1 } else { cm };
+            });
+            m
+        }
+    };
+    FV.with(|f| f.borrow_mut().insert(k, m));
+    m
+}
+
+fn h2(a: u64, b: u64) -> u64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    (a, b).hash(&mut h);
+    h.finish()
+}
+
+/// Structural hash with loose variables renumbered by `-off` (so a term and its shift hash alike).
+fn canon(s: &Spaces, e: &Expr, depth: u32, off: u32, memo: &mut std::collections::HashMap<(u32, u32), u64>) -> u64 {
+    let k = (s.key(e), depth);
+    if let Some(h) = memo.get(&k) {
+        return *h;
+    }
+    let n = s.node(e);
+    let h = match n {
+        Node::Var(i) if i >= depth => h2(0xAA, (i - depth).saturating_sub(off) as u64),
+        Node::Var(i) => h2(0xBB, i as u64),
+        n => {
+            let (t, l) = n.tag_leaf();
+            let mut h = h2(t as u64, l as u64);
+            n.for_kids(|c, under| {
+                let ch = canon(s, c, depth + under as u32, off, memo);
+                h = h2(h, ch);
+            });
+            h
+        }
+    };
+    memo.insert(k, h);
+    h
+}
+
+fn lam_telescope(s: &Spaces, e: &Expr) -> usize {
+    let mut n = 0;
+    let mut cur = *e;
+    while let Node::Lam(_, b) = s.node(&cur) {
+        n += 1;
+        cur = b;
+    }
+    n
+}
+
+// ---- beta events ----
+pub struct Tok {
+    site: usize,
+    lam: Expr,
+    args: Vec<Expr>,
+    inp: Expr,
+    t0: (u64, u64),
+}
+pub fn beta_begin(site: usize, lam: &Expr, args: &[&Expr], inp: &Expr) -> Option<Tok> {
+    prof::on().then(|| Tok { site, lam: *lam, args: args.iter().map(|a| **a).collect(), inp: *inp, t0: totals() })
+}
+
+fn add3(m: &mut (u64, u64, u64), sh: u64, inst: u64) {
+    m.0 += 1;
+    m.1 += sh;
+    m.2 += inst;
+}
+
+fn class_of(i: u32, c: usize, d: usize, opened: &[&'static str], origins: &[(u8, &'static str, u32)]) -> String {
+    let i = i as usize;
+    if i < c {
+        return format!("opened inside {} (traversal binder)", opened[c - 1 - i]);
+    }
+    let j = i - c;
+    if j < d {
+        let (st, l, o) = origins[d - 1 - j];
+        let stg = if l == "base ctx" { "" } else if st == 0 { "stmt: " } else { "proof: " };
+        if l.starts_with("proof lead") { format!("{stg}{l} [{o}]") } else { format!("{stg}{l}") }
+    } else {
+        format!("beyond the context (index {i}, ctx {d}, opened {c})")
+    }
+}
+
+pub fn beta_end(s: &Spaces, t: Option<Tok>) {
+    let Some(t) = t else { return };
+    let (a, b) = totals();
+    let (sh, inst) = (a - t.t0.0, b - t.t0.1);
+    let trig = TRIG.with(|c| c.get());
+    let trig_s = match trig {
+        None => "none (no whnf entry)".to_string(),
+        Some(g) => {
+            let base = if g.caller.starts_with("expect_") || g.caller.starts_with("whnf(") {
+                format!("{} in {}", g.caller, g.kind)
+            } else if g.caller == "defeq:check(inferred,expected)" {
+                format!("{} <- check from {}", g.caller, g.check_from)
+            } else {
+                g.caller.to_string()
+            };
+            if g.conv_depth > 0 {
+                format!("conv[{}] {} side {}", if g.conv_depth == 1 { "top" } else { "nested" }, base, if g.side == 0 { "A" } else { "B" })
+            } else {
+                format!("direct {base}")
+            }
+        }
+    };
+    let opened: Vec<&'static str> = OPENED.with(|o| o.borrow().clone());
+    let origins: Vec<(u8, &'static str, u32)> = ORIGINS.with(|o| o.borrow().clone());
+    let (c, d) = (opened.len(), origins.len());
+    let lam_mask = fv(s, &t.lam);
+    let mut all = lam_mask;
+    for a in &t.args {
+        all |= fv(s, a);
+    }
+    let lam_off = lam_mask.trailing_zeros().min(128);
+    let all_off = all.trailing_zeros().min(128);
+    let mut memo = Default::default();
+    let lam_canon = if lam_mask == 0 { canon(s, &t.lam, 0, 0, &mut memo) } else { canon(s, &t.lam, 0, lam_off, &mut memo) };
+    let mut memo2 = Default::default();
+    let mut red_canon = canon(s, &t.lam, 0, if all == 0 { 0 } else { all_off }, &mut memo2);
+    for a in &t.args {
+        red_canon = h2(red_canon, canon(s, a, 0, if all == 0 { 0 } else { all_off }, &mut memo2));
+    }
+    let mut red = s.key(&t.lam) as u64;
+    for a in &t.args {
+        red = h2(red, s.key(a) as u64);
+    }
+    // owner classes
+    let (low_cls, deep_cls) = if lam_mask == 0 {
+        ("closed lambda (no loose vars)".to_string(), "closed lambda (no loose vars)".to_string())
+    } else {
+        let lo = lam_mask.trailing_zeros();
+        let hi = 127 - lam_mask.leading_zeros();
+        (class_of(lo, c, d, &opened, &origins), class_of(hi, c, d, &opened, &origins))
+    };
+    TRIGTAB.with(|m| add3(m.borrow_mut().entry((trig_s.clone(), t.site)).or_default(), sh, inst));
+    OWN_LOW.with(|m| add3(m.borrow_mut().entry(low_cls.clone()).or_default(), sh, inst));
+    OWN_DEEP.with(|m| add3(m.borrow_mut().entry(deep_cls).or_default(), sh, inst));
+    DEPTHTAB.with(|m| add3(m.borrow_mut().entry((d, c)).or_default(), sh, inst));
+    EVENTS.with(|e| {
+        e.borrow_mut().push(Ev {
+            site: t.site,
+            lam: s.key(&t.lam),
+            red,
+            inp: s.key(&t.inp),
+            lam_canon,
+            red_canon,
+            sh,
+            inst,
+            lam_loose: lam_mask != 0,
+            nargs: t.args.len(),
+            taken_lams: lam_telescope(s, &t.lam),
+            d,
+            c,
+            trig: trig_s,
+            low: low_cls,
+            mask: lam_mask,
+        })
+    });
+}
+
+// ---- report ----
+fn row(m: &(u64, u64, u64)) -> String {
+    format!("{:>6} {:>7} {:>7}", m.0, m.1, m.2)
+}
+
+pub fn print(name: &str, site_stats: &[(&'static str, prof::SiteStat)], tot: (u64, u64)) {
+    let p = |s: String| println!("BETA {name}: {s}");
+    EVENTS.with(|evs| {
+        let evs = evs.borrow();
+        let sum = |f: &dyn Fn(&Ev) -> bool| evs.iter().filter(|e| f(e)).fold((0u64, 0u64, 0u64), |a, e| (a.0 + 1, a.1 + e.sh, a.2 + e.inst));
+        p(format!("whole-check totals: shift {} instantiate {}", tot.0, tot.1));
+        for (i, n) in SITES.iter().enumerate() {
+            let r = sum(&|e| e.site == i);
+            let lbl = ["whnf:beta_spine", "whnf:closed_prefix_spine", "whnf:single beta", "whnf:hnf_rc"][i];
+            let st = site_stats.iter().find(|(l, _)| l.starts_with(lbl));
+            let (ss, si, sc) = st.map(|(_, v)| (v.shift, v.inst, v.calls)).unwrap_or((0, 0, 0));
+            p(format!(
+                "site {n:<22} events: calls {} shift {} inst {} | prof::sites: calls {sc} shift {ss} inst {si} | match {}",
+                r.0,
+                r.1,
+                r.2,
+                (r.1, r.2) == (ss, si)
+            ));
+        }
+        let b3 = sum(&|e| e.site < 3);
+        p(format!(
+            "three beta sites: calls {} shift {} ({:.1}%) inst {} ({:.1}%)",
+            b3.0,
+            b3.1,
+            100.0 * b3.1 as f64 / tot.0.max(1) as f64,
+            b3.2,
+            100.0 * b3.2 as f64 / tot.1.max(1) as f64
+        ));
+        let all4 = sum(&|_| true);
+        p(format!("all four (with hnf_rc): calls {} shift {} inst {}", all4.0, all4.1, all4.2));
+        let loose = sum(&|e| e.site < 3 && e.lam_loose);
+        p(format!("three sites, lambda has loose vars: calls {} shift {} ({:.1}% of beta shift) inst {}", loose.0, loose.1, 100.0 * loose.1 as f64 / b3.1.max(1) as f64, loose.2));
+
+        // 1. trigger x site
+        p("== 1. TRIGGER (outermost whnf entry's caller) x site -> calls shift inst   [hnf_rc shown last]".into());
+        let tab = TRIGTAB.with(|m| m.borrow().clone());
+        let mut trigs: Vec<String> = tab.keys().map(|k| k.0.clone()).collect::<HashSet<_>>().into_iter().collect();
+        let tsum = |t: &String| (0..4).map(|s| tab.get(&(t.clone(), s)).map(|x| x.1 + x.2).unwrap_or(0)).sum::<u64>();
+        trigs.sort_by(|a, b| tsum(b).cmp(&tsum(a)));
+        for t in &trigs {
+            let mut line = format!("{t}\n          ");
+            for (i, n) in SITES.iter().enumerate() {
+                if let Some(x) = tab.get(&(t.clone(), i)) {
+                    line += &format!(" | {n}: {} calls {} sh {} in", x.0, x.1, x.2);
+                }
+            }
+            p(line);
+        }
+        // trigger totals (3 sites)
+        p("-- trigger totals over the three beta sites (calls shift inst)".into());
+        for t in &trigs {
+            let x = (0..3).fold((0, 0, 0), |a, s| {
+                let y = tab.get(&(t.clone(), s)).copied().unwrap_or_default();
+                (a.0 + y.0, a.1 + y.1, a.2 + y.2)
+            });
+            if x.0 > 0 {
+                p(format!("{} {t}", row(&x)));
+            }
+        }
+
+        // 2. repetition
+        p("== 2. REPETITION (three beta sites; keys over (lambda, args) etc.): distinct / calls | units first (sh/in) | units on repeats (sh/in) | calls that are repeats".into());
+        type KeyFn = fn(&Ev) -> u64;
+        let keyfns: [(&str, KeyFn); 5] = [
+            ("redex (lambda,args) identity", |e| e.red),
+            ("whnf input term identity", |e| e.inp as u64),
+            ("lambda alone", |e| e.lam as u64),
+            ("lambda alone, shift-normalised", |e| e.lam_canon),
+            ("redex (lambda,args), shift-normalised jointly", |e| e.red_canon),
+        ];
+        for (nm, f) in keyfns {
+            let mut seen = HashSet::new();
+            let (mut calls, mut rc) = (0, 0);
+            let (mut f_sh, mut f_in, mut r_sh, mut r_in) = (0, 0, 0, 0);
+            for e in evs.iter().filter(|e| e.site < 3) {
+                calls += 1;
+                if seen.insert(f(e)) {
+                    f_sh += e.sh;
+                    f_in += e.inst;
+                } else {
+                    rc += 1;
+                    r_sh += e.sh;
+                    r_in += e.inst;
+                }
+            }
+            p(format!("{nm:<48} {:>4} / {:>4} | {f_sh}/{f_in} | {r_sh}/{r_in} | {rc}", seen.len(), calls));
+        }
+        // same, per site, redex identity
+        for s in 0..3 {
+            let mut seen = HashSet::new();
+            let (mut calls, mut rc, mut r_sh, mut r_in) = (0, 0, 0, 0);
+            for e in evs.iter().filter(|e| e.site == s) {
+                calls += 1;
+                if !seen.insert(e.red) {
+                    rc += 1;
+                    r_sh += e.sh;
+                    r_in += e.inst;
+                }
+            }
+            p(format!("  redex identity, site {}: distinct {} / calls {calls} | repeat units {r_sh}/{r_in} | repeat calls {rc}", SITES[s], seen.len()));
+        }
+        // multiplicity histogram of the redex key
+        let mut mult: std::collections::HashMap<u64, (u32, u64)> = Default::default();
+        for e in evs.iter().filter(|e| e.site < 3) {
+            let m = mult.entry(e.red_canon).or_default();
+            m.0 += 1;
+            m.1 += e.sh + e.inst;
+        }
+        let mut v: Vec<_> = mult.values().copied().collect();
+        v.sort_by(|a, b| b.1.cmp(&a.1));
+        p(format!("shift-normalised redex classes by total units (times, units): {:?}", &v[..v.len().min(12)]));
+
+        // top events
+        p("== top beta events by units (site, calls-order idx, nargs, lambda telescope, ctx D / opened c, lam loose mask low..., trigger, lowest-var owner)".into());
+        let mut idx: Vec<usize> = (0..evs.len()).filter(|&i| evs[i].site < 3).collect();
+        idx.sort_by(|&a, &b| (evs[b].sh + evs[b].inst).cmp(&(evs[a].sh + evs[a].inst)));
+        for &i in idx.iter().take(8) {
+            let e = &evs[i];
+            p(format!(
+                "#{i} {} nargs {} lam-telescope {} D {} c {} sh {} in {} mask {:#x} | {} | {}",
+                SITES[e.site], e.nargs, e.taken_lams, e.d, e.c, e.sh, e.inst, e.mask, e.trig, e.low
+            ));
+        }
+
+        p("== trigger (sides merged) x ctx depth D, three beta sites, cells with >= 100 units: calls shift inst".into());
+        let mut xt: BTreeMap<(String, usize), (u64, u64, u64)> = BTreeMap::new();
+        for e in evs.iter().filter(|e| e.site < 3) {
+            let t = e.trig.replace(" side A", "").replace(" side B", "");
+            add3(xt.entry((t, e.d)).or_default(), e.sh, e.inst);
+        }
+        let mut xv: Vec<_> = xt.into_iter().filter(|(_, x)| x.1 + x.2 >= 100).collect();
+        xv.sort_by(|a, b| (b.1.1 + b.1.2).cmp(&(a.1.1 + a.1.2)));
+        for ((t, d), x) in xv {
+            p(format!("{} D {d:>2} | {t}", row(&x)));
+        }
+        p("== EV dump: idx|site|nargs|telescope|D|c|shift|inst|mask|lamkey|inputkey|lamcanon|redcanon|trigger|owner".into());
+        for (i, e) in evs.iter().enumerate() {
+            p(format!(
+                "EV {i}|{}|{}|{}|{}|{}|{}|{}|{:#x}|{}|{}|{:x}|{:x}|{}|{}",
+                SITES[e.site], e.nargs, e.taken_lams, e.d, e.c, e.sh, e.inst, e.mask, e.lam, e.inp, e.lam_canon, e.red_canon, e.trig, e.low
+            ));
+        }
+
+        // 3. binder ownership
+        p("== 3. BINDER OWNERSHIP of the beta lambda's loose variables -> calls shift inst (all four sites)".into());
+        for (title, tab) in [("by LOWEST-index loose var (outermost-referenced)", &OWN_LOW), ("by DEEPEST loose var (highest index)", &OWN_DEEP)] {
+            p(format!("-- {title}"));
+            let t = tab.with(|m| m.borrow().clone());
+            let mut v: Vec<_> = t.into_iter().collect();
+            v.sort_by(|a, b| (b.1.1 + b.1.2).cmp(&(a.1.1 + a.1.2)));
+            for (k, x) in v {
+                p(format!("{} {k}", row(&x)));
+            }
+        }
+        p("-- by (ctx depth D, traversal-opened binders c) -> calls shift inst".into());
+        let dt = DEPTHTAB.with(|m| m.borrow().clone());
+        for ((d, c), x) in dt {
+            p(format!("D {d:>2} c {c:>2}: {}", row(&x)));
+        }
+    });
+}
