+//! PROBE (worktree only, never merged): counters, phases, repeat stats and a path trie over the kernel's work.
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+
+macro_rules! ctrs {
+    ($($n:ident),* $(,)?) => {
+        #[derive(Clone, Copy, Debug)]
+        #[repr(usize)]
+        pub enum C { $($n),* }
+        pub const NAMES: &[&str] = &[$(stringify!($n)),*];
+    };
+}
+ctrs!(
+    // ticks (the six workers; WhnfApp/J/WRec/SigRec split whnf_step)
+    Shift, Inst, WhnfApp, WhnfJ, WhnfWRec, WhnfSigRec, NfWhnf, ConvWhnf, InferNode,
+    // whnf_step results
+    WhnfStuck, WhnfReduced,
+    // whnf_step App paths
+    PathClosedPrefix, PathBetaSpine, PathSingleBeta, PathStuckApp,
+    // memos
+    WhnfTrivial, WhnfHit, WhnfMiss, NfHit, NfMiss, ShiftHit, ShiftMiss, InstHit, InstMiss, InstNoMemo,
+    SpineHit, SpineMiss, HnfHit, HnfMiss, InferHit, InferMiss, InferUnshared,
+    // conv
+    DefEqCall, ConvSame, ConvEqualHit, ConvFull, ConvFalse,
+    // instantiate
+    InstTop, InstTopArgs, UsesCall, InstNoUseShift, InstLeafSubst,
+    // hash-consing
+    BuildCall, BuildNew,
+    // shift_in calls that return early (loose <= cutoff) vs. go to shift_unchecked
+    ShiftInEarly, ShiftInWork,
+);
+pub const NC: usize = NAMES.len();
+
+pub const PHASES: &[&str] = &["OUT", "STMT infer(expected)", "BINDER Lam-check(dom,whnf)", "BODY infer/check", "DEFEQ check", "VARLOOKUP shift", "APP inst types", "EXPECT whnf"];
+pub const NP: usize = PHASES.len();
+pub const P_OUT: usize = 0;
+pub const P_STMT: usize = 1;
+pub const P_BINDER: usize = 2;
+pub const P_BODY: usize = 3;
+pub const P_DEFEQ: usize = 4;
+pub const P_VAR: usize = 5;
+pub const P_APPINST: usize = 6;
+pub const P_EXPECT: usize = 7;
+
+#[derive(Default)]
+pub struct TN {
+    pub label: &'static str,
+    pub parent: usize,
+    pub kids: Vec<(&'static str, usize)>,
+    pub calls: u64,
+    pub incl: u64,
+}
+
+thread_local! {
+    static ON: Cell<bool> = const { Cell::new(false) };
+    static PHASE: Cell<usize> = const { Cell::new(0) };
+    static COUNTS: RefCell<Vec<u64>> = RefCell::new(vec![0; NC * NP]);
+    static PTIME: RefCell<Vec<f64>> = RefCell::new(vec![0.0; NP]);
+    static PSTART: Cell<Option<std::time::Instant>> = const { Cell::new(None) };
+    static REPEAT: RefCell<HashMap<(u8, u64, u64), u32>> = RefCell::new(HashMap::new());
+    static TRIE: RefCell<Vec<TN>> = RefCell::new(vec![TN { label: "root", ..Default::default() }]);
+    static CUR: Cell<usize> = const { Cell::new(0) };
+}
+
+pub fn on() -> bool {
+    ON.with(|o| o.get())
+}
+
+pub fn reset(enable: bool) {
+    ON.with(|o| o.set(enable));
+    PHASE.with(|p| p.set(0));
+    COUNTS.with(|c| c.borrow_mut().iter_mut().for_each(|x| *x = 0));
+    PTIME.with(|c| c.borrow_mut().iter_mut().for_each(|x| *x = 0.0));
+    PSTART.with(|c| c.set(Some(std::time::Instant::now())));
+    REPEAT.with(|c| c.borrow_mut().clear());
+    TRIE.with(|c| *c.borrow_mut() = vec![TN { label: "root", ..Default::default() }]);
+    CUR.with(|c| c.set(0));
+    clear_defeq_log();
+    clear_ref_stats();
+    reset_sites();
+    crate::prof_beta::reset();
+}
+
+#[inline]
+pub fn inc(c: C) {
+    add(c, 1)
+}
+
+#[inline]
+pub fn add(c: C, n: u64) {
+    if on() {
+        let p = PHASE.with(|p| p.get());
+        COUNTS.with(|x| x.borrow_mut()[p * NC + c as usize] += n);
+        if matches!(c, C::Shift | C::Inst) {
+            attribute(c, n);
+            crate::prof_beta::tick(matches!(c, C::Shift), n);
+        }
+    }
+}
+
+// ---- call-site attribution of the Shift / Inst ticks (outermost tagged entry wins) ----
+thread_local! {
+    static SITE: Cell<Option<&'static str>> = const { Cell::new(None) };
+    static DEPTH: Cell<usize> = const { Cell::new(0) };
+    static STAGE: Cell<usize> = const { Cell::new(0) };
+    static SITE_CTX: Cell<(usize, usize)> = const { Cell::new((0, 0)) };
+    static SITES: RefCell<std::collections::BTreeMap<&'static str, SiteStat>> = RefCell::new(Default::default());
+    static DEPTHS: RefCell<std::collections::BTreeMap<(usize, usize), (u64, u64)>> = RefCell::new(Default::default());
+}
+/// Leading binders of the closure loop's statement: a check depth above this is under the proof's own lambdas / deeper.
+pub const LEAD: usize = 11;
+#[derive(Default, Clone, Debug)]
+pub struct SiteStat {
+    pub calls: u64,
+    pub shift: u64,
+    pub inst: u64,
+    /// [stage (0 statement, 1 proof)][depth > LEAD] -> (shift, inst)
+    pub by: [[(u64, u64); 2]; 2],
+}
+pub fn set_depth(d: usize) -> usize {
+    DEPTH.with(|c| c.replace(d))
+}
+pub fn set_stage(s: usize) {
+    STAGE.with(|c| c.set(s))
+}
+fn cur_ctx() -> (usize, usize) {
+    (STAGE.with(|c| c.get()).min(1), DEPTH.with(|c| c.get()))
+}
+pub struct SiteGuard(bool);
+/// Tag the external call that follows (hold the guard across that call only). Only the outermost tag takes effect.
+pub fn site(label: &'static str) -> SiteGuard {
+    if !on() || SITE.with(|c| c.get()).is_some() {
+        return SiteGuard(false);
+    }
+    SITE.with(|c| c.set(Some(label)));
+    SITE_CTX.with(|c| c.set(cur_ctx()));
+    SITES.with(|m| m.borrow_mut().entry(label).or_default().calls += 1);
+    SiteGuard(true)
+}
+impl Drop for SiteGuard {
+    fn drop(&mut self) {
+        if self.0 {
+            SITE.with(|c| c.set(None));
+        }
+    }
+}
+fn attribute(c: C, n: u64) {
+    let (label, (stage, depth)) = match SITE.with(|c| c.get()) {
+        Some(l) => (l, SITE_CTX.with(|c| c.get())),
+        None => ("untagged", cur_ctx()),
+    };
+    let hi = (depth > LEAD) as usize;
+    let shift = matches!(c, C::Shift);
+    SITES.with(|m| {
+        let mut m = m.borrow_mut();
+        let e = m.entry(label).or_default();
+        if shift {
+            e.shift += n;
+            e.by[stage][hi].0 += n;
+        } else {
+            e.inst += n;
+            e.by[stage][hi].1 += n;
+        }
+    });
+    DEPTHS.with(|m| {
+        let mut m = m.borrow_mut();
+        let e = m.entry((stage, depth)).or_default();
+        if shift {
+            e.0 += n;
+        } else {
+            e.1 += n;
+        }
+    });
+}
+pub fn sites() -> Vec<(&'static str, SiteStat)> {
+    SITES.with(|m| m.borrow().iter().map(|(k, v)| (*k, v.clone())).collect())
+}
+pub fn depth_hist() -> Vec<((usize, usize), (u64, u64))> {
+    DEPTHS.with(|m| m.borrow().iter().map(|(k, v)| (*k, *v)).collect())
+}
+fn reset_sites() {
+    SITE.with(|c| c.set(None));
+    DEPTH.with(|c| c.set(0));
+    STAGE.with(|c| c.set(0));
+    SITES.with(|m| m.borrow_mut().clear());
+    DEPTHS.with(|m| m.borrow_mut().clear());
+}
+
+pub fn counts() -> Vec<Vec<u64>> {
+    COUNTS.with(|x| x.borrow().chunks(NC).map(|c| c.to_vec()).collect())
+}
+pub fn ptimes() -> Vec<f64> {
+    PTIME.with(|x| x.borrow().clone())
+}
+
+fn flush_time() {
+    let now = std::time::Instant::now();
+    if let Some(t0) = PSTART.with(|c| c.replace(Some(now))) {
+        let p = PHASE.with(|p| p.get());
+        PTIME.with(|x| x.borrow_mut()[p] += (now - t0).as_secs_f64() * 1e3);
+    }
+}
+
+pub struct PhaseGuard(usize, bool);
+pub fn phase(p: usize) -> PhaseGuard {
+    if !on() {
+        return PhaseGuard(0, false);
+    }
+    flush_time();
+    let prev = PHASE.with(|c| c.replace(p));
+    PhaseGuard(prev, true)
+}
+impl Drop for PhaseGuard {
+    fn drop(&mut self) {
+        if self.1 {
+            flush_time();
+            PHASE.with(|c| c.set(self.0));
+        }
+    }
+}
+
+#[inline]
+pub fn rep(kind: u8, a: u64, b: u64) {
+    if on() {
+        REPEAT.with(|m| *m.borrow_mut().entry((kind, a, b)).or_insert(0) += 1);
+    }
+}
+/// (distinct, total) per kind.
+pub fn repeats() -> Vec<(u8, usize, u64)> {
+    REPEAT.with(|m| {
+        let mut by: HashMap<u8, (usize, u64)> = HashMap::new();
+        for (&(k, _, _), &n) in m.borrow().iter() {
+            let e = by.entry(k).or_default();
+            e.0 += 1;
+            e.1 += n as u64;
+        }
+        let mut v: Vec<_> = by.into_iter().map(|(k, (d, t))| (k, d, t)).collect();
+        v.sort();
+        v
+    })
+}
+/// Histogram of multiplicities for a kind: (times seen, how many keys).
+pub fn rep_hist(kind: u8) -> Vec<(u32, usize)> {
+    REPEAT.with(|m| {
+        let mut h: HashMap<u32, usize> = HashMap::new();
+        for (&(k, _, _), &n) in m.borrow().iter() {
+            if k == kind {
+                *h.entry(n).or_default() += 1;
+            }
+        }
+        let mut v: Vec<_> = h.into_iter().collect();
+        v.sort();
+        v
+    })
+}
+pub fn rep_top(kind: u8, n: usize) -> Vec<((u64, u64), u32)> {
+    REPEAT.with(|m| {
+        let mut v: Vec<_> = m.borrow().iter().filter(|(k, _)| k.0 == kind).map(|(k, &c)| ((k.1, k.2), c)).collect();
+        v.sort_by(|a, b| b.1.cmp(&a.1));
+        v.truncate(n);
+        v
+    })
+}
+
+pub struct FrameGuard(usize, u64, bool);
+pub fn frame(label: &'static str) -> FrameGuard {
+    if !on() {
+        return FrameGuard(0, 0, false);
+    }
+    note_depth();
+    let w0 = crate::work();
+    let cur = CUR.with(|c| c.get());
+    let idx = TRIE.with(|t| {
+        let mut t = t.borrow_mut();
+        let found = t[cur].kids.iter().find(|(l, _)| std::ptr::eq(*l, label) || *l == label).map(|(_, i)| *i);
+        let idx = match found {
+            Some(i) => i,
+            None => {
+                let i = t.len();
+                t.push(TN { label, parent: cur, ..Default::default() });
+                t[cur].kids.push((label, i));
+                i
+            }
+        };
+        t[idx].calls += 1;
+        idx
+    });
+    CUR.with(|c| c.set(idx));
+    FrameGuard(cur, w0, true)
+}
+impl Drop for FrameGuard {
+    fn drop(&mut self) {
+        if self.2 {
+            let w = crate::work() - self.1;
+            let cur = CUR.with(|c| c.get());
+            TRIE.with(|t| t.borrow_mut()[cur].incl += w);
+            CUR.with(|c| c.set(self.0));
+        }
+    }
+}
+pub fn trie() -> Vec<TN> {
+    TRIE.with(|t| {
+        t.borrow()
+            .iter()
+            .map(|n| TN { label: n.label, parent: n.parent, kids: n.kids.clone(), calls: n.calls, incl: n.incl })
+            .collect()
+    })
+}
+
+pub const ARG: [&str; 20] = [
+    "arg0", "arg1", "arg2", "arg3", "arg4", "arg5", "arg6", "arg7", "arg8", "arg9", "arg10", "arg11", "arg12", "arg13", "arg14", "arg15",
+    "arg16", "arg17", "arg18", "arg19+",
+];
+
+thread_local! {
+    static BASE: Cell<usize> = const { Cell::new(0) };
+    static MIN: Cell<usize> = const { Cell::new(usize::MAX) };
+}
+#[inline(never)]
+pub fn mark_base() {
+    let x = 0u8;
+    BASE.with(|b| b.set(&x as *const u8 as usize));
+    MIN.with(|b| b.set(usize::MAX));
+}
+#[inline(never)]
+pub fn note_depth() {
+    let x = 0u8;
+    let a = &x as *const u8 as usize;
+    MIN.with(|m| {
+        if a < m.get() {
+            m.set(a)
+        }
+    });
+}
+/// Deepest native stack use (bytes) since `mark_base`.
+pub fn max_depth_bytes() -> usize {
+    BASE.with(|b| MIN.with(|m| b.get().saturating_sub(m.get())))
+}
+
+thread_local! {
+    static DLOG: RefCell<Vec<(u64, usize, crate::Expr, crate::Expr)>> = const { RefCell::new(Vec::new()) };
+}
+pub fn log_defeq(work: u64, a: &crate::Expr, b: &crate::Expr) {
+    if on() && work > 0 {
+        let cur = CUR.with(|c| c.get());
+        DLOG.with(|d| d.borrow_mut().push((work, cur, *a, *b)));
+    }
+}
+pub fn defeq_log() -> Vec<(u64, usize, crate::Expr, crate::Expr)> {
+    DLOG.with(|d| d.borrow().clone())
+}
+pub fn clear_defeq_log() {
+    DLOG.with(|d| d.borrow_mut().clear());
+}
+/// The labels from the root to trie node `i`, run-length encoded.
+pub fn path_of(i: usize) -> String {
+    let t = TRIE.with(|t| t.borrow().iter().map(|n| (n.label, n.parent)).collect::<Vec<_>>());
+    let mut labels = vec![];
+    let mut cur = i;
+    while cur != 0 {
+        labels.push(t[cur].0);
+        cur = t[cur].1;
+    }
+    labels.reverse();
+    let mut out: Vec<(&str, usize)> = vec![];
+    for l in labels {
+        match out.last_mut() {
+            Some((p, n)) if *p == l => *n += 1,
+            _ => out.push((l, 1)),
+        }
+    }
+    out.iter().map(|(l, n)| if *n > 1 { format!("{l} x{n}") } else { l.to_string() }).collect::<Vec<_>>().join(" > ")
+}
+
+thread_local! {
+    static SEEN_CHECK: RefCell<std::collections::HashSet<(u32, u32, u32)>> = RefCell::new(Default::default());
+    static IN_REPEAT: Cell<bool> = const { Cell::new(false) };
+    static REPEAT_WORK: Cell<(u64, u64)> = const { Cell::new((0, 0)) };
+    static REFSET: RefCell<std::collections::HashSet<u32>> = RefCell::new(Default::default());
+    static IN_REF: Cell<[bool; 4]> = const { Cell::new([false; 4]) };
+    // [kind][0 = closed node in refset, 1 = closed node, 2 = any node in refset] -> (calls, work)
+    static REFWORK: Cell<[[(u64, u64); 3]; 2]> = const { Cell::new([[(0, 0); 3]; 2]) };
+}
+pub struct CheckTok(bool, u64);
+pub fn check_enter(key: (u32, u32, u32)) -> CheckTok {
+    if !on() {
+        return CheckTok(false, 0);
+    }
+    let first = SEEN_CHECK.with(|s| s.borrow_mut().insert(key));
+    if !first && !IN_REPEAT.with(|c| c.get()) {
+        IN_REPEAT.with(|c| c.set(true));
+        return CheckTok(true, crate::work());
+    }
+    CheckTok(false, 0)
+}
+pub fn check_exit(t: CheckTok) {
+    if t.0 {
+        let w = crate::work() - t.1;
+        REPEAT_WORK.with(|c| {
+            let (a, b) = c.get();
+            c.set((a + 1, b + w))
+        });
+        IN_REPEAT.with(|c| c.set(false));
+    }
+}
+/// (outermost repeated check calls, work inside them).
+pub fn repeat_check_work() -> (u64, u64) {
+    REPEAT_WORK.with(|c| c.get())
+}
+pub fn set_ref(keys: impl IntoIterator<Item = u32>) {
+    REFSET.with(|s| *s.borrow_mut() = keys.into_iter().collect());
+}
+pub fn clear_ref_stats() {
+    REFWORK.with(|c| c.set([[(0, 0); 3]; 2]));
+    SEEN_CHECK.with(|s| s.borrow_mut().clear());
+    REPEAT_WORK.with(|c| c.set((0, 0)));
+}
+pub fn ref_stats() -> [[(u64, u64); 3]; 2] {
+    REFWORK.with(|c| c.get())
+}
+pub struct RefTok([bool; 3], usize, u64);
+pub fn ref_enter(kind: usize, key: u32, closed: bool) -> RefTok {
+    if !on() {
+        return RefTok([false; 3], 0, 0);
+    }
+    let in_ref = REFSET.with(|s| s.borrow().contains(&key));
+    let want = [closed && in_ref, closed, in_ref];
+    let mut flags = IN_REF.with(|c| c.get());
+    let mut take = [false; 3];
+    for i in 0..3 {
+        if want[i] && !flags[i] {
+            take[i] = true;
+            flags[i] = true;
+        }
+    }
+    // the flags are shared across kinds: a nested node of the other kind inside an outermost one is not double counted
+    IN_REF.with(|c| c.set(flags));
+    RefTok(take, kind, crate::work())
+}
+pub fn ref_exit(t: RefTok) {
+    if t.0.iter().any(|x| *x) {
+        let w = crate::work() - t.2;
+        let mut flags = IN_REF.with(|c| c.get());
+        let mut r = REFWORK.with(|c| c.get());
+        for i in 0..3 {
+            if t.0[i] {
+                r[t.1][i].0 += 1;
+                r[t.1][i].1 += w;
+                flags[i] = false;
+            }
+        }
+        REFWORK.with(|c| c.set(r));
+        IN_REF.with(|c| c.set(flags));
+    }
+}
+
+/// `subst_top` for the probes.
+pub fn inst1(body: &crate::Expr, a: &crate::Expr) -> crate::Expr {
+    crate::with_spaces(|s| crate::subst::subst_top(s, body, a))
+}
