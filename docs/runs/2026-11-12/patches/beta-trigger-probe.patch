+//! PROBE (worktree only): first call on a fresh thread; the check of a closed instance (the statement's binders as
+//! postulates, so nothing is open); the cost of the statement's own type-check apart from the proof's.
+use super::gate::compiled;
+use crate::jit::shape::wasm_table;
+use crate::proof::gate::build;
+use crate::support::samples::capturing_closure_loop;
+use tatic_kernel::prof;
+use tatic_kernel::{app, check_in, infer_in, mk, persist, scoped, whnf, work, Ctx, Expr, Globals, Node};
+use tatic_wasm::encoding::holds;
+
+fn on_stack(stack: usize, f: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new().stack_size(stack).spawn(f).unwrap().join().unwrap();
+}
+
+/// The first, second, third `build + holds` on a brand-new thread, with no probe on, by stack size.
+#[test]
+#[ignore]
+fn check_first_call() {
+    for (label, stack) in [("256MiB", tatic_kernel::CHECK_STACK), ("1MiB", 1 << 20)] {
+        on_stack(stack, move || {
+            let (s, h, frag) = compiled(&capturing_closure_loop);
+            for i in 0..4 {
+                scoped(|| {
+                    let t0 = std::time::Instant::now();
+                    let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+                    let p = p.expect("proves");
+                    let t1 = std::time::Instant::now();
+                    let w1 = work();
+                    holds(&p, &st).expect("holds");
+                    println!(
+                        "FIRST thread stack {label} call #{i}: build {:.3} ms, holds {:.3} ms (work {})",
+                        (t1 - t0).as_secs_f64() * 1e3,
+                        t1.elapsed().as_secs_f64() * 1e3,
+                        work() - w1
+                    );
+                });
+            }
+        });
+    }
+}
+
+/// The statement's binders as postulates (`Const`), so the checked term and type have no loose variable; the work of
+/// `check_in` on that against the work of `holds` on the open statement.
+#[test]
+#[ignore]
+fn check_closed_instance() {
+    on_stack(tatic_kernel::CHECK_STACK, || {
+        let (s, h, frag) = compiled(&capturing_closure_loop);
+        for round in 0..2 {
+            scoped(|| {
+                let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+                let p = p.expect("proves");
+                let (w0, t0) = (work(), std::time::Instant::now());
+                holds(&p, &st).expect("holds");
+                let open = work() - w0;
+                println!("CLOSED reference: open holds {:.3} ms", t0.elapsed().as_secs_f64() * 1e3);
+                // close the instance
+                let mut g: Globals = Globals::new();
+                let (mut e, mut t): (Expr, Expr) = (p, st);
+                let mut dom_work = 0u64;
+                let mut n = 0;
+                while let Node::Pi(dom, cod) = t.node() {
+                    assert_eq!(dom.loose(), 0, "binder {n}'s type is open");
+                    let w = work();
+                    let ty = infer_in(&g, &Ctx::new(), &dom).expect("dom infers");
+                    let _ = whnf(&ty);
+                    dom_work += work() - w;
+                    g.push_back(persist(dom));
+                    let c = mk(Node::Const(n));
+                    e = match e.node() {
+                        Node::Lam(_, b) => prof::inst1(&b, &c),
+                        _ => app(e, c),
+                    };
+                    t = prof::inst1(&cod, &c);
+                    n += 1;
+                }
+                if round == 1 {
+                    prof::reset(true);
+                    prof::mark_base();
+                }
+                let (w1, t1) = (work(), std::time::Instant::now());
+                check_in(&g, &Ctx::new(), &e, &t).expect("closed instance holds");
+                let closed = work() - w1;
+                if round == 0 {
+                    println!("CLOSED timing (probe off): check_in {:.3} ms vs open holds timed in CALLS lines", t1.elapsed().as_secs_f64() * 1e3);
+                }
+                if round == 1 {
+                    super::check_breakdown::dump(closed);
+                    super::check_breakdown::print_trie(closed, 0.03);
+                    super::check_breakdown::print_defeq();
+                    prof::reset(false);
+                }
+                println!(
+                    "CLOSED round {round}: open statement holds work {open}; closed instance ({n} binders as postulates) check_in work {closed} + binder-type inference work {dom_work} = {}",
+                    closed + dom_work
+                );
+            });
+        }
+    });
+}
+
+fn keys_of(e: &Expr, out: &mut std::collections::HashSet<u32>) {
+    let k = tatic_kernel::node_key(e) as u32;
+    if out.insert(k) {
+        e.node().for_kids(|c, _| keys_of(c, out));
+    }
+}
+
+/// How much of A's check touches nodes that also occur in B's statement and proof (persisted, so ids are stable
+/// across regions): the shape of what a cross-call memo for closed nodes could reuse.
+#[test]
+#[ignore]
+fn check_cross_call() {
+    use crate::support::samples::source;
+    let sum = |s: &mut crate::lang::term::TermStore| source(s, "rec f n acc = if n <= 0 then acc else f (n - 1) (acc + n)");
+    let sum2 = |s: &mut crate::lang::term::TermStore| source(s, "rec f acc n = if n <= 0 then acc else f (acc + n) (n - 1)");
+    on_stack(tatic_kernel::CHECK_STACK, move || {
+        let mk_pair = |f: &dyn Fn(&mut crate::lang::term::TermStore) -> crate::lang::term::Hash| {
+            let (s, h, frag) = compiled(f);
+            scoped(|| {
+                let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+                (st, p.expect("proves"))
+            })
+        };
+        let a = mk_pair(&capturing_closure_loop);
+        for (name, b) in [("sum", mk_pair(&sum)), ("sum2", mk_pair(&sum2)), ("itself", mk_pair(&capturing_closure_loop))] {
+            let (mut ka, mut kb) = (std::collections::HashSet::new(), std::collections::HashSet::new());
+            for e in [&a.0, &a.1] {
+                keys_of(e, &mut ka);
+            }
+            for e in [&b.0, &b.1] {
+                keys_of(e, &mut kb);
+            }
+            let shared = ka.intersection(&kb).count();
+            scoped(|| {
+                prof::reset(true);
+                prof::set_ref(kb.iter().copied());
+                let w0 = work();
+                holds(&a.1, &a.0).expect("holds");
+                let w = work() - w0;
+                let rs = prof::ref_stats();
+                println!(
+                    "CROSS A=capturing_closure_loop B={name}: A's distinct nodes {}, also in B {shared}; holds work {w}; infer_node outermost closed-in-B calls {} work {}; whnf_step {} work {}; in-B any infer {} work {}",
+                    ka.len(),
+                    rs[0][0].0,
+                    rs[0][0].1,
+                    rs[1][0].0,
+                    rs[1][0].1,
+                    rs[0][2].0,
+                    rs[0][2].1
+                );
+                prof::reset(false);
+            });
+        }
+    });
+}
+
+/// The statement's type-check alone (`infer` on it) and the proof's check with the statement's type-check skipped
+/// (checking against an already-known type is the same call minus the claim's `infer`): work of each.
+#[test]
+#[ignore]
+fn check_statement_alone() {
+    on_stack(tatic_kernel::CHECK_STACK, || {
+        let (s, h, frag) = compiled(&capturing_closure_loop);
+        scoped(|| {
+            let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+            let p = p.expect("proves");
+            let (w0, t0) = (work(), std::time::Instant::now());
+            let _ = infer_in(&Globals::new(), &Ctx::new(), &st).expect("statement infers");
+            println!("STMT alone: infer(statement) work {} ({:.3} ms; memos warm from build)", work() - w0, t0.elapsed().as_secs_f64() * 1e3);
+            let (w1, t1) = (work(), std::time::Instant::now());
+            holds(&p, &st).expect("holds");
+            println!("STMT then holds in the same region: holds work {} ({:.3} ms)", work() - w1, t1.elapsed().as_secs_f64() * 1e3);
+        });
+        for _ in 0..3 {
+            scoped(|| {
+                let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+                let p = p.expect("proves");
+                let (w1, t1) = (work(), std::time::Instant::now());
+                holds(&p, &st).expect("holds");
+                println!("STMT: holds alone work {} ({:.3} ms)", work() - w1, t1.elapsed().as_secs_f64() * 1e3);
+            });
+        }
+    });
+}
