+//! PROBE (worktree only): where the gate's `holds` work goes for `capturing_closure_loop`, by kernel operation, by
+//! phase of `check_in`, by path in the proof term, with repeat and memo statistics; and what repeats across calls.
+use super::gate::compiled;
+use crate::jit::shape::wasm_table;
+use crate::proof::gate::build;
+use crate::support::samples::capturing_closure_loop;
+use tatic_kernel::prof;
+use tatic_kernel::{persist, scoped, term_sizes, work, Expr, Node};
+use tatic_wasm::encoding::holds;
+
+fn on(f: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn(f).unwrap().join().unwrap();
+}
+
+fn kind(e: &Expr) -> &'static str {
+    match e.node() {
+        Node::Var(_) => "Var",
+        Node::Sort(_) => "Sort",
+        Node::Const(_) => "Const",
+        Node::Free(_) => "Free",
+        Node::Pi(..) => "Pi",
+        Node::Lam(..) => "Lam",
+        Node::App(..) => "App",
+        Node::Id(..) => "Id",
+        Node::Refl(..) => "Refl",
+        Node::J { .. } => "J",
+        Node::W(..) => "W",
+        Node::Sup(..) => "Sup",
+        Node::WRec { .. } => "WRec",
+        Node::Sigma(..) => "Sigma",
+        Node::Pair(..) => "Pair",
+        Node::SigRec { .. } => "SigRec",
+    }
+}
+
+fn describe(label: &str, e: &Expr) {
+    let mut cur = *e;
+    let mut binders = 0;
+    while let Node::Lam(_, b) | Node::Pi(_, b) = cur.node() {
+        binders += 1;
+        cur = b;
+    }
+    let (d, t) = term_sizes(e);
+    println!("DESC {label}: distinct nodes {d}, tree size {t}; {binders} leading binders; body is {}", kind(&cur));
+    if let Node::Id(a, x, y) = cur.node() {
+        for (n, z) in [("R", a), ("lhs", x), ("rhs", y)] {
+            let (d, t) = term_sizes(&z);
+            println!("DESC   Id.{n}: {} distinct {d} tree {t}", kind(&z));
+        }
+    }
+    let (mut args, mut h) = (vec![], cur);
+    while let Node::App(f, a) = h.node() {
+        args.push(a);
+        h = f;
+    }
+    args.reverse();
+    println!("DESC   body spine head {} with {} args", kind(&h), args.len());
+    for (i, a) in args.iter().enumerate() {
+        let (d, t) = term_sizes(a);
+        let mut c = *a;
+        let mut b = 0;
+        while let Node::Lam(_, bb) | Node::Pi(_, bb) = c.node() {
+            b += 1;
+            c = bb;
+        }
+        println!("DESC   arg{i}: {} ({b} binders, body {}) distinct {d} tree {t}", kind(a), kind(&c));
+    }
+}
+
+pub(super) fn dump(total_work: u64) {
+    let counts = prof::counts();
+    println!("PROF total work {total_work}");
+    print!("PROF {:<18}", "counter");
+    for p in prof::PHASES {
+        print!(" {:>9}", &p.split(' ').next().unwrap()[..p.split(' ').next().unwrap().len().min(9)]);
+    }
+    println!(" {:>9}", "TOTAL");
+    for (i, n) in prof::NAMES.iter().enumerate() {
+        let tot: u64 = counts.iter().map(|c| c[i]).sum();
+        if tot == 0 {
+            continue;
+        }
+        print!("PROF {n:<18}");
+        for c in &counts {
+            print!(" {:>9}", c[i]);
+        }
+        println!(" {tot:>9}");
+    }
+    let tick_names = ["Shift", "Inst", "WhnfApp", "WhnfJ", "WhnfWRec", "WhnfSigRec", "NfWhnf", "ConvWhnf", "InferNode"];
+    print!("PROF {:<18}", "TICKS (work)");
+    let mut all = 0;
+    for p in 0..prof::NP {
+        let s: u64 = tick_names.iter().map(|n| counts[p][prof::NAMES.iter().position(|x| x == n).unwrap()]).sum();
+        all += s;
+        print!(" {s:>9}");
+    }
+    println!(" {all:>9}");
+    print!("PROF {:<18}", "phase wall ms");
+    for t in prof::ptimes() {
+        print!(" {t:>9.3}");
+    }
+    println!();
+    println!("PROF phases: {:?}", prof::PHASES);
+    let names = [
+        "infer (node,ctx)",
+        "infer node",
+        "whnf_step node",
+        "conv_whnf (x,y)",
+        "inst_rec (node,d)",
+        "inst_rec node",
+        "shift_unchecked (node,cut,amt)",
+        "shift_unchecked node",
+        "nf_whnf node",
+        "check (e,expected)",
+        "check (e,cid)",
+        "check (e,expected,cid)",
+    ];
+    for (k, d, t) in prof::repeats() {
+        println!("REPEAT {:<32} distinct {d:>6} total {t:>6} ratio {:.2}", names[k as usize], t as f64 / d as f64);
+    }
+    let (rc, rw) = prof::repeat_check_work();
+    println!("CHECKREP outermost repeated check(e,expected,cid) calls {rc}, work inside them {rw} ({:.1}% of {total_work})", 100.0 * rw as f64 / total_work as f64);
+    let rs = prof::ref_stats();
+    for (k, name) in ["infer_node", "whnf_step"].iter().enumerate() {
+        println!(
+            "REFSTAT {name}: closed&in-reference-set calls {} work {}; closed (any) calls {} work {}; in-reference-set (any) calls {} work {}",
+            rs[k][0].0, rs[k][0].1, rs[k][1].0, rs[k][1].1, rs[k][2].0, rs[k][2].1
+        );
+    }
+    println!("DEPTH max native stack use {} KiB", prof::max_depth_bytes() / 1024);
+    for k in [1u8, 2, 3, 5, 7, 8, 11] {
+        let h = prof::rep_hist(k);
+        println!("HIST {:<22} (times seen: keys) {:?}", names[k as usize], &h[..h.len().min(14)]);
+    }
+}
+
+pub(super) fn print_defeq() {
+    let mut log = prof::defeq_log();
+    let all: u64 = log.iter().map(|x| x.0).sum();
+    println!("DEFEQ {} def_eq calls did work, total work {all}", log.len());
+    log.sort_by_key(|x| std::cmp::Reverse(x.0));
+    for (w, cur, a, b) in log.iter().take(14) {
+        let (da, ta) = term_sizes(a);
+        let (db, tb) = term_sizes(b);
+        println!(
+            "DEFEQ work {w:>5}  {}({da} distinct/{ta} tree) vs {}({db}/{tb})  at {}",
+            kind(a),
+            kind(b),
+            prof::path_of(*cur)
+        );
+    }
+    // by site (path), summed
+    let mut by: std::collections::HashMap<String, (u64, u64)> = Default::default();
+    for (w, cur, _, _) in &log {
+        let e = by.entry(prof::path_of(*cur)).or_default();
+        e.0 += 1;
+        e.1 += w;
+    }
+    let mut v: Vec<_> = by.into_iter().collect();
+    v.sort_by_key(|x| std::cmp::Reverse(x.1 .1));
+    for (p, (n, w)) in v.iter().take(8) {
+        println!("DEFEQSITE calls {n:>4} work {w:>6}  {p}");
+    }
+}
+
+pub(super) fn print_trie(total: u64, min_frac: f64) {
+    let t = prof::trie();
+    // flat profile by label: calls, inclusive, exclusive
+    let mut flat: std::collections::HashMap<&str, (u64, u64, u64)> = Default::default();
+    for (i, n) in t.iter().enumerate().skip(1) {
+        let kids: u64 = n.kids.iter().map(|k| t[k.1].incl).sum();
+        let e = flat.entry(n.label).or_default();
+        e.0 += n.calls;
+        e.2 += n.incl.saturating_sub(kids);
+        let _ = i;
+    }
+    let mut fl: Vec<_> = flat.into_iter().collect();
+    fl.sort_by_key(|x| std::cmp::Reverse(x.1 .2));
+    for (l, (c, _, ex)) in fl {
+        println!("FLAT {l:<32} calls {c:>7}  exclusive work {ex:>6} = {:.1}%", 100.0 * ex as f64 / total as f64);
+    }
+    fn go2(t: &[prof::TN], i: usize, depth: usize, total: u64, min_frac: f64) {
+        // follow the heavy child while one carries >= 98% of the node's work; run-length the labels
+        let mut labels: Vec<(&str, usize)> = vec![(t[i].label, 1)];
+        let mut cur = i;
+        loop {
+            let heavy = t[cur].kids.iter().map(|k| k.1).find(|&k| t[cur].incl > 0 && t[k].incl as f64 >= 0.98 * t[cur].incl as f64);
+            match heavy {
+                Some(k) => {
+                    cur = k;
+                    if labels.last().unwrap().0 == t[k].label {
+                        labels.last_mut().unwrap().1 += 1;
+                    } else {
+                        labels.push((t[k].label, 1));
+                    }
+                }
+                None => break,
+            }
+        }
+        let chain: Vec<String> = labels.iter().map(|(l, n)| if *n > 1 { format!("{l} x{n}") } else { l.to_string() }).collect();
+        let kids_incl: u64 = t[cur].kids.iter().map(|k| t[k.1].incl).sum();
+        println!(
+            "TRIE {:>width$}{} [calls {}, incl {} = {:.1}%, excl-at-end {}]",
+            "",
+            chain.join(" > "),
+            t[cur].calls,
+            t[cur].incl,
+            100.0 * t[cur].incl as f64 / total as f64,
+            t[cur].incl.saturating_sub(kids_incl),
+            width = depth.min(30) * 2
+        );
+        let mut kids: Vec<usize> = t[cur].kids.iter().map(|k| k.1).collect();
+        kids.sort_by_key(|&k| std::cmp::Reverse(t[k].incl));
+        for k in kids {
+            if t[k].incl as f64 >= min_frac * total as f64 {
+                go2(t, k, depth + 1, total, min_frac);
+            }
+        }
+    }
+    for k in t[0].kids.iter().map(|k| k.1).collect::<Vec<_>>() {
+        go2(&t, k, 0, total, min_frac);
+    }
+}
+
+#[allow(dead_code)]
+fn print_trie_old(total: u64, min_frac: f64) {
+    let t = prof::trie();
+    fn go(t: &[prof::TN], i: usize, depth: usize, total: u64, min_frac: f64) {
+        let mut chain = t[i].label.to_string();
+        let mut cur = i;
+        // collapse a single heavy child chain
+        loop {
+            let heavy: Vec<usize> = t[cur].kids.iter().map(|k| k.1).filter(|&k| t[k].incl as f64 >= 0.98 * t[cur].incl as f64 && t[cur].incl > 0).collect();
+            if t[cur].kids.len() == 1 && heavy.len() == 1 {
+                cur = heavy[0];
+                chain.push_str(" > ");
+                chain.push_str(t[cur].label);
+            } else {
+                break;
+            }
+        }
+        let kids_incl: u64 = t[cur].kids.iter().map(|k| t[k.1].incl).sum();
+        let excl = t[cur].incl.saturating_sub(kids_incl);
+        println!(
+            "TRIE {:>width$}{} [calls {}, incl {} = {:.1}%, excl {}]",
+            "",
+            chain,
+            t[cur].calls,
+            t[cur].incl,
+            100.0 * t[cur].incl as f64 / total as f64,
+            excl,
+            width = depth.min(40) * 2
+        );
+        let mut kids: Vec<usize> = t[cur].kids.iter().map(|k| k.1).collect();
+        kids.sort_by_key(|&k| std::cmp::Reverse(t[k].incl));
+        for k in kids {
+            if t[k].incl as f64 >= min_frac * total as f64 {
+                go(t, k, depth + 1, total, min_frac);
+            }
+        }
+    }
+    let kids: Vec<usize> = t[0].kids.iter().map(|k| k.1).collect();
+    for k in kids {
+        go(&t, k, 0, total, min_frac);
+    }
+}
+
+#[test]
+#[ignore]
+fn check_breakdown() {
+    on(|| {
+        let (s, h, frag) = compiled(&capturing_closure_loop);
+        // A: the instrumented check, in the region the gate uses (build then holds)
+        scoped(|| {
+            let (w0, t0) = (work(), std::time::Instant::now());
+            let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+            let p = p.expect("proves");
+            let w1 = work();
+            println!("RUN build work {} ({:.3} ms)", w1 - w0, t0.elapsed().as_secs_f64() * 1e3);
+            describe("statement", &st);
+            describe("proof", &p);
+            prof::reset(true);
+            prof::mark_base();
+            let (w1, t1) = (work(), std::time::Instant::now());
+            holds(&p, &st).expect("holds");
+            let (w2, ms) = (work(), t1.elapsed().as_secs_f64() * 1e3);
+            println!("RUN holds work {} ({ms:.3} ms with probe on)", w2 - w1);
+            dump(w2 - w1);
+            print_trie(w2 - w1, 0.02);
+            print_defeq();
+            prof::reset(false);
+            (st, p)
+        });
+        // B: what repeats across calls in one thread
+        for i in 0..3 {
+            scoped(|| {
+                let (w0, t0) = (work(), std::time::Instant::now());
+                let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+                let p = p.expect("proves");
+                let (w1, t1) = (work(), std::time::Instant::now());
+                holds(&p, &st).expect("holds");
+                let (w2, t2) = (work(), std::time::Instant::now());
+                println!(
+                    "CALLS fresh region #{i}: build work {} ({:.3} ms), holds work {} ({:.3} ms)",
+                    w1 - w0,
+                    (t1 - t0).as_secs_f64() * 1e3,
+                    w2 - w1,
+                    (t2 - t1).as_secs_f64() * 1e3
+                );
+            });
+        }
+        // C: the same check repeated inside one region (memos kept)
+        scoped(|| {
+            let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+            let p = p.expect("proves");
+            for i in 0..4 {
+                let (w0, t0) = (work(), std::time::Instant::now());
+                holds(&p, &st).expect("holds");
+                println!("CALLS same region holds #{i}: work {} ({:.3} ms)", work() - w0, t0.elapsed().as_secs_f64() * 1e3);
+            }
+        });
+        // D: holds with cold memos on persisted terms (what the check costs without the build's memos)
+        let (st, p) = scoped(|| {
+            let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+            (st, p.expect("proves"))
+        });
+        for i in 0..3 {
+            scoped(|| {
+                let (w0, t0) = (work(), std::time::Instant::now());
+                holds(&p, &st).expect("holds");
+                println!("CALLS persisted terms, cold memos #{i}: holds work {} ({:.3} ms)", work() - w0, t0.elapsed().as_secs_f64() * 1e3);
+            });
+        }
+        let _ = persist;
+        // E: instrumented, cold memos, persisted terms
+        scoped(|| {
+            prof::reset(true);
+            let w0 = work();
+            holds(&p, &st).expect("holds");
+            let w = work() - w0;
+            println!("RUN (cold memos, persisted terms) holds work {w}");
+            dump(w);
+            prof::reset(false);
+        });
+    });
+}
