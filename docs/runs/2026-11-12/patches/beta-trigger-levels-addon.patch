+/// ADDON: structural hash with loose variables anchored to the checker context. A var past the `c` conv-opened
+/// binders is its absolute context level (so a term moved to another conv depth hashes alike); one below `c` is
+/// kept as its index from the innermost (mode 0: equal modulo a shift with cutoff c) or from the outermost opened
+/// binder (mode 1: same position in the conv-opened prefix).
+fn canon2(s: &Spaces, e: &Expr, depth: u32, c: usize, d: usize, mode: u8, memo: &mut std::collections::HashMap<(u32, u32), u64>) -> u64 {
+    let k = (s.key(e), depth);
+    if let Some(h) = memo.get(&k) {
+        return *h;
+    }
+    let h = match s.node(e) {
+        Node::Var(i) if i >= depth => {
+            let j = (i - depth) as usize;
+            if j < c {
+                h2(0xCC, if mode == 0 { j } else { c - 1 - j } as u64)
+            } else if j - c < d {
+                h2(0xDD, (d - 1 - (j - c)) as u64)
+            } else {
+                h2(0xEE, (j - c - d) as u64)
+            }
+        }
+        Node::Var(i) => h2(0xBB, i as u64),
+        n => {
+            let (t, l) = n.tag_leaf();
+            let mut h = h2(t as u64, l as u64);
+            n.for_kids(|ch, under| {
+                let chh = canon2(s, ch, depth + under as u32, c, d, mode, memo);
+                h = h2(h, chh);
+            });
+            h
+        }
+    };
+    memo.insert(k, h);
+    h
+}
