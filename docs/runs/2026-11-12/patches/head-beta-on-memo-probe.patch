+/// PROBE: `e`, an application whose spine head is a syntactic lambda, contracted one step (the lambda telescope against the
+/// arguments, as `beta_spine` does, the result not reduced further). One tick, like a `whnf_step`.
+fn head_beta1(s: &Spaces, e: &Expr) -> Option<Expr> {
+    let head = spine(s, e).0;
+    let Node::Lam(_, first) = s.node(&head) else { return None };
+    s.tick();
+    let mut args: Vec<Expr> = Vec::new();
+    let mut sp = *e;
+    while let Node::App(g, b) = s.node(&sp) {
+        args.push(b);
+        sp = g;
+    }
+    args.reverse();
+    let (mut body, mut taken) = (first, 1);
+    while taken < args.len()
+        && let Node::Lam(_, inner) = s.node(&body)
+    {
+        body = inner;
+        taken += 1;
+    }
+    let used: Vec<&Expr> = args[..taken].iter().collect();
+    let mut r = instantiate_n(s, &body, &used, 0);
+    for a in &args[taken..] {
+        r = app(r, *a);
+    }
+    Some(r)
+}
