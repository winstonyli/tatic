+/// PROBE: one syntactic head-beta step of either side, then pointer equality with the other side.
+fn pre_head_beta(s: &Spaces, a: &Expr, b: &Expr) -> bool {
+    for (x, y) in [(a, b), (b, a)] {
+        if matches!(s.node(x), Node::App(..))
+            && let Some(r) = head_beta1(s, x)
+            && s.same(&r, y)
+        {
+            return true;
+        }
+    }
+    false
+}
