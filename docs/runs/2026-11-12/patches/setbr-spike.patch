@@ -0,0 +1,143 @@
+//! SOUNDNESS REVIEW (throwaway): extra Set/Br probes, differential against wasmtime.
+use tatic_wasm::machine::{Entry, Ins};
+
+use super::gate::{big, compiled};
+use crate::jit::compile::{CompiledFragment, Item};
+use crate::jit::shape::wasm_table;
+use crate::lang::term::{Hash, TermStore};
+use crate::proof::gate::{gate, Verdict};
+use crate::support::samples::{source, tail_recursive_loop_with_pap_producing_root_self_call_arg};
+use crate::testing::ins_mutate::with_entry;
+
+type Build = Box<dyn Fn(&mut TermStore) -> Hash + Send + Sync>;
+const SUM: &str = "rec f n acc = if n <= 0 then acc else f (n - 1) (acc + n)";
+
+fn set(i: i64) -> Ins {
+    Ins::Row { name: "local.set", operand: i }
+}
+fn get(i: i64) -> Ins {
+    Ins::Row { name: "local.get", operand: i }
+}
+fn konst(v: i64) -> Ins {
+    Ins::Row { name: "const", operand: v }
+}
+fn row(name: &'static str) -> Ins {
+    Ins::Row { name, operand: 0 }
+}
+
+fn run_wat(entry: &Entry, own: usize, args: (i64, i64)) -> Result<i64, String> {
+    let mut f = String::new();
+    tatic_wasm::print::print_func(wasm_table(), own, own, entry, &mut f);
+    let wat = format!("(module\n{f}  (export \"f\" (func $f))\n)\n");
+    let bytes = wat::parse_str(&wat).map_err(|e| format!("wat parse: {e}"))?;
+    let engine = wasmtime::Engine::default();
+    let module = wasmtime::Module::new(&engine, &bytes).map_err(|e| format!("INVALID WASM: {e:#}"))?;
+    let mut store = wasmtime::Store::new(&engine, ());
+    let inst = wasmtime::Instance::new(&mut store, &module, &[]).map_err(|e| format!("inst: {e}"))?;
+    let func = inst.get_typed_func::<(i64, i64), i64>(&mut store, "f").map_err(|e| format!("typed: {e}"))?;
+    func.call(&mut store, args).map_err(|e| format!("trap: {e}"))
+}
+
+fn probe(label: &str, b: &Build, code: Vec<Ins>) {
+    let (s, h, frag) = compiled(&**b);
+    let (own, orig) = (frag.entry_pos, frag.entry().clone());
+    let new = Entry { code: code.clone(), ..orig.clone() };
+    let mutant = with_entry(frag, |e| Entry { code, ..e });
+    let v = big(move || gate(wasm_table(), &s, h, &mutant));
+    println!("== {label}\n   gate: {}", format!("{v:?}").chars().take(240).collect::<String>());
+    let mut f = String::new();
+    tatic_wasm::print::print_func(wasm_table(), own, own, &new, &mut f);
+    println!("{f}");
+    for args in [(0i64, 5i64), (1, 0), (4, 1), (10, 100), (7, 7)] {
+        let got = run_wat(&new, own, args);
+        let want = run_wat(&orig, own, args);
+        println!("   args {args:?}: mutant {got:?}   original {want:?}");
+    }
+    let _ = matches!(v, Verdict::Accepted);
+}
+
+#[test]
+fn review_probes() {
+    let sum: Build = Box::new(|s| source(s, SUM));
+    let else_base = vec![get(0), konst(1), row("sub"), get(1), get(0), row("add"), set(1), set(0)];
+    let cond = vec![get(0), konst(0), row("le")];
+    let mk = |pre: Vec<Ins>, then: Vec<Ins>, els: Vec<Ins>| [pre, cond.clone(), vec![Ins::If(then, els)]].concat();
+    // base (sanity)
+    probe("base", &sum, mk(vec![], vec![get(1)], [else_base.clone(), vec![Ins::Br]].concat()));
+    // R1: acc left on the OUTER stack, the then arm empty (arms read the outer stack)
+    probe(
+        "R1 outer-stack acc, then arm empty",
+        &sum,
+        [vec![get(1)], cond.clone(), vec![Ins::If(vec![], [else_base.clone(), vec![Ins::Br]].concat())]].concat(),
+    );
+    // R2: interleaved computing and Sets, acc first
+    probe(
+        "R2 interleaved sets (acc := acc+n; n := n-1)",
+        &sum,
+        mk(vec![], vec![get(1)], vec![get(1), get(0), row("add"), set(1), get(0), konst(1), row("sub"), set(0), Ins::Br]),
+    );
+    // R2b: no-op prelude pair inside arm
+    probe(
+        "R2b interleaved + noop get/set",
+        &sum,
+        mk(vec![], vec![get(1)], vec![get(1), get(0), row("add"), set(1), get(0), set(0), get(0), konst(1), row("sub"), set(0), Ins::Br]),
+    );
+    // R6: nested if with both arms Br
+    probe(
+        "R6 else arm ends in if(br,br)",
+        &sum,
+        mk(vec![], vec![get(1)], [else_base.clone(), vec![get(0), konst(0), row("eq"), Ins::If(vec![Ins::Br], vec![Ins::Br])]].concat()),
+    );
+    // R7: unrolled by two (fuel profile differs from the source)
+    probe(
+        "R7 unrolled x2 (1 restart per 2 source iterations)",
+        &sum,
+        mk(
+            vec![],
+            vec![get(1)],
+            [
+                else_base.clone(),
+                vec![get(0), konst(0), row("le"), Ins::If(vec![get(1)], [else_base.clone(), vec![Ins::Br]].concat())],
+            ]
+            .concat(),
+        ),
+    );
+    // R8: Br in then arm (base case restarts impossible) but value-equal dead restart: cond always false
+    probe(
+        "R8 dead Br arm: if (0==1) Br else <base>",
+        &sum,
+        [vec![konst(0), konst(1), row("eq"), Ins::If(vec![Ins::Br], mk(vec![], vec![get(1)], [else_base.clone(), vec![Ins::Br]].concat()))]].concat(),
+    );
+    // R9: Set to the param BEFORE reading it for the cond, restored after (frame flow through if)
+    probe(
+        "R9 temp overwrite then restore",
+        &sum,
+        [vec![get(0), konst(5), row("add"), set(0), get(0), konst(5), row("sub"), set(0)], mk(vec![], vec![get(1)], [else_base.clone(), vec![Ins::Br]].concat())].concat(),
+    );
+}
+
+/// The pre-existing analog of R1 without Br or Set: arms reading the outer stack.
+#[test]
+fn review_preexisting_outer_stack_arms() {
+    let b: Build = Box::new(|s| source(s, "rec f n acc = if n <= 0 then acc else acc"));
+    let (_, _, frag) = compiled(&*b);
+    println!("original code: {:?}", frag.entry().code);
+    probe("PRE outer-stack arms, no Br/Set", &b, vec![get(1), get(0), konst(0), row("le"), Ins::If(vec![], vec![])]);
+}
+
+/// A Br in a callee record (position 0 of the pap module): dead-guarded.
+#[test]
+fn review_callee_br() {
+    let b: Build = Box::new(tail_recursive_loop_with_pap_producing_root_self_call_arg);
+    let (s, h, mut frag) = compiled(&*b);
+    for item in &mut frag.module {
+        if let Item::Func { pos: 0, entry, .. } = item {
+            println!("callee code {:?} arity {}", entry.code, entry.arity);
+            let old = entry.code.clone();
+            entry.code = vec![konst(0), konst(0), row("eq"), Ins::If(old, vec![Ins::Br])];
+        }
+    }
+    let frag: CompiledFragment = frag;
+    let v = big(move || gate(wasm_table(), &s, h, &frag));
+    println!("callee dead-Br verdict: {}", format!("{v:?}").chars().take(300).collect::<String>());
+}
