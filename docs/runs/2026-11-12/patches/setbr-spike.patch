+/// Informational: variants that are semantically equal to the source; each verdict is printed, none asserted except the
+/// no-op prelude, which the gate must take (the Set's frame rebuild reduces).
+#[test]
+fn setbr_equal_variants_info() {
+    let sum: Build = Box::new(|s| source(s, SUM));
+    let (v, _) = run(&sum, &|c, o, a| [vec![get(0), set(0)], restyle(c, o, &rev_slots(a), true)].concat());
+    println!("no-op prelude [get 0, Set 0]: {v:?}");
+    assert_eq!(v, Verdict::Accepted, "a no-op prelude");
+    let (v, _) = run(&sum, &|c, o, a| [vec![get(1), set(1)], restyle(c, o, &rev_slots(a), true)].concat());
+    println!("no-op prelude [get 1, Set 1]: {v:?}");
+    let (v, _) = run(&sum, &|c, o, a| [restyle(c, o, &rev_slots(a), true), vec![konst(0), row("add")]].concat());
+    println!("post-code `+ 0` after the if (Br skips it, base arm adds 0): {}", clip(format!("{v:?}")));
+}
