+/// The `local.set` row (SPIKE): operand `i` is the parameter slot written; the meaning is the frame rebuilt with slot
+/// `i` replaced (`Machine::setter`), and it prints `local.set $p{i}`.
+pub fn local_set_row() -> Row {
+    Row {
+        name: "local.set",
+        class: machine::Class::Set,
+        meaning: |c, m: &Machine, i| m.setter(c, i as usize),
+        line: |i| format!("local.set $p{i}"),
+    }
+}
