+/// VERIFIER: the Set/Br WAT validates and runs under wasmtime with the right results.
+#[test]
+fn verify_setbr_wat_runs_under_wasmtime() {
+    for (name, b, args, want) in [
+        ("capturing_closure_loop", Box::new(capturing_closure_loop) as Build, (5i64, 0i64), 15i64),
+        ("capturing_closure_loop", Box::new(capturing_closure_loop) as Build, (10, 100), 155),
+        ("capturing_closure_loop", Box::new(capturing_closure_loop) as Build, (0, 7), 7),
+        ("capturing_closure_loop", Box::new(capturing_closure_loop) as Build, (100000, 0), 5000050000),
+        ("SUM", Box::new(|s: &mut TermStore| source(s, SUM)) as Build, (4, 1), 11),
+        ("SUM2", Box::new(|s: &mut TermStore| source(s, SUM2)) as Build, (1, 4), 11),
+    ] {
+        let (_, _, frag) = compiled(&*b);
+        let (own, arity) = (frag.entry_pos, frag.entry().arity);
+        let orig = frag.entry().clone();
+        let new = Entry { code: restyle(&orig.code, own, &rev_slots(arity), true), ..orig.clone() };
+        let mut f = String::new();
+        tatic_wasm::print::print_func(wasm_table(), own, own, &new, &mut f);
+        let wat = format!("(module\n{f}  (export \"f\" (func $f))\n)\n");
+        let bytes = wat::parse_str(&wat).unwrap_or_else(|e| panic!("wat: {e}\n{wat}"));
+        let engine = wasmtime::Engine::default();
+        let module = wasmtime::Module::new(&engine, &bytes).unwrap(); // validates
+        let mut store = wasmtime::Store::new(&engine, ());
+        let inst = wasmtime::Instance::new(&mut store, &module, &[]).unwrap();
+        let func = inst.get_typed_func::<(i64, i64), i64>(&mut store, "f").unwrap();
+        let got = func.call(&mut store, args).unwrap();
+        println!("VERIFY {name} {args:?} -> {got} (want {want})");
+        assert_eq!(got, want, "{name} {args:?}");
+    }
+}
