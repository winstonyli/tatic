+/// The WAT of the rewritten capturing_closure_loop, and whether it is byte-identical to what h4's printer-only patch
+/// prints for the original `Call(own)` list (the h4 printer is `tatic_wasm::h4_print`, a spike copy).
+#[test]
+fn setbr_wat_matches_h4() {
+    for (name, b) in targets() {
+        let (_, _, frag) = compiled(&*b);
+        let (own, arity) = (frag.entry_pos, frag.entry().arity);
+        let orig = frag.entry().clone();
+        let new = Entry { code: restyle(&orig.code, own, &rev_slots(arity), true), ..orig.clone() };
+        assert_eq!(new.env, EnvAccess::Params(0));
+        let (mut a, mut h4) = (String::new(), String::new());
+        tatic_wasm::print::print_func(wasm_table(), own, own, &new, &mut a);
+        tatic_wasm::h4_print::print_func(wasm_table(), own, own, &orig, &mut h4);
+        if name == "capturing_closure_loop" {
+            println!("--- Set/Br WAT for {name}:\n{a}--- h4 WAT:\n{h4}---");
+        }
+        println!("{name}: Set/Br WAT {} h4's ({} vs {} bytes)", if a == h4 { "IDENTICAL to" } else { "DIFFERS from" }, a.len(), h4.len());
+        assert_eq!(a, h4, "{name}");
+    }
+}
