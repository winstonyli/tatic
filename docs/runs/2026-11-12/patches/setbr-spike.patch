+/// Gate build+check time, the `Call(own)` list against the Set/Br list of capturing_closure_loop, interleaved. Untimed
+/// in the sense of RUNS.md: the machine is shared, so the medians are indicative only.
+#[test]
+#[ignore]
+fn setbr_gate_time() {
+    let (s, h, frag) = compiled(&capturing_closure_loop);
+    let (_, _, frag2) = compiled(&capturing_closure_loop);
+    let (own, arity) = (frag.entry_pos, frag.entry().arity);
+    let new = with_code(frag2, restyle(&frag.entry().code, own, &rev_slots(arity), true));
+    let once = move |s: &TermStore, frag: &CompiledFragment| -> (f64, f64) {
+        tatic_kernel::scoped(|| {
+            let t0 = std::time::Instant::now();
+            let (st, p) = build(wasm_table(), s, h, frag).expect("builds");
+            let p = p.expect("proves");
+            let t1 = std::time::Instant::now();
+            assert!(tatic_wasm::encoding::holds(&p, &st).is_ok());
+            ((t1 - t0).as_secs_f64() * 1e3, t1.elapsed().as_secs_f64() * 1e3)
+        })
+    };
+    let (sa, fa, fb) = (s, frag, new);
+    let (a, b) = big(move || {
+        let (mut a, mut b) = (vec![], vec![]);
+        let _ = (once(&sa, &fa), once(&sa, &fb)); // warm up
+        for _ in 0..20 {
+            a.push(once(&sa, &fa));
+            b.push(once(&sa, &fb));
+        }
+        (a, b)
+    });
+    let med = |v: &[(f64, f64)], f: fn(&(f64, f64)) -> f64| {
+        let mut x: Vec<f64> = v.iter().map(f).collect();
+        x.sort_by(|p, q| p.partial_cmp(q).unwrap());
+        (x[x.len() / 2 - 1] + x[x.len() / 2]) / 2.0
+    };
+    println!("Call(own) list: build median {:.2} ms, check median {:.2} ms", med(&a, |t| t.0), med(&a, |t| t.1));
+    println!("Set/Br   list: build median {:.2} ms, check median {:.2} ms", med(&b, |t| t.0), med(&b, |t| t.1));
+    println!("raw A: {a:?}\nraw B: {b:?}");
+}
