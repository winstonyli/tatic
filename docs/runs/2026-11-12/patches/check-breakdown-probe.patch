+pub fn ref_exit(t: RefTok) {
+    if t.0.iter().any(|x| *x) {
+        let w = crate::work() - t.2;
+        let mut flags = IN_REF.with(|c| c.get());
+        let mut r = REFWORK.with(|c| c.get());
+        for i in 0..3 {
+            if t.0[i] {
+                r[t.1][i].0 += 1;
+                r[t.1][i].1 += w;
+                flags[i] = false;
+            }
+        }
+        REFWORK.with(|c| c.set(r));
+        IN_REF.with(|c| c.set(flags));
+    }
+}
