+    static APPDOM: RefCell<Vec<AppDom>> = const { RefCell::new(Vec::new()) };
+}
+pub fn app_dom(pending: usize, args: usize, units: u64, head: crate::Expr, head_ty: crate::Expr, dom: crate::Expr, arg0: crate::Expr, res: crate::Expr) {
+    if on() {
