+//! PROBE (worktree only): where the kernel check's shift and instantiate units come from, by call site of the
+//! substitution entry points (outermost tagged call wins; inclusive), and by check depth / stage.
+use super::gate::compiled;
+use crate::jit::shape::wasm_table;
+use crate::lang::term::TermStore;
+use crate::proof::gate::build;
+use crate::support::samples::{capturing_closure_loop, straight_line};
+use crate::testing::test_corpus::doubling;
+use tatic_kernel::prof;
+use tatic_kernel::{scoped, work};
+use tatic_wasm::encoding::holds;
+
+fn on(f: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn(f).unwrap().join().unwrap();
+}
+
+fn origin(name: &'static str, make: &dyn Fn(&mut TermStore) -> crate::lang::term::Hash) {
+    let (s, h, frag) = compiled(make);
+    scoped(|| {
+        let (st, p) = build(wasm_table(), &s, h, &frag).expect("builds");
+        let p = p.expect("proves");
+        prof::reset(true);
+        let w0 = work();
+        holds(&p, &st).expect("holds");
+        let w = work() - w0;
+        let counts = prof::counts();
+        let col = |n: &str| prof::NAMES.iter().position(|x| *x == n).unwrap();
+        let tot = |n: &str| -> u64 { counts.iter().map(|c| c[col(n)]).sum() };
+        let (shift_t, inst_t) = (tot("Shift"), tot("Inst"));
+        println!("ORIGIN {name}: total work {w}, shift {shift_t}, instantiate {inst_t}");
+        let sites = prof::sites();
+        let (ss, si): (u64, u64) = sites.iter().fold((0, 0), |a, (_, v)| (a.0 + v.shift, a.1 + v.inst));
+        println!("ORIGIN {name}: per-site sums shift {ss} instantiate {si} (match totals: {})", ss == shift_t && si == inst_t);
+        let mut rows = sites;
+        rows.sort_by(|a, b| (b.1.shift + b.1.inst).cmp(&(a.1.shift + a.1.inst)));
+        println!("ORIGIN {name}: {:>6} {:>7} {:>7}  | stmt<=11 stmt>11 proof<=11 proof>11 (shift/inst) | site", "calls", "shift", "inst");
+        for (l, v) in &rows {
+            let b = |x: (u64, u64)| format!("{}/{}", x.0, x.1);
+            println!(
+                "ORIGIN {name}: {:>6} {:>7} {:>7}  | {:>9} {:>8} {:>9} {:>8} | {l}",
+                v.calls,
+                v.shift,
+                v.inst,
+                b(v.by[0][0]),
+                b(v.by[0][1]),
+                b(v.by[1][0]),
+                b(v.by[1][1])
+            );
+        }
+        println!("ORIGIN {name}: depth histogram (stage, depth) -> shift/inst");
+        for ((st, d), (a, b)) in prof::depth_hist() {
+            println!("ORIGIN {name}:   {} depth {:>2}: {a}/{b}", if st == 0 { "stmt " } else { "proof" }, d);
+        }
+        prof::reset(false);
+        let _ = (st, p);
+    });
+}
+
+#[test]
+#[ignore]
+fn check_origin_closure_loop() {
+    on(|| origin("capturing_closure_loop", &capturing_closure_loop));
+}
+
+#[test]
+#[ignore]
+fn check_origin_straight_line() {
+    on(|| origin("straight_line", &straight_line));
+}
+
+#[test]
+#[ignore]
+fn check_origin_doubling6() {
+    on(|| origin("doubling(6)", &|s: &mut TermStore| doubling(s, 6)));
+}
