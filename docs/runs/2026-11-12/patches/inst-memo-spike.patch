+//! PROBE (worktree only): how the gate's build and check work of `doubling(d)` grow with d, and where the statement
+//! stage's App-domain instantiation comes from. `DG_DS=1,2,3` picks the d values (default 1..=12).
+use super::gate::compiled;
+use crate::jit::shape::wasm_table;
+use crate::lang::term::TermStore;
+use crate::proof::gate::{build, module_cost};
+use crate::testing::test_corpus::doubling;
+use tatic_kernel::prof;
+use tatic_kernel::{scoped, term_sizes, work, Expr, Node};
+use tatic_wasm::encoding::holds;
+
+fn on(f: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn(f).unwrap().join().unwrap();
+}
+
+fn leading_pis(e: &Expr) -> usize {
+    let (mut n, mut c) = (0, *e);
+    while let Node::Pi(_, b) = c.node() {
+        n += 1;
+        c = b;
+    }
+    n
+}
+
+fn stage_totals(stage: usize) -> (u64, u64) {
+    prof::sites().iter().fold((0, 0), |a, (_, v)| (a.0 + v.by[stage][0].0 + v.by[stage][1].0, a.1 + v.by[stage][0].1 + v.by[stage][1].1))
+}
+
+type Rec = prof::AppDom;
+
+fn one(d: u32) {
+    let t0 = std::time::Instant::now();
+    let (s, h, frag) = compiled(&|s: &mut TermStore| doubling(s, d));
+    let compile_ms = t0.elapsed().as_secs_f64() * 1e3;
+    let cost = module_cost(&s, h, &frag);
+    let ins: usize = frag.records().iter().flatten().map(|e| e.code.len()).sum();
+    let nrec = frag.records().iter().flatten().count();
+    println!("DG d={d} SRC tree {} distinct nodes {}; module_cost {cost}; records {nrec}; wasm instrs {ins}; compile {compile_ms:.1} ms", 1u64 << (d + 1), d + 2);
+    scoped(|| {
+        let (w0, t1) = (work(), std::time::Instant::now());
+        let (st, p) = match build(wasm_table(), &s, h, &frag) {
+            Ok((st, Ok(p))) => (st, p),
+            Ok((_, Err(e))) => {
+                println!("DG d={d} BUILD generator refused: {e}");
+                return;
+            }
+            Err(v) => {
+                println!("DG d={d} BUILD no statement: {v:?}");
+                return;
+            }
+        };
+        let bw = work() - w0;
+        let build_ms = t1.elapsed().as_secs_f64() * 1e3;
+        let region_after_build = prof::region_len();
+        let (sd, stt) = term_sizes(&st);
+        let (pd, pt) = term_sizes(&p);
+        println!("DG d={d} STMT distinct {sd} tree {stt} leading_pi {} | PROOF distinct {pd} tree {pt}", leading_pis(&st));
+        let lean = std::env::var("DG_LEAN").is_ok();
+        prof::reset(!lean);
+        prof::inst_stats(true);
+        let (w1, t2) = (work(), std::time::Instant::now());
+        let res = holds(&p, &st);
+        let cw = work() - w1;
+        let check_ms = t2.elapsed().as_secs_f64() * 1e3;
+        let counts = prof::counts();
+        let col = |n: &str| prof::NAMES.iter().position(|x| *x == n).unwrap();
+        let tot = |n: &str| -> u64 { counts.iter().map(|c| c[col(n)]).sum() };
+        let (sh, inst) = (tot("Shift"), tot("Inst"));
+        let trie = prof::trie();
+        let fr = |l: &str| trie.iter().filter(|n| n.label == l).map(|n| n.incl).sum::<u64>();
+        let (stmt_w, proof_w) = (fr("STMT infer(expected)"), fr("PROOF check(e,expected)"));
+        let (s_sh, s_in) = stage_totals(0);
+        let (p_sh, p_in) = stage_totals(1);
+        let sites = prof::sites();
+        let site = |l: &str| sites.iter().find(|(k, _)| *k == l).map(|(_, v)| v.clone()).unwrap_or_default();
+        let ad = site("check:App instantiate Pi domain with earlier args");
+        let ad0 = ad.by[0][0].1 + ad.by[0][1].1;
+        let ad1 = ad.by[1][0].1 + ad.by[1][1].1;
+        let ad0s = ad.by[0][0].0 + ad.by[0][1].0;
+        let log = prof::app_dom_log();
+        let l0: Vec<&Rec> = log.iter().filter(|r| r.stage == 0).collect();
+        let l1: Vec<&Rec> = log.iter().filter(|r| r.stage == 1).collect();
+        let sum = |v: &Vec<&Rec>, f: fn(&Rec) -> u64| v.iter().map(|r| f(r)).sum::<u64>();
+        let si = prof::stage_infer();
+        println!(
+            "DG d={d} REFEREE infer stmt: nodes {} hit {} miss {} unshared {}; proof: nodes {} hit {} miss {} unshared {}; heavy-site calls per tree node {:.3}",
+            si[0][0], si[0][1], si[0][2], si[0][3], si[1][0], si[1][1], si[1][2], si[1][3],
+            l0.iter().filter(|r| r.units >= 60).count() as f64 / (1u64 << (d + 1)) as f64
+        );
+        println!("DG d={d} MEMO arm {} [top hit, top miss, inner hit, inner miss, top entries, inner entries] = {:?}", std::env::var("TATIC_INST_MEMO").unwrap_or("0".into()), prof::inst_stats(false));
+        println!(
+            "DG d={d} TICKS {}",
+            ["Shift", "Inst", "WhnfApp", "WhnfJ", "WhnfWRec", "WhnfSigRec", "NfWhnf", "ConvWhnf", "InferNode"].iter().map(|n| format!("{n} {}", tot(n))).collect::<Vec<_>>().join(", ")
+        );
+        println!("DG d={d} BUILD work {bw} ({build_ms:.1} ms) region_nodes_after_build {region_after_build}");
+        println!(
+            "DG d={d} CHECK{} holds={:?} work {cw} ({check_ms:.1} ms probe on): shift {sh} inst {inst}; stmt-stage work {stmt_w} (shift {s_sh} inst {s_in}), proof-stage work {proof_w} (shift {p_sh} inst {p_in}); region_nodes_after_check {}",
+            if lean { "(lean: probe off, only work and region are valid)" } else { "" },
+            res.is_ok(),
+            prof::region_len()
+        );
+        println!(
+            "DG d={d} APPDOM stmt: site inst {ad0} (+shift {ad0s}), calls {}, units(work deltas) {}, pending sum {}, pending max {}, spine args max {}, depths {:?}..{:?}; proof: site inst {ad1}, calls {}, units {}",
+            l0.len(),
+            sum(&l0, |r| r.units),
+            sum(&l0, |r| r.pending as u64),
+            l0.iter().map(|r| r.pending).max().unwrap_or(0),
+            l0.iter().map(|r| r.args).max().unwrap_or(0),
+            l0.iter().map(|r| r.depth).min(),
+            l0.iter().map(|r| r.depth).max(),
+            l1.len(),
+            sum(&l1, |r| r.units)
+        );
+        if std::env::var("DG_DETAIL").is_ok() {
+            let mut h: std::collections::BTreeMap<(usize, usize), (u64, u64)> = Default::default();
+            let mut by: std::collections::BTreeMap<usize, (u64, u64)> = Default::default();
+            for r in &l0 {
+                let e = h.entry((r.args, r.pending)).or_default();
+                e.0 += 1;
+                e.1 += r.units;
+                let e = by.entry(r.depth).or_default();
+                e.0 += 1;
+                e.1 += r.units;
+            }
+            for ((args, pend), (n, u)) in h {
+                println!("DG d={d} APPDOM-STMT spine_args {args} pending {pend}: calls {n} units {u}");
+            }
+            for (dep, (n, u)) in by {
+                println!("DG d={d} APPDOM-STMT depth {dep}: calls {n} units {u}");
+            }
+            // do the heavy calls (>= 60 units, statement stage) repeat the same (dom, first pending arg)? and the same result?
+            let heavy: Vec<&&Rec> = l0.iter().filter(|r| r.units >= 60).collect();
+            let (mut pairs, mut results): (Vec<(Expr, Expr)>, Vec<Expr>) = (vec![], vec![]);
+            for r in &heavy {
+                if !pairs.contains(&(r.dom, r.arg0)) {
+                    pairs.push((r.dom, r.arg0));
+                }
+                if !results.contains(&r.res) {
+                    results.push(r.res);
+                }
+            }
+            let mut args: Vec<Expr> = vec![];
+            for r in &heavy {
+                if !args.contains(&r.arg0) {
+                    args.push(r.arg0);
+                }
+            }
+            println!(
+                "DG d={d} HEAVY (>=60 units) stmt calls {}: units {}; distinct (dom,arg0) {}; distinct arg0 {}; distinct results {}; arg0 sample: {}",
+                heavy.len(),
+                heavy.iter().map(|r| r.units).sum::<u64>(),
+                pairs.len(),
+                args.len(),
+                results.len(),
+                heavy.first().map(|r| short(&r.arg0)).unwrap_or_default()
+            );
+            // by distinct (head, head type, dom): who pays
+            let mut groups: Vec<(Rec, u64, u64, u64)> = vec![];
+            for r in &l0 {
+                match groups.iter_mut().find(|g| g.0.head == r.head && g.0.dom == r.dom) {
+                    Some(g) => {
+                        g.1 += 1;
+                        g.2 += r.units;
+                        g.3 += r.pending as u64;
+                    }
+                    None => groups.push((**r, 1, r.units, r.pending as u64)),
+                }
+            }
+            groups.sort_by(|a, b| b.2.cmp(&a.2));
+            println!("DG d={d} APPDOM-STMT distinct (head,dom) pairs {}", groups.len());
+            for (g, n, u, ps) in groups.iter().take(8) {
+                let (dd, dt) = term_sizes(&g.dom);
+                let (hd, ht) = term_sizes(&g.head);
+                let (td, tt) = term_sizes(&g.head_ty);
+                println!(
+                    "DG d={d}   group: calls {n} units {u} avg pending {:.1} spine args {} depth {} | head distinct {hd} tree {ht}: {} | head type distinct {td} tree {tt} leading_pi {} | dom distinct {dd} tree {dt}: {}",
+                    *ps as f64 / *n as f64,
+                    g.args,
+                    g.depth,
+                    short(&g.head),
+                    leading_pis(&g.head_ty),
+                    short(&g.dom)
+                );
+            }
+            if let Some((g, ..)) = groups.first() {
+                let mut o = String::new();
+                outline(&g.head_ty, 1, 3, &mut o);
+                println!("DG d={d} top group head type outline:\n{o}");
+            }
+        }
+        if std::env::var("DG_SHOW").is_ok() {
+            println!("DG d={d} STATEMENT: {}", format!("{st:?}").chars().take(40000).collect::<String>());
+        }
+        prof::reset(false);
+    });
+}
+
+fn short(e: &Expr) -> String {
+    let s = format!("{e:?}");
+    if s.len() > 90 { format!("{}...[{} chars]", &s[..90], s.len()) } else { s }
+}
+
+/// Indented outline of `e`: Pi/Lam telescopes with equal domains run-length collapsed, App spines as head plus args.
+fn outline(e: &Expr, ind: usize, left: usize, out: &mut String) {
+    let pad = "  ".repeat(ind);
+    if left == 0 {
+        out.push_str(&format!("{pad}{}\n", short(e)));
+        return;
+    }
+    match e.node() {
+        Node::Pi(..) | Node::Lam(..) => {
+            let (is_pi, mut cur, mut runs): (bool, Expr, Vec<(Expr, usize)>) = (matches!(e.node(), Node::Pi(..)), *e, vec![]);
+            loop {
+                let (d, b) = match cur.node() {
+                    Node::Pi(d, b) if is_pi => (d, b),
+                    Node::Lam(d, b) if !is_pi => (d, b),
+                    _ => break,
+                };
+                match runs.last_mut() {
+                    Some((p, n)) if *p == d => *n += 1,
+                    _ => runs.push((d, 1)),
+                }
+                cur = b;
+            }
+            for (d, n) in &runs {
+                out.push_str(&format!("{pad}{} x{n} over {}\n", if is_pi { "Pi" } else { "Lam" }, short(d)));
+            }
+            out.push_str(&format!("{pad}.body:\n"));
+            outline(&cur, ind + 1, left - 1, out);
+        }
+        Node::App(..) => {
+            let (mut args, mut h) = (vec![], *e);
+            while let Node::App(f, a) = h.node() {
+                args.push(a);
+                h = f;
+            }
+            args.reverse();
+            out.push_str(&format!("{pad}App head {} with {} args:\n", short(&h), args.len()));
+            let mut i = 0;
+            while i < args.len() {
+                let mut j = i;
+                while j + 1 < args.len() && args[j + 1] == args[i] {
+                    j += 1;
+                }
+                out.push_str(&format!("{pad}  arg{i}{} = {}\n", if j > i { format!("..arg{j}") } else { String::new() }, short(&args[i])));
+                i = j + 1;
+            }
+        }
+        _ => out.push_str(&format!("{pad}{}\n", short(e))),
+    }
+}
+
+#[test]
+#[ignore]
+fn doubling_statement_outline() {
+    on(|| {
+        let d: u32 = std::env::var("DG_D").ok().and_then(|v| v.parse().ok()).unwrap_or(2);
+        let (s, h, frag) = compiled(&|s: &mut TermStore| doubling(s, d));
+        scoped(|| {
+            let (st, p) = build(wasm_table(), &s, h, &frag).unwrap();
+            let mut out = String::new();
+            outline(&st, 0, 12, &mut out);
+            println!("OUTLINE statement d={d}:\n{out}");
+            let mut out = String::new();
+            outline(&p.unwrap(), 0, 6, &mut out);
+            println!("OUTLINE proof d={d}:\n{out}");
+        });
+    });
+}
+
+#[test]
+#[ignore]
+fn doubling_growth() {
+    let ds: Vec<u32> = match std::env::var("DG_DS") {
+        Ok(v) => v.split(',').map(|x| x.parse().unwrap()).collect(),
+        Err(_) => (1..=12).collect(),
+    };
+    on(move || ds.iter().for_each(|d| one(*d)));
+}
+
+/// SPIKE: build and check work (and the instantiation memo's stats) of the fixed sample programs, one line each.
+fn program(name: &str, mk: &dyn Fn(&mut TermStore) -> crate::lang::term::Hash) {
+    let (s, h, frag) = compiled(mk);
+    scoped(|| {
+        let w0 = work();
+        let (st, p) = match build(wasm_table(), &s, h, &frag) {
+            Ok((st, Ok(p))) => (st, p),
+            Ok((_, Err(e))) => return println!("PG {name} BUILD generator refused: {e}"),
+            Err(v) => return println!("PG {name} BUILD no statement: {v:?}"),
+        };
+        let bw = work() - w0;
+        prof::reset(true);
+        prof::inst_stats(true);
+        let w1 = work();
+        let res = holds(&p, &st);
+        let cw = work() - w1;
+        let counts = prof::counts();
+        let col = |n: &str| prof::NAMES.iter().position(|x| *x == n).unwrap();
+        let tot = |n: &str| -> u64 { counts.iter().map(|c| c[col(n)]).sum() };
+        let sites = prof::sites();
+        let ad = sites.iter().find(|(k, _)| *k == "check:App instantiate Pi domain with earlier args").map(|(_, v)| v.clone()).unwrap_or_default();
+        let site_inst = ad.by[0][0].1 + ad.by[0][1].1 + ad.by[1][0].1 + ad.by[1][1].1;
+        println!(
+            "PG {name} arm {} verdict {} build {bw} check {cw} (shift {} inst {}; Pi-domain site inst {site_inst}) memo {:?}",
+            std::env::var("TATIC_INST_MEMO").unwrap_or("0".into()),
+            if res.is_ok() { "Accepted" } else { "REJECTED" },
+            tot("Shift"),
+            tot("Inst"),
+            prof::inst_stats(false)
+        );
+        prof::reset(false);
+    });
+}
+
+#[test]
+#[ignore]
+fn inst_memo_programs() {
+    on(|| {
+        program("capturing_closure_loop", &crate::support::samples::capturing_closure_loop);
+        program("straight_line", &crate::support::samples::straight_line);
+        program("held_out_b", &crate::testing::test_corpus::held_out_b);
+        program("gcd", &crate::support::samples::gcd);
+        program("doubling(6)", &|s: &mut TermStore| doubling(s, 6));
+    });
+}
