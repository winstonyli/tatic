+    }
+}
+pub fn app_dom_log() -> Vec<AppDom> {
+    APPDOM.with(|v| v.borrow().clone())
+}
+pub fn app_dom_clear() {
+    APPDOM.with(|v| v.borrow_mut().clear());
+}
+/// Nodes in this thread's open region.
+pub fn region_len() -> usize {
+    crate::expr::with_spaces(|s| s.region_len())
+}
+/// SPIKE: the instantiation memo arm's stats (see `hc::inst_memo_stats`); `reset` zeroes the hit and miss counts.
+pub fn inst_stats(reset: bool) -> [u64; 6] {
+    let r = crate::hc::inst_memo_stats();
+    if reset {
+        crate::expr::with_spaces(|s| s.memos.borrow_mut().inst_stats = [0; 4]);
+    }
+    r
+}
