     }
 }
 
+/// SPIKE: the cross-call instantiation memo arm, read once from `TATIC_INST_MEMO` (0 off, A whole calls, B A plus inner entries kept across calls).
+pub fn inst_mode() -> u8 {
+    static M: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *M.get_or_init(|| match std::env::var("TATIC_INST_MEMO").as_deref() {
+        Ok("A") => 1,
+        Ok("B") => 2,
+        _ => 0,
+    })
