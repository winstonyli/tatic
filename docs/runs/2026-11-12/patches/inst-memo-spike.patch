+    let n = m.inst_args.len() as u32;
+    let id = match m.inst_args.get(&ks[..]) {
+        Some(&id) => id,
+        None => {
+            m.inst_args.insert(ks.into_boxed_slice(), n);
+            n
+        }
+    };
+    m.inst_cur = id;
+    let r = m.inst_top.get(&(s.key(e), id, d)).map(|r| s.expr_of(r));
+    m.inst_stats[if r.is_some() { 0 } else { 1 }] += 1;
+    r
+}
+
+pub fn inst_top_put(s: &Spaces, e: &Expr, d: u32, r: &Expr) {
+    let mut m = s.memos.borrow_mut();
+    let id = m.inst_cur;
+    m.inst_top.insert((s.key(e), id, d), s.key(r));
+}
+
