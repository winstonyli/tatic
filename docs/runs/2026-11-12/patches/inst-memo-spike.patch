+pub fn inst1(body: &crate::Expr, a: &crate::Expr) -> crate::Expr {
+    crate::with_spaces(|s| crate::subst::subst_top(s, body, a))
+}
+
+// ---- doubling-growth probe: per-call record of the App arm's 'instantiate Pi domain with earlier args' ----
+#[derive(Clone, Copy)]
+pub struct AppDom {
+    pub stage: usize,
+    pub depth: usize,
+    pub pending: usize,
+    pub args: usize,
+    pub units: u64,
+    pub head: crate::Expr,
+    pub head_ty: crate::Expr,
+    pub dom: crate::Expr,
+    pub arg0: crate::Expr,
+    pub res: crate::Expr,
