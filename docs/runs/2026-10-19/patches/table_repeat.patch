+// PROBE (throwaway): repeats per rule table
+pub struct TableProbe {
+    join: hashbrown::HashSet<Term>,
+    rw: hashbrown::HashSet<Term>,
+    dm16: Vec<Option<Term>>,
+    dm12: Vec<Option<Term>>,
+}
+impl TableProbe {
+    fn fresh() -> TableProbe {
+        TableProbe { join: Default::default(), rw: Default::default(), dm16: vec![None; 1 << 16], dm12: vec![None; 1 << 12] }
+    }
+}
+thread_local! {
+    pub static TPROBE: std::cell::RefCell<TableProbe> = std::cell::RefCell::new(TableProbe::fresh());
+}
+/// 16 join visits already seen under this table, 17 and 18 hits of a direct-mapped cache of 2^16 and 2^12 slots
+fn tprobe_join(t: Term) {
+    TPROBE.with(|p| {
+        let mut p = p.borrow_mut();
+        probe(16, !p.join.insert(t) as u64);
+        let i = t.sh() as usize;
+        let (a, b) = (i & 0xFFFF, i & 0xFFF);
+        probe(17, (p.dm16[a] == Some(t)) as u64);
+        p.dm16[a] = Some(t);
+        probe(18, (p.dm12[b] == Some(t)) as u64);
+        p.dm12[b] = Some(t);
+    })
+}
+/// 19 `rule_step_in` calls, 20 at a term it saw under this table, 21 at a term the join walked under it
+fn tprobe_rw(t: Term) {
+    TPROBE.with(|p| {
+        let mut p = p.borrow_mut();
+        probe(19, 1);
+        probe(20, !p.rw.insert(t) as u64);
+        probe(21, p.join.contains(&t) as u64);
+    })
+}
