+// PROBE (throwaway): op_callers counters
+thread_local! {
+    /// subterms `join_walk` was at in this search (repeats probe)
+    pub static WALKED: std::cell::RefCell<hashbrown::HashSet<Term>> = std::cell::RefCell::new(hashbrown::HashSet::new());
+}
+pub fn probe(i: usize, n: u64) {
+    count_join(|c| c.probe[i] += n)
+}
+thread_local! {
+    /// who is calling `Term::op` in the join: 0 other, 1 a new step's `subst_pat`, 2 a spine's `make`
+    pub static ORIGIN: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+/// `f` with `ORIGIN` set to `o`
+fn origin<T>(o: usize, f: impl FnOnce() -> T) -> T {
+    let before = ORIGIN.with(|c| c.replace(o));
+    let r = f();
+    ORIGIN.with(|c| c.set(before));
+    r
+}
+/// a `Term::op` call's outcome `k` (0 cache hit, 1 table hit, 2 insert) by its origin
+fn op_probe(k: usize) {
+    probe(ORIGIN.with(|c| c.get()) * 3 + k, 1)
+}
