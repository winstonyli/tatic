+// PROBE (throwaway): match_fail counters
+pub fn probe(i: usize, n: u64) {
+    count_join(|c| c.probe[i] += n)
+}
+/// `match_pat`, counting the pattern nodes it visits into `n`.
+fn match_nodes(p: &Term, t: &Term, sub: &mut [Option<Term>], n: &mut u64) -> bool {
+    *n += 1;
+    match (*p.node(), *t.node()) {
+        (Node::V(i), _) => match &sub[i] {
+            Some(b) => b == t,
+            None => {
+                sub[i] = Some(*t);
+                true
+            }
+        },
+        (Node::Zero, Node::Zero) | (Node::Ones, Node::Ones) => true,
+        (Node::Op(o, a, b), Node::Op(o2, c, d)) => o == o2 && match_nodes(&a, &c, sub, n) && match_nodes(&b, &d, sub, n),
+        _ => false,
+    }
+}
+/// What a pre-check of `p`'s repeated variables would walk: the depth of each occurrence of a variable that occurs twice or
+/// more, summed (0 when no variable repeats).
+fn repeat_depths(p: &Term) -> u64 {
+    fn walk(p: &Term, depth: u64, out: &mut Vec<(usize, u64)>) {
+        match *p.node() {
+            Node::V(i) => out.push((i, depth)),
+            Node::Op(_, a, b) => {
+                walk(&a, depth + 1, out);
+                walk(&b, depth + 1, out);
+            }
+            _ => {}
+        }
+    }
+    let mut occ = vec![];
+    walk(p, 0, &mut occ);
+    occ.iter().filter(|(v, _)| occ.iter().filter(|(w, _)| w == v).count() > 1).map(|&(_, d)| d).sum()
+}
+/// The least depth (root 0) where `p`'s shape rejects `t`, ignoring what a repeated variable binds; None when it fits.
+fn shape_miss(p: &Term, t: &Term, depth: u64) -> Option<u64> {
+    match (*p.node(), *t.node()) {
+        (Node::V(_), _) | (Node::Zero, Node::Zero) | (Node::Ones, Node::Ones) => None,
+        (Node::Op(o, a, b), Node::Op(o2, c, d)) if o == o2 => match (shape_miss(&a, &c, depth + 1), shape_miss(&b, &d, depth + 1)) {
+            (Some(x), Some(y)) => Some(x.min(y)),
+            (x, y) => x.or(y),
+        },
+        _ => Some(depth),
+    }
+}
