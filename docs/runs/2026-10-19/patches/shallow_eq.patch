+/// Whether `p`'s root has the same variable as both operands (`add(x, x)`).
+fn root_xx(p: &Term) -> bool {
+    matches!(*p.node(), Node::Op(_, a, b) if a == b && matches!(*a.node(), Node::V(_)))
+}
+/// Pairs of positions within depth 2 of `p`'s root (paths of left/right turns) that hold the same variable.
+fn shallow_pairs(p: &Term) -> Vec<(Vec<bool>, Vec<bool>)> {
+    let mut occ: Vec<(usize, Vec<bool>)> = vec![];
+    if let Node::Op(_, a, b) = *p.node() {
+        for (r, c) in [(false, a), (true, b)] {
+            match *c.node() {
+                Node::V(v) => occ.push((v, vec![r])),
+                Node::Op(_, x, y) => {
+                    for (r2, g) in [(false, x), (true, y)] {
+                        if let Node::V(v) = *g.node() {
+                            occ.push((v, vec![r, r2]));
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    let mut pairs = vec![];
+    for i in 0..occ.len() {
+        for j in i + 1..occ.len() {
+            if occ[i].0 == occ[j].0 {
+                pairs.push((occ[i].1.clone(), occ[j].1.clone()));
+            }
+        }
+    }
+    pairs
+}
+/// `t`'s subterm at `path` (the shape is known to reach it).
+fn at(t: &Term, path: &[bool]) -> Term {
+    path.iter().fold(*t, |t, &r| match *t.node() {
+        Node::Op(_, a, b) => if r { b } else { a },
+        _ => unreachable!("the pattern's shape fits"),
+    })
+}
+/// The least depth (root 0) where `p`'s shape rejects `t`, ignoring what a repeated variable binds; None when it fits.
+fn shape_miss(p: &Term, t: &Term, depth: u64) -> Option<u64> {
+    match (*p.node(), *t.node()) {
+        (Node::V(_), _) | (Node::Zero, Node::Zero) | (Node::Ones, Node::Ones) => None,
+        (Node::Op(o, a, b), Node::Op(o2, c, d)) if o == o2 => match (shape_miss(&a, &c, depth + 1), shape_miss(&b, &d, depth + 1)) {
+            (Some(x), Some(y)) => Some(x.min(y)),
+            (x, y) => x.or(y),
+        },
+        _ => Some(depth),
+    }
+}
