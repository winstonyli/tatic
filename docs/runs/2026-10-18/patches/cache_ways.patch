+// PROBE (throwaway): cache_ways, shadow caches of `Term::op`'s nodes by slot (bits 44.. of the hash), each a hit when the
+// node is in its set, the set's ways kept most recent first: direct 2^16 (the real one), 2^17, 2^18; 2-way 2^15 and
+// 2^16 sets; 4-way 2^14 sets. Hits in probe 16..22.
+const SIM_SLOTS: [(usize, usize); 6] = [(1 << 16, 1), (1 << 17, 1), (1 << 18, 1), (1 << 16, 2), (1 << 17, 2), (1 << 16, 4)];
+thread_local! {
+    static SIM: Vec<Box<[std::cell::Cell<u64>]>> = SIM_SLOTS.iter().map(|&(n, _)| (0..n).map(|_| std::cell::Cell::new(0)).collect()).collect();
+}
+fn sim(h: u64, m: &Interned) {
+    let p = m as *const Interned as u64;
+    SIM.with(|s| {
+        for (k, c) in s.iter().enumerate() {
+            let w = SIM_SLOTS[k].1;
+            let base = (h >> 44) as usize % (c.len() / w) * w;
+            let set = &c[base..base + w];
+            let hit = set.iter().position(|x| x.get() == p);
+            if hit.is_some() {
+                probe(16 + k, 1);
+            }
+            for j in (1..=hit.unwrap_or(w - 1)).rev() {
+                set[j].set(set[j - 1].get());
+            }
+            set[0].set(p);
+        }
+    })
+}
+// PROBE (throwaway): dup_count counters
+pub fn probe(i: usize, n: u64) {
+    count_join(|c| c.probe[i] += n)
+}
+fn pat_ops(t: &Term) -> u64 {
+    match *t.node() {
+        Node::Op(_, a, b) => 1 + pat_ops(&a) + pat_ops(&b),
+        _ => 0,
+    }
+}
