+/// PROBE (throwaway): bumps `JOIN_COST.probe[i]`: 0 join matcher calls, 1 calls a size bound would skip, 2 of those that
+/// match, 3 of those within the cap (must be 0), 4 matches over the cap, 5 of those the bound skips.
+fn probe(i: usize) {
+    JOIN_COST.with(|c| {
+        let mut v = c.get();
+        v.probe[i] += 1;
+        c.set(v)
+    })
+}
+
+/// PROBE: occurrences of variable `v` in `t`.
+fn occ(t: &Term, v: usize) -> usize {
+    match *t.node() {
+        Node::V(i) => (i == v) as usize,
+        Node::Op(_, a, b) => occ(&a, v) + occ(&b, v),
+        _ => 0,
+    }
+}
