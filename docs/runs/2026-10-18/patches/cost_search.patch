+/// PROBE: whether some path of join steps from `a` to `b` through terms of at most `cap` nodes has at most `budget`
+/// size-increasing steps (others free), searched from both sides by cost level, the side whose next level is smaller
+/// raised first: "met", "fail", or "unknown" past `safety` terms; with the terms reached and the final per-side limits.
+fn cost_join(a: &Term, b: &Term, cap: usize, budget: u32, safety: usize) -> (&'static str, usize, (u32, u32)) {
+    let ac = env_var("JOIN_AC").is_some();
+    let (a, b) = if ac { (&ac_canon(*a), &ac_canon(*b)) } else { (a, b) };
+    let mut dist: [hashbrown::HashMap<Term, u32>; 2] = [Default::default(), Default::default()];
+    let mut buckets: [Vec<Vec<Term>>; 2] = [vec![vec![]; budget as usize + 2], vec![vec![]; budget as usize + 2]];
+    for (s, t) in [(0, *a), (1, *b)] {
+        dist[s].insert(t, 0);
+        buckets[s][0].push(t);
+    }
+    if a == b {
+        return ("met", 2, (0, 0));
+    }
+    let mut lim: [Option<u32>; 2] = [None, None];
+    RULE_TABLE.with(|table| {
+        let table = &table.borrow();
+        let mut up = vec![];
+        loop {
+            // the side to raise: both to level 0 first, then the smaller next level while the limits sum under budget
+            let s = match lim {
+                [None, _] => 0,
+                [_, None] => 1,
+                [Some(x), Some(y)] if x + y >= budget => return ("fail", dist[0].len() + dist[1].len(), (x, y)),
+                [Some(x), Some(y)] => (buckets[1][y as usize + 1].len() < buckets[0][x as usize + 1].len()) as usize,
+            };
+            let level = lim[s].map_or(0, |l| l + 1);
+            let other_lim = lim[1 - s];
+            while let Some(t) = buckets[s][level as usize].pop() {
+                if dist[s][&t] < level {
+                    continue;
+                }
+                let mut met = false;
+                let (mine, other) = if s == 0 { let (x, y) = dist.split_at_mut(1); (&mut x[0], &y[0]) } else { let (x, y) = dist.split_at_mut(1); (&mut y[0], &x[0]) };
+                let bs = &mut buckets[s];
+                join_walk(t, table, cap, &mut up, &mut None, &mut |up, x, eq, sub, cap| {
+                    let e = &table.join[eq];
+                    if ac && matches!(e.kind, LawKind::Assoc | LawKind::Comm | LawKind::Bitwise) {
+                        return true;
+                    }
+                    let (h, size) = subst_sig(&e.to, sub);
+                    if size > cap || h == x.sh() && is_subst(x, &e.to, sub) {
+                        return true;
+                    }
+                    let u = place(up, subst_pat(&e.to, sub));
+                    let u = if ac { ac_canon(u) } else { u };
+                    let c = level + (u.size() > t.size()) as u32;
+                    if c > budget {
+                        return true;
+                    }
+                    if let (Some(&d), Some(ol)) = (other.get(&u), other_lim) {
+                        if d <= ol && c + d <= budget {
+                            met = true;
+                            return false;
+                        }
+                    }
+                    if mine.get(&u).is_none_or(|&d| c < d) {
+                        mine.insert(u, c);
+                        bs[c as usize].push(u);
+                    }
+                    true
+                });
+                if met {
+                    return ("met", dist[0].len() + dist[1].len(), (lim[0].unwrap_or(0), lim[1].unwrap_or(0)));
+                }
+                if dist[0].len() + dist[1].len() > safety {
+                    return ("unknown", dist[0].len() + dist[1].len(), (lim[0].unwrap_or(0), lim[1].unwrap_or(0)));
+                }
+            }
+            lim[s] = Some(level);
+            // a term of this side's new level already reached by the other within its limit
+            if let Some(ol) = lim[1 - s] {
+                if dist[s].iter().any(|(t, &d)| d <= level && dist[1 - s].get(t).is_some_and(|&e| e <= ol && d + e <= budget)) {
+                    return ("met", dist[0].len() + dist[1].len(), (lim[0].unwrap(), lim[1].unwrap()));
+                }
+            }
+        }
+    })
+}
