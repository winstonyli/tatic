+/// PROBE: `t` with every `add`, `and`, `or`, `xor` chain flattened, its operands sorted (`Ord`) and nested to the right.
+fn ac_canon(t: Term) -> Term {
+    let Node::Op(o, a, b) = *t.node() else { return t };
+    let (a, b) = (ac_canon(a), ac_canon(b));
+    if ![ADD, AND, OR, XOR].contains(&o) {
+        return Term::op(o, a, b);
+    }
+    let mut xs = vec![];
+    for mut x in [a, b] {
+        while let Node::Op(p, l, r) = *x.node() {
+            if p != o {
+                break;
+            }
+            xs.push(l);
+            x = r;
+        }
+        xs.push(x);
+    }
+    xs.sort();
+    let last = xs.pop().unwrap();
+    xs.into_iter().rev().fold(last, |acc, x| Term::op(o, x, acc))
+}
