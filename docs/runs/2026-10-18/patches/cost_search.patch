+/// PROBE: `cost_join`'s search as the join itself (`JOIN_COST_BOUND=<budget>`): the plan of `a = b` along a path of at
+/// most `budget` size-increasing steps, or None (also past `JOIN_SAFETY` terms); traces as `join_search` does.
+fn cost_search(a: &Term, b: &Term, budget: u32, examined: &mut Option<hashbrown::HashSet<Term>>) -> Option<PlanRc> {
+    let (cap, safety, t0) = (a.size().max(b.size()) + 2, env_or("JOIN_SAFETY", 200_000usize), std::time::Instant::now());
+    type Seen = hashbrown::HashMap<Term, (u32, Option<JoinStep>)>;
+    let mut seen: [Seen; 2] = [Default::default(), Default::default()];
+    let mut buckets: [Vec<Vec<Term>>; 2] = [vec![vec![]; budget as usize + 2], vec![vec![]; budget as usize + 2]];
+    for (s, t) in [(0, *a), (1, *b)] {
+        seen[s].insert(t, (0, None));
+        buckets[s][0].push(t);
+    }
+    let path = |seen: &Seen, mut t: Term, table: &RuleTable, terms: &mut Vec<Term>| -> PlanRc {
+        let mut steps = vec![];
+        terms.push(t);
+        while let Some(step) = seen[&t].1 {
+            steps.push(step_plan(&step, table));
+            t = step.from;
+            terms.push(t);
+        }
+        steps.into_iter().rev().reduce(Plan::trans).unwrap_or_else(|| Plan::refl(&t))
+    };
+    let mut lim: [Option<u32>; 2] = [None, None];
+    let found = RULE_TABLE.with(|table| {
+        let table = &table.borrow();
+        let mut up = vec![];
+        // the plan through `x`, reached by both sides, or by side `s` from `t` by `step`
+        let finish = |seen: &[Seen; 2], meet: (Term, Option<(usize, Term, JoinStep)>), examined: &mut Option<hashbrown::HashSet<Term>>| -> PlanRc {
+            let mut terms = vec![];
+            let (pa, pb) = match meet.1 {
+                None => (path(&seen[0], meet.0, table, &mut terms), path(&seen[1], meet.0, table, &mut terms)),
+                Some((s, t, step)) => {
+                    let here = Plan::trans(path(&seen[s], t, table, &mut terms), step_plan(&step, table));
+                    let there = path(&seen[1 - s], meet.0, table, &mut terms);
+                    if s == 0 { (here, there) } else { (there, here) }
+                }
+            };
+            if let Some(x) = examined {
+                x.clear();
+                while let Some(q) = terms.pop() {
+                    if let (true, Node::Op(_, l, r)) = (x.insert(q), *q.node()) {
+                        terms.extend([l, r]);
+                    }
+                }
+            }
+            Plan::trans(pa, Plan::sym(pb))
+        };
+        if a == b {
+            return Some(finish(&seen, (*a, None), examined));
+        }
+        loop {
+            let s = match lim {
+                [None, _] => 0,
+                [_, None] => 1,
+                [Some(x), Some(y)] if x + y >= budget => return None,
+                [Some(x), Some(y)] => (buckets[1][y as usize + 1].len() < buckets[0][x as usize + 1].len()) as usize,
+            };
+            let level = lim[s].map_or(0, |l| l + 1);
+            let other_lim = lim[1 - s];
+            while let Some(t) = buckets[s][level as usize].pop() {
+                if seen[s][&t].0 < level {
+                    continue;
+                }
+                let mut met = None;
+                let (mine, other) = if s == 0 { let (x, y) = seen.split_at_mut(1); (&mut x[0], &y[0]) } else { let (x, y) = seen.split_at_mut(1); (&mut y[0], &x[0]) };
+                let bs = &mut buckets[s];
+                join_walk(t, table, cap, &mut up, examined, &mut |up, x, eq, sub, cap| {
+                    let e = &table.join[eq];
+                    let (h, size) = subst_sig(&e.to, sub);
+                    if size > cap || h == x.sh() && is_subst(x, &e.to, sub) {
+                        return true;
+                    }
+                    let u = place(up, subst_pat(&e.to, sub));
+                    let c = level + (u.size() > t.size()) as u32;
+                    if c > budget {
+                        return true;
+                    }
+                    let step = JoinStep { from: t, path: up.iter().rev().fold(0, |p, e| p << 1 | e.3 as u64), depth: up.len() as u8, eq: eq as u32 };
+                    if let (Some(&(d, _)), Some(ol)) = (other.get(&u), other_lim) {
+                        if d <= ol && c + d <= budget {
+                            met = Some((u, step));
+                            return false;
+                        }
+                    }
+                    if mine.get(&u).is_none_or(|&(d, _)| c < d) {
+                        mine.insert(u, (c, Some(step)));
+                        bs[c as usize].push(u);
+                    }
+                    true
+                });
+                if let Some((u, step)) = met {
+                    return Some(finish(&seen, (u, Some((s, t, step))), examined));
+                }
+                if seen[0].len() + seen[1].len() > safety {
+                    return None;
+                }
+            }
+            lim[s] = Some(level);
+            if let Some(ol) = lim[1 - s] {
+                let x = seen[s].iter().find(|&(t, &(d, _))| d <= level && seen[1 - s].get(t).is_some_and(|&(e, _)| e <= ol && d + e <= budget)).map(|(t, _)| *t);
+                if let Some(x) = x {
+                    return Some(finish(&seen, (x, None), examined));
+                }
+            }
+        }
+    });
+    let (reached, nanos) = ((seen[0].len() + seen[1].len()) as u64, t0.elapsed().as_nanos() as u64);
+    count_join(|c| {
+        (c.searches, c.reached, c.met, c.nanos) = (c.searches + 1, c.reached + reached, c.met + found.is_some() as u64, c.nanos + nanos);
+        c.failed_nanos += if found.is_some() { 0 } else { nanos };
+    });
+    found
+}
