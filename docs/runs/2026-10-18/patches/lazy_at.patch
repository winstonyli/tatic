+fn is_subst(t: Term, p: &Term, sub: &Sub) -> bool {
+    match (*p.node(), *t.node()) {
+        (Node::V(i), _) => sub[i] == Some(t),
+        (Node::Op(o, pa, pb), Node::Op(q, a, b)) => o == q && is_subst(a, &pa, sub) && is_subst(b, &pb, sub),
