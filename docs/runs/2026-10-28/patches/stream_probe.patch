+// ---- PROBE (throwaway, never committed): where a stream's pool, grouping time and open-law filter go.
+
+/// Adds every term of `roots`, and every subterm of them, to `seen` (what a `ValueMemo` fills for `roots`).
+fn probe_closure(roots: &[Term], seen: &mut HashSet<Term>) {
+    fn go(t: Term, seen: &mut HashSet<Term>) {
+        if seen.insert(t) {
+            if let Node::Op(_, a, b) = *t.node() {
+                go(a, seen);
+                go(b, seen);
+            }
+        }
+    }
+    for t in roots {
+        go(*t, seen);
+    }
+}
