+/// Is a stream's 2-growth build the 4-growth build restricted? Per stream (salt 1): the 2-growth pool is a prefix of the
+/// 4-growth pool's order, and the 2-growth laws are, in order, the 4-growth laws with both sides in the 2-growth pool.
+#[test]
+#[ignore]
+pub fn stream_probe_nested() {
+    let deep = crate::classes::held_levels(crate::classes::HELD_BANDS.into_iter().max().unwrap());
+    std::thread::Builder::new()
+        .stack_size(256 << 20)
+        .spawn(move || {
+            let (sets, picks) = (stream_sets(), probe_picks());
+            crate::classes::Classes::get();
+            let (mut both, mut n) = (0usize, 0usize);
+            for ops in &sets {
+                let name = ops.iter().map(|o| OP_INFO[*o].name).collect::<Vec<_>>().join(",");
+                let (_, o2, _, _, t2) = stream_probe(ops, 1, STREAM_BUDGET, STREAM_LEVELS, &picks);
+                let (_, o4, _, _, t4) = stream_probe(ops, 1, STREAM_BUDGET, deep, &picks);
+                let in2: HashSet<Term> = t2.iter().copied().collect();
+                let prefix = t4.len() >= t2.len() && t4[..t2.len()] == t2[..];
+                let derived: Vec<(Term, Term)> = o4.iter().filter(|(a, b)| in2.contains(a) && in2.contains(b)).copied().collect();
+                let same = derived == o2;
+                println!("NESTED {name}: pool2 {} pool4 {} prefix {prefix}; laws2 {} laws4 {} laws4 within pool2 {} equal {same}", t2.len(), t4.len(), o2.len(), o4.len(), derived.len());
+                n += 1;
+                both += (prefix && same) as usize;
+            }
+            println!("NESTED {both} of {n} streams have the 2-growth pool as a prefix and the 2-growth laws as the 4-growth laws within it");
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
