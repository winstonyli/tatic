+/// The probe: salt 1, the loops' growth count and the extras' (the deepest held band's), every stream, one thread.
+/// `PROBE_LEVELS` (comma list) and `PROBE_STREAMS` (first n streams) narrow it.
+#[test]
+#[ignore]
+pub fn stream_group_probe() {
+    let deep = crate::classes::held_levels(crate::classes::HELD_BANDS.into_iter().max().unwrap());
+    let levels: Vec<usize> = std::env::var("PROBE_LEVELS").map_or_else(|_| vec![STREAM_LEVELS, deep], |s| s.split(',').map(|x| x.parse().unwrap()).collect());
+    let limit: usize = std::env::var("PROBE_STREAMS").ok().map_or(usize::MAX, |s| s.parse().unwrap());
+    println!("PROBE growths {levels:?} (STREAM_LEVELS {STREAM_LEVELS}, deepest held band {deep}), salt 1, budget {STREAM_BUDGET}, streams {}", limit.min(stream_sets().len()));
+    std::thread::Builder::new().stack_size(256 << 20).spawn(move || run_probe(levels, 1, limit)).unwrap().join().unwrap();
+}
