+/// Seconds since the last `lap`.
+struct ProbeLap(std::time::Instant);
+
+impl ProbeLap {
+    fn lap(&mut self) -> f64 {
+        let now = std::time::Instant::now();
+        let d = now.duration_since(self.0).as_secs_f64();
+        self.0 = now;
+        d
+    }
+}
+
+/// A fixed shuffle of the 4096 input indices (Fisher-Yates driven by `mix64`): the first K are the K inputs of a
+/// prefilter, so the sets nest (16 in 64 in 256). Input `i` of `ValueMemo::exhaustive(4, 3)` has variable `v` = bits
+/// `4v..4v+4` of `i`.
+fn probe_picks() -> Vec<usize> {
+    let mut v: Vec<usize> = (0..4096).collect();
+    for i in (1..4096usize).rev() {
+        let j = (tatic::rng::mix64(0x5eed_0000 + i as u64) % (i as u64 + 1)) as usize;
+        v.swap(i, j);
+    }
+    v
+}
+
+/// `pool_conjectures`' grouping in two stages: terms bucketed by their values on the first `k` of `picks` (and the
+/// comparison flag), then only the terms in buckets of more than one are given full 4096-input vectors and grouped.
+/// Returns (survivors, distinct terms the full memo fills, stage 1 seconds, stage 2 seconds, conjectures unsorted).
+fn probe_two_stage(terms: &[Term], picks: &[usize], k: usize) -> (usize, usize, f64, f64, Vec<(Term, Term)>) {
+    let t0 = std::time::Instant::now();
+    let vars: Vec<Box<[u8]>> = (0..3).map(|v| picks[..k].iter().map(|&i| (i >> (4 * v) & 15) as u8).collect()).collect();
+    let mut small = ValueMemo::new(4, k, vars);
+    let mut buckets: hashbrown::HashMap<Vec<u8>, Vec<usize>> = Default::default();
+    for (i, t) in terms.iter().enumerate() {
+        let mut key = small.values(t).to_vec();
+        key.push(matches!(*t.node(), Node::Op(LT, ..)) as u8);
+        buckets.entry(key).or_default().push(i);
+    }
+    let mut survivors: Vec<usize> = buckets.values().filter(|b| b.len() > 1).flatten().copied().collect();
+    survivors.sort_unstable();
+    let t1 = t0.elapsed().as_secs_f64();
+    drop(buckets);
+    drop(small);
+    let t0 = std::time::Instant::now();
+    let mut memo = ValueMemo::exhaustive(4, 3);
+    let mut groups: hashbrown::HashMap<Vec<u8>, Vec<Term>> = Default::default();
+    for &i in &survivors {
+        let t = terms[i];
+        let mut key = memo.values(&t).to_vec();
+        key.push(matches!(*t.node(), Node::Op(LT, ..)) as u8);
+        groups.entry(key).or_default().push(t);
+    }
+    let conj: Vec<(Term, Term)> = groups.values().filter(|g| g.len() > 1).flat_map(|g| g[1..].iter().map(|t2| (g[0], *t2))).collect();
+    (survivors.len(), memo.filled(), t1, t0.elapsed().as_secs_f64(), conj)
+}
+
+/// `stream_laws(ops, salt, budget, levels)` again, with counts and timers: the same steps in the same order (a copy of
+/// its body, `pool_conjectures` inlined); returns its stats, its laws, and the closures of the width-4 pool memo and of
+/// the width-8 memo (terms with a vector in each), and the pool in `pool_conjectures` order.
+fn stream_probe(ops: &[usize], salt: usize, budget: usize, levels: usize, picks: &[usize]) -> (ProbeStats, Vec<(Term, Term)>, Vec<Term>, Vec<Term>, Vec<Term>) {
+    let mut s = ProbeStats::default();
+    let mut lap = ProbeLap(std::time::Instant::now());
+    let c = crate::classes::Classes::get();
+    fn within(t: Term, ops: &[usize]) -> bool {
+        match *t.node() {
+            Node::Op(o, a, b) => ops.contains(&o) && within(a, ops) && within(b, ops),
+            _ => true,
+        }
+    }
+    let mut seeds: Vec<Term> = c.reps().filter(|t| within(*t, ops)).collect();
+    seeds.sort_by_cached_key(|t| t.show());
+    fn ops_of(t: Term, out: &mut std::collections::BTreeSet<usize>) {
+        if let Node::Op(o, a, b) = *t.node() {
+            out.insert(o);
+            ops_of(a, out);
+            ops_of(b, out);
+        }
+    }
+    fn leaf_count(t: Term) -> usize {
+        match *t.node() {
+            Node::Op(SHL1 | SHR1, a, _) => leaf_count(a),
+            Node::Op(_, a, b) => leaf_count(a) + leaf_count(b),
+            _ => 1,
+        }
+    }
+    fn replaced(t: Term, k: &mut Option<usize>, g: Term) -> Term {
+        match *t.node() {
+            Node::Op(o @ (SHL1 | SHR1), a, b) => Term::op(o, replaced(a, k, g), b),
+            Node::Op(o, a, b) => {
+                let a = replaced(a, k, g);
+                Term::op(o, a, replaced(b, k, g))
+            }
+            _ => match *k {
+                Some(0) => {
+                    *k = None;
+                    g
+                }
+                Some(i) => {
+                    *k = Some(i - 1);
+                    t
+                }
+                None => t,
+            },
+        }
+    }
+    let mut grown_ops = std::collections::BTreeSet::new();
+    seeds.iter().for_each(|t| ops_of(*t, &mut grown_ops));
+    let leaves = &leaves3();
+    let mut memo = ValueMemo::exhaustive(4, 3);
+    let leaf_values: Vec<Vec<u8>> = leaves.iter().map(|l| memo.values(l).to_vec()).collect();
+    s.add("t_setup", lap.lap());
+    let grow: Vec<Term> = grown_ops
+        .iter()
+        .flat_map(|&o| if o == SHL1 || o == SHR1 { leaves.iter().map(|a| mk(o, a, &Term::ZERO)).collect::<Vec<_>>() } else { leaves.iter().flat_map(|a| leaves.iter().map(move |b| mk(o, a, b))).collect() })
+        .filter(|g| !leaf_values.contains(&memo.values(g).to_vec()))
+        .collect();
+    s.add("t_grow", lap.lap());
+    let mut level: hashbrown::HashMap<Term, usize> = seeds.iter().map(|t| (*t, 0)).collect();
+    let (mut base, mut i) = (seeds.clone(), 0u64);
+    for l in 1..=levels {
+        let total: usize = base.iter().map(|t| leaf_count(*t)).sum::<usize>() * grow.len();
+        let mut next = vec![];
+        for t in &base {
+            for p in 0..leaf_count(*t) {
+                for g in &grow {
+                    i += 1;
+                    if (tatic::rng::mix64(i ^ tatic::rng::mix64(salt as u64 + 13 * l as u64)) % total.max(1) as u64) < budget as u64 {
+                        let w = replaced(*t, &mut Some(p), *g);
+                        if !level.contains_key(&w) {
+                            level.insert(w, l);
+                            next.push(w);
+                        }
+                    }
+                }
+            }
+        }
+        base = next;
+    }
+    s.add("t_growth", lap.lap());
+    let mut terms: Vec<Term> = level.keys().cloned().collect();
+    terms.sort_by_cached_key(|t| (level[t], t.show()));
+    s.add("t_sort", lap.lap());
+    s.add("seeds", seeds.len() as f64);
+    s.add("pool", terms.len() as f64);
+    // pool_conjectures(terms, 4, 3, 0), inlined
+    let (conj, pool_closure) = {
+        let mut pm = ValueMemo::exhaustive(4, 3);
+        let mut groups: hashbrown::HashMap<Vec<u8>, Vec<Term>> = Default::default();
+        let (mut t_fill, mut t_key, mut t_ins) = (0.0, 0.0, 0.0);
+        lap.lap();
+        for t in &terms {
+            let v = pm.values(t);
+            t_fill += lap.lap();
+            let mut key = v.to_vec();
+            key.push(matches!(*t.node(), Node::Op(LT, ..)) as u8);
+            t_key += lap.lap();
+            groups.entry(key).or_default().push(*t);
+            t_ins += lap.lap();
+        }
+        s.add("t_fill", t_fill);
+        s.add("t_key", t_key);
+        s.add("t_ins", t_ins);
+        let mut cl = HashSet::new();
+        probe_closure(&terms, &mut cl);
+        assert_eq!(cl.len(), pm.filled(), "the pool's closure is what the memo filled");
+        s.add("filled", pm.filled() as f64);
+        s.add("groups", groups.len() as f64);
+        s.add("multi", groups.values().filter(|g| g.len() > 1).count() as f64);
+        s.add("in_multi", groups.values().filter(|g| g.len() > 1).map(|g| g.len()).sum::<usize>() as f64);
+        lap.lap();
+        let mut conj: Vec<(Term, Term)> = groups.values().filter(|g| g.len() > 1).flat_map(|g| g[1..].iter().map(|t2| (g[0], *t2))).collect();
+        conj.sort_by_cached_key(|(a, b)| (a.show(), b.show()));
+        s.add("t_conj", lap.lap());
+        (conj, cl.into_iter().collect::<Vec<Term>>())
+    };
+    s.add("conj", conj.len() as f64);
+    // the two-stage grouping, for each prefilter size: same conjectures as the single stage
+    let base_set: HashSet<(Term, Term)> = conj.iter().copied().collect();
+    for k in [16usize, 64, 256] {
+        let (surv, filled, t1, t2, c2) = probe_two_stage(&terms, picks, k);
+        assert!(c2.len() == conj.len() && c2.iter().all(|p| base_set.contains(p)), "two-stage K={k} gives other conjectures than pool_conjectures");
+        s.add(&format!("pre{k}_terms"), surv as f64);
+        s.add(&format!("pre{k}_filled"), filled as f64);
+        s.add(&format!("t_pre{k}a"), t1);
+        s.add(&format!("t_pre{k}b"), t2);
+    }
+    drop(base_set);
+    lap.lap();
+    let laws: Vec<(Term, Term)> = conj.into_iter().filter(|(a, b)| level[a].max(level[b]) > 0 && (0..3).all(|v| a.has_var(v) || b.has_var(v))).collect();
+    s.add("grown", laws.len() as f64);
+    s.add("t_post", lap.lap());
+    let job = &mut Job::new(Setup::process());
+    let mut r8 = width8();
+    s.add("t_osetup", lap.lap());
+    let laws = shuffled(laws, salt);
+    s.add("t_shuf", lap.lap());
+    let (mut out, mut refuted, mut open) = (vec![], 0usize, 0usize);
+    let (mut t_norm, mut t_r8) = (0.0, 0.0);
+    let mut r8_roots: Vec<Term> = vec![];
+    tatic::kernel::scoped(|| {
+        lap.lap();
+        for (a, b) in laws {
+            let same = c.normalize(job, 4, 3, &a).0 == c.normalize(job, 4, 3, &b).0;
+            t_norm += lap.lap();
+            if same {
+                continue;
+            }
+            open += 1;
+            r8_roots.extend([a, b]);
+            let va = r8.values(&a).to_vec();
+            let differ = va != r8.values(&b);
+            t_r8 += lap.lap();
+            if differ {
+                refuted += 1;
+                continue;
+            }
+            out.push((a, b));
+        }
+    });
+    s.add("t_norm", t_norm);
+    s.add("t_r8", t_r8);
+    s.add("open", open as f64);
+    s.add("refuted", refuted as f64);
+    s.add("out", out.len() as f64);
+    let mut r8cl = HashSet::new();
+    probe_closure(&r8_roots, &mut r8cl);
+    assert_eq!(r8cl.len(), r8.filled(), "the width-8 memo's closure");
+    s.add("r8_filled", r8.filled() as f64);
+    let pipe: f64 = ["t_setup", "t_grow", "t_growth", "t_sort", "t_fill", "t_key", "t_ins", "t_conj", "t_post", "t_osetup", "t_shuf", "t_norm", "t_r8"].iter().map(|k| s.get(k)).sum();
+    s.add("t_pipe", pipe);
+    (s, out, pool_closure, r8cl.into_iter().collect(), terms)
+}
+
+/// Per-stream table rows: the totals, then the five largest pools.
+fn probe_table(title: &str, cols: &[String], rows: &[(String, ProbeStats)]) {
+    let fmt = |c: &str, v: f64| if c.starts_with("t_") { format!("{v:.2}") } else { format!("{v:.0}") };
+    println!("TABLE {title}");
+    println!("{:<14}{}", "stream", cols.iter().map(|c| format!("{c:>12}")).collect::<String>());
+    let total: Vec<f64> = cols.iter().map(|c| rows.iter().map(|(_, s)| s.get(c)).sum()).collect();
+    println!("{:<14}{}", "TOTAL", cols.iter().zip(&total).map(|(c, v)| format!("{:>12}", fmt(c, *v))).collect::<String>());
+    let mut order: Vec<usize> = (0..rows.len()).collect();
+    order.sort_by(|&a, &b| rows[b].1.get("pool").total_cmp(&rows[a].1.get("pool")));
+    for &i in order.iter().take(5) {
+        println!("{:<14}{}", rows[i].0, cols.iter().map(|c| format!("{:>12}", fmt(c, rows[i].1.get(c)))).collect::<String>());
+    }
+}
+
+/// The terms of `per_stream` by how many streams hold them; prints what one memo over all of them would save.
+fn probe_cross(label: &str, per_stream: &[Vec<Term>]) -> hashbrown::HashMap<Term, u16> {
+    let mut m: hashbrown::HashMap<Term, u16> = Default::default();
+    for v in per_stream {
+        for t in v {
+            *m.entry(*t).or_default() += 1;
+        }
+    }
+    let sum: usize = per_stream.iter().map(Vec::len).sum();
+    let mut hist = [0usize; 5];
+    for &n in m.values() {
+        hist[match n {
+            1 => 0,
+            2..=4 => 1,
+            5..=9 => 2,
+            10..=19 => 3,
+            _ => 4,
+        }] += 1;
+    }
+    println!(
+        "CROSS {label}: {} streams, sum of per-stream fills {sum}, distinct terms {} ({:.1}% of the fills are repeats), a 4096-byte vector each: {:.2} GB; distinct terms held by 1 / 2-4 / 5-9 / 10-19 / 20+ streams: {hist:?}",
+        per_stream.len(),
+        m.len(),
+        100.0 * (sum - m.len()) as f64 / sum.max(1) as f64,
+        m.len() as f64 * 4096.0 / 1e9
+    );
+    m
+}
