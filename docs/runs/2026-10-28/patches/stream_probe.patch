+/// Named numbers of one stream (counts, seconds), in the order first added.
+#[derive(Default)]
+struct ProbeStats(Vec<(String, f64)>);
+
+impl ProbeStats {
+    fn add(&mut self, k: &str, v: f64) {
+        match self.0.iter_mut().find(|(n, _)| n == k) {
+            Some(e) => e.1 += v,
+            None => self.0.push((k.to_string(), v)),
+        }
+    }
+    fn get(&self, k: &str) -> f64 {
+        self.0.iter().find(|(n, _)| n == k).map_or(0.0, |e| e.1)
+    }
+    fn line(&self) -> String {
+        self.0.iter().map(|(k, v)| if k.starts_with("t_") { format!("{k}={v:.3}") } else { format!("{k}={v:.0}") }).collect::<Vec<_>>().join(" ")
+    }
+}
