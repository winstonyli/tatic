+/// Does the instrumented copy cost what the real function does? Every `PROBE_STRIDE`-th stream (default 4), at the
+/// growth counts of `PROBE_LEVELS` (default as `stream_group_probe`): the real `stream_laws`, the probe, the real again,
+/// the probe again; seconds of each (the probe's `t_pipe`, which leaves out its two-stage analysis).
+#[test]
+#[ignore]
+pub fn stream_probe_overhead() {
+    let deep = crate::classes::held_levels(crate::classes::HELD_BANDS.into_iter().max().unwrap());
+    let levels: Vec<usize> = std::env::var("PROBE_LEVELS").map_or_else(|_| vec![STREAM_LEVELS, deep], |s| s.split(',').map(|x| x.parse().unwrap()).collect());
+    let stride: usize = std::env::var("PROBE_STRIDE").ok().map_or(4, |s| s.parse().unwrap());
+    std::thread::Builder::new()
+        .stack_size(256 << 20)
+        .spawn(move || {
+            let (sets, picks) = (stream_sets(), probe_picks());
+            crate::classes::Classes::get();
+            for levels in levels {
+                let mut tot = [0.0f64; 6];
+                for (i, ops) in sets.iter().enumerate().step_by(stride) {
+                    let name = ops.iter().map(|o| OP_INFO[*o].name).collect::<Vec<_>>().join(",");
+                    let t = std::time::Instant::now();
+                    let r1 = stream_laws(ops, 1, STREAM_BUDGET, levels);
+                    let a = t.elapsed().as_secs_f64();
+                    let (s1, o1, _, _, _) = stream_probe(ops, 1, STREAM_BUDGET, levels, &picks);
+                    let t = std::time::Instant::now();
+                    let r2 = stream_laws(ops, 1, STREAM_BUDGET, levels);
+                    let c = t.elapsed().as_secs_f64();
+                    let (s2, o2, _, _, _) = stream_probe(ops, 1, STREAM_BUDGET, levels, &picks);
+                    assert!(r1 == o1 && r2 == o2 && r1 == r2, "stream {i} {name}");
+                    let row = [a, s1.get("t_pipe"), c, s2.get("t_pipe"), s1.get("t_norm"), s2.get("t_norm")];
+                    println!("CHECK L={levels} {name} real1={:.3} probe1={:.3} real2={:.3} probe2={:.3} norm1={:.3} norm2={:.3}", row[0], row[1], row[2], row[3], row[4], row[5]);
+                    tot.iter_mut().zip(row).for_each(|(t, r)| *t += r);
+                }
+                println!("CHECK L={levels} TOTAL real1={:.2} probe1={:.2} real2={:.2} probe2={:.2} norm1={:.2} norm2={:.2}", tot[0], tot[1], tot[2], tot[3], tot[4], tot[5]);
+            }
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
