+fn run_probe(levels_list: Vec<usize>, salt: usize, limit: usize) {
+    let sets = stream_sets();
+    let picks = probe_picks();
+    println!("PROBE picks: first 16 of the fixed shuffle: {:?}", &picks[..16]);
+    // the class table is built at first use and shared by the whole process: keep it out of the first stream's setup time
+    crate::classes::Classes::get();
+    let (mut all_pool, mut all_pool_sum) = (HashSet::new(), 0usize);
+    for &levels in &levels_list {
+        let mut rows: Vec<(String, ProbeStats)> = vec![];
+        let (mut pool_cl, mut r8_cl) = (vec![], vec![]);
+        for ops in sets.iter().take(limit) {
+            let name = ops.iter().map(|o| OP_INFO[*o].name).collect::<Vec<_>>().join(",");
+            let (mut s, out, pc, rc, _) = stream_probe(ops, salt, STREAM_BUDGET, levels, &picks);
+            let t = std::time::Instant::now();
+            let real = stream_laws(ops, salt, STREAM_BUDGET, levels);
+            s.add("t_real", t.elapsed().as_secs_f64());
+            assert!(real == out, "stream {name} (growths {levels}): the probe's laws differ from stream_laws'");
+            println!("PROBE L={levels} {name} {}", s.line());
+            rows.push((name, s));
+            pool_cl.push(pc);
+            r8_cl.push(rc);
+        }
+        println!("PROBE growths {levels}: all {} streams' laws equal stream_laws'", rows.len());
+        let names = |v: &[&str]| v.iter().map(|x| x.to_string()).collect::<Vec<String>>();
+        probe_table(&format!("growths {levels}: counts"), &names(&["seeds", "pool", "filled", "groups", "multi", "in_multi", "conj", "grown", "open", "refuted", "out", "r8_filled"]), &rows);
+        let pre: Vec<String> = [16, 64, 256].iter().flat_map(|k| [format!("pre{k}_terms"), format!("pre{k}_filled")]).chain(["in_multi".to_string(), "filled".to_string()]).collect();
+        probe_table(&format!("growths {levels}: prefilter (terms still needing full vectors, distinct terms those fill; in_multi and filled are the floor and the baseline)"), &pre, &rows);
+        let times: Vec<String> = ["t_setup", "t_grow", "t_growth", "t_sort", "t_fill", "t_key", "t_ins", "t_conj", "t_post", "t_osetup", "t_shuf", "t_norm", "t_r8", "t_pipe", "t_real"].iter().map(|x| x.to_string()).collect();
+        probe_table(&format!("growths {levels}: seconds, one thread"), &times, &rows);
+        let pre_t: Vec<String> = [16, 64, 256].iter().flat_map(|k| [format!("t_pre{k}a"), format!("t_pre{k}b")]).chain(["t_fill".to_string(), "t_key".to_string(), "t_ins".to_string()]).collect();
+        probe_table(&format!("growths {levels}: seconds of the two-stage grouping (stage a, b) against the single stage's fill, key, insert"), &pre_t, &rows);
+        let p = probe_cross(&format!("growths {levels}, width-4 pool memos"), &pool_cl);
+        probe_cross(&format!("growths {levels}, width-8 memos"), &r8_cl);
+        all_pool_sum += pool_cl.iter().map(Vec::len).sum::<usize>();
+        all_pool.extend(p.keys().copied());
+    }
+    println!(
+        "CROSS all growth counts {levels_list:?}, width-4 pool memos: sum of every build's fills {all_pool_sum}, distinct terms {} ({:.1}% repeats), {:.2} GB at 4096 bytes each",
+        all_pool.len(),
+        100.0 * (all_pool_sum - all_pool.len()) as f64 / all_pool_sum.max(1) as f64,
+        all_pool.len() as f64 * 4096.0 / 1e9
+    );
+}
