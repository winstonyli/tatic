+pub mod nprobe {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+    macro_rules! counters {
+        ($($n:ident),* $(,)?) => {
+            #[allow(non_camel_case_types)]
+            #[derive(Clone, Copy)]
+            pub enum K { $($n),* }
+            pub const NAMES: &[&str] = &[$(stringify!($n)),*];
+        };
