+/// Builds the streams one after another on one thread, as `stream_group_probe` did, with `Classes::normalize`'s counters
+/// (`classes::nprobe`) read around each build: pass 1 is the cold one (each stream after the builds before it), pass 2 and
+/// later repeat the same builds. Env: `PROBE_LEVELS` (comma list; default the loops' and the extras' growths),
+/// `PROBE_PASSES` (2), `PROBE_SALTS` (1), `PROBE_STREAMS_IDX` (comma list of stream indices; default all 56),
+/// `PROBE_TWICE=1` (each build is followed at once by a repeat, printed as pass 0), `PROBE_O=1` (also count, per build,
+/// which earlier build first asked each distinct term; slows the hit path, so no timings from it),
+/// `PROBE_MEM_CAP_GB` (12; the test stops when its private bytes pass it).
+#[test]
+#[ignore]
+pub fn normalize_cold_probe() {
+    use crate::classes::nprobe as np;
+    let deep = crate::classes::held_levels(crate::classes::HELD_BANDS.into_iter().max().unwrap());
+    let list = |k: &str, d: Vec<usize>| std::env::var(k).map_or(d.clone(), |s| s.split(',').map(|x| x.parse().unwrap()).collect::<Vec<usize>>());
+    let levels = list("PROBE_LEVELS", vec![STREAM_LEVELS, deep]);
+    let salts = list("PROBE_SALTS", vec![1]);
+    let only: Option<Vec<usize>> = std::env::var("PROBE_STREAMS_IDX").ok().map(|s| s.split(',').map(|x| x.parse().unwrap()).collect());
+    let passes: usize = std::env::var("PROBE_PASSES").ok().map_or(2, |s| s.parse().unwrap());
+    let twice = std::env::var("PROBE_TWICE").is_ok_and(|s| s == "1");
+    let omode = std::env::var("PROBE_O").is_ok_and(|s| s == "1");
+    let cap: f64 = std::env::var("PROBE_MEM_CAP_GB").ok().map_or(12.0, |s| s.parse().unwrap());
+    std::thread::Builder::new()
+        .stack_size(256 << 20)
+        .spawn(move || {
+            let sets = stream_sets();
+            crate::classes::Classes::get();
+            np::O_ON.store(omode, std::sync::atomic::Ordering::Relaxed);
+            println!("NP config levels {levels:?} salts {salts:?} passes {passes} twice {twice} omode {omode} streams {:?} cap {cap} GB", only);
+            let (tsc0, clock0) = (np::tsc(), std::time::Instant::now());
+            let mut first: std::collections::HashMap<(usize, usize, usize), (usize, u64)> = Default::default();
+            let mut build = |pass: usize, salt: usize, lv: usize, i: usize, ops: &Vec<usize>| -> bool {
+                let name = ops.iter().map(|o| OP_INFO[*o].name).collect::<Vec<_>>().join(",");
+                np::begin(i, lv, salt);
+                let (pf0, _, _) = probe_mem();
+                let s0 = np::snap();
+                let t = std::time::Instant::now();
+                let laws = stream_laws(ops, salt, STREAM_BUDGET, lv);
+                let secs = t.elapsed().as_secs_f64();
+                let s1 = np::snap();
+                let (pf1, private, ws) = probe_mem();
+                let fnv = laws.iter().fold(0xcbf2_9ce4_8422_2325u64, |h, (a, b)| format!("{} = {}", a.show(), b.show()).bytes().fold(h, |h, c| (h ^ c as u64).wrapping_mul(0x100_0000_01b3)));
+                let same = *first.entry((salt, lv, i)).or_insert((laws.len(), fnv)) == (laws.len(), fnv);
+                let d: Vec<String> = np::NAMES.iter().enumerate().filter(|(j, _)| s1[*j] != s0[*j]).map(|(j, n)| format!("{n}={}", s1[j] - s0[j])).collect();
+                println!("NP pass={pass} salt={salt} L={lv} i={i} ops={name} laws={} same={same} secs={secs:.3} pf={} private_mb={} ws_mb={} {}", laws.len(), pf1 - pf0, private >> 20, ws >> 20, d.join(" "));
+                assert!(same, "stream {name} gave other laws the second time");
+                if private as f64 > cap * 1e9 {
+                    println!("NP ABORT: private bytes {} MB past the cap", private >> 20);
+                    return false;
+                }
+                true
+            };
+            'all: for pass in 1..=passes {
+                for &salt in &salts {
+                    for &lv in &levels {
+                        for (i, ops) in sets.iter().enumerate() {
+                            if only.as_ref().is_some_and(|o| !o.contains(&i)) {
+                                continue;
+                            }
+                            if !build(pass, salt, lv, i, ops) || (twice && !build(0, salt, lv, i, ops)) {
+                                break 'all;
+                            }
+                        }
+                    }
+                }
+            }
+            let hz = (np::tsc() - tsc0) as f64 / clock0.elapsed().as_secs_f64();
+            println!("NP HZ {hz:.0}");
+            println!("NP memo_len {:?}", crate::classes::Classes::memo_len());
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
