+// ---- PROBE (throwaway, never committed): why a stream's `Classes::normalize` costs more the first time (docs/tier-cycle.md,
+// "Grouping the streams' terms, and the 2-growth build inside the 4-growth one").
+
+/// The process's memory counters (kernel32): page faults so far, private bytes, working set.
+fn probe_mem() -> (u32, usize, usize) {
+    #[repr(C)]
+    struct Counters {
+        cb: u32,
+        page_faults: u32,
+        peak_ws: usize,
+        ws: usize,
+        quota: [usize; 4],
+        pagefile: usize,
+        peak_pagefile: usize,
+        private: usize,
+    }
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn GetCurrentProcess() -> isize;
+        fn K32GetProcessMemoryInfo(h: isize, c: *mut Counters, cb: u32) -> i32;
+    }
+    let mut c = Counters { cb: std::mem::size_of::<Counters>() as u32, page_faults: 0, peak_ws: 0, ws: 0, quota: [0; 4], pagefile: 0, peak_pagefile: 0, private: 0 };
+    // SAFETY: `c` is a `PROCESS_MEMORY_COUNTERS_EX` of the size passed
+    let ok = unsafe { K32GetProcessMemoryInfo(GetCurrentProcess(), &mut c, c.cb) };
+    assert!(ok != 0, "GetProcessMemoryInfo failed");
+    (c.page_faults, c.private, c.ws)
+}
