+    pub static O_ON: AtomicBool = AtomicBool::new(false);
+    thread_local! {
+        static ORIGIN: std::cell::RefCell<hashbrown::HashMap<Term, u32>> = Default::default();
+        static SEEN: std::cell::RefCell<hashbrown::HashSet<Term>> = Default::default();
+        static SEEN_ORIG: std::cell::RefCell<hashbrown::HashSet<Term>> = Default::default();
+        static CUR: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+        static BUILDS: std::cell::RefCell<Vec<(usize, usize, usize)>> = Default::default();
+    }
