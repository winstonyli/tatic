+    }
+    s.add("t_growth", lap.lap());
+    let mut terms: Vec<Term> = level.keys().cloned().collect();
+    terms.sort_by_cached_key(|t| (level[t], t.show()));
+    s.add("t_sort", lap.lap());
+    s.add("seeds", seeds.len() as f64);
+    s.add("pool", terms.len() as f64);
+    // pool_conjectures(terms, 4, 3, 0), inlined
+    let (conj, pool_closure) = {
+        let mut pm = ValueMemo::exhaustive(4, 3);
+        let mut groups: hashbrown::HashMap<Vec<u8>, Vec<Term>> = Default::default();
+        let (mut t_fill, mut t_key, mut t_ins) = (0.0, 0.0, 0.0);
+        lap.lap();
+        for t in &terms {
+            let v = pm.values(t);
+            t_fill += lap.lap();
+            let mut key = v.to_vec();
+            key.push(matches!(*t.node(), Node::Op(LT, ..)) as u8);
+            t_key += lap.lap();
+            groups.entry(key).or_default().push(*t);
+            t_ins += lap.lap();
+        }
+        s.add("t_fill", t_fill);
+        s.add("t_key", t_key);
+        s.add("t_ins", t_ins);
+        let mut cl = HashSet::new();
+        probe_closure(&terms, &mut cl);
+        assert_eq!(cl.len(), pm.filled(), "the pool's closure is what the memo filled");
+        s.add("filled", pm.filled() as f64);
+        s.add("groups", groups.len() as f64);
+        s.add("multi", groups.values().filter(|g| g.len() > 1).count() as f64);
+        s.add("in_multi", groups.values().filter(|g| g.len() > 1).map(|g| g.len()).sum::<usize>() as f64);
+        lap.lap();
+        let mut conj: Vec<(Term, Term)> = groups.values().filter(|g| g.len() > 1).flat_map(|g| g[1..].iter().map(|t2| (g[0], *t2))).collect();
+        conj.sort_by_cached_key(|(a, b)| (a.show(), b.show()));
+        s.add("t_conj", lap.lap());
+        (conj, cl.into_iter().collect::<Vec<Term>>())
+    };
+    s.add("conj", conj.len() as f64);
+    // the two-stage grouping, for each prefilter size: same conjectures as the single stage
+    let base_set: HashSet<(Term, Term)> = conj.iter().copied().collect();
+    for k in [16usize, 64, 256] {
+        let (surv, filled, t1, t2, c2) = probe_two_stage(&terms, picks, k);
+        assert!(c2.len() == conj.len() && c2.iter().all(|p| base_set.contains(p)), "two-stage K={k} gives other conjectures than pool_conjectures");
+        s.add(&format!("pre{k}_terms"), surv as f64);
+        s.add(&format!("pre{k}_filled"), filled as f64);
+        s.add(&format!("t_pre{k}a"), t1);
+        s.add(&format!("t_pre{k}b"), t2);
+    }
+    drop(base_set);
+    lap.lap();
+    let laws: Vec<(Term, Term)> = conj.into_iter().filter(|(a, b)| level[a].max(level[b]) > 0 && (0..3).all(|v| a.has_var(v) || b.has_var(v))).collect();
+    s.add("grown", laws.len() as f64);
+    s.add("t_post", lap.lap());
+    let job = &mut Job::new(Setup::process());
+    let mut r8 = width8();
+    s.add("t_osetup", lap.lap());
+    let laws = shuffled(laws, salt);
+    s.add("t_shuf", lap.lap());
+    let (mut out, mut refuted, mut open) = (vec![], 0usize, 0usize);
+    let (mut t_norm, mut t_r8) = (0.0, 0.0);
+    let mut r8_roots: Vec<Term> = vec![];
+    tatic::kernel::scoped(|| {
+        lap.lap();
+        for (a, b) in laws {
+            let same = c.normalize(job, 4, 3, &a).0 == c.normalize(job, 4, 3, &b).0;
+            t_norm += lap.lap();
+            if same {
+                continue;
+            }
+            open += 1;
+            r8_roots.extend([a, b]);
+            let va = r8.values(&a).to_vec();
+            let differ = va != r8.values(&b);
+            t_r8 += lap.lap();
+            if differ {
+                refuted += 1;
+                continue;
+            }
+            out.push((a, b));
+        }
+    });
+    s.add("t_norm", t_norm);
+    s.add("t_r8", t_r8);
+    s.add("open", open as f64);
+    s.add("refuted", refuted as f64);
+    s.add("out", out.len() as f64);
+    let mut r8cl = HashSet::new();
+    probe_closure(&r8_roots, &mut r8cl);
+    assert_eq!(r8cl.len(), r8.filled(), "the width-8 memo's closure");
+    s.add("r8_filled", r8.filled() as f64);
+    let pipe: f64 = ["t_setup", "t_grow", "t_growth", "t_sort", "t_fill", "t_key", "t_ins", "t_conj", "t_post", "t_osetup", "t_shuf", "t_norm", "t_r8"].iter().map(|k| s.get(k)).sum();
+    s.add("t_pipe", pipe);
+    (s, out, pool_closure, r8cl.into_iter().collect(), terms)
+}
