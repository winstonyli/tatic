+/// Probe: for the process (one mine), the path steps of every met search the miner's main thread ran, each labeled with
+/// the law (`lhs`, `rhs`) it is an instance of; a path through steps whose laws are all in the current table proves its
+/// ends equal. Only the main thread's searches (the evaluations of the chosen rules, the winners' proofs) feed it, so
+/// what the workers read does not depend on which worker scored what.
+#[derive(Default)]
+struct JoinStore {
+    edges: hashbrown::HashMap<Term, Vec<(Term, (Term, Term))>>,
+}
+
+impl JoinStore {
+    fn add(&mut self, a: Term, b: Term, law: (Term, Term)) {
+        let v = self.edges.entry(a).or_default();
+        if !v.iter().any(|e| e.0 == b && e.1 == law) {
+            v.push((b, law));
+            self.edges.entry(b).or_default().push((a, law));
+            count_join(|c| c.st_edges += 1);
+        }
+    }
+    /// the shortest stored path from `a` to `b` through the current table's laws and terms of at most `cap` nodes (`None`
+    /// for any size), as its length, within 1000 terms
