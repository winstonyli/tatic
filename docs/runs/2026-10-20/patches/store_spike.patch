+/// A join step kept by `JoinStore`: the step at `path` from `from` by the law `lhs = rhs` read in direction `backward`,
+/// which a table's `join` holds under the same key whatever its index.
+#[derive(Clone, Copy)]
+struct StoredStep {
+    from: Term,
+    path: StepPath,
+    law: (Term, Term, bool),
+}
+
+/// The steps of the join's met paths, as edges between the terms they join: each term's neighbours, by the step and
+/// whether it is walked backwards. A path through steps whose laws the current table holds proves its ends equal, so the
+/// join serves a pair from the store before it searches (docs/tier-cycle.md, "A shared store fed by the main thread").
+#[derive(Clone, Default)]
+pub struct JoinStore {
+    edges: hashbrown::HashMap<Term, Vec<(Term, StoredStep, bool)>>,
+}
+
+impl JoinStore {
+    fn add(&mut self, to: Term, step: StoredStep) {
+        let v = self.edges.entry(step.from).or_default();
+        if !v.iter().any(|e| e.0 == to && e.1.law == step.law && e.1.path.path == step.path.path && e.1.path.depth == step.path.depth) {
+            v.push((to, step, false));
+            self.edges.entry(to).or_default().push((step.from, step, true));
+        }
+    }
+    /// The plan of `a = b` along the shortest stored path through `table`'s laws and terms of at most `cap` nodes, within
+    /// 1000 terms, and the path's terms.
+    fn path(&self, table: &RuleTable, laws: &hashbrown::HashMap<(Term, Term, bool), u32>, a: Term, b: Term, cap: usize) -> Option<(PlanRc, Vec<Term>)> {
+        let mut prev: hashbrown::HashMap<Term, Option<(Term, StoredStep, bool, u32)>> = [(a, None)].into_iter().collect();
+        let mut front = vec![a];
+        while !front.is_empty() && prev.len() <= 1000 {
+            for t in std::mem::take(&mut front) {
+                for &(u, step, rev) in self.edges.get(&t).into_iter().flatten() {
+                    let Some(&eq) = laws.get(&step.law) else { continue };
+                    if u.size() > cap || prev.contains_key(&u) {
+                        continue;
+                    }
+                    prev.insert(u, Some((t, step, rev, eq)));
+                    if u == b {
+                        let (mut plans, mut terms, mut x) = (vec![], vec![b], b);
+                        while let Some((p, step, rev, eq)) = prev[&x] {
+                            let plan = step_plan(&JoinStep { from: step.from, path: step.path, eq }, table);
+                            plans.push(if rev { Plan::sym(plan) } else { plan });
+                            terms.push(p);
+                            x = p;
+                        }
+                        return Some((plans.into_iter().rev().reduce(Plan::trans).unwrap(), terms));
+                    }
+                    front.push(u);
+                }
+            }
+        }
+        None
+    }
+}
+
+/// The store the miner's main thread feeds (`STORE_FEEDS`), and the copy of it the other threads read, frozen when a round
+/// of scoring starts (`freeze_join_store`), so a candidate's gain does not depend on the thread count or on which worker
+/// scored what.
+static JOIN_STORE: std::sync::LazyLock<std::sync::Mutex<JoinStore>> = std::sync::LazyLock::new(Default::default);
+static JOIN_STORE_FROZEN: std::sync::RwLock<Option<std::sync::Arc<JoinStore>>> = std::sync::RwLock::new(None);
+
+thread_local! {
+    /// whether this thread's met joins feed `JOIN_STORE` and read it unfrozen (the miner's main thread)
+    pub static STORE_FEEDS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// the current table's join steps by their law, by the table's fingerprint
+    static STORE_LAWS: std::cell::RefCell<(u64, hashbrown::HashMap<(Term, Term, bool), u32>)> = Default::default();
+}
+
+/// Empties the join store, for a new mine.
+pub fn clear_join_store() {
+    *JOIN_STORE.lock().unwrap() = JoinStore::default();
+    *JOIN_STORE_FROZEN.write().unwrap() = None;
+}
+
+/// Freezes the join store's copy for the other threads.
+pub fn freeze_join_store() {
+    let copy = JOIN_STORE.lock().unwrap().clone();
+    *JOIN_STORE_FROZEN.write().unwrap() = Some(std::sync::Arc::new(copy));
+}
+
+/// The plan of `a = b` from the join store under the current table, and the path's terms.
+fn stored_join(a: Term, b: Term) -> Option<(PlanRc, Vec<Term>)> {
+    let cap = a.size().max(b.size()) + 2;
+    RULE_TABLE.with(|table| {
+        let table = &table.borrow();
+        let fp = table.mined.iter().fold(table.join.len() as u64, |h, (l, r)| h.rotate_left(5) ^ l.sh() ^ r.sh().rotate_left(17));
+        STORE_LAWS.with(|laws| {
+            let mut laws = laws.borrow_mut();
+            if laws.0 != fp {
+                let mut m = hashbrown::HashMap::new();
+                for (i, e) in table.join.iter().enumerate() {
+                    m.entry((e.lhs, e.rhs, e.backward)).or_insert(i as u32);
+                }
+                *laws = (fp, m);
+            }
+            if STORE_FEEDS.with(|f| f.get()) {
+                JOIN_STORE.lock().unwrap().path(table, &laws.1, a, b, cap)
+            } else {
+                let frozen = JOIN_STORE_FROZEN.read().unwrap().clone();
+                frozen.and_then(|s| s.path(table, &laws.1, a, b, cap))
+            }
+        })
+    })
+}
