+/// Probe: per thread and across rule sets, every met search's path steps, each labeled with the law (`lhs`, `rhs`) it is
+/// an instance of; a path through steps whose laws are all in the current table proves its ends equal.
+#[derive(Default)]
+struct JoinStore {
+    edges: hashbrown::HashMap<Term, Vec<(Term, (Term, Term))>>,
+    fp: u64,
+    allowed: hashbrown::HashSet<(Term, Term)>,
+}
+
+impl JoinStore {
+    fn add(&mut self, a: Term, b: Term, law: (Term, Term)) {
+        let v = self.edges.entry(a).or_default();
+        if !v.iter().any(|e| e.0 == b && e.1 == law) {
+            v.push((b, law));
+            self.edges.entry(b).or_default().push((a, law));
+            count_join(|c| c.st_edges += 1);
+        }
+    }
+    /// the shortest stored path from `a` to `b` through the current table's laws and terms of at most `cap` nodes (`None`
+    /// for any size), as its length, within 1000 terms
+    fn path(&mut self, table: &RuleTable, a: Term, b: Term, cap: Option<usize>) -> Option<u64> {
+        let fp = table.mined.iter().fold(table.join.len() as u64, |h, (l, r)| h.rotate_left(5) ^ l.sh() ^ r.sh().rotate_left(17));
+        if fp != self.fp {
+            self.fp = fp;
+            self.allowed = table.join.iter().map(|e| (e.lhs, e.rhs)).collect();
+        }
+        let mut depth: hashbrown::HashMap<Term, u64> = [(a, 0u64)].into_iter().collect();
+        let mut front = vec![a];
+        while !front.is_empty() && depth.len() <= 1000 {
+            for t in std::mem::take(&mut front) {
+                let d = depth[&t];
+                for &(u, law) in self.edges.get(&t).into_iter().flatten() {
+                    if !self.allowed.contains(&law) || cap.is_some_and(|c| u.size() > c) || depth.contains_key(&u) {
+                        continue;
+                    }
+                    if u == b {
+                        return Some(d + 1);
+                    }
+                    depth.insert(u, d + 1);
+                    front.push(u);
+                }
+            }
+        }
+        None
+    }
+}
+
+thread_local! {
+    static JOIN_STORE: std::cell::RefCell<JoinStore> = std::cell::RefCell::new(JoinStore::default());
+}
