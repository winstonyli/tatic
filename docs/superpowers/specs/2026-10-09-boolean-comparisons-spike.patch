@@ -1374,3 +1436,24 @@ pub fn ablation_audit() {
 // built gate by gate: `op(C(a), C(b)) = C(apply(op, a, b))` is proved by recursion on the diagrams (Harrison's BDD rule
 // for HOL, 1995), each step an instance of a closed lemma, memoized per node pair. Two signals have the same node iff
 // they are the same Boolean function, so an equality lemma is `trans` of one proof with the `sym` of the other.
+
+#[test]
+pub fn spike_boolean_of_lt_offset_law() {
+    let _scope = tatic::kernel::InternScope::enter();
+    let b = |t: Term| Box::new(t);
+    let op = |o: usize, x: Term, y: Term| Term::Op(o, b(x), b(y));
+    let (x, y) = (Term::V(0), Term::V(1));
+    let lt = |x: Term, y: Term| op(LT, x, y);
+    let lhs = lt(op(ADD, Term::Ones, x.clone()), y.clone());
+    let rhs = op(AND, lt(Term::Zero, x.clone()), op(XOR, lt(y.clone(), x.clone()), Term::Ones));
+    for n in 1..=6 {
+        assert!(lhs.plausibly_equals(&rhs, n, 2), "plausible at width {n}");
+    }
+    let wrong = op(AND, lt(Term::Zero, x.clone()), lt(y.clone(), x.clone()));
+    assert!(!lhs.plausibly_equals(&wrong, 4, 2), "false law screened");
+    let t = Instant::now();
+    let (p, s) = add_tree_law(4, 2, &lhs, &rhs).expect("no proof for the offset law");
+    ck("lt(x-1,y) = and(lt(0,x), not lt(y,x))", &p, &s);
+    eprintln!("SPIKE proved and checked at n=4 in {:?}", t.elapsed());
+    assert!(add_tree_law(4, 2, &lhs, &wrong).is_none());
+}
