+/// SPIKE (i1): a tail self-call is `return_call`, so a tail loop of 10^6 iterations runs in constant Wasm stack; the
+/// same module with `return_call` text-replaced by `call`, and a genuinely non-tail recursion of the same depth, trap.
+#[test]
+fn a_million_iteration_tail_loop_does_not_overflow_the_wasm_stack() {
+    let mut s = TermStore::new();
+    let h = crate::support::samples::source(&mut s, "rec f n acc = if n <= 0 then acc else f (n - 1) (acc + n)");
+    let wat = try_compile(&s, h).unwrap().wat();
+    assert!(wat.contains("return_call $f") && !wat.contains("loop"), "{wat}");
+    let n: i64 = 1_000_000;
+    let (mut store, instance) = instantiate(&wat);
+    let func = instance.get_typed_func::<(i64, i64), i64>(&mut store, "f").unwrap();
+    assert_eq!(func.call(&mut store, (n, 0)).unwrap(), n * (n + 1) / 2);
+    // control: the same text with `call` for `return_call` overflows
+    let (mut store, instance) = instantiate(&wat.replace("return_call", "call"));
+    let func = instance.get_typed_func::<(i64, i64), i64>(&mut store, "f").unwrap();
+    let e = func.call(&mut store, (n, 0)).expect_err("a million nested calls should exhaust the stack");
+    println!("TAIL-CONTROL (call for return_call): {}", e.to_string().lines().next().unwrap_or_default());
+    // control: a non-tail recursion that the lowering must keep as `call`
+    let h = crate::support::samples::source(&mut s, "rec f n = if n <= 0 then 0 else 1 + f (n - 1)");
+    let wat = try_compile(&s, h).unwrap().wat();
+    assert!(!wat.contains("return_call"), "{wat}");
+    let (mut store, instance) = instantiate(&wat);
+    let func = instance.get_typed_func::<i64, i64>(&mut store, "f").unwrap();
+    assert!(func.call(&mut store, n).is_err());
+}
