+//! SPIKE (f1, 2026-11-10): the e1 generator (`tatic_wasm::wasm::sim::gen_sim`) driven from tatic's real terms and the
+//! real lowering's instruction lists, with no per-function case. `gen_real` runs the targets, `gen_real_controls` the
+//! mutants of emitted code and the kernel-level negative.
+use std::time::Instant;
+
+use tatic_wasm::ops::Op;
+use tatic_wasm::wasm::Ins;
+
+use crate::jit::compile::{compile_specialised, CompiledFragment, Item};
+use crate::lang::syntax::print;
+use crate::lang::term::{Hash, TermStore};
+use crate::proof::gate::{sim_module, ModFn};
+use tatic_wasm::wasm::K;
+use crate::support::samples::{capturing_closure_loop, factorial, fib, partial_application_loop, redundant_arithmetic_recursion, source, twice_inc_5};
+use crate::testing::ins_mutate::mutate;
+use crate::testing::test_corpus::let_bound_factorial_10;
+
+/// The term the gate sees (the specialised one, if `specialise` changed it) and its compiled fragment.
+fn compiled(build: &dyn Fn(&mut TermStore) -> Hash) -> (TermStore, Hash, CompiledFragment) {
+    let mut s = TermStore::new();
+    let h = build(&mut s);
+    let c = compile_specialised(&s, h).expect("compiles");
+    match c.specialised {
+        Some((s2, h2)) => (s2, h2, c.frag),
+        None => (s, h, c.frag),
+    }
+}
+
+/// One function of the compiled module: `$f` (the entry) or `$c{k}` (table entry k, position k), its parameter count, whether
+/// it has an `i32` environment parameter, and its body as the lowering printed it (or as a control changed it).
+struct RawFn {
+    name: String,
+    arity: usize,
+    env: bool,
+    body: Vec<Ins>,
+}
+
+/// The module's functions in position order (`$c0 ..`, then `$f`), the entry's body replaced by `entry`.
+fn raw_module(frag: &CompiledFragment, entry: &[Ins]) -> Result<Vec<RawFn>, String> {
+    let mut funcs: Vec<RawFn> = frag
+        .module
+        .iter()
+        .filter_map(|item| match item {
+            Item::Func { name, header, body } => Some(RawFn {
+                name: name.clone(),
+                arity: header.matches("(param $p").count(),
+                env: header.contains("(param $env i32)"),
+                body: if name == "f" { entry.to_vec() } else { body.clone() },
+            }),
+            Item::Text(_) => None,
+        })
+        .collect();
+    let names: Vec<String> = funcs.iter().map(|f| f.name.clone()).collect();
+    let callees = funcs.len().checked_sub(1).ok_or("a module with no function")?;
+    let mut ordered = vec![];
+    for k in 0..callees {
+        let want = format!("c{k}");
+        let Some(i) = funcs.iter().position(|f| f.name == want) else { return Err(format!("no ${want} in the module's functions {names:?}")) };
+        ordered.push(funcs.remove(i));
+    }
+    match funcs.pop() {
+        Some(f) if f.name == "f" => ordered.push(f),
+        _ => return Err(format!("the module's functions {names:?} are not $c0..$c{{n-1}} and $f")),
+    }
+    Ok(ordered)
+}
+
+/// A function's parameters as the stack kinds a call of it pushes: the environment (if any), then the words.
+fn call_kinds(f: &RawFn) -> Vec<K> {
+    [if f.env { vec![K::I] } else { vec![] }, vec![K::W; f.arity]].concat()
+}
+
+/// The lowering's list as the machine's: `local.get $p{k}` is `LocalGet k`, `local.get $env` is `GetI` of the slot after the
+/// parameters, `i32.const v` is `ConstI`, and `call $x` / `return_call $x` is `Call` / `ReturnCall` of `$x`'s position with its
+/// parameters as kinds. Every other `Raw` line stays `Raw` and is pushed to `raws`.
+fn lift(code: &[Ins], me: &RawFn, all: &[RawFn], raws: &mut Vec<String>) -> Vec<Ins> {
+    code.iter()
+        .map(|ins| match ins {
+            Ins::Loop(b) => Ins::Loop(lift(b, me, all, raws)),
+            Ins::If(t, e) => Ins::If(lift(t, me, all, raws), lift(e, me, all, raws)),
+            Ins::Raw(s) => {
+                let target = |p: &str| s.strip_prefix(p).and_then(|nm| all.iter().position(|f| f.name == nm));
+                if let Some(k) = s.strip_prefix("local.get $p").and_then(|k| k.parse::<u32>().ok()) {
+                    Ins::LocalGet(k)
+                } else if s == "local.get $env" && me.env {
+                    Ins::GetI(me.arity as u32)
+                } else if let Some(v) = s.strip_prefix("i32.const ").and_then(|v| v.parse::<u32>().ok()) {
+                    Ins::ConstI(v)
+                } else if let Some(p) = target("call $") {
+                    Ins::Call(p as u32, call_kinds(&all[p]))
+                } else if let Some(p) = target("return_call $") {
+                    Ins::ReturnCall(p as u32, call_kinds(&all[p]))
+                } else {
+                    raws.push(s.clone());
+                    ins.clone()
+                }
+            }
+            other => other.clone(),
+        })
+        .collect()
+}
+
+/// The module as the generator takes it, or the `Raw` lines no `Ins` covers.
+fn lift_module(frag: &CompiledFragment, entry: &[Ins]) -> Result<Vec<ModFn>, String> {
+    let all = raw_module(frag, entry)?;
+    let mut raws = vec![];
+    let funcs: Vec<ModFn> = all.iter().map(|f| ModFn { code: lift(&f.body, f, &all, &mut raws), arity: f.arity, env: f.env }).collect();
+    if !raws.is_empty() {
+        raws.dedup();
+        return Err(format!("Raw lines with no Ins: {raws:?}"));
+    }
+    Ok(funcs)
+}
+
+/// `(proof, statement)` for `n`, the entry's body `entry` (the printed one, or a control's) and `edit` applied to the lifted
+/// module (position order, entry last) before the generator sees it.
+fn stmt_edit(s: &TermStore, h: Hash, frag: &CompiledFragment, entry: &[Ins], n: usize, edit: &dyn Fn(&mut Vec<ModFn>)) -> Result<(tatic_kernel::Expr, tatic_kernel::Expr), String> {
+    stmt_edit2(s, h, frag, entry, n, edit, &|_| {})
+}
+
+/// `stmt_edit`, and `edit_src` applied to the registry's sources (the pairing of `$cK` with its source term).
+fn stmt_edit2(
+    s: &TermStore,
+    h: Hash,
+    frag: &CompiledFragment,
+    entry: &[Ins],
+    n: usize,
+    edit: &dyn Fn(&mut Vec<ModFn>),
+    edit_src: &dyn Fn(&mut Vec<Option<Hash>>),
+) -> Result<(tatic_kernel::Expr, tatic_kernel::Expr), String> {
+    let mut funcs = lift_module(frag, entry)?;
+    edit(&mut funcs);
+    let mut sources = frag.sources.clone();
+    edit_src(&mut sources);
+    sim_module(s, h, frag.arity, &funcs, &sources, n)
+}
+
+fn stmt(s: &TermStore, h: Hash, frag: &CompiledFragment, entry: &[Ins], n: usize) -> Result<(tatic_kernel::Expr, tatic_kernel::Expr), String> {
+    stmt_edit(s, h, frag, entry, n, &|_| {})
+}
+
+/// `Ok((build ms, check ms))` for `n`, or why not. On one `CHECK_STACK` thread (an `Expr` does not cross threads).
+fn prove_edit(s: &TermStore, h: Hash, frag: &CompiledFragment, entry: &[Ins], n: usize, edit: &dyn Fn(&mut Vec<ModFn>)) -> Result<(f64, f64), String> {
+    prove_edit2(s, h, frag, entry, n, edit, &|_| {})
+}
+
+fn prove_edit2(
+    s: &TermStore,
+    h: Hash,
+    frag: &CompiledFragment,
+    entry: &[Ins],
+    n: usize,
+    edit: &dyn Fn(&mut Vec<ModFn>),
+    edit_src: &dyn Fn(&mut Vec<Option<Hash>>),
+) -> Result<(f64, f64), String> {
+    let t0 = Instant::now();
+    let (proof, stmt) = stmt_edit2(s, h, frag, entry, n, edit, edit_src)?;
+    let build = t0.elapsed().as_secs_f64() * 1e3;
+    let t1 = Instant::now();
+    tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &stmt).map_err(|e| format!("kernel: {}", e.chars().take(300).collect::<String>()))?;
+    Ok((build, t1.elapsed().as_secs_f64() * 1e3))
+}
+
+fn prove(s: &TermStore, h: Hash, frag: &CompiledFragment, entry: &[Ins], n: usize) -> Result<(f64, f64), String> {
+    prove_edit(s, h, frag, entry, n, &|_| {})
+}
+
+fn on_big_stack<R: Send>(f: impl FnOnce() -> R + Send) -> R {
+    std::thread::scope(|sc| std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn_scoped(sc, f).unwrap().join().unwrap())
+}
+
+type Target = (&'static str, fn(&mut TermStore) -> Hash);
+
+fn targets() -> Vec<Target> {
+    vec![
+        ("sum loop (capturing_closure_loop)", capturing_closure_loop),
+        ("sum loop (partial_application_loop)", partial_application_loop),
+        ("factorial", factorial),
+        ("redundant_arithmetic_recursion", redundant_arithmetic_recursion),
+        ("fib", fib),
+        ("direct call 13 (twice_inc_5)", twice_inc_5),
+        ("direct call 34 (let_bound_factorial_10)", let_bound_factorial_10),
+    ]
+}
+
+/// Terms written after `sim.rs` was hashed (d9f576fc..., 12:31): real syntax, the real specialiser and lowering.
+fn unseen() -> Vec<Target> {
+    vec![
+        ("tri", |s| source(s, "rec f n = if n <= 0 then 0 else n + f (n - 1) + 1")),
+        ("dbl", |s| source(s, "rec f n = if n <= 0 then 1 else f (n - 1) + f (n - 1)")),
+        ("mulloop", |s| source(s, "rec f n acc = if n <= 0 then acc else f (n - 1) (acc * n)")),
+        ("mixed", |s| source(s, "rec f n = if n <= 2 then n else f (f (n - 2)) * n + f (n - 3)")),
+        ("pow2sum (3 params)", |s| source(s, "rec f n acc p = if n <= 0 then acc else f (n - 1) (acc + p) (p + p)")),
+        ("eq-guarded loop (==)", |s| source(s, "rec f a b = if a == 0 then b else f (a - 1) (b + a)")),
+        ("two guards, two base cases", |s| source(s, "rec f a b = if a == 0 then b else if b == 0 then a else f (a - 1) (b - 1) + 1")),
+    ]
+}
+
+/// Every function of the module, with its parameter count and the `Raw` lines `lift` cannot map.
+fn raw_report(name: &str, frag: &CompiledFragment) {
+    match raw_module(frag, frag.entry()) {
+        Ok(all) => {
+            for f in &all {
+                let mut raws = vec![];
+                lift(&f.body, f, &all, &mut raws);
+                raws.dedup();
+                println!("RAWS {name}: ${} ({} params, env {}): {raws:?}", f.name, f.arity, f.env);
+            }
+        }
+        Err(e) => println!("RAWS {name}: {e}"),
+    }
+}
+
+#[test]
+fn gen_real_unseen() {
+    let mut failed = vec![];
+    for (name, build) in unseen() {
+        on_big_stack(|| {
+            let (s, h, frag) = compiled(&build);
+            println!("TERM {name}: {} (arity {})", print(&s, h), frag.arity);
+            for n in [4, 24, 64] {
+                match prove(&s, h, &frag, frag.entry(), n) {
+                    Ok((b, k)) => println!("REAL n={n} {name}: build {b:.1} ms, check {k:.1} ms"),
+                    Err(e) => {
+                        println!("REAL n={n} {name}: FAIL {}", e.chars().take(400).collect::<String>());
+                        failed.push((n, name));
+                    }
+                }
+            }
+        });
+    }
+    println!("FAILED: {failed:?}");
+    assert!(failed.is_empty(), "unseen terms that did not prove: {failed:?}");
+}
