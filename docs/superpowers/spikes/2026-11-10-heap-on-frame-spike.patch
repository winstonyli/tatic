+// ---- i3: commutativity of `eq`, `eq x y = eq y x`, so a store at `p` read at `p + j` reuses the region lemma.
+
+/// `[B, a, b]`: `and B (xnor a b) = and B (xnor b a)`.
+fn comm_s() -> (Expr, Expr) {
+    lemma_k(
+        3,
+        &|v| id(bool0(), and(v[0], not_(xor(v[1], v[2]))), and(v[0], not_(xor(v[2], v[1])))),
+        &|v| v[0] && (v[1] == v[2]),
+    )
+}
+
+/// The chain proof of `Id(Bool0, eq (mk a) (mk b), eq (mk b) (mk a))`, by the invariant `A_i = B_i` (the two prefix conjunctions).
+fn comm_chain(c: &mut Cx, a: &[At], ga: &[At], b: &[At], gb: &[At], s: Expr) -> Expr {
+    let n = a.len();
+    let (g_xnor, _) = good2(&|x, y| not_(xor(x, y)), &|x, y| x == y);
+    let (g_and_l, _) = good_and_lemma();
+    let bb0 = bool0();
+    let (mut aa, mut bb) = (t(), t());
+    let mut gbb = good_bit(true);
+    let mut p = refl(t());
+    for i in 0..n {
+        let (ai, bi, gai, gbi) = (c.at(a[i]), c.at(b[i]), c.at(ga[i]), c.at(gb[i]));
+        let xab = not_(xor(ai, bi));
+        let xba = not_(xor(bi, ai));
+        let f1 = lam(bb0, and(var(0), shift(&xab, 0, 1)));
+        let e1 = cong1(&bb0, &bb0, &f1, aa, bb, p);
+        let e2 = apps(s, vec![bb, ai, bi, gbb, gai, gbi]);
+        let pn = trans_proof(&bb0, &and(aa, xab), &and(bb, xab), &and(bb, xba), e1, e2);
+        let gx = apps(g_xnor, vec![bi, ai, gbi, gai]);
+        let gn = apps(g_and_l, vec![bb, xba, gbb, gx]);
+        (aa, bb, gbb, p) = (and(aa, xab), and(bb, xba), gn, pn);
+    }
+    p
+}
+
+/// `Pi x y. GoodBv x -> GoodBv y -> Id(Bool0, eq x y, eq y x)`.
+pub fn eq_comm_law(n: usize) -> (Expr, Expr) {
+    let s = comm_s().0;
+    let tys: Vec<Ty> = vec![
+        ty!(|_c, _x| bv_ty(n)),
+        ty!(|_c, _x| bv_ty(n)),
+        ty!(|c, x| app(good_bv(n), c.at(x[0]))),
+        ty!(|c, x| app(good_bv(n), c.at(x[1]))),
+    ];
+    let lhs = move |x: Expr, y: Expr| app2(eq_bv(n), x, y);
+    let rhs = move |x: Expr, y: Expr| app2(eq_bv(n), y, x);
+    let qty = arrow(bool0(), sort(1));
+    law(&tys, |c, xs| {
+        let (x, y, gx, gy) = (xs[0], xs[1], xs[2], xs[3]);
+        let stmt = id(bool0(), lhs(c.at(x), c.at(y)), rhs(c.at(x), c.at(y)));
+        let motive_p = c.lam(bv_ty(n), |c, p| {
+            c.pi(qty, |c, q| arrow(app(c.at(q), rhs(c.at(p), c.at(y))), app(c.at(q), lhs(c.at(p), c.at(y)))))
+        });
+        let step_p = bind_bits(c, n, &mut vec![], &mut |c, a, ga| {
+            let mk = |c: &Cx, bits: &[At]| church_tuple(&bits.iter().map(|b| c.at(*b)).collect::<Vec<_>>());
+            let motive_j = c.lam(bv_ty(n), |c, yy| {
+                c.pi(qty, |c, q| arrow(app(c.at(q), rhs(mk(c, a), c.at(yy))), app(c.at(q), lhs(mk(c, a), c.at(yy)))))
+            });
+            let step_j = bind_bits(c, n, &mut vec![], &mut |c, b, gb| {
+                let pf = comm_chain(c, a, ga, b, gb, s);
+                let (l, r) = (lhs(mk(c, a), mk(c, b)), rhs(mk(c, a), mk(c, b)));
+                leibniz(c, pf, l, r)
+            });
+            app2(c.at(gy), motive_j, step_j)
+        });
+        let body = app2(c.at(gx), motive_p, step_p);
+        let r0 = rhs(c.at(x), c.at(y));
+        let qid = lam(bool0(), id(bool0(), var(0), shift(&r0, 0, 1)));
+        (apps(body, vec![qid, refl(r0)]), stmt)
+    })
+}
