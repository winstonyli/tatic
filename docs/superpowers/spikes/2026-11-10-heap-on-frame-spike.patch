+
+fn first_in_else(code: &[Ins], f: &dyn Fn(&Ins) -> Option<Ins>) -> Vec<Ins> {
+    // SPIKE (i1): no wrapping `Loop` any more: the body ends in the `If`
+    let mut body = code.to_vec();
+    let Some(Ins::If(_, e)) = body.last_mut() else { panic!("no If") };
+    let mutated = mutate(e, f);
+    *e = mutated;
+    body
+}
+
+/// Mutated emitted code against the unchanged term: each must be rejected, by the generator's walk or the kernel.
+#[test]
+fn gen_real_controls() {
+    type Mut = Box<dyn Fn(&[Ins]) -> Vec<Ins> + Sync>;
+    let sub = |o: Op, to: Op| -> Mut { Box::new(move |c| mutate(c, &|i| (*i == Ins::Op(o)).then_some(Ins::Op(to)))) };
+    let cases: Vec<(&str, Target, Mut)> = vec![
+        ("operator: factorial Mul -> Add", ("factorial", factorial), sub(Op::Mul, Op::Add)),
+        ("operator: fib Add -> Sub", ("fib", fib), sub(Op::Add, Op::Sub)),
+        ("operator: sum loop acc + n -> acc - n", ("sum", capturing_closure_loop), Box::new(|c| mutate(c, &|i| (*i == Ins::Op(Op::Add)).then_some(Ins::Op(Op::Sub))))),
+        ("condition: factorial n <= 1 -> n < 1", ("factorial", factorial), sub(Op::LeS, Op::LtS)),
+        (
+            "call argument: factorial n - 1 -> n - 2",
+            ("factorial", factorial),
+            Box::new(|c| first_in_else(c, &|i| matches!(i, Ins::Push(_)).then_some(Ins::Push(2)))),
+        ),
+        (
+            "call argument: fib n - 1 -> n - 3",
+            ("fib", fib),
+            Box::new(|c| first_in_else(c, &|i| matches!(i, Ins::Push(_)).then_some(Ins::Push(3)))),
+        ),
+        (
+            "call dropped: factorial",
+            ("factorial", factorial),
+            Box::new(|c| first_in_else(c, &|i| (*i == Ins::Raw("call $f".into())).then_some(Ins::Push(7)))),
+        ),
+        (
+            "branches swapped: factorial",
+            ("factorial", factorial),
+            Box::new(|c| mutate(c, &|i| match i { Ins::If(t, e) => Some(Ins::If(e.clone(), t.clone())), _ => None })),
+        ),
+        (
+            "branches swapped: sum loop",
+            ("sum", capturing_closure_loop),
+            Box::new(|c| mutate(c, &|i| match i { Ins::If(t, e) => Some(Ins::If(e.clone(), t.clone())), _ => None })),
+        ),
+        (
+            "wrong parameter read: sum loop `local.get $p0` -> `$p1`",
+            ("sum", capturing_closure_loop),
+            Box::new(|c| mutate(c, &|i| (*i == Ins::LocalGet(0)).then_some(Ins::LocalGet(1)))),
+        ),
+        (
+            "wrong parameter read in the tail call's argument: sum loop `n - 1` reads `$p1`",
+            ("sum", capturing_closure_loop),
+            Box::new(|c| first_in_else(c, &|i| (*i == Ins::LocalGet(0)).then_some(Ins::LocalGet(1)))),
+        ),
+        (
+            "return_call for call where the continuation matters: factorial",
+            ("factorial", factorial),
+            Box::new(|c| mutate(c, &|i| (*i == Ins::Raw("call $f".into())).then_some(Ins::Raw("return_call $f".into())))),
+        ),
+        (
+            "return_call for call where the continuation matters: fib",
+            ("fib", fib),
+            Box::new(|c| mutate(c, &|i| (*i == Ins::Raw("call $f".into())).then_some(Ins::Raw("return_call $f".into())))),
+        ),
+        (
+            "return_call for call where the continuation matters: tri (n + f(n-1) + 1)",
+            ("tri", |s| source(s, "rec f n = if n <= 0 then 0 else n + f (n - 1) + 1")),
+            Box::new(|c| mutate(c, &|i| (*i == Ins::Raw("call $f".into())).then_some(Ins::Raw("return_call $f".into())))),
+        ),
+        (
+            "base case: factorial 1 -> 2",
+            ("factorial", factorial),
+            Box::new(|c| mutate(c, &|i| match i {
+                Ins::If(t, e) if *t == vec![Ins::Push(1)] => Some(Ins::If(vec![Ins::Push(2)], e.clone())),
+                _ => None,
+            })),
+        ),
+    ];
+    let mut accepted = vec![];
+    for n in [4, 24] {
+        for (what, (name, build), f) in &cases {
+            let r = on_big_stack(|| {
+                let (s, h, frag) = compiled(build);
+                let code = frag.entry();
+                let mutated = f(code);
+                if mutated == code {
+                    return Err("MUTATION DID NOT CHANGE THE CODE".to_string());
+                }
+                prove(&s, h, &frag, &mutated, n).map(|_| ())
+            });
+            match r {
+                Ok(()) => accepted.push((n, *what)),
