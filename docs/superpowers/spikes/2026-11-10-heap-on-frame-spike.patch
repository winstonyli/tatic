+/// M2, kernel level. (1) The same module relabelled consistently (callee definitions, calls and registry all exchanged) is
+/// the same machine: its own proof checks, and so does the original's proof against the relabelled statement (the `$cK`
+/// names carry no meaning of their own). (2) Each wrong pairing is refused by the generator's walk; its statement still
+/// exists, and the original (right) proof does not check against it: the kernel rejects too.
+#[test]
+fn gen_real_m2_kernel_judges_the_pairing() {
+    use crate::proof::gate::sim_module_parts;
+    for (name, src) in m2_terms() {
+        on_big_stack(|| {
+            let (s, h, frag) = compiled(&|st: &mut TermStore| source(st, src));
+            let n = 8;
+            let ctx = tatic_kernel::Ctx::new();
+            let (proof, own) = stmt_edit2(&s, h, &frag, frag.entry(), n, &|_| {}, &|_| {}).unwrap();
+            assert!(tatic_kernel::check(&ctx, &proof, &own).is_ok(), "{name}: own proof");
+            let parts = |edit: &dyn Fn(&mut Vec<ModFn>), edit_src: &dyn Fn(&mut Vec<Option<Hash>>)| {
+                let mut funcs = lift_module(&frag, frag.entry()).unwrap();
+                edit(&mut funcs);
+                let mut sources = frag.sources.clone();
+                edit_src(&mut sources);
+                sim_module_parts(&s, h, frag.arity, &funcs, &sources, n).unwrap()
+            };
+            let relabel = |fs: &mut Vec<ModFn>| {
+                for f in fs.iter_mut() {
+                    f.code = swap_calls(&f.code, 0, 1);
+                }
+                fs.swap(0, 1);
+            };
+            let (p2, other) = parts(&relabel, &|v| v.swap(0, 1));
+            let p2 = p2.expect("a consistent relabelling proves");
+            assert!(tatic_kernel::check(&ctx, &p2, &other).is_ok(), "{name}: relabelled module's own proof");
+            let r = tatic_kernel::check(&ctx, &proof, &other);
+            println!("M2-KERNEL {name}: relabelled module, original proof: {}", if r.is_ok() { "accepted (same machine)" } else { "REJECTED" });
+            // (what, machine edit, registry edit, whether the kernel rejects the original proof against the statement). The registry
+            // exchange leaves the entry's statement the same proposition (its callee is named by its own functions, whatever
+            // position they sit at), so the kernel has nothing to reject; only the generator's position-wise pairing refuses.
+            let wrong: Vec<(&str, Box<dyn Fn(&mut Vec<ModFn>)>, Box<dyn Fn(&mut Vec<Option<Hash>>)>, bool)> = vec![
+                ("machine calls exchanged", Box::new(|fs| for f in fs.iter_mut() { f.code = swap_calls(&f.code, 0, 1) }), Box::new(|_| {}), true),
+                ("registry exchanged", Box::new(|_| {}), Box::new(|v| v.swap(0, 1)), false), // kernel verdict varies with the term; printed, not asserted
+                ("callee bodies exchanged", Box::new(|fs| { let (a, b) = (fs[0].code.clone(), fs[1].code.clone()); fs[0].code = b; fs[1].code = a }), Box::new(|_| {}), true),
+            ];
+            for (what, e, es, kernel_rejects) in &wrong {
+                let (p, stmt) = parts(&**e, &**es);
+                assert!(p.is_err(), "{name} / {what}: the generator built a proof");
+                let k = tatic_kernel::check(&ctx, &proof, &stmt);
+                println!("M2-KERNEL {name} / {what}: walk refuses ({}); kernel on the original proof vs this statement: {}", p.err().unwrap().chars().take(60).collect::<String>(), if k.is_ok() { "ACCEPTED" } else { "rejected" });
+                if *kernel_rejects {
+                    assert!(k.is_err(), "{name} / {what}: the kernel accepted the right proof against the wrong pairing's statement");
+                }
+            }
+        });
+    }
+}
