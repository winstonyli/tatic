+// ---- M2: callees paired with `$cK` by the lowering's registry, two callees of one arity ----
+
+/// Two arity-1 callees, executed `$c1` then `$c0` (registration is head first, so the outer `inc` is `$c0`).
+const TWO_CALLEES: &str = r"rec f n = if n <= 0 then 0 else (\a. a + 1) ((\b. b * 2) (f (n - 1)))";
+/// The same two callees, the lambdas' roles exchanged: `dbl` is now the outer one, so `$c0` is `dbl`.
+const TWO_CALLEES_SWAPPED_ROLES: &str = r"rec f n = if n <= 0 then 0 else (\b. b * 2) ((\a. a + 1) (f (n - 1)))";
+/// Two callees called at two sites, each twice, interleaved.
+const TWO_CALLEES_TWICE: &str =
+    r"rec f n = if n <= 0 then 1 else (\a. a + 1) ((\b. b * 2) (f (n - 1))) + (\b. b * 2) ((\a. a + 1) (f (n - 2)))";
+/// A callee that calls another callee, beside a second callee of the same arity: registration is `ga`=0, `dbl`=1, then
+/// (LIFO) `ga`'s own `add3`=2. Preorder from the entry would number `add3` 1.
+const CALLEE_CALLS_CALLEE: &str = r"rec f n = if n <= 0 then 0 else (rec ga a = if a <= 0 then 0 else (\d. d + 3) (ga (a - 1))) (f (n - 1)) + (\b. b * 2) (f (n - 2))";
+
+fn m2_terms() -> Vec<(&'static str, &'static str)> {
+    vec![
+        ("two callees", TWO_CALLEES),
+        ("two callees, roles exchanged", TWO_CALLEES_SWAPPED_ROLES),
+        ("two callees, twice", TWO_CALLEES_TWICE),
+        ("callee calls callee", CALLEE_CALLS_CALLEE),
+    ]
+}
+
+/// The machine's calls in `$f` in text order (`call $cK`, not `call $f`).
+fn call_order(frag: &CompiledFragment) -> Vec<usize> {
+    frag.wat().lines().filter_map(|l| l.trim().strip_prefix("call $c").and_then(|k| k.parse().ok())).collect()
+}
+
+/// Swap every `Call(a)` and `Call(b)` in a code list (all occurrences).
+fn swap_calls(code: &[Ins], a: u32, b: u32) -> Vec<Ins> {
+    let sw = |p: u32| if p == a { b } else if p == b { a } else { p };
+    code.iter()
+        .map(|ins| match ins {
+            Ins::Call(p, k) => Ins::Call(sw(*p), k.clone()),
+            Ins::ReturnCall(p, k) => Ins::ReturnCall(sw(*p), k.clone()),
+            Ins::If(t, e) => Ins::If(swap_calls(t, a, b), swap_calls(e, a, b)),
+            Ins::Loop(x) => Ins::Loop(swap_calls(x, a, b)),
+            other => other.clone(),
+        })
+        .collect()
+}
+
+/// M2: real terms with two or more callees of one arity install from emitted code through the generator, and the shape
+/// that matters is asserted: the call order differs from the registration order, and a callee calls a callee.
+#[test]
+fn gen_real_m2_two_callees_prove() {
+    for (name, src) in m2_terms() {
+        on_big_stack(|| {
+            let (s, h, frag) = compiled(&|st: &mut TermStore| source(st, src));
+            let order = call_order(&frag);
+            println!("M2 {name}: term {} ; call order in $f {order:?} ; sources {:?}", print(&s, h), frag.sources.iter().map(|x| x.map(|t| print(&s, t))).collect::<Vec<_>>());
+            let callees = frag.sources.len();
+            assert!(callees >= 2, "{name}: {callees} callees\n{}", frag.wat());
+            let arities: Vec<usize> = lift_module(&frag, frag.entry()).unwrap().iter().map(|f| f.arity).collect();
+            assert!(arities[..callees].windows(2).all(|w| w[0] == w[1]), "{name}: callee arities differ {arities:?}");
+            for n in [4, 24] {
+                match prove(&s, h, &frag, frag.entry(), n) {
+                    Ok((b, k)) => println!("M2 n={n} {name}: PROVES, build {b:.1} ms, check {k:.1} ms"),
+                    Err(e) => panic!("M2 n={n} {name}: {e}"),
+                }
+            }
+            match name {
+                "two callees" | "two callees, roles exchanged" => {
+                    assert_eq!(order, vec![1, 0], "{name}: machine calls $c1 then $c0, registration is the other way");
+                }
+                "callee calls callee" => {
+                    // the inner callee is registered last (LIFO), not next to its caller
+                    let printed: Vec<String> = frag.sources.iter().map(|x| print(&s, x.unwrap())).collect();
+                    assert!(printed[2].contains("+ 3") && printed[1].contains("* 2"), "{printed:?}");
+                }
+                _ => {}
+            }
+        });
+    }
+}
