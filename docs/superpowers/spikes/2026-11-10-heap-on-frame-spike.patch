+//! SPIKE (throwaway, 2026-11-10, e1 then S3): ONE generator of simulation proofs for the functions of a module, each
+//! with `Call`/`ReturnCall` (one constructor each, any arity) and optionally an `i32` environment parameter.
+//!
+//! l3: the locals are an R-free FRAME, a nested pair of `fw` words (module-wide width, callees padded with zeros) and a
+//! terminal word, passed to every class interpreter and never passed back through a return; the state is the memory `mu`
+//! alone, a variable in every proof (no store is generated here).
+//!
+//! For a function `k` of the module and a fuel `N` with `GoodNat N`, every `R`, `z`, arguments `x_i`, memory `mu`, machine
+//! continuation `km` and source continuation `ks`, the LAW of `k` is
+//!
+//! ```text
+//! (Pi a mu. km a mu = ks a) -> M_N^k (frame x..) mu km = S_N^k x.. ks
+//! ```
+//!
+//! `M_N^k = N H timeout Bm_k` runs `k`'s code through `prog`; the module's table (`V -> H`, `H = Fr -> Mem -> Ret -> R`)
+//! maps an index to `k`'s own fuel-unrolled environment (its own index), or to `N H timeout Bm_c` for a callee `c`.
+//! `S_N^k = N Hs_k ts Bs_k` is the source's step unrolled by the same fuel; a source call of a callee is `S_N^c`.
+//!
+//! The proof of `k`'s law is `GoodNat`'s induction on the fuel. In the step both sides are put in weak head normal form
+//! and walked in lockstep as kernel terms (`Sim::sim`), with no match on the instruction list or the function:
+//!   - `km a mu` against `ks a'`: the relation hypothesis;
+//!   - `CH R w t e` against `CH R w' t' e'` (`CH` is the probe standing for `choose`): J through the shared choice;
+//!   - a read of a local is the frame's projection, which reduces (the frame is a concrete nested pair);
+//!   - the fuel variable `j` applied to a frame, a memory and a continuation (a `br`, a `return_call` or a `call` of the
+//!     function itself: one rule): the induction hypothesis at the arguments read off the source side and the
+//!     temporaries read off the frame's pair spine;
+//!   - the outer fuel `N` applied to a frame, a memory and a continuation (a `call` of a callee): the CALLEE'S LAW, a
+//!     hypothesis of this proof, at the source's arguments, the callee's frame having been checked to be the canonical one.
+//! `CH` is a bound variable of the proof only: the statement uses the real `choose`, and the proof is applied to it.
+//! A callee's law enters its caller's proof only as a hypothesis; `closed` discharges it with the callee's own proof.
+use super::addr::{cancel_law, eq_comm_law, eq_refl_lemma, region_law, Rg};
+use super::*;
+use std::cell::{OnceCell, RefCell};
+
+/// What a source builder is given: the answer sort `r`, the function's own fixpoint variable `g`, its parameters, the
+/// probe `ch` that stands for `choose` (the statement uses the real one: `None`), the outer fuel and the callees' source
+/// functions (`S_N^c`, by module position).
+pub struct SEnv {
+    pub n: usize,
+    pub r: At,
+    pub g: At,
+    pub params: Vec<At>,
+    /// SPIKE (s1): the source's parameters after `params`: the value of each heap cell the statement fixes (`HeapSpec`).
+    pub cells: Vec<At>,
+    pub ch: Option<At>,
+    pub fuel: At,
+    pub callees: Vec<(usize, At)>,
+}
+
+impl SEnv {
+    /// `choose R cond t f`, through the probe in the proof.
+    pub fn choose(&self, c: &Cx, cond: Expr, t: Expr, f: Expr) -> Expr {
+        match self.ch {
+            Some(h) => apps(c.at(h), vec![c.at(self.r), cond, t, f]),
+            None => choose(c.at(self.r), cond, t, f),
+        }
+    }
+    /// A call of the function itself on `args`, its answer passed to `k`: `g args (\res. k res)`.
+    pub fn call(&self, c: &mut Cx, args: &[At], k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+        let kont = c.lam(bv_ty(self.n), |c, res| k(c, c.at(res)));
+        let mut xs: Vec<Expr> = args.iter().map(|a| c.at(*a)).collect();
+        xs.push(kont);
+        apps(c.at(self.g), xs)
+    }
+    /// A call of the callee at module position `pos` on `args`, its answer passed to `k`: `S_N^pos args (\res. k res)`.
+    pub fn call_fn(&self, c: &mut Cx, pos: usize, args: &[At], k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+        let (_, t) = self.callees.iter().find(|(p, _)| *p == pos).unwrap_or_else(|| panic!("no callee at position {pos}"));
+        let kont = c.lam(bv_ty(self.n), |c, res| k(c, c.at(res)));
+        let mut xs: Vec<Expr> = args.iter().map(|a| c.at(*a)).collect();
+        xs.push(kont);
+        apps(c.at(*t), xs)
+    }
+}
+
+/// The source in continuation-passing form: given the environment and the final continuation, `cps src`.
+pub type SrcFn<'a> = dyn Fn(&mut Cx, &SEnv, &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr + 'a;
+
+/// One function of a module. Its table index is its position in the module's list.
+pub struct FuncSpec<'a> {
+    pub code: Vec<Ins>,
+    /// Source parameters (words), at slots `0..arity`.
+    pub arity: usize,
+    /// Whether the function has an `i32` environment parameter, at slot `arity`; every caller passes it 0.
+    pub env: bool,
+    /// Temporaries (`local.set`/`local.get` slots after the parameters and the environment).
+    pub temps: usize,
+    /// Module positions of the functions it calls (other than itself).
+    pub callees: Vec<usize>,
+    pub src: &'a SrcFn<'a>,
+    /// SPIKE (s1): the heap cells the statement fixes (empty for a function that touches no heap).
+    pub heap: HeapSpec,
+}
+
+/// SPIKE (s1): the heap a statement fixes beyond the frame, ported from the heap-continuation spike.
+#[derive(Default, Clone)]
+pub struct HeapSpec {
+    /// `(p, off)`: a cell at address `x_p + off`. Its value is one more source parameter, after the non-pointer ones.
+    pub cells: Vec<(usize, u128)>,
+    /// The machine parameters the source does not take (pointers).
+    pub ptrs: Vec<usize>,
+    /// Indices into `cells` the function leaves as they were: `rel` gains a premise that the returned heap holds them,
+    /// so a non-tail call's continuation can read them.
+    pub post: Vec<usize>,
+}
+
+static NOHEAP: HeapSpec = HeapSpec { cells: Vec::new(), ptrs: Vec::new(), post: Vec::new() };
+
+/// `CH : Pi R:Sort0. Bv1 -> R -> R -> R`.
+fn ch_ty() -> Expr {
+    pi(sort(0), arrow(bv_ty(1), arrow(var(0), arrow(var(0), var(0)))))
+}
+/// `Pi R t e. Id(R, CH R (lit1 b) t e, t or e)`: the probe's behaviour at a literal condition (applied to the real
+/// `choose` at the end, where it is `refl`).
+fn probe_ty(c: &mut Cx, ch: At, truth: bool) -> Expr {
+    c.pi(sort(0), |c, r| {
+        c.pi(c.at(r), |c, t| {
+            c.pi(c.at(r), |c, e| {
+                let pick = apps(c.at(ch), vec![c.at(r), lit(1, truth as u128), c.at(t), c.at(e)]);
+                id(c.at(r), pick, c.at(if truth { t } else { e }))
+            })
+        })
+    })
+}
+fn probe_real(truth: bool) -> Expr {
+    Cx::default().lam(sort(0), |c, r| c.lam(c.at(r), |c, t| c.lam(c.at(r), |c, e| refl(c.at(if truth { t } else { e })))))
+}
+/// The real choice, `\R w x y. choose R w x y`.
+fn choose_fn() -> Expr {
+    Cx::default().lam(sort(0), |c, r| {
+        c.lam(bv_ty(1), |c, w| {
+            c.lam(c.at(r), |c, x| c.lam(c.at(r), |c, y| choose(c.at(r), c.at(w), c.at(x), c.at(y))))
+        })
+    })
+}
+
+/// `Id(R, CH R w t e, CH R w t' e')` from `Id(R, t, t')` and `Id(R, e, e')`: J on each branch.
+fn cong(c: &mut Cx, r: At, ch: At, cd: At, (t, t2, pt): (Expr, Expr, Expr), (e, e2, pe): (Expr, Expr, Expr)) -> Expr {
+    let pick = |c: &Cx, x: Expr, y: Expr| apps(c.at(ch), vec![c.at(r), c.at(cd), x, y]);
+    let (e, e2, pe) = (c.mark(e), c.mark(e2), c.mark(pe));
+    let outer_m = c.lam(c.at(r), |c, a| {
+        c.lam(c.at(r), |c, b| {
+            let ty = id(c.at(r), c.at(a), c.at(b));
+            c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(e)), pick(c, c.at(b), c.at(e2))))
+        })
+    });
+    let outer_b = c.lam(c.at(r), |c, a| {
+        let inner_m = c.lam(c.at(r), |c, y| {
+            c.lam(c.at(r), |c, y2| {
+                let ty = id(c.at(r), c.at(y), c.at(y2));
+                c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(y)), pick(c, c.at(a), c.at(y2))))
+            })
+        });
+        let inner_b = c.lam(c.at(r), |c, y| refl(pick(c, c.at(a), c.at(y))));
+        jelim(inner_m, inner_b, c.at(e), c.at(e2), c.at(pe))
+    });
+    jelim(outer_m, outer_b, t, t2, pt)
+}
+
+fn spine(e: &Expr) -> (Expr, Vec<Expr>) {
+    let (mut args, mut cur) = (vec![], *e);
+    while let tatic_kernel::Node::App(f, a) = cur.node() {
+        args.push(a);
+        cur = f;
+    }
+    args.reverse();
+    (cur, args)
+}
+
+/// The sizes one function is generated at: `m` parameters, `e` (0 or 1) environment slots and `t` temporaries.
+#[derive(Clone, Copy)]
+struct G<'a> {
+    w: Wasm,
+    n: usize,
+    m: usize,
+    e: usize,
+    t: usize,
+    heap: &'a HeapSpec,
+    /// Whether the code touches the heap, so the statement carries `GoodBv` witnesses for the pointer parameters.
+    good: bool,
+}
+
+/// The flat binder lists, named: `[d] a.. cv.. [t..] hp h km ks rel cell_hyps.. [good..]`.
+struct Bind {
+    d: Option<At>,
+    args: Vec<At>,
+    cvs: Vec<At>,
+    temps: Vec<At>,
+    hp: At,
+    h: At,
+    km: At,
+    ks: At,
+    rel: At,
+    hyps: Vec<At>,
+    gws: Vec<At>,
+}
+
+impl G<'_> {
+    fn v(&self) -> Expr {
+        self.w.v()
+    }
+    /// How many parameters the source takes: the machine's non-pointer ones, then one per cell.
+    fn nsrc(&self) -> usize {
+        self.m - self.heap.ptrs.len() + self.heap.cells.len()
+    }
+    /// The source's arguments from the machine's parameters and the cells' values.
+    fn src_args<T: Copy>(&self, args: &[T], cvs: &[T]) -> Vec<T> {
+        let mut v: Vec<T> = (0..self.m).filter(|i| !self.heap.ptrs.contains(i)).map(|i| args[i]).collect();
+        v.extend_from_slice(cvs);
+        v
+    }
+    /// A flat binder list as `Bind`: with the dummy numeral and the temporaries (`binders`) or without (`law_binders`).
+    fn view(&self, x: &[At], full: bool) -> Bind {
+        let (m, nc, t) = (self.m, self.heap.cells.len(), if full { self.t } else { 0 });
+        let a0 = full as usize;
+        let hp = a0 + m + nc + t;
+        let gw = hp + 5 + nc;
+        Bind {
+            d: full.then(|| x[0]),
+            args: x[a0..a0 + m].to_vec(),
+            cvs: x[a0 + m..a0 + m + nc].to_vec(),
+            temps: x[a0 + m + nc..hp].to_vec(),
+            hp: x[hp],
+            h: x[hp + 1],
+            km: x[hp + 2],
+            ks: x[hp + 3],
+            rel: x[hp + 4],
+            hyps: x[hp + 5..gw].to_vec(),
+            gws: x[gw..].to_vec(),
+        }
+    }
+    /// The address of cell `k`, `param + offset`, over the parameters `args`.
+    fn cell_addr(&self, k: usize, args: &[Expr]) -> Expr {
+        let (p, off) = self.heap.cells[k];
+        if off == 0 {
+            return args[p];
+        }
+        app2(Op::Add.term(self.n), args[p], lit(self.n, off))
+    }
+    /// `Pi K. Id(R, h addr K, K cv)`: the heap holds `cv` at the cell's address, whatever else it holds.
+    fn cell_ty(&self, c: &mut Cx, r: At, h: At, k: usize, args: &[At], cv: At) -> Expr {
+        let kt = arrow(self.v(), c.at(r));
+        c.pi(kt, |c, kk| {
+            // built under the binder, so its indices count it
+            let addr = self.cell_addr(k, &args.iter().map(|a| c.at(*a)).collect::<Vec<_>>());
+            id(c.at(r), app2(c.at(h), addr, c.at(kk)), app(c.at(kk), c.at(cv)))
+        })
+    }
+    /// `Pi (cell k in h) ... . then`, one premise per cell index.
+    fn post_pis(&self, c: &mut Cx, r: At, h: At, args: &[At], cvs: &[At], idx: &[usize], then: &mut dyn FnMut(&mut Cx) -> Expr) -> Expr {
+        match idx.split_first() {
+            None => then(c),
+            Some((k, rest)) => {
+                let ty = self.cell_ty(c, r, h, *k, args, cvs[*k]);
+                c.pi(ty, |c, _| self.post_pis(c, r, h, args, cvs, rest, then))
+            }
+        }
+    }
+    /// `Ret = V -> Mem -> R`.
+    fn ret_m(&self, c: &mut Cx, r: At) -> Expr {
+        let mem = self.w.mem(c, r);
+        arrow(self.v(), arrow(mem, c.at(r)))
+    }
+    /// `H = Fr -> Mem -> Ret -> R`.
+    fn hm(&self, c: &mut Cx, r: At) -> Expr {
+        let (mem, ret) = (self.w.mem(c, r), self.ret_m(c, r));
+        arrow(self.w.fr(), arrow(mem, arrow(ret, c.at(r))))
+    }
+    fn ret_s(&self, c: &Cx, r: At) -> Expr {
+        arrow(self.v(), c.at(r))
+    }
+    /// `Hs = V^m -> (V -> R) -> R`.
+    fn hs(&self, c: &Cx, r: At) -> Expr {
+        (0..self.nsrc()).fold(arrow(self.ret_s(c, r), c.at(r)), |acc, _| arrow(self.v(), acc))
+    }
+    /// `Pi a hp h. (the cells in post hold in h) -> Id(R, km a (hp, h), ks a)`, the cells at the parameters `args`, valued `cvs`.
+    fn rel_ty(&self, c: &mut Cx, r: At, km: At, ks: At, args: &[At], cvs: &[At]) -> Expr {
+        let w = self.w;
+        // over the components of the state, not a state variable: a `sigrec` on a variable is stuck (no eta)
+        c.pi(self.v(), |c, a| {
+            c.pi(self.v(), |c, hp| {
+                let hh = w.heap(c, r);
+                c.pi(hh, |c, h| {
+                    self.post_pis(c, r, h, args, cvs, &self.heap.post, &mut |c| {
+                        let mu = w.mkmu(c, r, c.at(hp), c.at(h));
+                        id(c.at(r), app2(c.at(km), c.at(a), mu), app(c.at(ks), c.at(a)))
+                    })
+                })
+            })
+        })
+    }
+    /// The frame holding the parameters `args`, the environment's 0 (if any) and the temporaries `temps`, zeros after.
+    fn frame(&self, args: &[Expr], temps: &[Expr]) -> Expr {
+        let mut vals = args.to_vec();
+        if self.e == 1 {
+            vals.push(lit(self.n, 0));
+        }
+        vals.extend_from_slice(temps);
+        self.w.frame(&vals)
+    }
+    fn tm(&self, c: &mut Cx, r: At, z: At) -> Expr {
+        let w = self.w;
+        c.lam(w.fr(), |c, _| {
+            let mem = w.mem(c, r);
+            c.lam(mem, |c, _| {
+                let ret = self.ret_m(c, r);
+                c.lam(ret, |c, _| c.at(z))
+            })
+        })
+    }
+    fn ts(&self, c: &mut Cx, r: At, z: At) -> Expr {
+        let n = self.n;
+        let args: Vec<Ty> = (0..self.nsrc()).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+        tele(c, &args, &mut vec![], &lam, &mut |c, _| {
+            let rs = self.ret_s(c, r);
+            c.lam(rs, |c, _| c.at(z))
+        })
+    }
+    /// `Bm = \env fr mu k. M_env (prog code) fr 0 mu`, the body's answer passed to `k`, the module's table built by
+    /// `table` from `env` (the function's own fuel-unrolled environment).
+    fn bm(&self, c: &mut Cx, r: At, z: At, ch: Option<At>, code: &[Ins], table: &dyn Fn(&mut Cx, At) -> Expr) -> Expr {
+        let (w, n) = (self.w, self.n);
+        let hm = self.hm(c, r);
+        c.lam(hm, |c, env| {
+            c.lam(w.fr(), |c, fr| {
+                let mem = w.mem(c, r);
+                c.lam(mem, |c, mu| {
+                    let rm = self.ret_m(c, r);
+                    c.lam(rm, |c, k| {
+                        let base = c.mark(w.v());
+                        let p = w.prog(c, code, &[], base);
+                        let p = c.mark(p);
+                        let fuel0 = c.mark(nat2_lit(0));
+                        let st_ty = prod(w.v(), c.at(base));
+                        let kk = c.lam(w.fr(), |c, _| {
+                            c.lam(st_ty, |c, st| {
+                                let mem = w.mem(c, r);
+                                c.lam(mem, |c, mu2| w.split(c, r, w.v(), base, st, |c, y, _| app2(c.at(k), c.at(y), c.at(mu2))))
+                            })
+                        });
+                        let kk = c.mark(kk);
+                        let restart = c.lam(w.fr(), |c, f2| {
+                            let mem = w.mem(c, r);
+                            c.lam(mem, |c, m2| app3(c.at(env), c.at(f2), c.at(m2), c.at(k)))
+                        });
+                        let restart = c.mark(restart);
+                        let tbl = table(c, env);
+                        let tbl = c.mark(tbl);
+                        let hooks = Hooks { env: Some(tbl), lab: Some(restart), ret: Some(k), ch };
+                        let m = w.meaning_with(c, p, fuel0, r, kk, z, &hooks);
+                        app3(m, c.at(fr), lit(n, 0), c.at(mu))
+                    })
+                })
+            })
+        })
+    }
+    /// `Bs = \g x.. ks. cps src`.
+    fn bs(&self, c: &mut Cx, r: At, ch: Option<At>, src: &SrcFn, fuel: At, callees: &[(usize, At)]) -> Expr {
+        let n = self.n;
+        let hs = self.hs(c, r);
+        c.lam(hs, |c, g| {
+            let vs: Vec<Ty> = (0..self.nsrc()).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+            tele(c, &vs, &mut vec![], &lam, &mut |c, xs| {
+                let rs = self.ret_s(c, r);
+                c.lam(rs, |c, ks| {
+                    let mp = xs.len() - self.heap.cells.len();
+                    let env = SEnv { n, r, g, params: xs[..mp].to_vec(), cells: xs[mp..].to_vec(), ch, fuel, callees: callees.to_vec() };
+                    src(c, &env, &|c, v| app(c.at(ks), v))
+                })
+            })
+        })
+    }
+    /// The binder types of `binders` (`full`) or `law_binders`: `[d] a_0..a_{m-1} cv_0..cv_{c-1} [t_0..t_{t-1}] hp h km ks
+    /// rel cell_0..cell_{c-1} [GoodBv of each pointer parameter]`, the components of the state as separate binders.
+    fn binder_tys<'b>(&'b self, r: At, full: bool) -> Vec<Ty<'b>> {
+        let (g, n, m, nc) = (self, self.n, self.m, self.heap.cells.len());
+        let t = if full { self.t } else { 0 };
+        let a0 = full as usize;
+        let hp = a0 + m + nc + t;
+        let mut tys: Vec<Ty> = vec![];
+        if full {
+            tys.push(ty!(|_c, _x| nat2()));
+        }
+        tys.extend((0..m + nc + t).map(|_| ty!(|_c, _x| bv_ty(n))));
+        tys.push(ty!(|_c, _x| bv_ty(n)));
+        tys.push(ty!(|c, _x| g.w.heap(c, r)));
+        tys.push(ty!(|c, _x| g.ret_m(c, r)));
+        tys.push(ty!(|c, _x| g.ret_s(c, r)));
+        tys.push(ty!(|c, x| g.rel_ty(c, r, x[hp + 2], x[hp + 3], &x[a0..a0 + m], &x[a0 + m..a0 + m + nc])));
+        for k in 0..nc {
+            tys.push(ty!(|c, x| g.cell_ty(c, r, x[hp + 1], k, &x[a0..a0 + m], x[a0 + m + k])));
+        }
+        if g.good {
+            for &pi in &g.heap.ptrs {
+                tys.push(ty!(|c, x| app(good_bv(n), c.at(x[a0 + pi]))));
+            }
+        }
+        tys
+    }
+    /// The binders of the induction's motive, step and hypothesis applications, after the dummy numeral that lifts the
+    /// motive to Sort3 (see `binder_tys`).
+    fn binders(&self, c: &mut Cx, r: At, wrap: &dyn Fn(Expr, Expr) -> Expr, body: &mut dyn FnMut(&mut Cx, &Bind) -> Expr) -> Expr {
+        tele(c, &self.binder_tys(r, true), &mut vec![], wrap, &mut |c, x| body(c, &self.view(x, true)))
+    }
+    /// The binders of a function's law after `N gn R z`.
+    fn law_binders(&self, c: &mut Cx, r: At, wrap: &dyn Fn(Expr, Expr) -> Expr, body: &mut dyn FnMut(&mut Cx, &[At]) -> Expr) -> Expr {
+        tele(c, &self.binder_tys(r, false), &mut vec![], wrap, body)
+    }
+}
+
+/// Whether the code touches the heap, so its statement carries `GoodBv` witnesses for the pointer parameters.
+fn uses_heap(code: &[Ins]) -> bool {
+    code.iter().any(|i| match i {
+        Ins::Load | Ins::Store => true,
+        Ins::Loop(b) => uses_heap(b),
+        Ins::If(t, e) => uses_heap(t) || uses_heap(e),
+        _ => false,
+    })
+}
+
+/// What `gen_module` checks of a function's code before generating anything.
+fn check_code(code: &[Ins], arity: usize, env: bool, temps: usize) -> Result<(), String> {
+    fn walk(code: &[Ins], locals: usize, top: bool) -> Result<(), String> {
+        for ins in code {
+            match ins {
+                Ins::Loop(b) if top && code.len() == 1 => walk(b, locals, false)?,
+                Ins::Loop(_) => return Err("a loop other than the function's one top-level loop".into()),
+                Ins::If(t, e) => {
+                    walk(t, locals, false)?;
+                    walk(e, locals, false)?
+                }
+                Ins::LocalGet(i) | Ins::LocalSet(i) | Ins::GetI(i) if *i as usize >= locals => return Err(format!("local {i} out of range")),
+                Ins::Raw(s) => return Err(format!("raw line {s:?}")),
+                Ins::Dup => return Err(format!("{ins:?}: not modelled here")),
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+    walk(code, arity + env as usize + temps, true)?;
+    match shape(code, vec![], &[]) {
+        Ok(Some(s)) if s == vec![K::W] => Ok(()),
+        other => Err(format!("the body does not run from [] to [word]: {other:?}")),
+    }
+}
+
+/// A function's pieces as marks at the base depth of a proof: its `Bm`, `Bs`, and `N H timeout Bm`, `N Hs ts Bs`.
+#[derive(Clone, Copy)]
+struct Real {
+    bm: At,
+    bs: At,
+    hc: At,
+    sc: At,
+}
+
+/// The module at one context: the fuel `N`, the answer sort `r` and `z`, with the real (probe-free) pieces of each
+/// function built on demand (at the depth this was made, so every mark is valid under all deeper binders).
+struct Ctxt<'a> {
+    w: Wasm,
+    funcs: &'a [FuncSpec<'a>],
+    fuel: At,
+    r: At,
+    z: At,
+    hm: At,
+    tm: At,
+    memo: RefCell<Vec<Option<Real>>>,
+}
+
+impl<'a> Ctxt<'a> {
+    fn new(c: &mut Cx, w: Wasm, funcs: &'a [FuncSpec<'a>], fuel: At, r: At, z: At) -> Self {
+        let g0 = G { w, n: w.n, m: 0, e: 0, t: 0, heap: &NOHEAP, good: false };
+        let hm = {
+            let e = g0.hm(c, r);
+            c.mark(e)
+        };
+        let tm = {
+            let e = g0.tm(c, r, z);
+            c.mark(e)
+        };
+        Ctxt { w, funcs, fuel, r, z, hm, tm, memo: RefCell::new(vec![None; funcs.len()]) }
+    }
+    fn g(&self, k: usize) -> G<'a> {
+        g_of(self.w, &self.funcs[k])
+    }
+    /// The table of function `k`: `\i fr mu kont. (i == k) (env fr mu kont) ((i == c) (H_c fr mu kont) .. z)`.
+    fn table(&self, c: &mut Cx, k: usize, env: At, cs: &[(usize, Real)]) -> Expr {
+        let (w, r, z, n) = (self.w, self.r, self.z, self.w.n);
+        c.lam(w.v(), |c, i| {
+            c.lam(w.fr(), |c, fr| {
+                let mem = w.mem(c, r);
+                c.lam(mem, |c, mu| {
+                    let rm = G { w, n, m: 0, e: 0, t: 0, heap: &NOHEAP, good: false }.ret_m(c, r);
+                    c.lam(rm, |c, kont| {
+                        let pick = |c: &Cx, pos: usize, yes: Expr, no: Expr| app3(app2(eq_bv(n), c.at(i), lit(n, pos as u128)), c.at(r), yes, no);
+                        let mut acc = c.at(z);
+                        for (pos, re) in cs.iter().rev() {
+                            let call = app3(c.at(re.hc), c.at(fr), c.at(mu), c.at(kont));
+                            acc = pick(c, *pos, call, acc);
+                        }
+                        let me = app3(c.at(env), c.at(fr), c.at(mu), c.at(kont));
+                        pick(c, k, me, acc)
+                    })
+                })
+            })
+        })
+    }
+    /// `Bm_k` and `Bs_k`, through the probe `probe` if any; the callees' real pieces are those of `real`.
+    fn bm_bs(&self, c: &mut Cx, k: usize, probe: Option<At>) -> (Expr, Expr) {
+        let f = &self.funcs[k];
+        let g = self.g(k);
+        let cs: Vec<(usize, Real)> = f.callees.iter().map(|&p| (p, self.real(c, p))).collect();
+        let bm = g.bm(c, self.r, self.z, probe, &f.code, &|c, env| self.table(c, k, env, &cs));
+        let scs: Vec<(usize, At)> = cs.iter().map(|(p, re)| (*p, re.sc)).collect();
+        let bs = g.bs(c, self.r, probe, f.src, self.fuel, &scs);
+        (bm, bs)
+    }
+    fn real(&self, c: &mut Cx, k: usize) -> Real {
+        let cached = self.memo.borrow()[k];
+        if let Some(re) = cached {
+            return re;
+        }
+        let g = self.g(k);
+        let (bm, bs) = self.bm_bs(c, k, None);
+        let (bm, bs) = (c.mark(bm), c.mark(bs));
+        let hs = {
+            let e = g.hs(c, self.r);
+            c.mark(e)
+        };
+        let ts = {
+            let e = g.ts(c, self.r, self.z);
+            c.mark(e)
+        };
+        let hc = c.mark(apps(c.at(self.fuel), vec![c.at(self.hm), c.at(self.tm), c.at(bm)]));
+        let sc = c.mark(apps(c.at(self.fuel), vec![c.at(hs), c.at(ts), c.at(bs)]));
+        let re = Real { bm, bs, hc, sc };
+        self.memo.borrow_mut()[k] = Some(re);
+        re
+    }
+    /// The law of function `k`: `Pi x.. cv.. hp h km ks rel. Id(R, N H timeout Bm_k (frame x..) (hp, h) km, N Hs ts Bs_k x.. cv.. ks)`.
+    fn law(&self, c: &mut Cx, k: usize) -> Expr {
+        let g = self.g(k);
+        let re = self.real(c, k);
+        let r = self.r;
+        g.law_binders(c, r, &pi, &mut |c, x| {
+            let b = g.view(x, false);
+            let args: Vec<Expr> = b.args.iter().map(|a| c.at(*a)).collect();
+            let mu = g.w.mkmu(c, r, c.at(b.hp), c.at(b.h));
+            let l = app3(c.at(re.hc), g.frame(&args, &[]), mu, c.at(b.km));
+            let sargs: Vec<Expr> = g.src_args(&b.args, &b.cvs).iter().map(|a| c.at(*a)).collect();
+            let rhs = apps(c.at(re.sc), [sargs, vec![c.at(b.ks)]].concat());
+            id(c.at(r), l, rhs)
+        })
+    }
+}
+
+/// The sizes function `f` is generated at.
+fn g_of<'a>(w: Wasm, f: &'a FuncSpec) -> G<'a> {
+    G { w, n: w.n, m: f.arity, e: f.env as usize, t: f.temps, heap: &f.heap, good: !f.heap.cells.is_empty() || uses_heap(&f.code) }
+}
+
+/// The module-wide frame width: the widest function's parameters, environment slot and temporaries.
+fn widen(w: Wasm, funcs: &[FuncSpec]) -> Wasm {
+    Wasm { fw: funcs.iter().map(|f| f.arity + f.env as usize + f.temps).max().unwrap_or(0), ..w }
+}
+
+/// What the walk needs of a callee.
+struct CalleeRule<'a> {
+    g: G<'a>,
+    bm: At,
+    bs: At,
+    hc: At,
+}
+
+/// The telescope `N gn R z`, then (for the proof and the closed composition) the callees' laws.
+fn head_tys<'a>(w: Wasm, funcs: &'a [FuncSpec<'a>], callees: &[usize], with_laws: bool) -> Vec<Ty<'a>> {
+    let mut tys: Vec<Ty> = vec![ty!(|_c, _x| nat2()), ty!(|c, x| w.good_nat(c, x[0])), ty!(|_c, _x| sort(0)), ty!(|c, x| c.at(x[2]))];
+    if with_laws {
+        for &p in callees {
+            tys.push(ty!(|c, x| {
+                let cx = Ctxt::new(c, w, funcs, x[0], x[2], x[3]);
+                cx.law(c, p)
+            }));
+        }
+    }
+    tys
+}
+
+/// The proof of function `k`'s law, with the callees' laws as hypotheses and the probe `CH` as its first parameter:
+/// `\CH N gn R z HC.. x.. h km ks rel. ..`, or why the two do not simulate each other.
+fn proof_open(w: Wasm, funcs: &[FuncSpec], k: usize) -> Result<Expr, String> {
+    let f = &funcs[k];
+    check_code(&f.code, f.arity, f.env, f.temps)?;
+    let g = g_of(w, f);
+    let nhc = f.callees.len();
+    let err: RefCell<Option<String>> = RefCell::new(None);
+    let tys = head_tys(w, funcs, &f.callees, true);
+    let proof = Cx::default().lam(ch_ty(), |c, ch| {
+      let ht_ty = probe_ty(c, ch, true);
+      c.lam(ht_ty, |c, ht| {
+       let hf_ty = probe_ty(c, ch, false);
+       c.lam(hf_ty, |c, hf| {
+        tele(c, &tys, &mut vec![], &lam, &mut |c, x| {
+            let (fuel, gn, r, z) = (x[0], x[1], x[2], x[3]);
+            let cx = Ctxt::new(c, w, funcs, fuel, r, z);
+            let rules: Vec<CalleeRule> = f
+                .callees
+                .iter()
+                .zip(&x[4..4 + nhc])
+                .map(|(p, hc)| {
+                    let re = cx.real(c, *p);
+                    CalleeRule { g: cx.g(*p), bm: re.bm, bs: re.bs, hc: *hc }
+                })
+                .collect();
+            let (hm, tm) = (cx.hm, cx.tm);
+            let (bm0, bs0) = cx.bm_bs(c, k, Some(ch));
+            let (bm, bs) = (c.mark(bm0), c.mark(bs0));
+            let (hs0, ts0) = (g.hs(c, r), g.ts(c, r, z));
+            let (hs, ts) = (c.mark(hs0), c.mark(ts0));
+            g.law_binders(c, r, &lam, &mut |c, y| {
+                let b0 = g.view(y, false);
+                // the motive at a fuel: the binders, then the two sides
+                let mot = |c: &mut Cx, mm: Expr| {
+                    let mm = c.mark(mm);
+                    g.binders(c, r, &pi, &mut |c, b| {
+                        let ex = |c: &Cx, ys: &[At]| ys.iter().map(|a| c.at(*a)).collect::<Vec<Expr>>();
+                        let (ya, ycv, yt) = (ex(c, &b.args), ex(c, &b.cvs), ex(c, &b.temps));
+                        let mu = g.w.mkmu(c, r, c.at(b.hp), c.at(b.h));
+                        let l = app3(apps(c.at(mm), vec![c.at(hm), c.at(tm), c.at(bm)]), g.frame(&ya, &yt), mu, c.at(b.km));
+                        let sargs = g.src_args(&ya, &ycv);
+                        let rhs = apps(c.at(mm), [vec![c.at(hs), c.at(ts), c.at(bs)], sargs, vec![c.at(b.ks)]].concat());
+                        id(c.at(r), l, rhs)
+                    })
+                };
+                let motive = c.lam(nat2(), |c, mm| mot(c, c.at(mm)));
+                let hz = g.binders(c, r, &lam, &mut |c, _| refl(c.at(z)));
+                let step = c.lam(nat2(), |c, j| {
+                    let ih_ty = mot(c, c.at(j));
+                    c.lam(ih_ty, |c, ih| {
+                        g.binders(c, r, &lam, &mut |c, b| {
+                            let sim = Sim {
+                                g: &g,
+                                r,
+                                ch,
+                                j,
+                                ih,
+                                fuel,
+                                d: b.d.unwrap(),
+                                hp: b.hp,
+                                h: b.h,
+                                km: b.km,
+                                ks: b.ks,
+                                rel: b.rel,
+                                args: b.args.clone(),
+                                cvs: b.cvs.clone(),
+                                hyps: b.hyps.clone(),
+                                gptrs: g.heap.ptrs.iter().copied().zip(b.gws.iter().copied()).collect(),
+                                ht,
+                                hf,
+                                lem: Lemmas::default(),
+                                facts: RefCell::new(vec![]),
+                                callees: &rules,
+                            };
+                            let ex = |c: &Cx, ys: &[At]| ys.iter().map(|a| c.at(*a)).collect::<Vec<Expr>>();
+                            let fr = g.frame(&ex(c, &b.args), &ex(c, &b.temps));
+                            let mj = apps(c.at(j), vec![c.at(hm), c.at(tm), c.at(bm)]);
+                            let sj = apps(c.at(j), vec![c.at(hs), c.at(ts), c.at(bs)]);
+                            let mu = g.w.mkmu(c, r, c.at(b.hp), c.at(b.h));
+                            let m0 = apps(c.at(bm), vec![mj, fr, mu, c.at(b.km)]);
+                            let sargs = g.src_args(&ex(c, &b.args), &ex(c, &b.cvs));
+                            let s0 = apps(c.at(bs), [vec![sj], sargs, vec![c.at(b.ks)]].concat());
+                            match sim.sim(c, m0, s0, "body") {
+                                Ok(p) => p,
+                                Err(e) => {
+                                    err.borrow_mut().get_or_insert(e);
+                                    refl(m0)
+                                }
+                            }
+                        })
+                    })
+                });
+                let mut all = vec![motive, hz, step, nat2_lit(0)];
+                let at = |c: &Cx, ys: &[At]| ys.iter().map(|a| c.at(*a)).collect::<Vec<Expr>>();
+                all.extend(at(c, &b0.args));
+                all.extend(at(c, &b0.cvs));
+                all.extend((0..g.t).map(|_| lit(w.n, 0)));
+                all.extend([c.at(b0.hp), c.at(b0.h), c.at(b0.km), c.at(b0.ks), c.at(b0.rel)]);
+                all.extend(at(c, &b0.hyps));
+                all.extend(at(c, &b0.gws));
+                apps(c.at(gn), all)
+            })
+        })
+       })
+      })
+    });
+    if let Some(e) = err.into_inner() {
+        return Err(e);
+    }
+    Ok(proof)
+}
+
+/// The closed proof of function `k`'s law, `Pi N gn R z, law_k`: the probe applied to `choose`, every callee's law
+/// discharged by that callee's own closed proof.
+fn closed(w: Wasm, funcs: &[FuncSpec], k: usize) -> Result<Expr, String> {
+    let open = apps(proof_open(w, funcs, k)?, vec![choose_fn(), probe_real(true), probe_real(false)]);
+    let callees = &funcs[k].callees;
+    let closed_callees: Vec<Expr> = callees.iter().map(|p| closed(w, funcs, *p)).collect::<Result<_, _>>()?;
+    let tys = head_tys(w, funcs, callees, false);
+    Ok(tele(&mut Cx::default(), &tys, &mut vec![], &lam, &mut |c, x| {
+        let nzs: Vec<At> = x.to_vec();
+        let mut all: Vec<Expr> = nzs.iter().map(|a| c.at(*a)).collect();
+        for (p, cl) in callees.iter().zip(&closed_callees) {
+            let gc = g_of(w, &funcs[*p]);
+            let law = gc.law_binders(c, nzs[2], &lam, &mut |c, y| {
+                apps(*cl, [nzs.iter().map(|a| c.at(*a)).collect::<Vec<_>>(), y.iter().map(|a| c.at(*a)).collect()].concat())
+            });
+            all.push(law);
+        }
+        apps(open, all)
+    }))
+}
+
+/// `(proof, statement)` that function `entry` of the module simulates its source, for every fuel: `Pi N gn R z, law_entry`.
+/// Every function it calls (and they, theirs) is proved on its own and enters as a hypothesis, then is discharged.
+pub fn gen_module(w: Wasm, funcs: &[FuncSpec], entry: usize) -> Result<(Expr, Expr), String> {
+    let (proof, stmt) = gen_module_parts(w, funcs, entry)?;
+    Ok((proof?, stmt))
+}
+
+/// `gen_module`, the statement kept when the generator's walk refuses the proof (SPIKE m2: a test checks another module's
+/// proof against it). Ill-formed code is still an outer error: no statement is built over it.
+pub fn gen_module_parts(w: Wasm, funcs: &[FuncSpec], entry: usize) -> Result<(Result<Expr, String>, Expr), String> {
+    for f in funcs {
+        check_code(&f.code, f.arity, f.env, f.temps)?;
+    }
+    let w = widen(w, funcs);
+    let proof = closed(w, funcs, entry);
+    let tys = head_tys(w, funcs, &[], false);
+    let stmt = tele(&mut Cx::default(), &tys, &mut vec![], &pi, &mut |c, x| {
+        let cx = Ctxt::new(c, w, funcs, x[0], x[2], x[3]);
+        cx.law(c, entry)
+    });
+    Ok((proof, stmt))
+}
+
+/// `gen_module` for one function with no callees and no environment parameter.
+pub fn gen_sim(w: Wasm, code: &[Ins], arity: usize, temps: usize, src: &SrcFn) -> Result<(Expr, Expr), String> {
+    gen_sim_with(w, code, arity, temps, HeapSpec::default(), src)
+}
+
+/// `gen_sim` over a function with the heap cells `heap` fixed by its statement.
+pub fn gen_sim_with(w: Wasm, code: &[Ins], arity: usize, temps: usize, heap: HeapSpec, src: &SrcFn) -> Result<(Expr, Expr), String> {
+    let f = FuncSpec { code: code.to_vec(), arity, env: false, temps, callees: vec![], src, heap };
+    gen_module(w, std::slice::from_ref(&f), 0)
+}
+
+/// The address lemmas, built when a walk first needs one.
+#[derive(Default)]
+struct Lemmas {
+    refl: OnceCell<Expr>,
+    comm: OnceCell<Expr>,
+    region: OnceCell<Expr>,
+    cancel: OnceCell<Expr>,
+    good_add: OnceCell<Expr>,
+}
+
+/// One walk's fixed names.
+struct Sim<'g> {
+    g: &'g G<'g>,
+    r: At,
+    ch: At,
+    j: At,
+    ih: At,
+    fuel: At,
+    d: At,
+    hp: At,
+    h: At,
+    km: At,
+    ks: At,
+    rel: At,
+    args: Vec<At>,
+    cvs: Vec<At>,
+    /// the statement's cell hypotheses, one per cell
+    hyps: Vec<At>,
+    /// `(parameter, GoodBv witness)` for each pointer parameter
+    gptrs: Vec<(usize, At)>,
+    ht: At,
+    hf: At,
+    lem: Lemmas,
+    /// Heaps a returned call's `rel` premises describe, pushed while its continuation is walked.
+    facts: RefCell<Vec<Fact<'g>>>,
+    callees: &'g [CalleeRule<'g>],
+}
+
+/// A heap known to hold the post cells `hyps` (cell index, hypothesis) of the function `g` at the parameters `args`,
+/// valued `cvs`.
+struct Fact<'a> {
+    g: G<'a>,
+    h: At,
+    args: Vec<At>,
+    cvs: Vec<At>,
+    hyps: Vec<(usize, At)>,
+}
+
+/// `\u. \C k. k u : Bool0 -> Bv1`: a bit as a one-bit word (`eq_bit a b` is this of `eq a b`).
+fn fmap() -> Expr {
+    lam(bool0(), lam(sort(1), lam(karrow(1), app(var(0), var(2)))))
+}
+
+/// `p : a = b`, `q : b = c` give `a = c`.
+fn trans(c: &mut Cx, r: At, (a, b, cc): (Expr, Expr, Expr), p: Expr, q: Expr) -> Expr {
+    let a = c.mark(a);
+    let motive = c.lam(c.at(r), |c, u| {
+        c.lam(c.at(r), |c, v| {
+            let ty = id(c.at(r), c.at(u), c.at(v));
+            c.lam(ty, |c, _| arrow(id(c.at(r), c.at(a), c.at(u)), id(c.at(r), c.at(a), c.at(v))))
+        })
+    });
+    let base = c.lam(c.at(r), |c, u| {
+        let ty = id(c.at(r), c.at(a), c.at(u));
+        c.lam(ty, |c, h| c.at(h))
+    });
+    app(jelim(motive, base, b, cc, q), p)
+}
+
+impl<'g> Sim<'g> {
+    /// What a term in weak head normal form is doing, for the reasons.
+    fn kind(&self, c: &Cx, head: &Expr) -> &'static str {
+        if *head == c.at(self.km) || *head == c.at(self.ks) {
+            "returns"
+        } else if *head == c.at(self.ch) {
+            "branches"
+        } else if *head == c.at(self.j) {
+            "recurses"
+        } else if *head == c.at(self.fuel) {
+            "calls another function"
+        } else if *head == c.at(self.h) {
+            "reads the heap"
+        } else {
+            "is stuck"
+        }
+    }
+
+    /// A proof of `Id(R, m, s)`.
+    fn sim(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        tatic_kernel::grow(|| self.sim_step(c, m, s, path))
+    }
+
+    /// The `fw` words of a frame, read off its pair spine.
+    fn slots(&self, fr: Expr, path: &str) -> Result<Vec<Expr>, String> {
+        let (mut cur, mut xs) = (fr, vec![]);
+        for _ in 0..self.g.w.fw {
+            let tatic_kernel::Node::Pair(_, x, rest) = whnf(&cur).node() else {
+                return Err(format!("{path}: the frame is not a pair spine of the module's width"));
+            };
+            xs.push(x);
+            cur = rest;
+        }
+        Ok(xs)
+    }
+
+    /// The two components of a memory in weak head normal form: `(hp, heap)`.
+    fn parts(st: &Expr) -> Option<(Expr, Expr)> {
+        let tatic_kernel::Node::Pair(_, hp, heap) = whnf(st).node() else { return None };
+        Some((hp, heap))
+    }
+
+    // ---- addresses
+
+    /// `base + off` as built (not reduced), or the whole address with no offset.
+    fn addr_parts(&self, e: &Expr) -> (Expr, Option<Expr>) {
+        let (h, a) = spine(e);
+        if a.len() == 2 && def_eq(&h, &Op::Add.term(self.g.n)) { (a[0], Some(a[1])) } else { (*e, None) }
+    }
+
+    /// The word a literal builds, if `e` is one.
+    fn as_lit(&self, e: &Expr) -> Option<u128> {
+        let tatic_kernel::Node::Lam(_, b) = e.node() else { return None };
+        let tatic_kernel::Node::Lam(_, b) = b.node() else { return None };
+        let (h, bits) = spine(&b);
+        if h != var(0) || bits.len() != self.g.n {
+            return None;
+        }
+        let mut v = 0u128;
+        for (i, bt) in bits.iter().enumerate() {
+            if def_eq(bt, &t()) {
+                v |= 1 << i;
+            } else if !def_eq(bt, &f()) {
+                return None;
+            }
+        }
+        Some(v)
+    }
+
+    /// A proof of `GoodBv e` for an address built from a pointer parameter, literals and `+`.
+    fn good_of(&self, c: &Cx, e: &Expr) -> Result<Expr, String> {
+        let n = self.g.n;
+        if let Some((_, gp)) = self.gptrs.iter().find(|(pi, _)| def_eq(e, &c.at(self.args[*pi]))) {
+            return Ok(c.at(*gp));
+        }
+        if let Some(v) = self.as_lit(e) {
+            return Ok(good_lit(n, v));
+        }
+        let (h, a) = spine(e);
+        if a.len() == 2 && def_eq(&h, &Op::Add.term(n)) {
+            let (ga, gb) = (self.good_of(c, &a[0])?, self.good_of(c, &a[1])?);
+            let ad = self.lem.good_add.get_or_init(|| good_add(n).0);
+            return Ok(apps(*ad, vec![a[0], a[1], ga, gb]));
+        }
+        Err("an address is not built from a pointer parameter, literals and +: no GoodBv witness".into())
+    }
+
+    /// For a store at `s` read at `t` (each one base and at most one literal offset): whether the two are the same
+    /// address, and a proof of `Id(Bool0, eq s t, true or false)` (up to conversion of the right side).
+    fn decide(&self, c: &Cx, s: &Expr, t: &Expr) -> Result<(bool, Expr), String> {
+        let n = self.g.n;
+        let eq = |x: &Expr, y: &Expr| app2(eq_bv(n), *x, *y);
+        if def_eq(s, t) {
+            let g = self.good_of(c, s)?;
+            let l = self.lem.refl.get_or_init(|| eq_refl_lemma(n).0);
+            return Ok((true, apps(*l, vec![*s, g])));
+        }
+        let ((bs, os), (bt, ot)) = (self.addr_parts(s), self.addr_parts(t));
+        let zero = lit(n, 0);
+        match (os, ot) {
+            // a store at `p`, a read at `p + j`: commute, then the region lemma `eq (p + j) p = eq j 0`
+            (None, Some(j)) if def_eq(&bs, &bt) => {
+                if !def_eq(&eq(&j, &zero), &f()) {
+                    return Err("a store at p and a read at p + j, with j not a nonzero literal".into());
+                }
+                let (gs, gt, gj) = (self.good_of(c, s)?, self.good_of(c, t)?, self.good_of(c, &j)?);
+                let comm = apps(*self.lem.comm.get_or_init(|| eq_comm_law(n).0), vec![*s, *t, gs, gt]);
+                let reg = apps(*self.lem.region.get_or_init(|| region_law(n, Rg::Ok).0), vec![*s, j, gs, gj]);
+                Ok((false, trans_proof(&bool0(), &eq(s, t), &eq(t, s), &eq(&j, &zero), comm, reg)))
+            }
+            // a store at `p + j`, a read at `p`: the region lemma as it stands
+            (Some(j), None) if def_eq(&bs, t) => {
+                if !def_eq(&eq(&j, &zero), &f()) {
+                    return Err("a store at p + j and a read at p, with j not a nonzero literal".into());
+                }
+                let (gt, gj) = (self.good_of(c, t)?, self.good_of(c, &j)?);
+                Ok((false, apps(*self.lem.region.get_or_init(|| region_law(n, Rg::Ok).0), vec![*t, j, gt, gj])))
+            }
+            // two offsets from one base: cancellation `eq (p + i) (p + j) = eq i j`
+            (Some(i), Some(j)) if def_eq(&bs, &bt) => {
+                if !def_eq(&eq(&i, &j), &f()) {
+                    return Err("two offsets from one base that are not distinct literals".into());
+                }
+                let (gp, gi, gj) = (self.good_of(c, &bs)?, self.good_of(c, &i)?, self.good_of(c, &j)?);
+                Ok((false, apps(*self.lem.cancel.get_or_init(|| cancel_law(n, Rg::Ok).0), vec![bs, i, j, gp, gi, gj])))
+            }
+            _ => Err("cannot tell whether a store address and a read address are the same".into()),
+        }
+    }
+
+    /// `Id(R, CH R w x y, x or y)` from `pe : Id(Bool0, eq s t, true or false)` and `w = eq_bit s t`.
+    fn ch_by(&self, c: &mut Cx, truth: bool, (s, t): (Expr, Expr), x: Expr, y: Expr, pe: Expr) -> Expr {
+        let (r, n) = (self.r, self.g.n);
+        let w = app2(eq_bit(n), s, t);
+        let lit_b = lit(1, truth as u128);
+        let e1 = cong1(&bool0(), &bv_ty(1), &fmap(), app2(eq_bv(n), s, t), bit(truth), pe);
+        let (xm, ym) = (c.mark(x), c.mark(y));
+        let f2 = c.lam(bv_ty(1), |c, u| apps(c.at(self.ch), vec![c.at(r), c.at(u), c.at(xm), c.at(ym)]));
+        let rt = c.at(r);
+        let e2 = cong1(&bv_ty(1), &rt, &f2, w, lit_b, e1);
+        let probe = c.at(if truth { self.ht } else { self.hf });
+        let e3 = apps(probe, vec![c.at(r), x, y]);
+        let pick = |w: Expr| apps(c.at(self.ch), vec![c.at(r), w, x, y]);
+        let tup = (pick(w), pick(lit_b), if truth { x } else { y });
+        trans(c, r, tup, e2, e3)
+    }
+
+    // ---- the heap
+
+    /// A proof of `Id(R, e, K target)` for `e = heap t K` with `heap` a chain of stores over a known heap.
+    fn cell_pf(&self, c: &mut Cx, e: Expr, target: &Expr, kk: &Expr) -> Result<Expr, String> {
+        let n = self.g.n;
+        let w = whnf(&e);
+        let (h, a) = spine(&w);
+        if a.len() == 2 && self.is_known_heap(c, &h) {
+            let Some((cv, hyp)) = self.lookup(c, &h, &a[0]) else {
+                return Err("a cell is read at an address the statement's cells do not fix".into());
+            };
+            if !def_eq(&cv, target) {
+                return Err("a cell is not written, yet the source's call passes a different value for it".into());
+            }
+            return Ok(app(hyp, a[1]));
+        }
+        if h == c.at(self.ch) && a.len() == 4 {
+            let (wh, wa) = spine(&a[1]);
+            if wa.len() != 2 || !def_eq(&wh, &eq_bit(n)) {
+                return Err("a store's address test is not `eq_bit`".into());
+            }
+            let (s, t, x, y) = (wa[0], wa[1], a[2], a[3]);
+            let (same, pe) = self.decide(c, &s, &t)?;
+            let pick = self.ch_by(c, same, (s, t), x, y, pe);
+            if same {
+                if !def_eq(&x, &app(*kk, *target)) {
+                    return Err("the last store to the cell writes a value other than the source's".into());
+                }
+                return Ok(pick);
+            }
+            let rest = self.cell_pf(c, y, target, kk)?;
+            return Ok(trans(c, self.r, (w, y, app(*kk, *target)), pick, rest));
+        }
+        Err("a cell's heap is neither a known heap nor a store over one".into())
+    }
+
+    /// `\(cell k in h) ... . body`, one binder per post cell of `cg`; `body` gets the binders as (cell index, hypothesis).
+    fn post_lams(&self, c: &mut Cx, cg: &G, h: At, na: &[At], cn: &[At], idx: &[usize], hyps: &mut Vec<(usize, At)>, body: &mut dyn FnMut(&mut Cx, &[(usize, At)]) -> Expr) -> Expr {
+        match idx.split_first() {
+            None => body(c, hyps),
+            Some((k, rest)) => {
+                let ty = cg.cell_ty(c, self.r, h, *k, na, cn[*k]);
+                c.lam(ty, |c, hy| {
+                    hyps.push((*k, hy));
+                    self.post_lams(c, cg, h, na, cn, rest, hyps, body)
+                })
+            }
+        }
+    }
+
+    /// Whether `e` is the statement's heap or one a returned call's premises describe.
+    fn is_known_heap(&self, c: &Cx, e: &Expr) -> bool {
+        *e == c.at(self.h) || self.facts.borrow().iter().any(|f| *e == c.at(f.h))
+    }
+
+    /// The value and hypothesis (a function of the continuation `K`) of the cell at `addr` in the known heap `heap`.
+    fn lookup(&self, c: &Cx, heap: &Expr, addr: &Expr) -> Option<(Expr, Expr)> {
+        if *heap == c.at(self.h) {
+            let args: Vec<Expr> = self.args.iter().map(|a| c.at(*a)).collect();
+            let k = (0..self.g.heap.cells.len()).find(|k| def_eq(addr, &self.g.cell_addr(*k, &args)))?;
+            return Some((c.at(self.cvs[k]), c.at(self.hyps[k])));
+        }
+        for f in self.facts.borrow().iter().filter(|f| *heap == c.at(f.h)) {
+            let args: Vec<Expr> = f.args.iter().map(|a| c.at(*a)).collect();
+            for (k, hyp) in &f.hyps {
+                if def_eq(addr, &f.g.cell_addr(*k, &args)) {
+                    return Some((c.at(f.cvs[*k]), c.at(*hyp)));
+                }
+            }
+        }
+        None
+    }
+
+    /// For each cell index `idx` of `cg`: a proof (a function of `K`) that it holds in the heap `h2` at the parameters
+    /// `na`, valued `cn`.
+    fn cell_proofs(&self, c: &mut Cx, cg: &G, h2: Expr, na: &[At], cn: &[At], idx: &[usize], what: &str, path: &str) -> Result<Vec<Expr>, String> {
+        let (h2m, mut out) = (c.mark(h2), vec![]);
+        for &k in idx {
+            let failed: RefCell<Option<String>> = RefCell::new(None);
+            let ne: Vec<Expr> = na.iter().map(|a| c.at(*a)).collect();
+            let addr = c.mark(cg.cell_addr(k, &ne));
+            let kt = arrow(self.g.v(), c.at(self.r));
+            let p = c.lam(kt, |c, kk| {
+                let e = app2(c.at(h2m), c.at(addr), c.at(kk));
+                let (tv, kv) = (c.at(cn[k]), c.at(kk));
+                match self.cell_pf(c, e, &tv, &kv) {
+                    Ok(p) => p,
+                    Err(e) => {
+                        failed.borrow_mut().get_or_insert(format!("{path}: {what} cell {k}: {e}"));
+                        refl(c.at(addr))
+                    }
+                }
+            });
+            if let Some(e) = failed.into_inner() {
+                return Err(e);
+            }
+            out.push(p);
+        }
+        Ok(out)
+    }
+
+    /// The `GoodBv` witnesses a call of `cg` at the parameters `na` passes: one per pointer parameter.
+    fn goods_for(&self, c: &Cx, cg: &G, na: &[At]) -> Result<Vec<Expr>, String> {
+        if !cg.good {
+            return Ok(vec![]);
+        }
+        cg.heap.ptrs.iter().map(|&pi| self.good_of(c, &c.at(na[pi]))).collect()
+    }
+
+    /// `Pi a hp h (post cells of cg hold in h). Id(R, k2 a (hp, h), ks2 a)`, from walking the two continuations under their
+    /// binders, with the callee's post cells known of the returned heap.
+    fn cont_rel(&self, c: &mut Cx, cg: &G<'g>, na: &[At], cn: &[At], k2: Expr, ks2: Expr, path: &str) -> Result<Expr, String> {
+        let (k2m, ks2m) = (c.mark(k2), c.mark(ks2));
+        let failed: RefCell<Option<String>> = RefCell::new(None);
+        let w = self.g.w;
+        let rel2 = c.lam(self.g.v(), |c, a| {
+            c.lam(self.g.v(), |c, hp| {
+                let hh = w.heap(c, self.r);
+                c.lam(hh, |c, h| {
+                    self.post_lams(c, cg, h, na, cn, &cg.heap.post, &mut vec![], &mut |c, hyps| {
+                        let mu = w.mkmu(c, self.r, c.at(hp), c.at(h));
+                        let (l, r) = (app2(c.at(k2m), c.at(a), mu), app(c.at(ks2m), c.at(a)));
+                        // the returned heap holds the callee's post cells, for the continuation's reads
+                        self.facts.borrow_mut().push(Fact { g: *cg, h, args: na.to_vec(), cvs: cn.to_vec(), hyps: hyps.to_vec() });
+                        let out = self.sim(c, l, r, &format!("{path}/after"));
+                        self.facts.borrow_mut().pop();
+                        match out {
+                            Ok(p) => p,
+                            Err(e) => {
+                                failed.borrow_mut().get_or_insert(e);
+                                refl(l)
+                            }
+                        }
+                    })
+                })
+            })
+        });
+        match failed.into_inner() {
+            Some(e) => Err(e),
+            None => Ok(rel2),
+        }
+    }
+
+    fn sim_step(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        let n = self.g.n;
+        let (mw, sw) = (whnf(&m), whnf(&s));
+        let ((mh, ma), (sh, sa)) = (spine(&mw), spine(&sw));
+        let (mk, sk) = (self.kind(c, &mh), self.kind(c, &sh));
+
+        // a stuck read of the heap at a cell the statement fixes: rewrite by the cell's hypothesis, then go on
+        if ma.len() == 2 && self.is_known_heap(c, &mh) {
+            let Some((cv, hyp)) = self.lookup(c, &mh, &ma[0]) else {
+                return Err(format!("{path}: reads a heap address that no cell fixes"));
+            };
+            let next = app(ma[1], cv);
+            let rest = self.sim(c, next, s, path)?;
+            let p = app(hyp, ma[1]);
+            return Ok(trans(c, self.r, (mw, next, s), p, rest));
+        }
+        if mh == c.at(self.km) {
+            if sh != c.at(self.ks) {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if ma.len() != 2 || sa.len() != 1 || !def_eq(&ma[0], &sa[0]) {
+                return Err(format!("{path}: both return, with different values"));
+            }
+            let Some((hp2, h2)) = Self::parts(&ma[1]) else {
+                return Err(format!("{path}: returns in a memory that is not a pair"));
+            };
+            let args: Vec<At> = self.args.clone();
+            let cvs: Vec<At> = self.cvs.clone();
+            let posts = self.cell_proofs(c, self.g, h2, &args, &cvs, &self.g.heap.post, "post", path)?;
+            return Ok(apps(c.at(self.rel), [vec![ma[0], hp2, h2], posts].concat()));
+        }
+        // a store's address test (`eq_bit s t`) in the machine alone (the source does not branch on the same test, as it
+        // does for an `==` guard): decide it, take the branch it picks, go on
+        let paired = sh == c.at(self.ch) && sa.len() == 4 && ma.len() == 4 && def_eq(&ma[1], &sa[1]);
+        if mh == c.at(self.ch) && ma.len() == 4 && !paired {
+            let (wh, wa) = spine(&ma[1]);
+            if wa.len() == 2 && def_eq(&wh, &eq_bit(n)) {
+                let (same, pe) = self.decide(c, &wa[0], &wa[1]).map_err(|e| format!("{path}: {e}"))?;
+                let pick = self.ch_by(c, same, (wa[0], wa[1]), ma[2], ma[3], pe);
+                let next = if same { ma[2] } else { ma[3] };
+                let rest = self.sim(c, next, s, path)?;
+                return Ok(trans(c, self.r, (mw, next, s), pick, rest));
+            }
+        }
+        if mh == c.at(self.ch) {
+            if sh != c.at(self.ch) || ma.len() != 4 || sa.len() != 4 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if !def_eq(&ma[1], &sa[1]) {
+                return Err(format!("{path}: the branch conditions differ"));
+            }
+            let pt = self.sim(c, ma[2], sa[2], &format!("{path}/then"))?;
+            let pe = self.sim(c, ma[3], sa[3], &format!("{path}/else"))?;
+            let cd = c.mark(ma[1]);
+            return Ok(cong(c, self.r, self.ch, cd, (ma[2], sa[2], pt), (ma[3], sa[3], pe)));
+        }
+        if mh == c.at(self.j) {
+            let (m_args, nsrc, e, t) = (self.g.m, self.g.nsrc(), self.g.e, self.g.t);
+            if sh != c.at(self.j) || ma.len() != 6 || sa.len() != 3 + nsrc + 1 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            let (fr2, mu2, k2, ks2) = (ma[3], ma[4], ma[5], sa[sa.len() - 1]);
+            let Some((hp2, h2)) = Self::parts(&mu2) else {
+                return Err(format!("{path}: the memory at the recursion is not a pair"));
+            };
+            let src_args = &sa[3..3 + nsrc];
+            // the frame: each non-pointer parameter's slot holds the source's argument, a pointer's slot is the machine's own
+            // next value, the environment's slot 0, the temporaries anything (the induction hypothesis quantifies over
+            // them), the padding 0
+            let slots = self.slots(fr2, path)?;
+            let mut next_args: Vec<Expr> = vec![];
+            let mut si = 0;
+            for i in 0..m_args {
+                if self.g.heap.ptrs.contains(&i) {
+                    next_args.push(slots[i]);
+                    continue;
+                }
+                if !def_eq(&slots[i], &src_args[si]) {
+                    return Err(format!("{path}: at the recursion, local {i} does not hold the source's argument {si}"));
+                }
+                next_args.push(src_args[si]);
+                si += 1;
+            }
+            let zero = lit(n, 0);
+            if e == 1 && !def_eq(&slots[m_args], &zero) {
+                return Err(format!("{path}: at the recursion, the environment slot is not 0"));
+            }
+            if let Some(i) = (m_args + e + t..slots.len()).find(|i| !def_eq(&slots[*i], &zero)) {
+                return Err(format!("{path}: at the recursion, padding slot {i} is not 0"));
+            }
+            let cv_next: Vec<Expr> = src_args[si..].to_vec();
+            let na: Vec<At> = next_args.iter().map(|a| c.mark(*a)).collect();
+            let cn: Vec<At> = cv_next.iter().map(|a| c.mark(*a)).collect();
+            // the cells at the recursion: each must hold the value the source passes, in the heap the machine passes
+            let all_cells: Vec<usize> = (0..self.g.heap.cells.len()).collect();
+            let cell_proofs = self.cell_proofs(c, self.g, h2, &na, &cn, &all_cells, "recursion", path)?;
+            let gp_next = self.goods_for(c, self.g, &na).map_err(|e| format!("{path}: {e}"))?;
+            let rel2 = self.cont_rel(c, self.g, &na, &cn, k2, ks2, path)?;
+            let mut all = vec![c.at(self.d)];
+            all.extend(na.iter().map(|a| c.at(*a)));
+            all.extend(cn.iter().map(|a| c.at(*a)));
+            all.extend_from_slice(&slots[m_args + e..m_args + e + t]);
+            all.extend([hp2, h2, k2, ks2, rel2]);
+            all.extend(cell_proofs);
+            all.extend(gp_next);
+            return Ok(apps(c.at(self.ih), all));
+        }
+        // a call of another function: `N H timeout Bm_c frame mu kont` against `N Hs ts Bs_c args ks'`
+        if mh == c.at(self.fuel) {
+            if ma.len() != 6 {
+                return Err(format!("{path}: the machine {mk} with {} arguments", ma.len()));
+            }
+            let Some(rule) = self.callees.iter().find(|rl| def_eq(&ma[2], &c.at(rl.bm))) else {
+                return Err(format!("{path}: the machine calls a function that is not one of this function's callees"));
+            };
+            let cg = &rule.g;
+            let nsrc = cg.nsrc();
+            if sh != c.at(self.fuel) || sa.len() != 3 + nsrc + 1 || !def_eq(&sa[2], &c.at(rule.bs)) {
+                return Err(format!("{path}: the machine calls a callee but the source {sk} (or another function, or another arity)"));
+            }
+            let src_args = &sa[3..3 + nsrc];
+            let slots = self.slots(ma[3], path)?;
+            let mut callee_args: Vec<Expr> = vec![];
+            let mut si = 0;
+            for i in 0..cg.m {
+                if cg.heap.ptrs.contains(&i) {
+                    callee_args.push(slots[i]);
+                } else {
+                    callee_args.push(src_args[si]);
+                    si += 1;
+                }
+            }
+            if !def_eq(&ma[3], &cg.frame(&callee_args, &[])) {
+                return Err(format!("{path}: the callee's frame is not the arguments the source passes it (order, values or environment)"));
+            }
+            let (mu2, k2, ks2) = (ma[4], ma[5], sa[sa.len() - 1]);
+            let Some((hp2, h2)) = Self::parts(&mu2) else {
+                return Err(format!("{path}: the memory at the call is not a pair"));
+            };
+            let na: Vec<At> = callee_args.iter().map(|a| c.mark(*a)).collect();
+            let cn: Vec<At> = src_args[si..].iter().map(|a| c.mark(*a)).collect();
+            let all_cells: Vec<usize> = (0..cg.heap.cells.len()).collect();
+            let cell_proofs = self.cell_proofs(c, cg, h2, &na, &cn, &all_cells, "call", path)?;
+            let gws = self.goods_for(c, cg, &na).map_err(|e| format!("{path}: {e}"))?;
+            let rel2 = self.cont_rel(c, cg, &na, &cn, k2, ks2, path)?;
+            let mut all: Vec<Expr> = na.iter().map(|a| c.at(*a)).collect();
+            all.extend(cn.iter().map(|a| c.at(*a)));
+            all.extend([hp2, h2, k2, ks2, rel2]);
+            all.extend(cell_proofs);
+            all.extend(gws);
+            return Ok(apps(c.at(rule.hc), all));
+        }
+        Err(format!("{path}: the machine {mk} but the source {sk}"))
+    }
+}
