+    run("wrong callee index, kinds kept (13)", twice_inc_5, &same, &to_self);
+    run("wrong callee index, kinds kept (34)", let_bound_factorial_10, &same, &to_self);
+    run("wrong callee index, kinds kept (23)", t23, &same, &to_self);
