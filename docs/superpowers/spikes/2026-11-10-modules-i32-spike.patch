+//! SPIKE (throwaway, 2026-11-10, e1 then S3): ONE generator of simulation proofs for the functions of a module, each
+//! with `Call`/`ReturnCall` (one constructor each, any arity) and optionally an `i32` environment parameter.
+//!
+//! For a function `k` of the module and a fuel `N` with `GoodNat N`, every `R`, `z`, arguments `x_i`, heap `h`, machine
+//! continuation `km` and source continuation `ks`, the LAW of `k` is
+//!
+//! ```text
+//! (Pi a loc h. km a (loc, h) = ks a) -> M_N^k (frame x.., h) km = S_N^k x.. ks
+//! ```
+//!
+//! `M_N^k = N H timeout Bm_k` runs `k`'s code through `prog`; the module's table (`V -> H`, `H = State -> Ret -> R`) maps
+//! an index to `k`'s own fuel-unrolled environment (its own index), or to `N H timeout Bm_c` for a callee `c`.
+//! `S_N^k = N Hs_k ts Bs_k` is the source's step unrolled by the same fuel; a source call of a callee is `S_N^c`.
+//!
+//! The proof of `k`'s law is `GoodNat`'s induction on the fuel. In the step both sides are put in weak head normal form
+//! and walked in lockstep as kernel terms (`Sim::sim`), with no match on the instruction list or the function:
+//!   - `km a mu` against `ks a'`: the relation hypothesis;
+//!   - `CH R w t e` against `CH R w' t' e'` (`CH` is the probe standing for `choose`): J through the shared choice;
+//!   - a stuck read of a slot `loc i K` (a parameter, or the environment): the slot hypothesis, then on;
+//!   - the fuel variable `j` applied to a state and a continuation (a `br`, a `return_call` or a `call` of the function
+//!     itself: one rule): the induction hypothesis at the arguments read off the source side;
+//!   - the outer fuel `N` applied to a state and a continuation (a `call` of a callee): the CALLEE'S LAW, a hypothesis of
+//!     this proof, at the source's arguments, the callee's frame having been checked to be the canonical one for them.
+//! `CH` is a bound variable of the proof only: the statement uses the real `choose`, and the proof is applied to it.
+//! A callee's law enters its caller's proof only as a hypothesis; `closed` discharges it with the callee's own proof.
+use super::*;
+use std::cell::RefCell;
+
+/// What a source builder is given: the answer sort `r`, the function's own fixpoint variable `g`, its parameters, the
+/// probe `ch` that stands for `choose` (the statement uses the real one: `None`), the outer fuel and the callees' source
+/// functions (`S_N^c`, by module position).
+pub struct SEnv {
+    pub n: usize,
+    pub r: At,
+    pub g: At,
+    pub params: Vec<At>,
+    pub ch: Option<At>,
+    pub fuel: At,
+    pub callees: Vec<(usize, At)>,
+}
+
+impl SEnv {
+    /// `choose R cond t f`, through the probe in the proof.
+    pub fn choose(&self, c: &Cx, cond: Expr, t: Expr, f: Expr) -> Expr {
+        match self.ch {
+            Some(h) => apps(c.at(h), vec![c.at(self.r), cond, t, f]),
+            None => choose(c.at(self.r), cond, t, f),
+        }
+    }
+    /// A call of the function itself on `args`, its answer passed to `k`: `g args (\res. k res)`.
+    pub fn call(&self, c: &mut Cx, args: &[At], k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+        let kont = c.lam(bv_ty(self.n), |c, res| k(c, c.at(res)));
+        let mut xs: Vec<Expr> = args.iter().map(|a| c.at(*a)).collect();
+        xs.push(kont);
+        apps(c.at(self.g), xs)
+    }
+    /// A call of the callee at module position `pos` on `args`, its answer passed to `k`: `S_N^pos args (\res. k res)`.
+    pub fn call_fn(&self, c: &mut Cx, pos: usize, args: &[At], k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+        let (_, t) = self.callees.iter().find(|(p, _)| *p == pos).unwrap_or_else(|| panic!("no callee at position {pos}"));
+        let kont = c.lam(bv_ty(self.n), |c, res| k(c, c.at(res)));
+        let mut xs: Vec<Expr> = args.iter().map(|a| c.at(*a)).collect();
+        xs.push(kont);
+        apps(c.at(*t), xs)
+    }
+}
+
+/// The source in continuation-passing form: given the environment and the final continuation, `cps src`.
+pub type SrcFn<'a> = dyn Fn(&mut Cx, &SEnv, &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr + 'a;
+
+/// One function of a module. Its table index is its position in the module's list.
+pub struct FuncSpec<'a> {
+    pub code: Vec<Ins>,
+    /// Source parameters (words), at slots `0..arity`.
+    pub arity: usize,
+    /// Whether the function has an `i32` environment parameter, at slot `arity`; every caller passes it 0.
+    pub env: bool,
+    /// Temporaries (`local.set`/`local.get` slots after the parameters and the environment).
+    pub temps: usize,
+    /// Module positions of the functions it calls (other than itself).
+    pub callees: Vec<usize>,
+    pub src: &'a SrcFn<'a>,
+}
+
+/// `CH : Pi R:Sort0. Bv1 -> R -> R -> R`.
+fn ch_ty() -> Expr {
+    pi(sort(0), arrow(bv_ty(1), arrow(var(0), arrow(var(0), var(0)))))
+}
+/// The real choice, `\R w x y. choose R w x y`.
+fn choose_fn() -> Expr {
+    Cx::default().lam(sort(0), |c, r| {
+        c.lam(bv_ty(1), |c, w| {
+            c.lam(c.at(r), |c, x| c.lam(c.at(r), |c, y| choose(c.at(r), c.at(w), c.at(x), c.at(y))))
+        })
+    })
+}
+
+/// `p : a = b`, `q : b = c` give `a = c`.
+fn trans(c: &mut Cx, r: At, (a, b, cc): (Expr, Expr, Expr), p: Expr, q: Expr) -> Expr {
+    let a = c.mark(a);
+    let motive = c.lam(c.at(r), |c, u| {
+        c.lam(c.at(r), |c, v| {
+            let ty = id(c.at(r), c.at(u), c.at(v));
+            c.lam(ty, |c, _| arrow(id(c.at(r), c.at(a), c.at(u)), id(c.at(r), c.at(a), c.at(v))))
+        })
+    });
+    let base = c.lam(c.at(r), |c, u| {
+        let ty = id(c.at(r), c.at(a), c.at(u));
+        c.lam(ty, |c, h| c.at(h))
+    });
+    app(jelim(motive, base, b, cc, q), p)
+}
+
+/// `Id(R, CH R w t e, CH R w t' e')` from `Id(R, t, t')` and `Id(R, e, e')`: J on each branch.
+fn cong(c: &mut Cx, r: At, ch: At, cd: At, (t, t2, pt): (Expr, Expr, Expr), (e, e2, pe): (Expr, Expr, Expr)) -> Expr {
+    let pick = |c: &Cx, x: Expr, y: Expr| apps(c.at(ch), vec![c.at(r), c.at(cd), x, y]);
+    let (e, e2, pe) = (c.mark(e), c.mark(e2), c.mark(pe));
+    let outer_m = c.lam(c.at(r), |c, a| {
+        c.lam(c.at(r), |c, b| {
+            let ty = id(c.at(r), c.at(a), c.at(b));
+            c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(e)), pick(c, c.at(b), c.at(e2))))
+        })
+    });
+    let outer_b = c.lam(c.at(r), |c, a| {
+        let inner_m = c.lam(c.at(r), |c, y| {
+            c.lam(c.at(r), |c, y2| {
+                let ty = id(c.at(r), c.at(y), c.at(y2));
+                c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(y)), pick(c, c.at(a), c.at(y2))))
+            })
+        });
+        let inner_b = c.lam(c.at(r), |c, y| refl(pick(c, c.at(a), c.at(y))));
+        jelim(inner_m, inner_b, c.at(e), c.at(e2), c.at(pe))
+    });
+    jelim(outer_m, outer_b, t, t2, pt)
+}
+
+fn spine(e: &Expr) -> (Expr, Vec<Expr>) {
+    let (mut args, mut cur) = (vec![], *e);
+    while let tatic_kernel::Node::App(f, a) = cur.node() {
+        args.push(a);
+        cur = f;
+    }
+    args.reverse();
+    (cur, args)
+}
+
+/// The sizes one function is generated at: `m` parameters and `e` (0 or 1) environment slots.
+#[derive(Clone, Copy)]
+struct G {
+    w: Wasm,
+    n: usize,
+    m: usize,
+    e: usize,
+}
+
+impl G {
+    fn v(&self) -> Expr {
+        self.w.v()
+    }
+    /// `Ret = V -> State -> R`.
+    fn ret_m(&self, c: &mut Cx, r: At) -> Expr {
+        let mem = self.w.mem(c, r);
+        arrow(self.v(), arrow(mem, c.at(r)))
+    }
+    /// `H = State -> Ret -> R`.
+    fn hm(&self, c: &mut Cx, r: At) -> Expr {
+        let (mem, ret) = (self.w.mem(c, r), self.ret_m(c, r));
+        arrow(mem, arrow(ret, c.at(r)))
+    }
+    fn ret_s(&self, c: &Cx, r: At) -> Expr {
+        arrow(self.v(), c.at(r))
+    }
+    /// `Hs = V^m -> (V -> R) -> R`.
+    fn hs(&self, c: &Cx, r: At) -> Expr {
+        (0..self.m).fold(arrow(self.ret_s(c, r), c.at(r)), |acc, _| arrow(self.v(), acc))
+    }
+    fn rel_ty(&self, c: &mut Cx, r: At, km: At, ks: At) -> Expr {
+        let w = self.w;
+        // over the two components of the state, not a state variable: a `sigrec` on a variable is stuck (no eta)
+        c.pi(self.v(), |c, a| {
+            let hp = w.heap(c, r);
+            c.pi(hp, |c, loc| {
+                let hp = w.heap(c, r);
+                c.pi(hp, |c, h| {
+                    let mu = w.mkmu(c, r, c.at(loc), c.at(h));
+                    id(c.at(r), app2(c.at(km), c.at(a), mu), app(c.at(ks), c.at(a)))
+                })
+            })
+        })
+    }
+    /// `Pi K. Id(R, loc i K, K a)`: slot `i` of `loc` holds `a` (`None`: the environment's 0).
+    fn hyp_ty(&self, c: &mut Cx, r: At, loc: At, i: usize, a: Option<At>) -> Expr {
+        let n = self.n;
+        let kt = arrow(self.v(), c.at(r));
+        c.pi(kt, |c, kk| {
+            let val = match a {
+                Some(a) => c.at(a),
+                None => lit(n, 0),
+            };
+            id(c.at(r), app2(c.at(loc), lit(n, i as u128), c.at(kk)), app(c.at(kk), val))
+        })
+    }
+    /// The slots `vals` (parameters, then the environment's 0) over locals that are all 0.
+    fn frame(&self, c: &mut Cx, r: At, vals: Vec<Expr>) -> Expr {
+        let blank = self.w.zero_heap(c, r);
+        vals.into_iter().enumerate().rev().fold(blank, |acc, (i, v)| self.w.upd(c, r, lit(self.n, i as u128), v, acc))
+    }
+    fn frame_of(&self, c: &mut Cx, r: At, args: &[At]) -> Expr {
+        let mut vals: Vec<Expr> = args.iter().map(|a| c.at(*a)).collect();
+        if self.e == 1 {
+            vals.push(lit(self.n, 0));
+        }
+        self.frame(c, r, vals)
+    }
+    fn tm(&self, c: &mut Cx, r: At, z: At) -> Expr {
