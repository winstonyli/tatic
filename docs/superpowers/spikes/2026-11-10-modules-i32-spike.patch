+                let rm = self.ret_m(c, r);
+                c.lam(rm, |c, k| {
+                    let base = c.mark(w.v());
+                    let p = w.prog(c, code, &[], base);
+                    let p = c.mark(p);
+                    let fuel0 = c.mark(nat2_lit(0));
+                    let st_ty = prod(w.v(), c.at(base));
+                    let kk = c.lam(st_ty, |c, st| {
+                        let mem = w.mem(c, r);
+                        c.lam(mem, |c, mu2| w.split(c, r, w.v(), base, st, |c, y, _| app2(c.at(k), c.at(y), c.at(mu2))))
+                    });
+                    let kk = c.mark(kk);
+                    let restart = {
+                        let mem = w.mem(c, r);
+                        c.lam(mem, |c, m2| app2(c.at(env), c.at(m2), c.at(k)))
+                    };
+                    let restart = c.mark(restart);
+                    let tbl = table(c, env);
+                    let tbl = c.mark(tbl);
+                    let hooks = Hooks { env: Some(tbl), lab: Some(restart), ret: Some(k), ch };
+                    let m = w.meaning_with(c, p, fuel0, r, kk, z, &hooks);
+                    app2(m, lit(n, 0), c.at(mu))
+                })
+            })
+        })
+    }
+    /// `Bs = \g x.. ks. cps src`.
+    fn bs(&self, c: &mut Cx, r: At, ch: Option<At>, src: &SrcFn, fuel: At, callees: &[(usize, At)]) -> Expr {
+        let n = self.n;
+        let hs = self.hs(c, r);
+        c.lam(hs, |c, g| {
+            let vs: Vec<Ty> = (0..self.m).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+            tele(c, &vs, &mut vec![], &lam, &mut |c, xs| {
+                let rs = self.ret_s(c, r);
+                c.lam(rs, |c, ks| {
+                    let env = SEnv { n, r, g, params: xs.to_vec(), ch, fuel, callees: callees.to_vec() };
+                    src(c, &env, &|c, v| app(c.at(ks), v))
+                })
+            })
+        })
+    }
+    /// The binders of the induction's motive, step and hypothesis applications, after the dummy numeral that lifts the
+    /// motive to Sort3: `d, a_0..a_{m-1}, loc, h, km, ks, rel, slot_0..slot_{m+e-1}`.
+    fn binders(&self, c: &mut Cx, r: At, wrap: &dyn Fn(Expr, Expr) -> Expr, body: &mut dyn FnMut(&mut Cx, &[At]) -> Expr) -> Expr {
+        let (g, n, m, e) = (self, self.n, self.m, self.e);
+        let mut tys: Vec<Ty> = vec![ty!(|_c, _x| nat2())];
+        tys.extend((0..m).map(|_| ty!(|_c, _x| bv_ty(n))));
+        tys.push(ty!(|c, _x| g.w.heap(c, r)));
+        tys.push(ty!(|c, _x| g.w.heap(c, r)));
+        tys.push(ty!(|c, _x| g.ret_m(c, r)));
+        tys.push(ty!(|c, _x| g.ret_s(c, r)));
+        tys.push(ty!(|c, x| g.rel_ty(c, r, x[m + 3], x[m + 4])));
+        for i in 0..m {
+            tys.push(ty!(|c, x| g.hyp_ty(c, r, x[m + 1], i, Some(x[1 + i]))));
+        }
+        for _ in 0..e {
+            tys.push(ty!(|c, x| g.hyp_ty(c, r, x[m + 1], m, None)));
+        }
+        tele(c, &tys, &mut vec![], wrap, body)
+    }
+    /// The binders of a function's law after `N gn R z`: `x_0..x_{m-1}, h, km, ks, rel`.
+    fn law_binders(&self, c: &mut Cx, r: At, wrap: &dyn Fn(Expr, Expr) -> Expr, body: &mut dyn FnMut(&mut Cx, &[At]) -> Expr) -> Expr {
+        let (g, w, m) = (self, self.w, self.m);
+        let mut tys: Vec<Ty> = (0..m).map(|_| ty!(|_c, _x| w.v())).collect();
+        tys.push(ty!(|c, _x| w.heap(c, r)));
+        tys.push(ty!(|c, _x| g.ret_m(c, r)));
+        tys.push(ty!(|c, _x| g.ret_s(c, r)));
+        tys.push(ty!(|c, x| g.rel_ty(c, r, x[m + 1], x[m + 2])));
+        tele(c, &tys, &mut vec![], wrap, body)
+    }
+}
+
+/// What `gen_module` checks of a function's code before generating anything.
+fn check_code(code: &[Ins], arity: usize, env: bool, temps: usize) -> Result<(), String> {
+    fn walk(code: &[Ins], locals: usize, top: bool) -> Result<(), String> {
+        for ins in code {
+            match ins {
+                Ins::Loop(b) if top && code.len() == 1 => walk(b, locals, false)?,
+                Ins::Loop(_) => return Err("a loop other than the function's one top-level loop".into()),
+                Ins::If(t, e) => {
+                    walk(t, locals, false)?;
+                    walk(e, locals, false)?
+                }
+                Ins::LocalGet(i) | Ins::LocalSet(i) | Ins::GetI(i) if *i as usize >= locals => return Err(format!("local {i} out of range")),
+                Ins::Raw(s) => return Err(format!("raw line {s:?}")),
+                Ins::Store | Ins::Load | Ins::Dup => return Err(format!("{ins:?}: the heap is not modelled here")),
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+    walk(code, arity + env as usize + temps, true)?;
+    match shape(code, vec![], &[]) {
+        Ok(Some(s)) if s == vec![K::W] => Ok(()),
+        other => Err(format!("the body does not run from [] to [word]: {other:?}")),
+    }
+}
+
+/// A function's pieces as marks at the base depth of a proof: its `Bm`, `Bs`, and `N H timeout Bm`, `N Hs ts Bs`.
+#[derive(Clone, Copy)]
+struct Real {
+    bm: At,
+    bs: At,
+    hc: At,
+    sc: At,
+}
+
+/// The module at one context: the fuel `N`, the answer sort `r` and `z`, with the real (probe-free) pieces of each
+/// function built on demand (at the depth this was made, so every mark is valid under all deeper binders).
+struct Ctxt<'a> {
+    w: Wasm,
+    funcs: &'a [FuncSpec<'a>],
+    fuel: At,
+    r: At,
+    z: At,
+    hm: At,
+    tm: At,
+    memo: RefCell<Vec<Option<Real>>>,
+}
+
+impl<'a> Ctxt<'a> {
+    fn new(c: &mut Cx, w: Wasm, funcs: &'a [FuncSpec<'a>], fuel: At, r: At, z: At) -> Self {
+        let g0 = G { w, n: w.n, m: 0, e: 0 };
+        let hm = {
+            let e = g0.hm(c, r);
+            c.mark(e)
+        };
+        let tm = {
+            let e = g0.tm(c, r, z);
+            c.mark(e)
+        };
+        Ctxt { w, funcs, fuel, r, z, hm, tm, memo: RefCell::new(vec![None; funcs.len()]) }
+    }
+    fn g(&self, k: usize) -> G {
+        G { w: self.w, n: self.w.n, m: self.funcs[k].arity, e: self.funcs[k].env as usize }
+    }
+    /// The table of function `k`: `\i mu kont. (i == k) (env mu kont) ((i == c) (H_c mu kont) .. z)`.
+    fn table(&self, c: &mut Cx, k: usize, env: At, cs: &[(usize, Real)]) -> Expr {
+        let (w, r, z, n) = (self.w, self.r, self.z, self.w.n);
+        c.lam(w.v(), |c, i| {
+            let mem = w.mem(c, r);
+            c.lam(mem, |c, mu| {
+                let rm = G { w, n, m: 0, e: 0 }.ret_m(c, r);
+                c.lam(rm, |c, kont| {
+                    let pick = |c: &Cx, pos: usize, yes: Expr, no: Expr| app3(app2(eq_bv(n), c.at(i), lit(n, pos as u128)), c.at(r), yes, no);
+                    let mut acc = c.at(z);
+                    for (pos, re) in cs.iter().rev() {
+                        let call = app2(c.at(re.hc), c.at(mu), c.at(kont));
+                        acc = pick(c, *pos, call, acc);
+                    }
+                    let me = app2(c.at(env), c.at(mu), c.at(kont));
+                    pick(c, k, me, acc)
+                })
+            })
+        })
+    }
+    /// `Bm_k` and `Bs_k`, through the probe `probe` if any; the callees' real pieces are those of `real`.
+    fn bm_bs(&self, c: &mut Cx, k: usize, probe: Option<At>) -> (Expr, Expr) {
+        let f = &self.funcs[k];
+        let g = self.g(k);
+        let cs: Vec<(usize, Real)> = f.callees.iter().map(|&p| (p, self.real(c, p))).collect();
+        let bm = g.bm(c, self.r, self.z, probe, &f.code, &|c, env| self.table(c, k, env, &cs));
+        let scs: Vec<(usize, At)> = cs.iter().map(|(p, re)| (*p, re.sc)).collect();
+        let bs = g.bs(c, self.r, probe, f.src, self.fuel, &scs);
+        (bm, bs)
+    }
+    fn real(&self, c: &mut Cx, k: usize) -> Real {
+        let cached = self.memo.borrow()[k];
+        if let Some(re) = cached {
+            return re;
+        }
+        let g = self.g(k);
+        let (bm, bs) = self.bm_bs(c, k, None);
+        let (bm, bs) = (c.mark(bm), c.mark(bs));
+        let hs = {
+            let e = g.hs(c, self.r);
+            c.mark(e)
+        };
+        let ts = {
+            let e = g.ts(c, self.r, self.z);
+            c.mark(e)
+        };
+        let hc = c.mark(apps(c.at(self.fuel), vec![c.at(self.hm), c.at(self.tm), c.at(bm)]));
+        let sc = c.mark(apps(c.at(self.fuel), vec![c.at(hs), c.at(ts), c.at(bs)]));
+        let re = Real { bm, bs, hc, sc };
+        self.memo.borrow_mut()[k] = Some(re);
+        re
+    }
+    /// The law of function `k`: `Pi x.. h km ks rel. Id(R, N H timeout Bm_k (frame x.., h) km, N Hs ts Bs_k x.. ks)`.
+    fn law(&self, c: &mut Cx, k: usize) -> Expr {
+        let g = self.g(k);
+        let re = self.real(c, k);
+        let (r, w) = (self.r, self.w);
+        g.law_binders(c, r, &pi, &mut |c, x| {
+            let m = g.m;
+            let args = &x[..m];
+            let (h, km, ks) = (x[m], x[m + 1], x[m + 2]);
+            let fr = g.frame_of(c, r, args);
+            let mu = w.mkmu(c, r, fr, c.at(h));
+            let l = app2(c.at(re.hc), mu, c.at(km));
+            let rhs = apps(c.at(re.sc), [args.iter().map(|a| c.at(*a)).collect::<Vec<_>>(), vec![c.at(ks)]].concat());
+            id(c.at(r), l, rhs)
+        })
+    }
+}
+
+/// What the walk needs of a callee.
+struct CalleeRule {
+    g: G,
+    bm: At,
+    bs: At,
+    hc: At,
+}
+
+/// The telescope `N gn R z`, then (for the proof and the closed composition) the callees' laws.
+fn head_tys<'a>(w: Wasm, funcs: &'a [FuncSpec<'a>], callees: &[usize], with_laws: bool) -> Vec<Ty<'a>> {
+    let mut tys: Vec<Ty> = vec![ty!(|_c, _x| nat2()), ty!(|c, x| w.good_nat(c, x[0])), ty!(|_c, _x| sort(0)), ty!(|c, x| c.at(x[2]))];
+    if with_laws {
+        for &p in callees {
+            tys.push(ty!(|c, x| {
+                let cx = Ctxt::new(c, w, funcs, x[0], x[2], x[3]);
+                cx.law(c, p)
+            }));
+        }
+    }
+    tys
+}
+
+/// The proof of function `k`'s law, with the callees' laws as hypotheses and the probe `CH` as its first parameter:
+/// `\CH N gn R z HC.. x.. h km ks rel. ..`, or why the two do not simulate each other.
+fn proof_open(w: Wasm, funcs: &[FuncSpec], k: usize) -> Result<Expr, String> {
+    let f = &funcs[k];
+    check_code(&f.code, f.arity, f.env, f.temps)?;
+    let g = G { w, n: w.n, m: f.arity, e: f.env as usize };
+    let (m, nhc) = (g.m, f.callees.len());
+    let err: RefCell<Option<String>> = RefCell::new(None);
+    let tys = head_tys(w, funcs, &f.callees, true);
+    let proof = Cx::default().lam(ch_ty(), |c, ch| {
+        tele(c, &tys, &mut vec![], &lam, &mut |c, x| {
+            let (fuel, gn, r, z) = (x[0], x[1], x[2], x[3]);
+            let cx = Ctxt::new(c, w, funcs, fuel, r, z);
+            let rules: Vec<CalleeRule> = f
+                .callees
+                .iter()
+                .zip(&x[4..4 + nhc])
+                .map(|(p, hc)| {
+                    let re = cx.real(c, *p);
+                    CalleeRule { g: cx.g(*p), bm: re.bm, bs: re.bs, hc: *hc }
+                })
+                .collect();
+            let (hm, tm) = (cx.hm, cx.tm);
+            let (bm0, bs0) = cx.bm_bs(c, k, Some(ch));
+            let (bm, bs) = (c.mark(bm0), c.mark(bs0));
+            let (hs0, ts0) = (g.hs(c, r), g.ts(c, r, z));
+            let (hs, ts) = (c.mark(hs0), c.mark(ts0));
+            g.law_binders(c, r, &lam, &mut |c, y| {
+                let args: Vec<At> = y[..m].to_vec();
+                let (h, km, ks, rel) = (y[m], y[m + 1], y[m + 2], y[m + 3]);
+                // the motive at a fuel: the binders, then the two sides
+                let mot = |c: &mut Cx, mm: Expr| {
+                    let mm = c.mark(mm);
+                    g.binders(c, r, &pi, &mut |c, y| {
+                        let (ya, loc, hp, kmm, kss) = (&y[1..1 + m], y[1 + m], y[2 + m], y[3 + m], y[4 + m]);
+                        let mu = w.mkmu(c, r, c.at(loc), c.at(hp));
+                        let l = app2(apps(c.at(mm), vec![c.at(hm), c.at(tm), c.at(bm)]), mu, c.at(kmm));
+                        let rhs = apps(
+                            c.at(mm),
+                            [vec![c.at(hs), c.at(ts), c.at(bs)], ya.iter().map(|a| c.at(*a)).collect(), vec![c.at(kss)]].concat(),
+                        );
+                        id(c.at(r), l, rhs)
+                    })
+                };
+                let motive = c.lam(nat2(), |c, mm| mot(c, c.at(mm)));
+                let hz = g.binders(c, r, &lam, &mut |c, _| refl(c.at(z)));
+                let step = c.lam(nat2(), |c, j| {
+                    let ih_ty = mot(c, c.at(j));
+                    c.lam(ih_ty, |c, ih| {
+                        g.binders(c, r, &lam, &mut |c, y| {
+                            let sim = Sim {
+                                g: &g,
+                                r,
+                                ch,
+                                j,
+                                ih,
+                                fuel,
+                                d: y[0],
+                                loc: y[1 + m],
+                                km: y[3 + m],
+                                ks: y[4 + m],
+                                rel: y[5 + m],
+                                args: y[1..1 + m].to_vec(),
+                                hyps: y[6 + m..6 + 2 * m + g.e].to_vec(),
+                                callees: &rules,
+                            };
+                            let mu = w.mkmu(c, r, c.at(y[1 + m]), c.at(y[2 + m]));
+                            let mj = apps(c.at(j), vec![c.at(hm), c.at(tm), c.at(bm)]);
+                            let sj = apps(c.at(j), vec![c.at(hs), c.at(ts), c.at(bs)]);
+                            let m0 = apps(c.at(bm), vec![mj, mu, c.at(y[3 + m])]);
+                            let s0 = apps(c.at(bs), [vec![sj], sim.args.iter().map(|a| c.at(*a)).collect(), vec![c.at(y[4 + m])]].concat());
+                            match sim.sim(c, m0, s0, "body") {
+                                Ok(p) => p,
+                                Err(e) => {
+                                    err.borrow_mut().get_or_insert(e);
+                                    refl(m0)
+                                }
+                            }
+                        })
+                    })
+                });
+                let fr = g.frame_of(c, r, &args);
+                let slots: Vec<Expr> = (0..m + g.e)
+                    .map(|i| {
+                        let a = (i < m).then(|| args[i]);
+                        c.lam(arrow(w.v(), c.at(r)), |c, kk| {
+                            let val = match a {
+                                Some(a) => c.at(a),
+                                None => lit(w.n, 0),
+                            };
+                            refl(app(c.at(kk), val))
+                        })
+                    })
+                    .collect();
+                let mut all = vec![motive, hz, step, nat2_lit(0)];
+                all.extend(args.iter().map(|a| c.at(*a)));
+                all.extend([fr, c.at(h), c.at(km), c.at(ks), c.at(rel)]);
+                all.extend(slots);
+                apps(c.at(gn), all)
+            })
+        })
+    });
+    if let Some(e) = err.into_inner() {
+        return Err(e);
+    }
+    Ok(proof)
+}
+
+/// The closed proof of function `k`'s law, `Pi N gn R z, law_k`: the probe applied to `choose`, every callee's law
+/// discharged by that callee's own closed proof.
+fn closed(w: Wasm, funcs: &[FuncSpec], k: usize) -> Result<Expr, String> {
+    let open = app(proof_open(w, funcs, k)?, choose_fn());
+    let callees = &funcs[k].callees;
+    let closed_callees: Vec<Expr> = callees.iter().map(|p| closed(w, funcs, *p)).collect::<Result<_, _>>()?;
+    let tys = head_tys(w, funcs, callees, false);
+    Ok(tele(&mut Cx::default(), &tys, &mut vec![], &lam, &mut |c, x| {
+        let nzs: Vec<At> = x.to_vec();
+        let mut all: Vec<Expr> = nzs.iter().map(|a| c.at(*a)).collect();
+        for (p, cl) in callees.iter().zip(&closed_callees) {
+            let gc = G { w, n: w.n, m: funcs[*p].arity, e: funcs[*p].env as usize };
+            let law = gc.law_binders(c, nzs[2], &lam, &mut |c, y| {
+                apps(*cl, [nzs.iter().map(|a| c.at(*a)).collect::<Vec<_>>(), y.iter().map(|a| c.at(*a)).collect()].concat())
+            });
+            all.push(law);
+        }
+        apps(open, all)
+    }))
+}
+
+/// `(proof, statement)` that function `entry` of the module simulates its source, for every fuel: `Pi N gn R z, law_entry`.
+/// Every function it calls (and they, theirs) is proved on its own and enters as a hypothesis, then is discharged.
+pub fn gen_module(w: Wasm, funcs: &[FuncSpec], entry: usize) -> Result<(Expr, Expr), String> {
+    let proof = closed(w, funcs, entry)?;
+    let tys = head_tys(w, funcs, &[], false);
+    let stmt = tele(&mut Cx::default(), &tys, &mut vec![], &pi, &mut |c, x| {
+        let cx = Ctxt::new(c, w, funcs, x[0], x[2], x[3]);
+        cx.law(c, entry)
+    });
+    Ok((proof, stmt))
+}
+
+/// `gen_module` for one function with no callees and no environment parameter.
+pub fn gen_sim(w: Wasm, code: &[Ins], arity: usize, temps: usize, src: &SrcFn) -> Result<(Expr, Expr), String> {
+    let f = FuncSpec { code: code.to_vec(), arity, env: false, temps, callees: vec![], src };
+    gen_module(w, std::slice::from_ref(&f), 0)
+}
+
+/// One walk's fixed names.
+struct Sim<'g> {
+    g: &'g G,
+    r: At,
+    ch: At,
+    j: At,
+    ih: At,
+    fuel: At,
+    d: At,
+    loc: At,
+    km: At,
+    ks: At,
+    rel: At,
+    args: Vec<At>,
+    hyps: Vec<At>,
+    callees: &'g [CalleeRule],
+}
+
+impl Sim<'_> {
+    /// What a term in weak head normal form is doing, for the reasons.
+    fn kind(&self, c: &Cx, head: &Expr) -> &'static str {
+        if *head == c.at(self.km) || *head == c.at(self.ks) {
+            "returns"
+        } else if *head == c.at(self.ch) {
+            "branches"
+        } else if *head == c.at(self.j) {
+            "recurses"
+        } else if *head == c.at(self.fuel) {
+            "calls another function"
+        } else if *head == c.at(self.loc) {
+            "reads a local"
+        } else {
+            "is stuck"
+        }
+    }
+
+    /// What slot `i` of the activation's frame holds: its parameter, or (the environment's slot) 0.
+    fn slot_val(&self, c: &Cx, i: usize) -> Expr {
+        if i < self.g.m { c.at(self.args[i]) } else { lit(self.g.n, 0) }
+    }
+
+    /// A proof of `Id(R, m, s)`.
+    fn sim(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        tatic_kernel::grow(|| self.sim_step(c, m, s, path))
+    }
+
+    /// `Pi a loc h. Id(R, k2 a (loc, h), ks2 a)`, from walking the two continuations under their binders.
+    fn cont_rel(&self, c: &mut Cx, k2: Expr, ks2: Expr, path: &str) -> Result<Expr, String> {
+        let (k2m, ks2m) = (c.mark(k2), c.mark(ks2));
+        let failed: RefCell<Option<String>> = RefCell::new(None);
+        let w = self.g.w;
+        let rel2 = c.lam(self.g.v(), |c, a| {
+            let hp = w.heap(c, self.r);
+            c.lam(hp, |c, loc| {
+                let hp = w.heap(c, self.r);
+                c.lam(hp, |c, h| {
+                    let mu = w.mkmu(c, self.r, c.at(loc), c.at(h));
+                    let (l, r) = (app2(c.at(k2m), c.at(a), mu), app(c.at(ks2m), c.at(a)));
+                    match self.sim(c, l, r, &format!("{path}/after")) {
+                        Ok(p) => p,
+                        Err(e) => {
+                            failed.borrow_mut().get_or_insert(e);
+                            refl(l)
+                        }
+                    }
+                })
+            })
+        });
+        match failed.into_inner() {
+            Some(e) => Err(e),
+            None => Ok(rel2),
+        }
+    }
+
+    fn sim_step(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        let n = self.g.n;
+        let (mw, sw) = (whnf(&m), whnf(&s));
+        let ((mh, ma), (sh, sa)) = (spine(&mw), spine(&sw));
+        let (mk, sk) = (self.kind(c, &mh), self.kind(c, &sh));
+
+        // a stuck read of a slot: rewrite by the slot hypothesis, then go on
+        if mh == c.at(self.loc) && ma.len() == 2 {
+            let Some(i) = (0..self.g.m + self.g.e).find(|i| def_eq(&ma[0], &lit(n, *i as u128))) else {
+                return Err(format!("{path}: reads a local that no parameter or earlier write fixes"));
+            };
+            let next = app(ma[1], self.slot_val(c, i));
+            let rest = self.sim(c, next, s, path)?;
+            let p = app(c.at(self.hyps[i]), ma[1]);
+            return Ok(trans(c, self.r, (mw, next, s), p, rest));
+        }
+        if mh == c.at(self.km) {
+            if sh != c.at(self.ks) {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if ma.len() != 2 || sa.len() != 1 || !def_eq(&ma[0], &sa[0]) {
+                return Err(format!("{path}: both return, with different values"));
+            }
+            let tatic_kernel::Node::Pair(_, loc2, h2) = ma[1].node() else {
+                return Err(format!("{path}: returns in a state that is not a pair"));
+            };
+            return Ok(apps(c.at(self.rel), vec![ma[0], loc2, h2]));
+        }
+        if mh == c.at(self.ch) {
+            if sh != c.at(self.ch) || ma.len() != 4 || sa.len() != 4 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if !def_eq(&ma[1], &sa[1]) {
+                return Err(format!("{path}: the branch conditions differ"));
+            }
+            let pt = self.sim(c, ma[2], sa[2], &format!("{path}/then"))?;
+            let pe = self.sim(c, ma[3], sa[3], &format!("{path}/else"))?;
+            let cd = c.mark(ma[1]);
+            return Ok(cong(c, self.r, self.ch, cd, (ma[2], sa[2], pt), (ma[3], sa[3], pe)));
+        }
+        if mh == c.at(self.j) {
+            let (m_args, e) = (self.g.m, self.g.e);
+            if sh != c.at(self.j) || ma.len() != 5 || sa.len() != 3 + m_args + 1 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            let tatic_kernel::Node::Pair(_, loc2, h2) = ma[3].node() else {
+                return Err(format!("{path}: the state at the recursion is not a pair"));
+            };
+            let (k2, ks2) = (ma[4], sa[sa.len() - 1]);
+            let src_args = &sa[3..3 + m_args];
+            // each slot must hold the source's argument (the environment's: 0), or be untouched and the source's
+            // argument be the parameter itself
+            let mut wants: Vec<Expr> = src_args.to_vec();
+            if e == 1 {
+                wants.push(lit(n, 0));
+            }
+            let mut untouched = vec![false; wants.len()];
+            for (i, a) in wants.iter().enumerate() {
+                let (ok, same) = c.under(|c, _| {
+                    let (kv, l2) = (var(0), shift(&loc2, 0, 1));
+                    let got = app2(l2.clone(), lit(n, i as u128), kv.clone());
+                    let held = def_eq(&got, &app(kv.clone(), shift(a, 0, 1)));
+                    let same = def_eq(&got, &app2(c.at(self.loc), lit(n, i as u128), kv)) && def_eq(&shift(a, 0, 1), &self.slot_val(c, i));
+                    (held, same)
+                });
+                if !ok && !same {
+                    return Err(format!("{path}: at the recursion, local {i} does not hold the source's argument {i}"));
+                }
+                untouched[i] = !ok;
+            }
+            let rel2 = self.cont_rel(c, k2, ks2, path)?;
+            let slots: Vec<Expr> = wants
+                .iter()
+                .enumerate()
+                .map(|(i, a)| {
+                    let a = c.mark(*a);
+                    c.lam(arrow(self.g.v(), c.at(self.r)), |c, kk| {
+                        if untouched[i] { app(c.at(self.hyps[i]), c.at(kk)) } else { refl(app(c.at(kk), c.at(a))) }
+                    })
+                })
+                .collect();
+            let mut all = vec![c.at(self.d)];
+            all.extend(src_args.iter().copied());
+            all.extend([loc2, h2, k2, ks2, rel2]);
+            all.extend(slots);
+            return Ok(apps(c.at(self.ih), all));
+        }
+        // a call of another function: `N H timeout Bm_c (frame, h) kont` against `N Hs ts Bs_c args ks'`
+        if mh == c.at(self.fuel) {
+            if ma.len() != 5 {
+                return Err(format!("{path}: the machine {mk} with {} arguments", ma.len()));
+            }
+            let Some(rule) = self.callees.iter().find(|rl| def_eq(&ma[2], &c.at(rl.bm))) else {
+                return Err(format!("{path}: the machine calls a function that is not one of this function's callees"));
+            };
+            let mc = rule.g.m;
+            if sh != c.at(self.fuel) || sa.len() != 3 + mc + 1 || !def_eq(&sa[2], &c.at(rule.bs)) {
+                return Err(format!("{path}: the machine calls a callee but the source {sk} (or another function, or another arity)"));
+            }
+            let tatic_kernel::Node::Pair(_, loc2, h2) = ma[3].node() else {
+                return Err(format!("{path}: the state at the call is not a pair"));
+            };
+            let src_args = &sa[3..3 + mc];
+            let mut vals: Vec<Expr> = src_args.to_vec();
+            if rule.g.e == 1 {
+                vals.push(lit(n, 0));
+            }
+            let canon = rule.g.frame(c, self.r, vals);
+            if !def_eq(&loc2, &canon) {
+                return Err(format!("{path}: the callee's frame is not the arguments the source passes it (order, values or environment)"));
+            }
+            let (k2, ks2) = (ma[4], sa[sa.len() - 1]);
+            let rel2 = self.cont_rel(c, k2, ks2, path)?;
+            let mut all: Vec<Expr> = src_args.to_vec();
+            all.extend([h2, k2, ks2, rel2]);
+            return Ok(apps(c.at(rule.hc), all));
+        }
+        Err(format!("{path}: the machine {mk} but the source {sk}"))
+    }
+}
