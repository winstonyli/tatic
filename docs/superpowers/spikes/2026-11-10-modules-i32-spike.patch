+fn build_module(n: usize, callee: &[Ins], caller: &[Ins], callee_src: &Src, caller_src: &Src, callee_arity: usize) -> Result<(Expr, Expr), String> {
+    let fc = |cx: &mut Cx, en: &SEnv, k: &dyn Fn(&mut Cx, Expr) -> Expr| cps(en, cx, callee_src, k);
+    let ff = |cx: &mut Cx, en: &SEnv, k: &dyn Fn(&mut Cx, Expr) -> Expr| cps(en, cx, caller_src, k);
+    let funcs = [
+        FuncSpec { code: callee.to_vec(), arity: callee_arity, env: true, temps: 0, callees: vec![], src: &fc },
+        FuncSpec { code: caller.to_vec(), arity: 0, env: false, temps: 0, callees: vec![0], src: &ff },
+    ];
+    gen_module(Wasm { n }, &funcs, 1)
+}
