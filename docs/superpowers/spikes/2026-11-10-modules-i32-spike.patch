+/// generator (`tatic_wasm::wasm::sim::gen_module`). Callee `j` of the machine is the `j`-th callee head of the term in
+/// order of first appearance (checked only by arity: the lowering's numbering is not exposed).
+pub(crate) fn sim_module(store: &TermStore, h: Hash, m: usize, funcs: &[ModFn], n: usize) -> Result<(Expr, Expr), String> {
+    let mut body = match store.resolve(h) {
+        Term::Rec(inner) => *inner,
+        _ => h,
+    };
+    for _ in 0..m {
+        match store.resolve(body) {
+            Term::Abs(b) => body = *b,
+            other => return Err(format!("fewer than {m} leading lambdas: {other:?}")),
         }
     }
+    let mut calls = Some(vec![]);
+    walk(store, body, m, &mut calls)?;
+    let calls = calls.unwrap_or_default();
+    let Some((entry, callees)) = funcs.split_last() else { return Err("an empty module".into()) };
+    if callees.len() != calls.len() {
+        return Err(format!("the machine has {} callee functions, the term {}", callees.len(), calls.len()));
+    }
+    if entry.arity != m {
+        return Err(format!("the entry has {} parameters, the term {m}", entry.arity));
+    }
+    let peeled: Vec<(Hash, usize)> = calls.iter().map(|t| peel_fn(store, *t)).collect();
+    for (j, ((_, k), f)) in peeled.iter().zip(callees).enumerate() {
+        if f.arity != *k {
+            return Err(format!("callee {j}: {} machine parameters, {k} in the term", f.arity));
+        }
+    }
+    let positions: Vec<(Hash, usize)> = calls.iter().copied().enumerate().map(|(j, t)| (t, j)).collect();
+    let callee_srcs: Vec<Box<SrcFn>> = peeled
+        .iter()
+        .map(|(b, _)| {
+            let b = *b;
+            Box::new(move |c: &mut Cx, env: &SEnv, kk: &dyn Fn(&mut Cx, Expr) -> Expr| {
+                Source { store, qs: env.params.clone(), r: env.r, n, sim: Some(env), callees: &[] }.cps(c, b, kk)
+            }) as Box<SrcFn>
+        })
+        .collect();
+    let entry_src = |c: &mut Cx, env: &SEnv, kk: &dyn Fn(&mut Cx, Expr) -> Expr| {
+        Source { store, qs: env.params.clone(), r: env.r, n, sim: Some(env), callees: &positions }.cps(c, body, kk)
+    };
+    let mut specs: Vec<FuncSpec> = callees
+        .iter()
+        .zip(&callee_srcs)
+        .map(|(f, s)| FuncSpec { code: f.code.clone(), arity: f.arity, env: f.env, temps: 0, callees: vec![], src: &**s })
+        .collect();
+    specs.push(FuncSpec { code: entry.code.clone(), arity: m, env: entry.env, temps: 0, callees: (0..calls.len()).collect(), src: &entry_src });
+    gen_module(Wasm { n }, &specs, calls.len())
 }
