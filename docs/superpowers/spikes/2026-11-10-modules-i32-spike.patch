+#[test]
+fn gen_module_call_as_hypothesis() {
+    let (callee, caller, caller_src) = sub_module();
+    let callee_src = pr(Op::Sub, p(0), p(1));
+    for n in [4, 8, 24] {
+        let r = run_module(n, &callee, &caller, callee_src.clone(), caller_src.clone(), 2);
+        println!("MODULE n={n} sub: {r:?}");
+        r.unwrap();
+    }
+}
+
+/// Mutants of the module: each must be rejected, by the generator's walk or the kernel.
+#[test]
+fn gen_module_controls() {
+    let (callee, caller, caller_src) = sub_module();
+    let callee_src = pr(Op::Sub, p(0), p(1));
+    let cases: Vec<(&str, Vec<Ins>, Vec<Ins>, Src, Src)> = vec![
+        // the call names the function itself (position 1), not the callee
+        ("wrong callee index (self)", callee.clone(), vec![Ins::ConstI(0), pu(10), pu(3), call_to(1, 2)], callee_src.clone(), caller_src.clone()),
+        // the call names a position that is not in the table
+        ("wrong callee index (absent)", callee.clone(), vec![Ins::ConstI(0), pu(10), pu(3), call_to(2, 2)], callee_src.clone(), caller_src.clone()),
+        // x - y with the arguments pushed the other way round
+        ("wrong argument order", callee.clone(), vec![Ins::ConstI(0), pu(3), pu(10), call_to(0, 2)], callee_src.clone(), caller_src.clone()),
+        // the environment pointer not 0
+        ("wrong environment", callee.clone(), vec![Ins::ConstI(1), pu(10), pu(3), call_to(0, 2)], callee_src.clone(), caller_src.clone()),
+        // a callee law that does not hold: the machine adds, the source subtracts
+        ("callee law false", vec![lg(0), lg(1), op(Op::Add)], caller.clone(), callee_src.clone(), caller_src.clone()),
+        // the caller's own source disagrees with what the call returns
+        ("caller source wrong", callee.clone(), caller.clone(), callee_src.clone(), Src::CallFn(0, vec![l(10), l(4)])),
+    ];
+    let mut accepted = vec![];
+    for n in [4, 8] {
+        for (what, cm, cr, cs, rs) in &cases {
+            match run_module(n, cm, cr, cs.clone(), rs.clone(), 2) {
+                Ok(()) => accepted.push((n, *what)),
+                Err(e) => println!("CONTROL n={n} {what}: rejected: {}", e.chars().take(140).collect::<String>()),
+            }
+        }
+    }
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+}
+
+/// The kernel is the judge, not the walk: the proof of one module does not check against another's statement (the
+/// callee's law differs: `x - y` against `x + y`).
+#[test]
+fn gen_module_kernel_rejects_a_proof_for_another_callee() {
+    std::thread::scope(|s| {
+        std::thread::Builder::new()
+            .stack_size(tatic_kernel::CHECK_STACK)
+            .spawn_scoped(s, || {
+                let (callee, caller, caller_src) = sub_module();
+                let (proof, own) = build_module(8, &callee, &caller, &pr(Op::Sub, p(0), p(1)), &caller_src, 2).unwrap();
+                let add = vec![lg(0), lg(1), op(Op::Add)];
+                let (_, other) = build_module(8, &add, &caller, &pr(Op::Add, p(0), p(1)), &caller_src, 2).unwrap();
+                assert!(tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &own).is_ok());
+                let r = tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &other);
+                println!("MODULE-KERNEL-NEG: {}", r.as_ref().err().map(|e| e.chars().take(100).collect::<String>()).unwrap_or_default());
+                assert!(r.is_err(), "the kernel accepted sub's proof for add's statement");
+            })
+            .unwrap()
+            .join()
+            .unwrap()
+    })
+}
