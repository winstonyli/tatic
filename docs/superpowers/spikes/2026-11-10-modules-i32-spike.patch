+/// Whether the body `h` of `m` parameters is in the generator's fragment: parameters, literals and table rows, with `If`s
+/// on comparisons, saturated calls of the function itself (`Var(m)`) and (S3), where `calls` is `Some`, saturated calls
+/// of function terms (`Abs^k` or `Rec(Abs^k)`) whose own bodies are in the fragment with no callees. `calls` collects the
+/// callee heads in order of first appearance.
+fn walk(store: &TermStore, h: Hash, m: usize, calls: &mut Option<Vec<Hash>>) -> Result<(), String> {
+    match store.resolve(h) {
+        Term::Lit(_) => Ok(()),
+        Term::Var(i) if (*i as usize) < m => Ok(()),
+        Term::Var(i) => Err(format!("free variable {i}")),
+        Term::Prim(p, a, b) => match op_of(*p) {
+            Some(o) if o.kind() == K::W => walk(store, *a, m, calls).and(walk(store, *b, m, calls)),
+            _ => Err(format!("operator {p:?} has no word row")),
+        },
+        Term::If(c, t, e) => match store.resolve(*c) {
+            Term::Prim(p, a, b) if is_comparison(*p) => {
+                walk(store, *a, m, calls).and(walk(store, *b, m, calls)).and(walk(store, *t, m, calls)).and(walk(store, *e, m, calls))
+            }
+            other => Err(format!("an If on {other:?}, not a comparison")),
+        },
+        Term::App(..) => {
+            let (mut args, mut cur) = (vec![], h);
+            while let Term::App(f, a) = store.resolve(cur) {
+                args.push(*a);
+                cur = *f;
+            }
+            args.reverse();
+            match store.resolve(cur) {
+                Term::Var(i) if *i as usize == m && args.len() == m => {}
+                Term::Abs(_) | Term::Rec(_) => {
+                    let (body, k) = peel_fn(store, cur);
+                    if args.len() != k {
+                        return Err(format!("a call of a {k}-parameter function on {} arguments", args.len()));
+                    }
+                    let Some(list) = calls.as_mut() else { return Err("a callee that itself calls a callee".into()) };
+                    if !list.contains(&cur) {
+                        list.push(cur);
+                    }
+                    walk(store, body, k, &mut None)?;
+                }
+                other => return Err(format!("an application of {other:?} that is not a saturated call")),
+            }
+            args.iter().try_for_each(|a| walk(store, *a, m, calls))
+        }
+        other => Err(format!("{other:?} is outside the generator's fragment")),
+    }
+}
