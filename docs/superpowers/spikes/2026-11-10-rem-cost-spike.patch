+        let mut diff = Vec::with_capacity(n);
+        for j in 0..n {
+            let x = xor(r2[j], mb[j]);
+            diff.push(xor(x, borrow));
+            borrow = ripple_carry(true, r2[j], mb[j], borrow, x);
+        }
+        let ge = not_(borrow);
+        r = (0..n).map(|j| mux(ge, diff[j], r2[j])).collect();
+    }
+    neg_if(&r, sa)
