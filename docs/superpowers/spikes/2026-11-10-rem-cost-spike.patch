+/// The cost of `%` through the gate beside `*`, at the gate's width `N` (edit the const to sweep it): circuit sizes
+/// (distinct nodes, tree nodes), then `name build_ms check_ms ok` best of 3.
+#[test]
+#[ignore]
+fn measure_rem_cost() {
+    for o in [Op::Mul, Op::RemS] {
+        let t0 = std::time::Instant::now();
+        let term = o.term(N);
+        let (d, tree) = tatic_kernel::term_sizes(&term);
+        println!("circuit {o:?} n={N}: {d} distinct, {tree} tree nodes, built in {:.2} ms", t0.elapsed().as_secs_f64() * 1e3);
+    }
+    for (name, src) in [
+        ("mul", r"\a b. a * b"),
+        ("rem", r"\a b. a % b"),
+        ("rem in an arm", r"\a b. if a < b then a % b else a"),
+        ("mul in an arm", r"\a b. if a < b then a * b else a"),
+    ] {
+        let (s, h, frag) = compiled(&move |s: &mut TermStore| source(s, src));
+        assert!(in_fragment(&s, h, 2), "{name} should be in the fragment");
+        let (b, k, ok) = time_gate(&s, h, 2, frag.entry(), 1, 3);
+        println!("n={N} {name} {b:.2} {k:.2} {ok}");
+    }
+}
+
