+/// Runs `f` on a `CHECK_STACK` thread.
+fn big<T: Send + 'static>(f: impl FnOnce() -> T + Send + 'static) -> T {
+    std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn(f).unwrap().join().unwrap()
+}
+
+/// The partial-row cost (i4): per width, each term guarded (`ctrl` 0) and, for the `%` terms, with both guards removed
+/// (`ctrl` 4: unsound, cost reference only), beside the same shapes with `*`. Prints
+/// `n name guard build_ms check_ms ok`, best of 3.
+#[test]
+#[ignore]
+fn measure_partial_row_cost() {
+    use crate::proof::gate::set_nbits;
+    let cases: [(&str, &str, usize, bool); 8] = [
+        ("rem tail", r"\a b. a % b", 2, true),
+        ("rem nontail", r"\a b. (a % b) + b", 2, true),
+        ("rem twice", r"\a b c. (a % b) % c", 3, true),
+        ("rem in an arm", r"\a b. if a < b then a % b else a", 2, true),
+        ("mul tail", r"\a b. a * b", 2, false),
+        ("mul nontail", r"\a b. (a * b) + b", 2, false),
+        ("mul twice", r"\a b c. (a * b) * c", 3, false),
+        ("mul in an arm", r"\a b. if a < b then a * b else a", 2, false),
+    ];
+    for n in [4usize, 24, 64] {
+        set_nbits(n);
+        for (name, src, arity, partial) in cases {
+            for ctrl in if partial { vec![0u8, 4] } else { vec![0] } {
+                tatic_wasm::ops::CTRL.store(ctrl, std::sync::atomic::Ordering::Relaxed);
+                let (b, k, ok) = big(move || {
+                    let (s, h, frag) = compiled(&move |s: &mut TermStore| source(s, src));
+                    assert!(in_fragment(&s, h, arity), "{name} should be in the fragment");
+                    time_gate(&s, h, arity, frag.entry(), 1, 3)
+                });
+                println!("n={n} {name} {} {b:.2} {k:.2} {ok}", if ctrl == 4 { "unguarded" } else { "guarded" });
+            }
+        }
+    }
+    tatic_wasm::ops::CTRL.store(0, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// The partial row's controls (n = 64 unless said). Each mutant must be rejected, for the reason printed.
+#[test]
+#[ignore]
+fn partial_row_controls() {
+    use std::sync::atomic::Ordering::Relaxed;
+    use tatic_wasm::ops::{Dom, CTRL};
+    let srcs: [(&str, usize); 3] = [(r"\a b. a % b", 2), (r"\a b. (a % b) + b", 2), (r"\a b c. (a % b) % c", 3)];
+    let run = |ctrl: u8| -> Vec<bool> {
+        CTRL.store(ctrl, Relaxed);
+        let r = big(move || {
+            srcs.iter()
+                .map(|&(src, arity)| {
+                    let (s, h, frag) = compiled(&move |s: &mut TermStore| source(s, src));
+                    gate(&s, h, arity, frag.entry())
+                })
+                .collect::<Vec<bool>>()
+        });
+        CTRL.store(0, Relaxed);
+        r
+    };
+    println!("sound (ctrl 0): gate accepts {:?}", run(0));
+    println!("machine guard dropped (ctrl 1): gate accepts {:?}", run(1));
+    println!("machine tests the wrong operand (ctrl 3): gate accepts {:?}", run(3));
+    println!("both sides test the wrong operand (ctrl 2): gate accepts {:?}", run(2));
+    println!("both sides unguarded (ctrl 4): gate accepts {:?}", run(4));
+    // the table test's check of a wrong shared Dom: the circuit against `holds`, at n = 8
+    CTRL.store(2, Relaxed);
+    let bad = big(|| {
+        let d = Dom::NonZeroDivisor;
+        let mut bad = vec![];
+        for (x, y) in [(5i64, 0i64), (0, 5), (3, 3), (0, 0)] {
+            let got = tatic_kernel::app2(d.term(8), tatic_wasm::encoding::lit(8, x as u128), tatic_wasm::encoding::lit(8, y as u128));
+            if !tatic_kernel::def_eq(&got, &tatic_wasm::encoding::lit(1, d.holds(x, y) as u128)) {
+                bad.push((x, y));
+            }
+        }
+        bad
+    });
+    CTRL.store(0, Relaxed);
+    println!("wrong-operand Dom (ctrl 2) disagrees with `holds` at {bad:?}");
+    // an operator mutated in the emitted code, and `%` replaced by `/` in the source
+    for (what, to) in [("RemS -> Mul", Op::Mul), ("RemS -> Add", Op::Add), ("RemS -> Sub", Op::Sub)] {
+        let ok = big(move || {
+            let (s, h, frag) = compiled(&|s: &mut TermStore| source(s, r"\a b. a % b"));
+            let m = mutate(frag.entry(), &|i| (i == &Ins::Op(Op::RemS)).then_some(Ins::Op(to)));
+            assert_ne!(m, frag.entry(), "{what} changed nothing");
+            gate(&s, h, 2, &m)
+        });
+        println!("{what}: gate accepts {ok}");
+    }
+    let (s, h, _) = {
+        let mut s = TermStore::new();
+        let h = source(&mut s, r"\a b. a / b");
+        (s, h, ())
+    };
+    println!("`a / b` (Div, no row): in_fragment {}", in_fragment(&s, h, 2));
+}
