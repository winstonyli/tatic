+/// `Op::RemS` on literals against Rust's `wrapping_rem` (and `x % 0 = x`, which `eval` rejects and wasm traps on).
+fn rem_ref(n: usize, a: u128, b: u128) -> u128 {
+    let sext = |v: u128| ((v << (128 - n)) as i128) >> (128 - n);
