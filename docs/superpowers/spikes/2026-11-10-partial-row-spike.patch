+/// restoring division of the magnitudes, one subtract-and-select row per dividend bit, MSB first.
+pub fn rem_s_bits(n: usize, a: &[Expr], b: &[Expr]) -> Vec<Expr> {
+    let (sa, sb) = (a[n - 1], b[n - 1]);
+    let (ma, mb) = (neg_if(a, sa), neg_if(b, sb));
