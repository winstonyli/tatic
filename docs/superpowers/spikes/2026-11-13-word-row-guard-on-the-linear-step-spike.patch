+//! SPIKE x1 (option 1 of the partial-row draft): verdicts for `%` through the gate, and the controls.
+use super::gate::{big, compiled};
+use super::*;
+use crate::jit::shape::wasm_table;
+use crate::lang::term::Hash;
+use crate::proof::gate::{gate, Layer, Verdict};
+use crate::support::samples::{gcd, gcd_with_two_base_cases, source};
+use crate::testing::ins_mutate::{mutate, with_entry};
+use tatic_wasm::encoding::{constant_n, dom_true, rem_s};
+use tatic_wasm::machine::{Class, Entry, Ins, Row, Table};
+
+fn row(name: &'static str) -> Ins {
+    Ins::Row { name, operand: 0 }
+}
+
+/// The wasm table plus `mod_total`: `mod`'s circuit and line with the constant-true domain.
+fn twin() -> Table {
+    let t = wasm_table();
+    let mut rows: Vec<Row> = t
+        .names()
+        .into_iter()
+        .map(|n| {
+            let r = t.row(n).unwrap();
+            Row { name: r.name, class: r.class, meaning: r.meaning, dom: r.dom, line: r.line }
+        })
+        .collect();
+    rows.push(Row { name: "mod_total", class: Class::Word, meaning: |_c, m, _| constant_n(rem_s, m.n), dom: dom_true, line: |_| "i64.rem_s".to_string() });
+    Table::new(rows)
+}
+
+type Build = fn(&mut TermStore) -> Hash;
+
+/// The gate's verdict on `mk`'s fragment with its code edited by `edit`, against the twin table when `use_twin`, with
+/// the machine's Word guard dropped when `drop_guard`.
+fn run(mk: Build, edit: fn(Vec<Ins>) -> Vec<Ins>, use_twin: bool, drop_guard: bool) -> Verdict {
+    big(move || {
+        let (s, h, frag) = compiled(&mk);
+        let frag = with_entry(frag, |e| Entry { code: edit(e.code.clone()), ..e });
+        tatic_wasm::machine::spike_drop_guard(drop_guard);
+        let v = if use_twin { gate(&twin(), &s, h, &frag) } else { gate(wasm_table(), &s, h, &frag) };
+        tatic_wasm::machine::spike_drop_guard(false);
+        v
+    })
+}
+
+fn same(c: Vec<Ins>) -> Vec<Ins> {
+    c
+}
+fn to_total(c: Vec<Ins>) -> Vec<Ins> {
+    let out = mutate(&c, &|i| (i == &row("mod")).then_some(row("mod_total")));
+    assert!(out != c, "the code holds a mod site");
+    out
+}
+
+fn mod_if(s: &mut TermStore) -> Hash {
+    source(s, r"\a b. if a % b == 0 then a else b")
+}
+fn mod_chain(s: &mut TermStore) -> Hash {
+    source(s, r"\a b c. a % (b % c)")
+}
+fn mod_plain(s: &mut TermStore) -> Hash {
+    source(s, r"\a b. a % b")
+}
+
+#[test]
+fn x1_verdicts() {
+    let cases: [(&str, Build); 5] = [
+        ("gcd", gcd),
+        ("gcd_with_two_base_cases", gcd_with_two_base_cases),
+        ("if a % b == 0 then a else b", mod_if),
+        ("a % (b % c)", mod_chain),
+        ("a % b", mod_plain),
+    ];
+    for (name, mk) in cases {
+        let v = run(mk, same, false, false);
+        println!("X1 verdict {name}: {v:?}");
+    }
+    for (name, mk) in [("gcd", gcd as Build), ("gcd2", gcd_with_two_base_cases)] {
+        assert_eq!(run(mk, same, false, false), Verdict::Accepted, "{name}");
+    }
+}
+
+#[test]
+fn x1_controls() {
+    // the twin table alone changes nothing
+    assert_eq!(run(gcd, same, true, false), Verdict::Accepted, "gcd against the twin table");
+    // (i) the machine reads mod_total (domain constant true), the source reads mod (domain y != 0)
+    for (name, mk) in [("gcd", gcd as Build), ("gcd2", gcd_with_two_base_cases)] {
+        let v = run(mk, to_total, true, false);
+        println!("X1 control i {name}: {v:?}");
+        assert!(matches!(v, Verdict::Rejected(Layer::Walk, _)), "{name}: {v:?}");
+    }
+    // (ii) the machine's guard dropped for the Word sites (gcd's only Word row is mod)
+    for (name, mk) in [("gcd", gcd as Build), ("gcd2", gcd_with_two_base_cases)] {
+        let v = run(mk, same, false, true);
+        println!("X1 control ii {name}: {v:?}");
+        assert!(matches!(v, Verdict::Rejected(..)), "{name}: {v:?}");
+    }
+}
+
+/// Right-nested `a % (b % (a % ... b))` with `d` operators: the y operand of every level is a guarded prim result.
+fn chain_src(d: usize) -> String {
+    let mut e = "b".to_string();
+    for k in 0..d {
+        e = format!("({} % {})", if k % 2 == 0 { "a" } else { "b" }, e);
+    }
+    format!(r"\a b. {e}")
+}
+
+/// (accepted, check work, build work) of the nested chain at depth `d`.
+fn chain_work(d: usize) -> (bool, u64, u64) {
+    big(move || {
+        let src = chain_src(d);
+        let (s, h, frag) = compiled(&move |s: &mut TermStore| source(s, &src));
+        tatic_kernel::scoped(|| {
+            let b0 = tatic_kernel::work();
+            let (p, st) = super::gate::built(&s, h, &frag);
+            let b1 = tatic_kernel::work();
+            let w0 = tatic_kernel::work();
+            let ok = tatic_wasm::encoding::holds(&p, &st).is_ok();
+            (ok, tatic_kernel::work() - w0, b1 - b0)
+        })
+    })
+}
+
+#[test]
+fn x1_mod_chain_work() {
+    for d in [4usize, 8, 16, 32, 64, 128, 256] {
+        let (ok, check, build) = chain_work(d);
+        println!("X1 chain d={d} accepted={ok} check_work={check} build_work={build}");
+        assert!(ok, "d={d}");
+    }
+}
