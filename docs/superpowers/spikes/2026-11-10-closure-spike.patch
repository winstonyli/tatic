+#[test]
+pub fn closure_spike() {
+    for n in [4usize, 24, 64] {
+        tatic_kernel::scoped(|| {
+            let w = Wasm { n };
+            let run = |name: &str, build: &dyn Fn() -> (Expr, Expr)| {
+                let t0 = Instant::now();
+                let (p, s) = build();
+                let tb = t0.elapsed();
+                let t1 = Instant::now();
+                ck(&format!("{name} n={n}"), &p, &s);
+                println!("CLOS n={n} {name}: build {tb:?}, check {:?} (proved)", t1.elapsed());
+            };
+            let rej = |name: &str, build: &dyn Fn() -> (Expr, Expr)| {
+                let t0 = Instant::now();
+                let (p, s) = build();
+                let tb = t0.elapsed();
+                let sort_of = infer(&Ctx::new(), &s).map(|t| whnf(&t));
+                assert!(matches!(sort_of.as_ref().map(|t| t.node()), Ok(tatic_kernel::Node::Sort(_))), "{name}: statement is not a type: {sort_of:?}");
+                let t1 = Instant::now();
+                let e = holds(&p, &s).expect_err(&format!("{name} must be rejected at n={n}"));
+                println!("CLOS n={n} {name}: build {tb:?}, check {:?} (rejected: {})", t1.elapsed(), e.chars().take(100).collect::<String>());
+            };
+            let split = |swap: bool| {
+                let word = lit(n, clo_word(n));
+                let want = lit(n, TIDX);
+                (refl(want.clone()), id(w.v(), app(clo_half(n, swap), word), want))
+            };
+            run("split lo(clo) = idx", &|| split(false));
+            rej("split hi(clo) = idx", &|| split(true));
+            run("twice law", &|| twice_law(w, Tw::Ok));
+            run("concrete: plus 1 related to \\a ks. ks (a+1)", &|| conc_law(w, 1, 1));
+            run("compose: twice (plus 1) x = ks ((x+1)+1)", &|| comp_law(w, 1));
+            rej("control: twice calls f once", &|| twice_law(w, Tw::Once));
+            rej("control: inner call's argument f x + 1", &|| twice_law(w, Tw::WrongArg));
+            rej("control: halves swapped in the split", &|| twice_law(w, Tw::Swap));
+            rej("control: table entry computes v + 2, relation v + 1", &|| conc_law(w, 2, 1));
+            rej("control: compose with the v + 2 table", &|| comp_law(w, 2));
+            // stretch: iterate (17)
+            run("iterate run: 2 iterations of +1 from 5, fuel 3, answers 7", &|| iter_run(w, 2, 5, 3, Some(7)));
+            run("iterate run: fuel 2 times out", &|| iter_run(w, 2, 5, 2, None));
+            rej("iterate run: answers 8", &|| iter_run(w, 2, 5, 3, Some(8)));
+            run("concrete (pure): plus 1 related, CRp", &|| conc_pure_law(w));
+            run("iterate law (CRp)", &|| iter_law(w, It::Ok));
+            run("iterate (+1 closure) = fuel-N source", &|| iter_comp(w));
+            rej("control: iterate tests n < 0", &|| iter_law(w, It::LtNotLe));
+            rej("control: iterate calls f on n", &|| iter_law(w, It::ArgN));
+            rej("control: iterate drops the call", &|| iter_law(w, It::NoCall));
+        })
+    }
+}
