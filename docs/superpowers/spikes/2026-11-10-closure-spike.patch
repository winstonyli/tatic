+// ---- SPIKE stretch: `iterate` (17) against CR for pure callees (`CRp`: the callee hands the heap back) ----
+
+/// `CRp(clo, f) := Pi a h km ks. (Pi y. km y h = ks y) -> Id(R, tbl (lo clo) (hi clo) a h km, f a ks)`.
+fn crp_ty(w: Wasm, c: &mut Cx, r: At, tbl: At, clo: At, fapp: FApp) -> Expr {
+    let n = w.n;
+    c.pi(w.v(), |c, a| {
+        let heap = w.mem(c, r);
+        c.pi(heap, |c, h| {
+            let ret = ret_m(w, c, r);
+            c.pi(ret, |c, km| {
+                let kt = arrow(w.v(), c.at(r));
+                c.pi(kt, |c, ks| {
+                    let hy = c.pi(w.v(), |c, y| id(c.at(r), app2(c.at(km), c.at(y), c.at(h)), app(c.at(ks), c.at(y))));
+                    c.pi(hy, |c, _| {
+                        let (lo, hi) = (app(clo_half(n, false), c.at(clo)), app(clo_half(n, true), c.at(clo)));
+                        let lhs = apps(c.at(tbl), vec![lo, hi, c.at(a), c.at(h), c.at(km)]);
+                        let (aa, kk) = (c.at(a), c.at(ks));
+                        let rhs = fapp(c, aa, kk);
+                        id(c.at(r), lhs, rhs)
+                    })
+                })
+            })
+        })
+    })
+}
