+/// `V -> (V -> R) -> R`: a source function in CPS.
+fn fs_ty(w: Wasm, c: &mut Cx, r: At) -> Expr {
+    arrow(w.v(), arrow(arrow(w.v(), c.at(r)), c.at(r)))
+}
+/// `Pi y h'. Id(R, km y h', ks y)`: the machine's continuation is the source's, whatever heap it is handed.
+fn kcont_ty(w: Wasm, c: &mut Cx, r: At, km: At, ks: At) -> Expr {
+    c.pi(w.v(), |c, y| {
+        let heap = w.mem(c, r);
+        c.pi(heap, |c, h2| id(c.at(r), app2(c.at(km), c.at(y), c.at(h2)), app(c.at(ks), c.at(y))))
+    })
