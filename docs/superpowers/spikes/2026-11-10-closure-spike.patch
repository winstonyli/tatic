+/// `Pi R z. CR(clo_word, \a ks. ks (a + rel_add))` for the table holding `plus_body(body_add)` at `TIDX`.
+pub fn conc_law(w: Wasm, body_add: i64, rel_add: i64) -> (Expr, Expr) {
+    let n = w.n;
+    let tys: Vec<Ty> = vec![ty!(|_c, _x| sort(0)), ty!(|c, x| c.at(x[0]))];
+    law(&tys, |c, x| {
+        let (r, z) = (x[0], x[1]);
+        let tbl = tbl_concrete(w, c, r, z, &plus_body(body_add), TIDX, false);
+        let tbl = c.mark(tbl);
+        let clo = c.mark(lit(n, clo_word(n)));
+        let plus = move |a: Expr| app2(Op::Add.term(n), a, lit(n, rel_add as u128));
+        let stmt = cr_ty(w, c, r, tbl, clo, &move |_c, a, ks| app(ks, plus(a)));
+        let proof = c.lam(w.v(), |c, a| {
+            let heap = w.mem(c, r);
+            c.lam(heap, |c, h| {
+                let ret = ret_m(w, c, r);
+                c.lam(ret, |c, km| {
+                    let kt = arrow(w.v(), c.at(r));
+                    c.lam(kt, |c, ks| {
+                        let hy = kcont_ty(w, c, r, km, ks);
+                        c.lam(hy, |c, hy| {
+                            let val = app2(Op::Add.term(n), c.at(a), lit(n, rel_add as u128));
+                            let env = app(clo_half(n, true), c.at(clo));
+                            let (ae, he) = (c.at(a), c.at(h));
+                            let fr = frame2(w, c, r, env, ae, he);
+                            apps(c.at(hy), vec![val, fr])
+                        })
+                    })
+                })
+            })
+        });
+        (proof, stmt)
+    })
+}
