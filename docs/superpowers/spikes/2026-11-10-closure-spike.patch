+/// `V -> V -> V -> Mem -> (V -> Mem -> R) -> R`: the table, by (index, env, argument).
+fn tbl_ty(w: Wasm, c: &mut Cx, r: At) -> Expr {
+    let (heap, ret) = (w.mem(c, r), ret_m(w, c, r));
