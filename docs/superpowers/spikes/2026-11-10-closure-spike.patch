+fn frame2(w: Wasm, c: &mut Cx, r: At, p0: Expr, p1: Expr, mu: Expr) -> Expr {
+    let inner = w.upd(c, r, lit(w.n, 1), p1, mu);
+    w.upd(c, r, lit(w.n, 0), p0, inner)
