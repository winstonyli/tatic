+/// `Pi y h'. Id(R, k (y, s) h', ks y)`: the same, for the machine's final continuation `k` on the stack `(y, s)`.
+fn hk_ty(w: Wasm, c: &mut Cx, r: At, sty: At, k: At, s: At, ks: At) -> Expr {
+    c.pi(w.v(), |c, y| {
+        let heap = w.mem(c, r);
+        c.pi(heap, |c, h2| {
+            id(c.at(r), app2(c.at(k), mkpair(c.at(sty), c.at(y), c.at(s)), c.at(h2)), app(c.at(ks), c.at(y)))
+        })
+    })
