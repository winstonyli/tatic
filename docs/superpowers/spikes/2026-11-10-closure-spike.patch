+/// The concrete table: index `k` runs `body` (env in local 0, argument in local 1) on the callee's own frame over
+/// the caller's heap and hands its one answer, with the heap it ends on, to the continuation; any other index times out.
+fn tbl_concrete(w: Wasm, c: &mut Cx, r: At, z: At, body: &[Ins], k: u128, restore: bool) -> Expr {
+    let n = w.n;
+    c.lam(w.v(), |c, idx| {
+        c.lam(w.v(), |c, env| {
+            c.lam(w.v(), |c, a| {
+                let heap = w.mem(c, r);
+                c.lam(heap, |c, mu| {
+                    let ret = ret_m(w, c, r);
+                    c.lam(ret, |c, km| {
+                        let base = c.mark(bv_ty(n));
+                        let p = w.prog(c, body, &[], base);
+                        let p = c.mark(p);
+                        let fuel0 = c.mark(nat2_lit(0));
+                        let st_ty = prod(w.v(), c.at(base));
+                        let kk = c.lam(st_ty, |c, st| {
+                            let heap = w.mem(c, r);
+                            c.lam(heap, |c, mu2| {
+                                // `restore`: the callee's frame and temporaries are private, the caller's heap comes back
+                                let back = if restore { mu } else { mu2 };
+                                w.split(c, r, w.v(), base, st, |c, y, _| app2(c.at(km), c.at(y), c.at(back)))
+                            })
+                        });
+                        let kk = c.mark(kk);
+                        let m = w.meaning(c, p, fuel0, r, kk, z);
+                        let (ee, ae, me) = (c.at(env), c.at(a), c.at(mu));
+                        let fr = frame2(w, c, r, ee, ae, me);
+                        let entry = app2(m, lit(n, 0), fr);
+                        choose(c.at(r), app2(Op::Eq.term(n), c.at(idx), lit(n, k)), entry, c.at(z))
+                    })
+                })
+            })
+        })
+    })
+}
