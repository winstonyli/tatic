+/// `Pi R z. CRp(clo_word, \a ks. ks (a + 1))` for the table holding `\v. v + 1` at `TIDX` with a private callee frame.
+pub fn conc_pure_law(w: Wasm) -> (Expr, Expr) {
+    let n = w.n;
+    let tys: Vec<Ty> = vec![ty!(|_c, _x| sort(0)), ty!(|c, x| c.at(x[0]))];
+    law(&tys, |c, x| {
+        let (r, z) = (x[0], x[1]);
+        let tbl = tbl_concrete(w, c, r, z, &plus_body(1), TIDX, true);
+        let tbl = c.mark(tbl);
+        let clo = c.mark(lit(n, clo_word(n)));
+        let stmt = crp_ty(w, c, r, tbl, clo, &move |_c, a, ks| app(ks, app2(Op::Add.term(n), a, lit(n, 1))));
+        let proof = c.lam(w.v(), |c, a| {
+            let heap = w.mem(c, r);
+            c.lam(heap, |c, _h| {
+                let ret = ret_m(w, c, r);
+                c.lam(ret, |c, km| {
+                    let kt = arrow(w.v(), c.at(r));
+                    c.lam(kt, |c, ks| {
+                        let hy = c.pi(w.v(), |c, y| id(c.at(r), app2(c.at(km), c.at(y), c.at(_h)), app(c.at(ks), c.at(y))));
+                        c.lam(hy, |c, hy| app(c.at(hy), app2(Op::Add.term(n), c.at(a), lit(n, 1))))
+                    })
+                })
+            })
+        });
+        (proof, stmt)
+    })
+}
