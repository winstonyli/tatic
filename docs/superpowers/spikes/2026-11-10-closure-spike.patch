+    law(&tys, |c, y| {
+        let [sty, r, z, k, xx, s, mu, ks, hk] = [0, 1, 2, 3, 4, 5, 6, 7, 8].map(|i| y[i]);
+        let tbl = tbl_concrete(w, c, r, z, &plus_body(body_add), TIDX, false);
+        let tbl = c.mark(tbl);
+        let clo = lit(n, clo_word(n));
+        let (xe, se, me) = (c.at(xx), c.at(s), c.at(mu));
+        let l = clo_lhs(w, c, &twice_code(Tw::Ok), false, (sty, r, k, z, tbl), clo.clone(), xe, se, me);
+        let plus1 = |a: Expr| app2(Op::Add.term(n), a, lit(n, 1));
+        let rhs = app(c.at(ks), plus1(plus1(c.at(xx))));
+        let f = c.lam(w.v(), |c, a| c.lam(arrow(w.v(), c.at(r)), |c, k2| app(c.at(k2), plus1(c.at(a)))));
+        let (tp, _) = twice_law(w, Tw::Ok);
+        let (cp, _) = conc_law(w, 1, 1);
+        let cr = apps(cp, vec![c.at(r), c.at(z)]);
+        let args = vec![c.at(sty), c.at(r), c.at(z), c.at(k), c.at(tbl), f, clo, c.at(xx), c.at(s), c.at(mu), c.at(ks), cr, c.at(hk)];
+        (apps(tp, args), id(c.at(r), l, rhs))
+    })
+}
