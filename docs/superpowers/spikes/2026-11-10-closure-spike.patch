+/// Table index and env of the concrete closure, and its closure word `idx | env << n/2`.
+const TIDX: u128 = 1;
+const TENV: u128 = 2;
+fn clo_word(n: usize) -> u128 {
+    TIDX | (TENV << (n / 2))
+}
