+fn half_circuit(n: usize, hi: bool) -> Expr {
+    let h = n / 2;
+    let d = 3 + n; // ctx [a, C, k, b_0 .. b_(n-1)]
+    let outs: Vec<Expr> = (0..n).map(|j| if j < h { var((d - 1 - (3 + if hi { h + j } else { j })) as u32) } else { f() }).collect();
+    let mut body = apps(var((d - 1 - 2) as u32), outs);
+    for _ in 0..n {
+        body = lam(bool0(), body);
+    }
+    lam(bv_ty(n), lam(sort(1), lam(karrow(n), app2(var(2), var(1), body))))
+}
