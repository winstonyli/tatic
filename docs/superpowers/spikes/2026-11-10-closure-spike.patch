+type FApp<'a> = &'a dyn Fn(&mut Cx, Expr, Expr) -> Expr;
+/// `CR(clo, f) := Pi a h km ks. kcont km ks -> Id(R, tbl (lo clo) (hi clo) a h km, f a ks)`, `f a ks` given by `fapp`.
+fn cr_ty(w: Wasm, c: &mut Cx, r: At, tbl: At, clo: At, fapp: FApp) -> Expr {
+    let n = w.n;
+    c.pi(w.v(), |c, a| {
+        let heap = w.mem(c, r);
+        c.pi(heap, |c, h| {
+            let ret = ret_m(w, c, r);
+            c.pi(ret, |c, km| {
+                let kt = arrow(w.v(), c.at(r));
+                c.pi(kt, |c, ks| {
