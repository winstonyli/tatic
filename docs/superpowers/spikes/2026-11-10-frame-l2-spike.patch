+/// M2 controls: the pairing of `$cK` with its source term exchanged in each place it lives. Each must be rejected, and the
+/// message says by whom (`kernel:` prefix is the kernel; anything else the generator's walk, before any proof exists).
+#[test]
+fn gen_real_m2_swapped_pairing_is_rejected() {
+    let mut accepted = vec![];
+    for (name, src) in m2_terms() {
+        for n in [4, 24] {
+            let r = on_big_stack(|| {
+                let (s, h, frag) = compiled(&|st: &mut TermStore| source(st, src));
+                let callees = frag.sources.len();
+                let mut out = vec![];
+                // (a) the machine's calls to $c0 and $c1 exchanged (kinds kept: same arity), the registry as is
+                let swap_machine = |fs: &mut Vec<ModFn>| {
+                    for f in fs.iter_mut() {
+                        f.code = swap_calls(&f.code, 0, 1);
+                    }
+                };
+                out.push(("machine calls $c0 <-> $c1", prove_edit2(&s, h, &frag, frag.entry(), n, &swap_machine, &|_| {})));
+                // (b) the registry's pairing exchanged ($c0's source is now $c1's), the machine as is: what encounter order
+                // would produce on a term where the order differs
+                let swap_src = |v: &mut Vec<Option<Hash>>| v.swap(0, 1);
+                out.push(("registry sources $c0 <-> $c1", prove_edit2(&s, h, &frag, frag.entry(), n, &|_| {}, &swap_src)));
+                // (c) the callees' bodies exchanged (positions 0 and 1), calls and registry as is
+                let swap_bodies = |fs: &mut Vec<ModFn>| {
+                    let (a, b) = (fs[0].code.clone(), fs[1].code.clone());
+                    fs[0].code = b;
+                    fs[1].code = a;
+                };
+                out.push(("callee bodies $c0 <-> $c1", prove_edit2(&s, h, &frag, frag.entry(), n, &swap_bodies, &|_| {})));
+                assert!(callees >= 2);
+                out.into_iter().map(|(w, r)| (w, r.map(|_| ()))).collect::<Vec<_>>()
+            });
+            for (what, res) in r {
+                match res {
+                    Ok(()) => accepted.push((n, name, what)),
+                    Err(e) => println!("M2-CONTROL n={n} {name} / {what}: rejected: {}", e.chars().take(170).collect::<String>()),
+                }
+            }
+        }
+    }
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+}
