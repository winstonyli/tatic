+/// A function term as the generator takes it: `Rec(Abs^k body)` or `Abs^k body` is `(body, k)` (a `Rec`'s own variable is
+/// `Var(k)` in `body`).
+fn peel_fn(store: &TermStore, h: Hash) -> (Hash, usize) {
+    let mut body = match store.resolve(h) {
+        Term::Rec(inner) => *inner,
+        _ => h,
+    };
+    let mut k = 0;
+    while let Term::Abs(b) = store.resolve(body) {
+        body = *b;
+        k += 1;
+    }
+    (body, k)
+}
+
+/// Whether the body `h` of `m` parameters is in the generator's fragment: parameters, literals and table rows, with `If`s
+/// on comparisons, saturated calls of the function itself (`Var(m)`) and saturated calls of function terms (`Abs^k` or
+/// `Rec(Abs^k)`) that the lowering registered (`pos`: the registry's source term -> its `$c` index). `calls` collects the
+/// module positions this body calls, in order of first appearance. A callee's own body is walked on its own, so a callee
+/// may call another callee.
+fn walk(store: &TermStore, h: Hash, m: usize, pos: &HashMap<Hash, usize>, calls: &mut Vec<usize>) -> Result<(), String> {
+    match store.resolve(h) {
+        Term::Lit(_) => Ok(()),
+        Term::Var(i) if (*i as usize) < m => Ok(()),
+        Term::Var(i) => Err(format!("free variable {i}")),
+        Term::Prim(p, a, b) => match op_of(*p) {
+            Some(o) if o.kind() == K::W => walk(store, *a, m, pos, calls).and(walk(store, *b, m, pos, calls)),
+            _ => Err(format!("operator {p:?} has no word row")),
+        },
+        Term::If(c, t, e) => match store.resolve(*c) {
+            Term::Prim(p, a, b) if is_comparison(*p) => walk(store, *a, m, pos, calls)
+                .and(walk(store, *b, m, pos, calls))
+                .and(walk(store, *t, m, pos, calls))
+                .and(walk(store, *e, m, pos, calls)),
+            other => Err(format!("an If on {other:?}, not a comparison")),
+        },
+        Term::App(..) => {
+            let (mut args, mut cur) = (vec![], h);
+            while let Term::App(f, a) = store.resolve(cur) {
+                args.push(*a);
+                cur = *f;
+            }
+            args.reverse();
+            match store.resolve(cur) {
+                Term::Var(i) if *i as usize == m && args.len() == m => {}
+                Term::Abs(_) | Term::Rec(_) => {
+                    let (_, k) = peel_fn(store, cur);
+                    if args.len() != k {
+                        return Err(format!("a call of a {k}-parameter function on {} arguments", args.len()));
+                    }
+                    let Some(&p) = pos.get(&cur) else { return Err("a callee the lowering did not register".into()) };
+                    if !calls.contains(&p) {
+                        calls.push(p);
+                    }
+                }
+                other => return Err(format!("an application of {other:?} that is not a saturated call")),
+            }
+            args.iter().try_for_each(|a| walk(store, *a, m, pos, calls))
         }
+        other => Err(format!("{other:?} is outside the generator's fragment")),
     }
 }
+
+/// One function of the machine's module: its instruction list, parameters and whether it has an `i32` environment.
+pub(crate) struct ModFn {
+    pub code: Vec<Ins>,
+    pub arity: usize,
+    pub env: bool,
+}
+
+/// `(proof, statement)` that the module `funcs` (the callees `$c0 ..` in table order, then the entry `$f` last) and the
+/// term `h` (an entry of `m` parameters, calling function terms and itself) simulate each other at width `n`, from the
+/// generator (`tatic_wasm::wasm::sim::gen_module`). `sources[p]` is the source term the lowering's own registry holds at
+/// `$c{p}` (`CompiledFragment::sources`): a call of a function term in the source is the call of its registered `$cK`, read,
+/// not matched by order or arity. The machine's `Call(K)` is then judged against it by the generator's walk (and the
+/// kernel).
+pub(crate) fn sim_module(store: &TermStore, h: Hash, m: usize, funcs: &[ModFn], sources: &[Option<Hash>], n: usize) -> Result<(Expr, Expr), String> {
+    let (proof, stmt) = sim_module_parts(store, h, m, funcs, sources, n)?;
+    Ok((proof?, stmt))
+}
+
+/// `sim_module`, the statement kept when the generator refuses the proof (a test checks another module's proof against it).
+pub(crate) fn sim_module_parts(
+    store: &TermStore,
+    h: Hash,
+    m: usize,
+    funcs: &[ModFn],
+    sources: &[Option<Hash>],
+    n: usize,
+) -> Result<(Result<Expr, String>, Expr), String> {
+    let mut body = match store.resolve(h) {
+        Term::Rec(inner) => *inner,
+        _ => h,
+    };
+    for _ in 0..m {
+        match store.resolve(body) {
+            Term::Abs(b) => body = *b,
+            other => return Err(format!("fewer than {m} leading lambdas: {other:?}")),
+        }
+    }
+    let Some((entry, callees)) = funcs.split_last() else { return Err("an empty module".into()) };
+    if sources.len() != callees.len() {
+        return Err(format!("the machine has {} callee functions, the lowering's registry {}", callees.len(), sources.len()));
+    }
+    if entry.arity != m {
+        return Err(format!("the entry has {} parameters, the term {m}", entry.arity));
+    }
+    let mut positions: Vec<(Hash, usize)> = vec![];
+    for (p, s) in sources.iter().enumerate() {
+        let Some(t) = s else { return Err(format!("callee {p} is not a lifted function term")) };
+        positions.push((*t, p));
+    }
+    let pos: HashMap<Hash, usize> = positions.iter().copied().collect();
+    let peeled: Vec<(Hash, usize)> = positions.iter().map(|(t, _)| peel_fn(store, *t)).collect();
+    for (j, ((_, k), f)) in peeled.iter().zip(callees).enumerate() {
+        if f.arity != *k {
+            return Err(format!("callee {j}: {} machine parameters, {k} in the term", f.arity));
+        }
+    }
+    // each function's own callees, by its body
+    let mut callee_calls: Vec<Vec<usize>> = vec![];
+    for (b, k) in &peeled {
+        let mut calls = vec![];
+        walk(store, *b, *k, &pos, &mut calls)?;
+        callee_calls.push(calls);
+    }
+    let mut entry_calls = vec![];
+    walk(store, body, m, &pos, &mut entry_calls)?;
+    let positions = &positions;
+    let callee_srcs: Vec<Box<SrcFn>> = peeled
+        .iter()
+        .map(|(b, _)| {
+            let b = *b;
+            Box::new(move |c: &mut Cx, env: &SEnv, kk: &dyn Fn(&mut Cx, Expr) -> Expr| {
+                Source { store, qs: env.params.clone(), r: env.r, n, sim: Some(env), callees: positions }.cps(c, b, kk)
+            }) as Box<SrcFn>
+        })
+        .collect();
+    let entry_src = |c: &mut Cx, env: &SEnv, kk: &dyn Fn(&mut Cx, Expr) -> Expr| {
+        Source { store, qs: env.params.clone(), r: env.r, n, sim: Some(env), callees: positions }.cps(c, body, kk)
+    };
+    let mut specs: Vec<FuncSpec> = callees
+        .iter()
+        .zip(&callee_srcs)
+        .zip(callee_calls)
+        .map(|((f, s), calls)| FuncSpec { code: f.code.clone(), arity: f.arity, env: f.env, temps: 0, callees: calls, src: &**s })
+        .collect();
+    specs.push(FuncSpec { code: entry.code.clone(), arity: m, env: entry.env, temps: 0, callees: entry_calls, src: &entry_src });
+    gen_module_parts(Wasm { n, fw: module_width(&specs) }, &specs, callees.len())
+}
