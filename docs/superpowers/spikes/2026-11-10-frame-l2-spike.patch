+//! SPIKE tests for the generator: `gen_spike` (six functions, three widths) and `gen_spike_controls` (mutants).
+use super::*;
+use std::time::Instant;
+
+/// The mini source language: a mirror of what a `Term` walk produces, for these tests only (the real one is
+/// `tatic::proof::gate::Source`).
+#[derive(Clone, Debug)]
+enum Src {
+    Param(usize),
+    Lit(u128),
+    /// A word operator on two operands.
+    Prim(Op, Box<Src>, Box<Src>),
+    /// `If(cmp, a, b, then, else)`: `cmp a b` chooses.
+    If(Op, Box<Src>, Box<Src>, Box<Src>, Box<Src>),
+    /// A call of the function itself (non-tail or tail).
+    SelfCall(Vec<Src>),
+    /// A call of the module function at this position.
+    CallFn(usize, Vec<Src>),
+}
+
+fn cps(e: &SEnv, c: &mut Cx, s: &Src, k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+    tatic_kernel::grow(|| match s {
+        Src::Param(i) => k(c, c.at(e.params[*i])),
+        Src::Lit(v) => k(c, lit(e.n, *v & low_bits(e.n))),
+        Src::Prim(o, a, b) => cps(e, c, a, &|c, x| {
+            let x = c.mark(x);
+            cps(e, c, b, &|c, y| k(c, app2(o.term(e.n), c.at(x), y)))
+        }),
+        Src::If(o, a, b, t, f) => cps(e, c, a, &|c, x| {
+            let x = c.mark(x);
+            cps(e, c, b, &|c, y| {
+                let cond = app2(o.term(e.n), c.at(x), y);
+                let (t2, f2) = (cps(e, c, t, k), cps(e, c, f, k));
+                e.choose(c, cond, t2, f2)
+            })
+        }),
+        Src::SelfCall(args) => call_args(e, c, None, args, vec![], k),
+        Src::CallFn(pos, args) => call_args(e, c, Some(*pos), args, vec![], k),
+    })
+}
+
+fn call_args(e: &SEnv, c: &mut Cx, to: Option<usize>, args: &[Src], done: Vec<At>, k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+    match args.split_first() {
+        None => match to {
+            None => e.call(c, &done, k),
+            Some(pos) => e.call_fn(c, pos, &done, k),
+        },
+        Some((a, rest)) => cps(e, c, a, &|c, x| {
+            let mut d2 = done.clone();
+            d2.push(c.mark(x));
+            call_args(e, c, to, rest, d2, k)
+        }),
+    }
+}
+
+fn p(i: usize) -> Src {
+    Src::Param(i)
+}
+fn l(v: u128) -> Src {
+    Src::Lit(v)
+}
+fn pr(o: Op, a: Src, b: Src) -> Src {
+    Src::Prim(o, Box::new(a), Box::new(b))
+}
+fn iff(o: Op, a: Src, b: Src, t: Src, e: Src) -> Src {
+    Src::If(o, Box::new(a), Box::new(b), Box::new(t), Box::new(e))
+}
+fn lg(i: u32) -> Ins {
+    Ins::LocalGet(i)
+}
+fn ls(i: u32) -> Ins {
+    Ins::LocalSet(i)
+}
+/// `call` of the function itself (position 0 of a one-function module) on one word.
+fn cl() -> Ins {
+    Ins::Call(0, vec![K::W])
+}
+fn op(o: Op) -> Ins {
+    Ins::Op(o)
+}
+fn pu(v: i64) -> Ins {
+    Ins::Push(v)
+}
+/// `loop { cond; if (t) else (e) }`, the function's body.
+fn func(cond: Vec<Ins>, t: Vec<Ins>, e: Vec<Ins>) -> Vec<Ins> {
+    vec![Ins::Loop([cond, vec![Ins::If(t, e)]].concat())]
+}
+
+/// name, code, arity, temps, source
+type Case = (&'static str, Vec<Ins>, usize, usize, Src);
+
+fn sum() -> Case {
+    let cond = vec![lg(0), pu(0), op(Op::LeS)];
+    let e = vec![lg(0), pu(1), op(Op::Sub), ls(2), lg(1), lg(0), op(Op::Add), ls(3), lg(2), ls(0), lg(3), ls(1), Ins::Br(0)];
+    let src = iff(Op::LeS, p(0), l(0), p(1), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Add, p(1), p(0))]));
+    ("sum", func(cond, vec![lg(1)], e), 2, 2, src)
+}
+fn fact() -> Case {
+    let e = vec![lg(0), lg(0), pu(1), op(Op::Sub), cl(), op(Op::Mul)];
+    let src = iff(Op::LeS, p(0), l(0), l(1), pr(Op::Mul, p(0), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))])));
+    ("fact", func(vec![lg(0), pu(0), op(Op::LeS)], vec![pu(1)], e), 1, 0, src)
+}
+fn fib() -> Case {
+    let e = vec![lg(0), pu(1), op(Op::Sub), cl(), lg(0), pu(2), op(Op::Sub), cl(), op(Op::Add)];
+    let rec = |k| Src::SelfCall(vec![pr(Op::Sub, p(0), l(k))]);
+    let src = iff(Op::LeS, p(0), l(1), p(0), pr(Op::Add, rec(1), rec(2)));
+    ("fib", func(vec![lg(0), pu(1), op(Op::LeS)], vec![lg(0)], e), 1, 0, src)
+}
+fn nest() -> Case {
+    let e = vec![lg(0), pu(1), op(Op::Sub), cl(), cl()];
+    let src = iff(Op::LeS, p(0), l(0), p(0), Src::SelfCall(vec![Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))])]));
+    ("nest", func(vec![lg(0), pu(0), op(Op::LeS)], vec![lg(0)], e), 1, 0, src)
+}
+/// unseen after the freeze: `tri x = if x<=0 then 0 else x + tri(x-1) + 1`
+fn tri() -> Case {
+    let e = vec![lg(0), lg(0), pu(1), op(Op::Sub), cl(), op(Op::Add), pu(1), op(Op::Add)];
+    let rec = Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))]);
+    let src = iff(Op::LeS, p(0), l(0), l(0), pr(Op::Add, pr(Op::Add, p(0), rec), l(1)));
+    ("tri", func(vec![lg(0), pu(0), op(Op::LeS)], vec![pu(0)], e), 1, 0, src)
+}
+/// unseen after the freeze: `pw n acc p = if n<=0 then acc else pw (n-1) (acc+p) (p+p)`
+fn pow2sum() -> Case {
+    let e = vec![
+        lg(0), pu(1), op(Op::Sub), ls(3), lg(1), lg(2), op(Op::Add), ls(4), lg(2), lg(2), op(Op::Add), ls(2), lg(3), ls(0), lg(4),
+        ls(1), Ins::Br(0),
+    ];
+    let src = iff(
+        Op::LeS,
+        p(0),
+        l(0),
+        p(1),
+        Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Add, p(1), p(2)), pr(Op::Add, p(2), p(2))]),
+    );
+    ("pow2sum", func(vec![lg(0), pu(0), op(Op::LeS)], vec![lg(1)], e), 3, 2, src)
+}
+
+// ---- written after sim.rs was frozen (sha256 0f509c17..., 11:21): no generator change for any of these
+/// `dbl x = if x<=0 then 1 else dbl(x-1) + dbl(x-1)`
+fn dbl() -> Case {
+    let rec = || Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))]);
+    let call = [lg(0), pu(1), op(Op::Sub), cl()];
+    let e = [&call[..], &call[..], &[op(Op::Add)]].concat();
+    let src = iff(Op::LeS, p(0), l(0), l(1), pr(Op::Add, rec(), rec()));
+    ("dbl", func(vec![lg(0), pu(0), op(Op::LeS)], vec![pu(1)], e), 1, 0, src)
+}
+/// `mulloop n acc = if n<=0 then acc else mulloop (n-1) (acc*n)`, one temp
+fn mulloop() -> Case {
+    let e = vec![lg(0), pu(1), op(Op::Sub), ls(2), lg(1), lg(0), op(Op::Mul), ls(1), lg(2), ls(0), Ins::Br(0)];
+    let src = iff(Op::LeS, p(0), l(0), p(1), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Mul, p(1), p(0))]));
+    ("mulloop", func(vec![lg(0), pu(0), op(Op::LeS)], vec![lg(1)], e), 2, 1, src)
+}
+/// `g x = if x<=2 then x else g(g(x-2)) * x + g(x-3)`
+fn mixed() -> Case {
+    let e = vec![
+        lg(0), pu(2), op(Op::Sub), cl(), cl(), lg(0), op(Op::Mul), lg(0), pu(3), op(Op::Sub), cl(), op(Op::Add),
+    ];
+    let rec = |k| Src::SelfCall(vec![pr(Op::Sub, p(0), l(k))]);
+    let inner = Src::SelfCall(vec![rec(2)]);
+    let src = iff(Op::LeS, p(0), l(2), p(0), pr(Op::Add, pr(Op::Mul, inner, p(0)), rec(3)));
+    ("mixed", func(vec![lg(0), pu(2), op(Op::LeS)], vec![lg(0)], e), 1, 0, src)
+}
+
+/// A proof of one function does not check against another's statement: the kernel is the judge, not the walk.
+#[test]
+fn gen_spike_kernel_rejects_a_proof_for_another_statement() {
+    std::thread::scope(|s| {
+        std::thread::Builder::new()
+            .stack_size(tatic_kernel::CHECK_STACK)
+            .spawn_scoped(s, || {
+                let ((_, a, b, c, d), (_, e, f, g, h)) = (fact(), nest());
+                let (proof, own) = gen_sim(Wasm { n: 8, fw: b + c }, &a, b, c, &|cx, en, k| cps(en, cx, &d, k)).unwrap();
+                let (_, other) = gen_sim(Wasm { n: 8, fw: f + g }, &e, f, g, &|cx, en, k| cps(en, cx, &h, k)).unwrap();
+                assert!(tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &own).is_ok());
+                let r = tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &other);
+                println!("KERNEL-NEG: {}", r.as_ref().err().map(|e| e.chars().take(100).collect::<String>()).unwrap_or_default());
+                assert!(r.is_err(), "the kernel accepted fact's proof for nest's statement");
+            })
+            .unwrap()
+            .join()
+            .unwrap()
+    })
+}
+
+/// Build and check on one `CHECK_STACK` thread (an `Expr` does not cross threads).
+fn run(n: usize, case: &Case) -> Result<(), String> {
+    std::thread::scope(|s| {
+        std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn_scoped(s, || run_here(n, case)).unwrap().join().unwrap()
+    })
+}
+
+fn run_here(n: usize, case: &Case) -> Result<(), String> {
+    let (name, code, arity, temps, src) = case;
+    let t0 = Instant::now();
+    let (proof, stmt) = gen_sim(Wasm { n, fw: arity + temps }, code, *arity, *temps, &|cx, en, k| cps(en, cx, src, k))?;
+    let build = t0.elapsed();
+    let t1 = Instant::now();
+    let r = tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &stmt);
+    println!(
+        "GEN n={n} {name}: build {:.1} ms, check {:.1} ms{}",
+        build.as_secs_f64() * 1e3,
+        t1.elapsed().as_secs_f64() * 1e3,
+        if r.is_ok() { "" } else { " (CHECK FAILED)" }
+    );
+    r.map_err(|e| format!("kernel: {}", e.chars().take(300).collect::<String>()))
+}
+
+#[test]
+fn gen_spike() {
+    let mut failed = vec![];
+    for n in [4, 24, 64] {
+        for case in [sum(), fact(), fib(), nest(), tri(), pow2sum(), dbl(), mulloop(), mixed()] {
+            if let Err(e) = run(n, &case) {
+                println!("GEN n={n} {}: FAIL {}", case.0, e.chars().take(300).collect::<String>());
+                failed.push((n, case.0));
+            }
+        }
+    }
+    assert!(failed.is_empty(), "failed: {failed:?}");
+}
+
+/// the body is `[Loop([cond.., If(t, e)])]`
+fn arms(code: &mut [Ins]) -> (&mut Vec<Ins>, &mut Vec<Ins>) {
+    let Ins::Loop(b) = &mut code[0] else { panic!() };
+    let Some(Ins::If(t, e)) = b.last_mut() else { panic!() };
+    (t, e)
+}
+
+fn mutate(mut c: Case, f: &dyn Fn(&mut [Ins])) -> Case {
+    f(&mut c.1);
+    c
+}
+
+/// Mutated code against the intended source: each must be rejected, by the generator's walk or the kernel.
+#[test]
+fn gen_spike_controls() {
+    let cases: Vec<(&str, Case)> = vec![
+        (
+            "operator swapped (sum: acc+n -> acc-n)",
+            mutate(sum(), &|c| {
+                let (_, e) = arms(c);
+                let k = e.iter().position(|i| *i == Ins::Op(Op::Add)).unwrap();
+                e[k] = Ins::Op(Op::Sub);
+            }),
+        ),
+        (
+            "call dropped (fact)",
+            mutate(fact(), &|c| {
+                let (_, e) = arms(c);
+                e.retain(|i| *i != cl());
+            }),
+        ),
+        (
+            "call argument off by one (fact: n-1 -> n-2)",
+            mutate(fact(), &|c| {
+                let (_, e) = arms(c);
+                let k = e.iter().position(|i| *i == Ins::Push(1)).unwrap();
+                e[k] = Ins::Push(2);
+            }),
+        ),
+        (
+            "branches swapped (fact)",
+            mutate(fact(), &|c| {
+                let (t, e) = arms(c);
+                std::mem::swap(t, e);
+            }),
+        ),
+        (
+            "wrong local.set (sum: local.set 0 -> 2)",
+            mutate(sum(), &|c| {
+                let (_, e) = arms(c);
+                let k = e.iter().position(|i| *i == Ins::LocalSet(0)).unwrap();
+                e[k] = Ins::LocalSet(2);
+            }),
+        ),
+    ];
+    let mut accepted = vec![];
+    for n in [4, 24] {
+        for (what, case) in &cases {
+            match run(n, case) {
+                Ok(()) => accepted.push((n, *what)),
+                Err(e) => println!("CONTROL n={n} {what}: rejected: {}", e.chars().take(100).collect::<String>()),
+            }
+        }
+    }
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+}
+
+// ---- S3: a module of several functions; a call names its callee and the callee's law enters the caller as a hypothesis
+
+/// `i32.const 0` then the arguments, then `call` of position `pos` (kinds: the environment, then `m` words).
+fn call_to(pos: u32, m: usize) -> Ins {
+    Ins::Call(pos, [vec![K::I], vec![K::W; m]].concat())
+}
+
+/// The callee `c x y = x - y` (an environment parameter at slot 2) and the caller `f = c a b`, the call's two argument
+/// instruction lists given, so a control can reorder them.
+type Mod2 = (Vec<Ins>, Vec<Ins>, Src);
+
+fn sub_module() -> Mod2 {
+    let callee = vec![lg(0), lg(1), op(Op::Sub)];
+    let caller = vec![Ins::ConstI(0), pu(10), pu(3), call_to(0, 2)];
+    (callee, caller, Src::CallFn(0, vec![l(10), l(3)]))
+}
+
+fn run_module(n: usize, callee: &[Ins], caller: &[Ins], callee_src: Src, caller_src: Src, callee_arity: usize) -> Result<(), String> {
+    std::thread::scope(|s| {
+        std::thread::Builder::new()
+            .stack_size(tatic_kernel::CHECK_STACK)
+            .spawn_scoped(s, || {
+                let (proof, stmt) = build_module(n, callee, caller, &callee_src, &caller_src, callee_arity)?;
+                tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &stmt).map_err(|e| format!("kernel: {}", e.chars().take(300).collect::<String>()))
+            })
+            .unwrap()
+            .join()
+            .unwrap()
+    })
+}
+
+fn build_module(n: usize, callee: &[Ins], caller: &[Ins], callee_src: &Src, caller_src: &Src, callee_arity: usize) -> Result<(Expr, Expr), String> {
+    let fc = |cx: &mut Cx, en: &SEnv, k: &dyn Fn(&mut Cx, Expr) -> Expr| cps(en, cx, callee_src, k);
+    let ff = |cx: &mut Cx, en: &SEnv, k: &dyn Fn(&mut Cx, Expr) -> Expr| cps(en, cx, caller_src, k);
+    let funcs = [
+        FuncSpec { code: callee.to_vec(), arity: callee_arity, env: true, temps: 0, callees: vec![], src: &fc },
+        FuncSpec { code: caller.to_vec(), arity: 0, env: false, temps: 0, callees: vec![0], src: &ff },
+    ];
+    gen_module(Wasm { n, fw: module_width(&funcs) }, &funcs, 1)
+}
+
+#[test]
+fn gen_module_call_as_hypothesis() {
+    let (callee, caller, caller_src) = sub_module();
+    let callee_src = pr(Op::Sub, p(0), p(1));
+    for n in [4, 8, 24] {
+        let r = run_module(n, &callee, &caller, callee_src.clone(), caller_src.clone(), 2);
+        println!("MODULE n={n} sub: {r:?}");
+        r.unwrap();
+    }
+}
+
+/// Mutants of the module: each must be rejected, by the generator's walk or the kernel.
+#[test]
+fn gen_module_controls() {
+    let (callee, caller, caller_src) = sub_module();
+    let callee_src = pr(Op::Sub, p(0), p(1));
+    let cases: Vec<(&str, Vec<Ins>, Vec<Ins>, Src, Src)> = vec![
+        // the call names the function itself (position 1), not the callee
+        ("wrong callee index (self)", callee.clone(), vec![Ins::ConstI(0), pu(10), pu(3), call_to(1, 2)], callee_src.clone(), caller_src.clone()),
+        // the call names a position that is not in the table
+        ("wrong callee index (absent)", callee.clone(), vec![Ins::ConstI(0), pu(10), pu(3), call_to(2, 2)], callee_src.clone(), caller_src.clone()),
+        // x - y with the arguments pushed the other way round
+        ("wrong argument order", callee.clone(), vec![Ins::ConstI(0), pu(3), pu(10), call_to(0, 2)], callee_src.clone(), caller_src.clone()),
+        // the environment pointer not 0
+        ("wrong environment", callee.clone(), vec![Ins::ConstI(1), pu(10), pu(3), call_to(0, 2)], callee_src.clone(), caller_src.clone()),
+        // a callee law that does not hold: the machine adds, the source subtracts
+        ("callee law false", vec![lg(0), lg(1), op(Op::Add)], caller.clone(), callee_src.clone(), caller_src.clone()),
+        // the caller's own source disagrees with what the call returns
+        ("caller source wrong", callee.clone(), caller.clone(), callee_src.clone(), Src::CallFn(0, vec![l(10), l(4)])),
+    ];
+    let mut accepted = vec![];
+    for n in [4, 8] {
+        for (what, cm, cr, cs, rs) in &cases {
+            match run_module(n, cm, cr, cs.clone(), rs.clone(), 2) {
+                Ok(()) => accepted.push((n, *what)),
+                Err(e) => println!("CONTROL n={n} {what}: rejected: {}", e.chars().take(140).collect::<String>()),
+            }
+        }
+    }
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+}
+
+/// The kernel is the judge, not the walk: the proof of one module does not check against another's statement (the
+/// callee's law differs: `x - y` against `x + y`).
+#[test]
+fn gen_module_kernel_rejects_a_proof_for_another_callee() {
+    std::thread::scope(|s| {
+        std::thread::Builder::new()
+            .stack_size(tatic_kernel::CHECK_STACK)
+            .spawn_scoped(s, || {
+                let (callee, caller, caller_src) = sub_module();
+                let (proof, own) = build_module(8, &callee, &caller, &pr(Op::Sub, p(0), p(1)), &caller_src, 2).unwrap();
+                let add = vec![lg(0), lg(1), op(Op::Add)];
+                let (_, other) = build_module(8, &add, &caller, &pr(Op::Add, p(0), p(1)), &caller_src, 2).unwrap();
+                assert!(tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &own).is_ok());
+                let r = tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &other);
+                println!("MODULE-KERNEL-NEG: {}", r.as_ref().err().map(|e| e.chars().take(100).collect::<String>()).unwrap_or_default());
+                assert!(r.is_err(), "the kernel accepted sub's proof for add's statement");
+            })
+            .unwrap()
+            .join()
+            .unwrap()
+    })
+}
