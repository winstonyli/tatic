+/// S3 controls on the real module terms 13 and 34: each mutant must be rejected, by the generator or the kernel.
+#[test]
+fn gen_real_s3_controls() {
+    use crate::support::samples::tail_recursive_loop_with_pap_producing_root_self_call_arg as t23;
+    let mut accepted = vec![];
+    let mut run = |what: &str, build: T23, entry: &(dyn Fn(&[Ins]) -> Vec<Ins> + Sync), edit: &(dyn Fn(&mut Vec<ModFn>) + Sync)| {
+        for n in [4, 24] {
+            let r = on_big_stack(|| {
+                let (s, h, frag) = compiled(&build);
+                let code = entry(frag.entry());
+                prove_edit(&s, h, &frag, &code, n, edit).map(|_| ())
+            });
+            match r {
+                Ok(()) => accepted.push((n, what.to_string())),
+                Err(e) => println!("S3-CONTROL n={n} {what}: rejected: {}", e.chars().take(200).collect::<String>()),
+            }
+        }
+    };
+    let same = |c: &[Ins]| c.to_vec();
+    let none = |_: &mut Vec<ModFn>| {};
+    // wrong callee index: the entry calls itself (13) or the entry's call names a position that is not there
+    run("wrong callee index (13: call $c0 -> call $f)", twice_inc_5, &|c| mutate(c, &|i| (*i == Ins::Raw("call $c0".into())).then_some(Ins::Raw("call $f".into()))), &none);
+    run("wrong callee index (34: call $c0 -> call $f)", let_bound_factorial_10, &|c| mutate(c, &|i| (*i == Ins::Raw("call $c0".into())).then_some(Ins::Raw("call $f".into()))), &none);
+    // the same with the kinds kept: the call's index points at the entry, which has another frame
+    let to_self = |fs: &mut Vec<ModFn>| {
+        let me = fs.len() as u32 - 1;
+        let e = fs.last_mut().unwrap();
+        e.code = mutate(&e.code, &|i| match i {
+            Ins::Call(0, k) => Some(Ins::Call(me, k.clone())),
+            _ => None,
+        });
+    };
+    run("wrong callee index, kinds kept (13)", twice_inc_5, &same, &to_self);
+    run("wrong callee index, kinds kept (34)", let_bound_factorial_10, &same, &to_self);
+    run("wrong callee index, kinds kept (23)", t23, &same, &to_self);
+    // wrong argument order (23): the two arguments of `call $c0` swapped
+    run(
+        "wrong argument order (23)",
+        t23,
+        &|c| {
+            let mut v = c.to_vec();
+            let Some(Ins::If(_, e)) = v.last_mut() else { panic!("no If") };
+            // [i32.const 0, Push 0, LocalGet 0, Push 1, Sub, call, return_call] -> the words' order reversed
+            e.splice(1..5, [Ins::LocalGet(0), Ins::Push(1), Ins::Op(Op::Sub), Ins::Push(0)]);
+            v
+        },
+        &none,
+    );
+    // a callee law that does not hold
+    let flip = |from: Op, to: Op| move |fs: &mut Vec<ModFn>| {
+        fs[0].code = mutate(&fs[0].code, &|i| (*i == Ins::Op(from)).then_some(Ins::Op(to)));
+    };
+    run("callee law false (13: callee Add -> Sub)", twice_inc_5, &same, &flip(Op::Add, Op::Sub));
+    run("callee law false (34: callee Mul -> Add)", let_bound_factorial_10, &same, &flip(Op::Mul, Op::Add));
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+}
