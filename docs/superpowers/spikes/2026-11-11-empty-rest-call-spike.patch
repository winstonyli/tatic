+/// S2a: the call rule given the walk's own `km` (1), `ks` (2) or `rel` (3) in place of the call's: each must be rejected, on the
+/// sum loop (a tail call, an empty `rest`) and, for `km`, on term 13's callee call. A tail call's continuation is the activation's
+/// own up to beta, so `rel` given for itself is the same proof there: that substitution is a mutant only where the continuation
+/// is not the activation's (factorial, fib), and on the sum loop it must be ACCEPTED (it is not a mutation).
+#[test]
+fn gen_real_s2a_wrong_call_substitutions() {
+    use tatic_wasm::wasm::sim::WRONG_CALL;
+    let mut accepted = vec![];
+    let cases: Vec<(&str, Target, u8)> = vec![
+        ("wrong km (sum loop)", ("sum", capturing_closure_loop), 1),
+        ("wrong ks (sum loop)", ("sum", capturing_closure_loop), 2),
+        ("wrong rel (factorial, a non-tail call)", ("factorial", factorial), 3),
+        ("wrong rel (fib)", ("fib", fib), 3),
+        ("wrong km (13's callee call)", ("13", twice_inc_5), 1),
+    ];
+    for (what, (_, build), wrong) in cases {
+        for n in [4, 24] {
+            let r = on_big_stack(|| {
+                let (s, h, frag) = compiled(&build);
+                WRONG_CALL.with(|x| x.set(wrong));
+                let r = prove(&s, h, &frag, frag.entry(), n).map(|_| ());
+                WRONG_CALL.with(|x| x.set(0));
+                r
+            });
+            match r {
+                Ok(()) => accepted.push((n, what)),
+                Err(e) => println!("CONTROL n={n} {what}: rejected: {}", e.chars().take(200).collect::<String>()),
+            }
+        }
+    }
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+    for n in [4, 24] {
+        let r = on_big_stack(|| {
+            let (s, h, frag) = compiled(&capturing_closure_loop);
+            WRONG_CALL.with(|x| x.set(3));
+            let r = prove(&s, h, &frag, frag.entry(), n).map(|_| ());
+            WRONG_CALL.with(|x| x.set(0));
+            r
+        });
+        assert!(r.is_ok(), "the tail call's own rel must prove the sum loop (equal to the call's up to beta): {r:?}");
+        println!("TAIL-REL n={n} sum loop: rel for rel2 accepted (the same proof up to beta)");
+    }
+}
