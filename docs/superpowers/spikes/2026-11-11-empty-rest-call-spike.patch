+        })
+    }
+    /// `Bs = \g x.. ks. cps src`.
+    fn bs(&self, c: &mut Cx, r: At, ch: Option<At>, src: &SrcFn, fuel: At, callees: &[(usize, At)]) -> Expr {
+        let n = self.n;
+        let hs = self.hs(c, r);
+        c.lam(hs, |c, g| {
+            let vs: Vec<Ty> = (0..self.m).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+            tele(c, &vs, &mut vec![], &lam, &mut |c, xs| {
+                let rs = self.ret_s(c, r);
+                c.lam(rs, |c, ks| {
+                    let env = SEnv { n, r, g, params: xs.to_vec(), ch, fuel, callees: callees.to_vec() };
+                    src(c, &env, &|c, v| app(c.at(ks), v))
+                })
+            })
+        })
+    }
+    /// The binders of a function's law (after `N gn R z`) and of the induction's motive, step and hypothesis: ONE telescope,
+    /// the dummy numeral that lifts the motive to Sort3 (the kernel is not cumulative), then
+    /// `d, a_0..a_{m-1}, t_0..t_{t-1}, mu, km, ks, rel`.
+    fn binders(&self, c: &mut Cx, r: At, wrap: &dyn Fn(Expr, Expr) -> Expr, body: &mut dyn FnMut(&mut Cx, &[At]) -> Expr) -> Expr {
+        let (g, n, m, t) = (self, self.n, self.m, self.t);
+        let mut tys: Vec<Ty> = vec![ty!(|_c, _x| nat2())];
+        tys.extend((0..m + t).map(|_| ty!(|_c, _x| bv_ty(n))));
+        tys.push(ty!(|c, _x| g.w.mem(c, r)));
+        tys.push(ty!(|c, _x| g.ret_m(c, r)));
+        tys.push(ty!(|c, _x| g.ret_s(c, r)));
+        tys.push(ty!(|c, x| g.rel_ty(c, r, x[m + t + 2], x[m + t + 3])));
+        tele(c, &tys, &mut vec![], wrap, body)
+    }
+}
+
+/// What `gen_module` checks of a function's code before generating anything.
+fn check_code(code: &[Ins], arity: usize, env: bool, temps: usize) -> Result<(), String> {
+    fn walk(code: &[Ins], locals: usize, top: bool) -> Result<(), String> {
+        for ins in code {
+            match ins {
+                Ins::Loop(b) if top && code.len() == 1 => walk(b, locals, false)?,
+                Ins::Loop(_) => return Err("a loop other than the function's one top-level loop".into()),
+                Ins::If(t, e) => {
+                    walk(t, locals, false)?;
+                    walk(e, locals, false)?
+                }
+                Ins::LocalGet(i) | Ins::LocalSet(i) | Ins::GetI(i) if *i as usize >= locals => return Err(format!("local {i} out of range")),
+                Ins::Raw(s) => return Err(format!("raw line {s:?}")),
+                Ins::Store | Ins::Load | Ins::Dup => return Err(format!("{ins:?}: the heap is not modelled here")),
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+    walk(code, arity + env as usize + temps, true)?;
+    match shape(code, vec![], &[]) {
+        Ok(Some(s)) if s == vec![K::W] => Ok(()),
+        other => Err(format!("the body does not run from [] to [word]: {other:?}")),
+    }
+}
+
+/// A function's pieces as marks at the base depth of a proof: its `Bm`, `Bs`, and `N H timeout Bm`, `N Hs ts Bs`.
+#[derive(Clone, Copy)]
+struct Real {
+    bm: At,
+    bs: At,
+    hc: At,
+    sc: At,
+}
+
+/// The module at one context: the fuel `N`, the answer sort `r` and `z`, with the real (probe-free) pieces of each
+/// function built on demand (at the depth this was made, so every mark is valid under all deeper binders).
+struct Ctxt<'a> {
+    w: Wasm,
+    funcs: &'a [FuncSpec<'a>],
+    fuel: At,
+    r: At,
+    z: At,
+    hm: At,
+    tm: At,
+    memo: RefCell<Vec<Option<Real>>>,
+}
+
+impl<'a> Ctxt<'a> {
+    fn new(c: &mut Cx, w: Wasm, funcs: &'a [FuncSpec<'a>], fuel: At, r: At, z: At) -> Self {
+        let g0 = G { w, n: w.n, m: 0, e: 0, t: 0 };
+        let hm = {
+            let e = g0.hm(c, r);
+            c.mark(e)
+        };
+        let tm = {
+            let e = g0.tm(c, r, z);
+            c.mark(e)
+        };
+        Ctxt { w, funcs, fuel, r, z, hm, tm, memo: RefCell::new(vec![None; funcs.len()]) }
+    }
+    fn g(&self, k: usize) -> G {
+        g_of(self.w, &self.funcs[k])
+    }
+    /// The table of function `k`: `\i fr mu kont. (i == k) (env fr mu kont) ((i == c) (H_c fr mu kont) .. z)`.
+    fn table(&self, c: &mut Cx, k: usize, env: At, cs: &[(usize, Real)]) -> Expr {
+        let (w, r, z, n) = (self.w, self.r, self.z, self.w.n);
+        c.lam(w.v(), |c, i| {
+            c.lam(w.fr(), |c, fr| {
+                let mem = w.mem(c, r);
+                c.lam(mem, |c, mu| {
+                    let rm = G { w, n, m: 0, e: 0, t: 0 }.ret_m(c, r);
+                    c.lam(rm, |c, kont| {
+                        let pick = |c: &Cx, pos: usize, yes: Expr, no: Expr| app3(app2(eq_bv(n), c.at(i), lit(n, pos as u128)), c.at(r), yes, no);
+                        let mut acc = c.at(z);
+                        for (pos, re) in cs.iter().rev() {
+                            let call = app3(c.at(re.hc), c.at(fr), c.at(mu), c.at(kont));
+                            acc = pick(c, *pos, call, acc);
+                        }
+                        let me = app3(c.at(env), c.at(fr), c.at(mu), c.at(kont));
+                        pick(c, k, me, acc)
+                    })
+                })
+            })
+        })
+    }
+    /// `Bm_k` and `Bs_k`, through the probe `probe` if any; the callees' real pieces are those of `real`.
+    fn bm_bs(&self, c: &mut Cx, k: usize, probe: Option<At>) -> (Expr, Expr) {
+        let f = &self.funcs[k];
+        let g = self.g(k);
+        let cs: Vec<(usize, Real)> = f.callees.iter().map(|&p| (p, self.real(c, p))).collect();
+        let bm = g.bm(c, self.r, self.z, probe, &f.code, &|c, env| self.table(c, k, env, &cs));
+        let scs: Vec<(usize, At)> = cs.iter().map(|(p, re)| (*p, re.sc)).collect();
+        let bs = g.bs(c, self.r, probe, f.src, self.fuel, &scs);
+        (bm, bs)
+    }
+    fn real(&self, c: &mut Cx, k: usize) -> Real {
+        let cached = self.memo.borrow()[k];
+        if let Some(re) = cached {
+            return re;
+        }
+        let g = self.g(k);
+        let (bm, bs) = self.bm_bs(c, k, None);
+        let (bm, bs) = (c.mark(bm), c.mark(bs));
+        let hs = {
+            let e = g.hs(c, self.r);
+            c.mark(e)
+        };
+        let ts = {
+            let e = g.ts(c, self.r, self.z);
+            c.mark(e)
+        };
+        let hc = c.mark(apps(c.at(self.fuel), vec![c.at(self.hm), c.at(self.tm), c.at(bm)]));
+        let sc = c.mark(apps(c.at(self.fuel), vec![c.at(hs), c.at(ts), c.at(bs)]));
+        let re = Real { bm, bs, hc, sc };
+        self.memo.borrow_mut()[k] = Some(re);
+        re
+    }
+    /// The law of function `k`: `Pi x.. t.. mu km ks rel. Id(R, N H timeout Bm_k (frame x.. t..) mu km, N Hs ts Bs_k x.. ks)`.
+    fn law(&self, c: &mut Cx, k: usize) -> Expr {
+        let g = self.g(k);
+        let re = self.real(c, k);
+        let r = self.r;
+        g.binders(c, r, &pi, &mut |c, x| {
+            let (m, t) = (g.m, g.t);
+            let args: Vec<Expr> = x[1..1 + m].iter().map(|a| c.at(*a)).collect();
+            let temps: Vec<Expr> = x[1 + m..1 + m + t].iter().map(|a| c.at(*a)).collect();
+            let (mu, km, ks) = (x[1 + m + t], x[2 + m + t], x[3 + m + t]);
+            let l = app3(c.at(re.hc), g.frame(&args, &temps), c.at(mu), c.at(km));
+            let rhs = apps(c.at(re.sc), [args, vec![c.at(ks)]].concat());
+            id(c.at(r), l, rhs)
+        })
+    }
+}
+
+/// The sizes function `f` is generated at.
+fn g_of(w: Wasm, f: &FuncSpec) -> G {
+    G { w, n: w.n, m: f.arity, e: f.env as usize, t: f.temps }
+}
+
+/// The module-wide frame width: the widest function's parameters, environment slot and temporaries.
+fn widen(w: Wasm, funcs: &[FuncSpec]) -> Wasm {
+    Wasm { fw: funcs.iter().map(|f| f.arity + f.env as usize + f.temps).max().unwrap_or(0), ..w }
+}
+
+/// What the walk needs of a function it may meet called: the fuel variable it is applied through (the induction's `j` for
+/// the function itself, the outer fuel `N` for a callee), its sizes, its `Bm` and `Bs`, and its law (the induction
+/// hypothesis, or the callee's law hypothesis).
+#[derive(Clone, Copy)]
+struct CallRule {
+    head: At,
+    g: G,
+    bm: At,
+    bs: At,
+    law: At,
+}
+
+/// The telescope `N gn R z`, then (for the proof and the closed composition) the callees' laws.
+fn head_tys<'a>(w: Wasm, funcs: &'a [FuncSpec<'a>], callees: &[usize], with_laws: bool) -> Vec<Ty<'a>> {
+    let mut tys: Vec<Ty> = vec![ty!(|_c, _x| nat2()), ty!(|c, x| w.good_nat(c, x[0])), ty!(|_c, _x| sort(0)), ty!(|c, x| c.at(x[2]))];
+    if with_laws {
+        for &p in callees {
+            tys.push(ty!(|c, x| {
+                let cx = Ctxt::new(c, w, funcs, x[0], x[2], x[3]);
+                cx.law(c, p)
+            }));
+        }
+    }
+    tys
+}
+
+/// The proof of function `k`'s law, with the callees' laws as hypotheses and the probe `CH` as its first parameter:
+/// `\CH N gn R z HC.. x.. h km ks rel. ..`, or why the two do not simulate each other.
+fn proof_open(w: Wasm, funcs: &[FuncSpec], k: usize) -> Result<Expr, String> {
+    let f = &funcs[k];
+    check_code(&f.code, f.arity, f.env, f.temps)?;
+    let g = g_of(w, f);
+    let (m, nhc) = (g.m, f.callees.len());
+    let err: RefCell<Option<String>> = RefCell::new(None);
+    let tys = head_tys(w, funcs, &f.callees, true);
+    let proof = Cx::default().lam(ch_ty(), |c, ch| {
+        tele(c, &tys, &mut vec![], &lam, &mut |c, x| {
+            let (fuel, gn, r, z) = (x[0], x[1], x[2], x[3]);
+            let cx = Ctxt::new(c, w, funcs, fuel, r, z);
+            let rules: Vec<CallRule> = f
+                .callees
+                .iter()
+                .zip(&x[4..4 + nhc])
+                .map(|(p, hc)| {
+                    let re = cx.real(c, *p);
+                    CallRule { head: fuel, g: cx.g(*p), bm: re.bm, bs: re.bs, law: *hc }
+                })
+                .collect();
+            let (hm, tm) = (cx.hm, cx.tm);
+            let (bm0, bs0) = cx.bm_bs(c, k, Some(ch));
+            let (bm, bs) = (c.mark(bm0), c.mark(bs0));
+            let (hs0, ts0) = (g.hs(c, r), g.ts(c, r, z));
+            let (hs, ts) = (c.mark(hs0), c.mark(ts0));
+            g.binders(c, r, &lam, &mut |c, y| {
+                // the motive at a fuel: the binders, then the two sides
+                let mot = |c: &mut Cx, mm: Expr| {
+                    let mm = c.mark(mm);
+                    g.binders(c, r, &pi, &mut |c, y| {
+                        let ex = |c: &Cx, ys: &[At]| ys.iter().map(|a| c.at(*a)).collect::<Vec<Expr>>();
+                        let (ya, yt) = (ex(c, &y[1..1 + m]), ex(c, &y[1 + m..1 + m + g.t]));
+                        let (mu, kmm, kss) = (y[1 + m + g.t], y[2 + m + g.t], y[3 + m + g.t]);
+                        let l = app3(apps(c.at(mm), vec![c.at(hm), c.at(tm), c.at(bm)]), g.frame(&ya, &yt), c.at(mu), c.at(kmm));
+                        let rhs = apps(c.at(mm), [vec![c.at(hs), c.at(ts), c.at(bs)], ya, vec![c.at(kss)]].concat());
+                        id(c.at(r), l, rhs)
+                    })
+                };
+                let motive = c.lam(nat2(), |c, mm| mot(c, c.at(mm)));
+                let hz = g.binders(c, r, &lam, &mut |c, _| refl(c.at(z)));
+                let step = c.lam(nat2(), |c, j| {
+                    let ih_ty = mot(c, c.at(j));
+                    c.lam(ih_ty, |c, ih| {
+                        g.binders(c, r, &lam, &mut |c, y| {
+                            let t = g.t;
+                            // the function itself is a call like any callee's: through `j`, with the hypothesis for its law
+                            let own = CallRule { head: j, g, bm, bs, law: ih };
+                            let all_rules: Vec<CallRule> = std::iter::once(own).chain(rules.iter().copied()).collect();
+                            let sim = Sim { g: &g, r, ch, d: y[0], km: y[2 + m + t], ks: y[3 + m + t], rel: y[4 + m + t], rules: &all_rules };
+                            let ex = |c: &Cx, ys: &[At]| ys.iter().map(|a| c.at(*a)).collect::<Vec<Expr>>();
+                            let (ya, yt) = (ex(c, &y[1..1 + m]), ex(c, &y[1 + m..1 + m + t]));
+                            let fr = g.frame(&ya, &yt);
+                            let mj = apps(c.at(j), vec![c.at(hm), c.at(tm), c.at(bm)]);
+                            let sj = apps(c.at(j), vec![c.at(hs), c.at(ts), c.at(bs)]);
+                            let m0 = apps(c.at(bm), vec![mj, fr, c.at(y[1 + m + t]), c.at(y[2 + m + t])]);
+                            let s0 = apps(c.at(bs), [vec![sj], ya, vec![c.at(y[3 + m + t])]].concat());
+                            match sim.sim(c, m0, s0, "body") {
+                                Ok(p) => p,
+                                Err(e) => {
+                                    err.borrow_mut().get_or_insert(e);
+                                    refl(m0)
+                                }
+                            }
+                        })
+                    })
+                });
+                let mut all = vec![motive, hz, step];
+                all.extend(y.iter().map(|a| c.at(*a)));
+                apps(c.at(gn), all)
+            })
+        })
+    });
+    if let Some(e) = err.into_inner() {
+        return Err(e);
+    }
+    Ok(proof)
+}
+
+/// The closed proof of function `k`'s law, `Pi N gn R z, law_k`: the probe applied to `choose`, every callee's law
+/// discharged by that callee's own closed proof.
+fn closed(w: Wasm, funcs: &[FuncSpec], k: usize) -> Result<Expr, String> {
+    let open = app(proof_open(w, funcs, k)?, choose_fn());
+    let callees = &funcs[k].callees;
+    let closed_callees: Vec<Expr> = callees.iter().map(|p| closed(w, funcs, *p)).collect::<Result<_, _>>()?;
+    let tys = head_tys(w, funcs, callees, false);
+    Ok(tele(&mut Cx::default(), &tys, &mut vec![], &lam, &mut |c, x| {
+        let nzs: Vec<At> = x.to_vec();
+        let mut all: Vec<Expr> = nzs.iter().map(|a| c.at(*a)).collect();
+        for (p, cl) in callees.iter().zip(&closed_callees) {
+            let gc = g_of(w, &funcs[*p]);
+            let law = gc.binders(c, nzs[2], &lam, &mut |c, y| {
+                apps(*cl, [nzs.iter().map(|a| c.at(*a)).collect::<Vec<_>>(), y.iter().map(|a| c.at(*a)).collect()].concat())
+            });
+            all.push(law);
+        }
+        apps(open, all)
+    }))
+}
+
+/// `(proof, statement)` that function `entry` of the module simulates its source, for every fuel: `Pi N gn R z, law_entry`.
+/// Every function it calls (and they, theirs) is proved on its own and enters as a hypothesis, then is discharged.
+pub fn gen_module(w: Wasm, funcs: &[FuncSpec], entry: usize) -> Result<(Expr, Expr), String> {
+    let (proof, stmt) = gen_module_parts(w, funcs, entry)?;
+    Ok((proof?, stmt))
+}
+
+/// `gen_module`, the statement kept when the generator's walk refuses the proof (SPIKE m2: a test checks another module's
+/// proof against it). Ill-formed code is still an outer error: no statement is built over it.
+pub fn gen_module_parts(w: Wasm, funcs: &[FuncSpec], entry: usize) -> Result<(Result<Expr, String>, Expr), String> {
+    for f in funcs {
+        check_code(&f.code, f.arity, f.env, f.temps)?;
+    }
+    let w = widen(w, funcs);
+    let proof = closed(w, funcs, entry);
+    let tys = head_tys(w, funcs, &[], false);
+    let stmt = tele(&mut Cx::default(), &tys, &mut vec![], &pi, &mut |c, x| {
+        let cx = Ctxt::new(c, w, funcs, x[0], x[2], x[3]);
+        cx.law(c, entry)
+    });
+    Ok((proof, stmt))
+}
+
+/// `gen_module` for one function with no callees and no environment parameter.
+pub fn gen_sim(w: Wasm, code: &[Ins], arity: usize, temps: usize, src: &SrcFn) -> Result<(Expr, Expr), String> {
+    let f = FuncSpec { code: code.to_vec(), arity, env: false, temps, callees: vec![], src };
+    gen_module(w, std::slice::from_ref(&f), 0)
+}
+
+thread_local! {
+    /// SPIKE (S2a controls, test only): 0 = off; at every call the law is given the walk's own `km` (1), `ks` (2) or `rel` (3)
+    /// in place of the call's continuation, source continuation or relation.
+    pub static WRONG_CALL: std::cell::Cell<u8> = const { std::cell::Cell::new(0) };
+}
+
+/// One walk's fixed names.
+struct Sim<'g> {
+    g: &'g G,
+    r: At,
+    ch: At,
+    /// The walk's own copy of the lifting numeral every law and the induction hypothesis take first.
+    d: At,
+    km: At,
+    ks: At,
+    rel: At,
+    /// The functions the walk may meet called: the function itself first, then its callees.
+    rules: &'g [CallRule],
+}
+
+impl Sim<'_> {
+    /// What a term in weak head normal form is doing, for the reasons.
+    fn kind(&self, c: &Cx, head: &Expr) -> &'static str {
+        if *head == c.at(self.km) || *head == c.at(self.ks) {
+            "returns"
+        } else if *head == c.at(self.ch) {
+            "branches"
+        } else if self.rules.iter().any(|rl| *head == c.at(rl.head)) {
+            "calls a function"
+        } else {
+            "is stuck"
+        }
+    }
+
+    /// A proof of `Id(R, m, s)`.
+    fn sim(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        tatic_kernel::grow(|| self.sim_step(c, m, s, path))
+    }
+
+    /// The `fw` words of a frame, read off its pair spine.
+    fn slots(&self, fr: Expr, path: &str) -> Result<Vec<Expr>, String> {
+        let (mut cur, mut xs) = (fr, vec![]);
+        for _ in 0..self.g.w.fw {
+            let tatic_kernel::Node::Pair(_, x, rest) = whnf(&cur).node() else {
+                return Err(format!("{path}: the frame is not a pair spine of the module's width"));
+            };
+            xs.push(x);
+            cur = rest;
+        }
+        Ok(xs)
+    }
+
+    /// `Pi a mu. Id(R, k2 a mu, ks2 a)`, from walking the two continuations under their binders.
+    fn cont_rel(&self, c: &mut Cx, k2: Expr, ks2: Expr, path: &str) -> Result<Expr, String> {
+        let (k2m, ks2m) = (c.mark(k2), c.mark(ks2));
+        let failed: RefCell<Option<String>> = RefCell::new(None);
+        let w = self.g.w;
+        let rel2 = c.lam(self.g.v(), |c, a| {
+            let mem = w.mem(c, self.r);
+            c.lam(mem, |c, mu| {
+                let (l, r) = (app2(c.at(k2m), c.at(a), c.at(mu)), app(c.at(ks2m), c.at(a)));
+                match self.sim(c, l, r, &format!("{path}/after")) {
+                    Ok(p) => p,
+                    Err(e) => {
+                        failed.borrow_mut().get_or_insert(e);
+                        refl(l)
+                    }
+                }
+            })
+        });
+        match failed.into_inner() {
+            Some(e) => Err(e),
+            None => Ok(rel2),
+        }
+    }
+
+    fn sim_step(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        let n = self.g.n;
+        let (mw, sw) = (whnf(&m), whnf(&s));
+        let ((mh, ma), (sh, sa)) = (spine(&mw), spine(&sw));
+        let (mk, sk) = (self.kind(c, &mh), self.kind(c, &sh));
+
+        if mh == c.at(self.km) {
+            if sh != c.at(self.ks) {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if ma.len() != 2 || sa.len() != 1 || !def_eq(&ma[0], &sa[0]) {
+                return Err(format!("{path}: both return, with different values"));
+            }
+            return Ok(apps(c.at(self.rel), vec![ma[0], ma[1]]));
+        }
+        if mh == c.at(self.ch) {
+            if sh != c.at(self.ch) || ma.len() != 4 || sa.len() != 4 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if !def_eq(&ma[1], &sa[1]) {
+                return Err(format!("{path}: the branch conditions differ"));
+            }
+            let pt = self.sim(c, ma[2], sa[2], &format!("{path}/then"))?;
+            let pe = self.sim(c, ma[3], sa[3], &format!("{path}/else"))?;
+            let cd = c.mark(ma[1]);
+            return Ok(cong(c, self.r, self.ch, cd, (ma[2], sa[2], pt), (ma[3], sa[3], pe)));
+        }
+        // a call (a `br`, a `return_call` or a `call`, of the function itself or of a callee): `F H timeout Bm_c frame mu kont`
+        // against `F Hs ts Bs_c args ks'`, answered by the law of `c` at the arguments read off the source and the
+        // temporaries read off the frame
+        if self.rules.iter().any(|rl| mh == c.at(rl.head)) {
+            if ma.len() != 6 {
+                return Err(format!("{path}: the machine {mk} with {} arguments", ma.len()));
+            }
+            let Some(rule) = self.rules.iter().find(|rl| mh == c.at(rl.head) && def_eq(&ma[2], &c.at(rl.bm))) else {
+                return Err(format!("{path}: the machine calls a function that is neither this one nor one of its callees"));
+            };
+            let (mc, e, t) = (rule.g.m, rule.g.e, rule.g.t);
+            if sh != c.at(rule.head) || sa.len() != 3 + mc + 1 || !def_eq(&sa[2], &c.at(rule.bs)) {
+                return Err(format!("{path}: the machine calls a function but the source {sk} (or another function, or another arity)"));
+            }
+            let (fr2, mu2, k2, ks2) = (ma[3], ma[4], ma[5], sa[sa.len() - 1]);
+            let src_args = &sa[3..3 + mc];
+            // the frame: each parameter slot holds the source's argument, the environment's 0, the temporaries anything
+            // (the law quantifies over them), the padding 0
+            let slots = self.slots(fr2, path)?;
+            for (i, a) in src_args.iter().enumerate() {
+                if !def_eq(&slots[i], a) {
+                    return Err(format!("{path}: at the call, local {i} does not hold the source's argument {i} (order or values)"));
+                }
+            }
+            let zero = lit(n, 0);
+            if e == 1 && !def_eq(&slots[mc], &zero) {
+                return Err(format!("{path}: at the call, the environment slot is not 0"));
+            }
+            if let Some(i) = (mc + e + t..slots.len()).find(|i| !def_eq(&slots[*i], &zero)) {
+                return Err(format!("{path}: at the call, padding slot {i} is not 0"));
+            }
+            let rel2 = self.cont_rel(c, k2, ks2, path)?;
+            let mut all = vec![c.at(self.d)];
+            all.extend_from_slice(src_args);
+            all.extend_from_slice(&slots[mc + e..mc + e + t]);
+            let wrong = WRONG_CALL.with(|x| x.get());
+            let pick = |w: u8, own: At, right: Expr| if wrong == w { c.at(own) } else { right };
+            all.extend([mu2, pick(1, self.km, k2), pick(2, self.ks, ks2), pick(3, self.rel, rel2)]);
+            return Ok(apps(c.at(rule.law), all));
+        }
+        Err(format!("{path}: the machine {mk} but the source {sk}"))
+    }
+}
