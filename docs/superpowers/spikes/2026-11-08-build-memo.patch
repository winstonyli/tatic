+fn probe_build_growth() {
+    fn count(code: &[Ins]) -> usize {
+        code.iter().map(|i| 1 + match i { Ins::Loop(b) => count(b), Ins::If(t, e) => count(t) + count(e), _ => 0 }).sum()
+    }
+    tatic_kernel::scoped(|| {
+        use tatic_wasm::wasm::{prod, K, Wasm};
+        let w = Wasm { n: 64 };
+        let mut c = tatic_wasm::encoding::Cx::default();
+        c.under(|c, base| {
+            c.under(|c, _| {
+                for ks in [vec![], vec![K::W], vec![K::B, K::W], vec![K::W, K::W, K::B, K::W, K::W]] {
+                    let old = ks.iter().rev().fold(c.at(base), |acc, k| {
+                        prod(tatic_wasm::encoding::bv_ty(if *k == K::W { 64 } else { 1 }), acc)
+                    });
+                    assert!(old == w.sty(c, &ks, base), "sty differs at {ks:?}");
+                }
+                tatic_kernel::sort(0)
+            })
+        });
+    });
+    for d in 7..=13u32 {
+        let r = std::thread::Builder::new().stack_size(256 << 20).spawn(move || {
+            let (s, h, frag) = compiled(&move |s: &mut TermStore| doubling(s, d));
+            let code = frag.entry();
+            let mut best = f64::MAX;
+            let mut bw = 0;
+            for _ in 0..3 {
+                tatic_kernel::scoped(|| {
+                    let w0 = tatic_kernel::work();
+                    let t0 = std::time::Instant::now();
+                    let _ = statement(&s, h, 1, code, 1);
+                    best = best.min(t0.elapsed().as_secs_f64() * 1e3);
+                    bw = tatic_kernel::work() - w0;
+                });
+            }
+            let (pw, pms) = tatic_kernel::scoped(|| {
+                let w = tatic_wasm::wasm::Wasm { n: 64 };
+                let w0 = tatic_kernel::work();
+                let t0 = std::time::Instant::now();
+                let _ = tatic_wasm::encoding::Cx::default().under(|c, x| w.prog(c, code, &[], x));
+                (tatic_kernel::work() - w0, t0.elapsed().as_secs_f64() * 1e3)
+            });
+            (count(code), best, bw, pw, pms)
+        }).unwrap().join().unwrap();
+        println!("PROBE d={d} ins={} build_ms={:.2} build_work={} prog_work={} prog_ms={:.2}", r.0, r.1, r.2, r.3, r.4);
