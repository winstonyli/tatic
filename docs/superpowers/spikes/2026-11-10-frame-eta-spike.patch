+// ---- SPIKE c1: a store at an address computed at run time, a callee that writes the next cell, and a read back.
+
+/// Binds `a_0..a_(n-1) : Bool0` then `ga_i : GoodBool a_i` (the `GoodBv` step's binders) around `body(a, ga)`.
+fn bind_bits(c: &mut Cx, n: usize, acc: &mut Vec<At>, body: &mut dyn FnMut(&mut Cx, &[At], &[At]) -> Expr) -> Expr {
+    let k = acc.len();
+    if k == 2 * n {
+        let (a, ga) = acc.split_at(n);
+        let (a, ga) = (a.to_vec(), ga.to_vec());
+        return body(c, &a, &ga);
+    }
+    let ty = if k < n { bool0() } else { app(good_bool(), c.at(acc[k - n])) };
+    c.lam(ty, |c, v| {
+        acc.push(v);
+        let r = bind_bits(c, n, acc, body);
+        acc.pop();
+        r
+    })
+}
+
+/// `Pi x. GoodBv x -> Id(Bool0, lhs x, b0)`. `GoodBv`'s motive must land in Sort2 and `Id(Bool0, ..)` is in Sort1
+/// (no cumulativity), so the motive is the Leibniz form `Pi Q:(Bool0 -> Sort1). Q b0 -> Q (lhs y)`, instantiated at the
+/// end with `Q e = Id(Bool0, e, b0)`. `step(c, a, ga)` proves `Id(Bool0, lhs (mk a), b0)` under the step's binders.
+fn bool_lemma(n: usize, lhs: &dyn Fn(Expr) -> Expr, b0: Expr,
+              step: &mut dyn FnMut(&mut Cx, &[At], &[At]) -> Expr) -> (Expr, Expr) {
+    let tys: Vec<Ty> = vec![ty!(|_c, _x| bv_ty(n)), ty!(|c, x| app(good_bv(n), c.at(x[0])))];
+    let qty = arrow(bool0(), sort(1));
+    law(&tys, |c, xs| {
+        let (x, g) = (xs[0], xs[1]);
+        let motive = c.lam(bv_ty(n), |c, y| {
+            c.pi(qty, |c, q| arrow(app(c.at(q), b0), app(c.at(q), lhs(c.at(y)))))
+        });
+        let body = bind_bits(c, n, &mut vec![], &mut |c, a, ga| {
+            let p = step(c, a, ga);
+            let bits: Vec<Expr> = a.iter().map(|b| c.at(*b)).collect();
+            let l = lhs(church_tuple(&bits));
+            let (p, l) = (c.mark(p), c.mark(l));
+            c.lam(qty, |c, q| {
+                let qb = app(c.at(q), b0);
+                c.lam(qb, |c, hq| {
+                    // J at `\a b _. Q b -> Q a` takes `Q b0` to `Q (lhs (mk a))`
+                    let jm = c.lam(bool0(), |c, u| {
+                        c.lam(bool0(), |c, v| {
+                            let e = id(bool0(), c.at(u), c.at(v));
+                            c.lam(e, |c, _| arrow(app(c.at(q), c.at(v)), app(c.at(q), c.at(u))))
+                        })
+                    });
+                    let base = c.lam(bool0(), |c, u| c.lam(app(c.at(q), c.at(u)), |c, h| c.at(h)));
+                    app(jelim(jm, base, c.at(l), b0, c.at(p)), c.at(hq))
+                })
+            })
+        });
+        let qid = lam(bool0(), id(bool0(), var(0), b0));
+        let proof = apps(app2(c.at(g), motive, body), vec![qid, refl(b0)]);
+        (proof, id(bool0(), lhs(c.at(x)), b0))
+    })
+}
+
+/// `Pi x. GoodBv x -> Id(Bool0, eq x x, true)`: a bit split per bit, chained by `cong1` and `trans_proof`.
+pub fn eq_refl_lemma(n: usize) -> (Expr, Expr) {
+    let (q, _) = bit_lemma(id(bool0(), and(t(), not_(xor(var(0), var(0)))), t()), refl(t()), refl(t()));
+    bool_lemma(n, &|y| app2(eq_bv(n), y, y), t(), &mut |c, a, ga| {
+        let (mut acc, mut p) = (t(), refl(t()));
+        for i in 0..n {
+            let xi = not_(xor(c.at(a[i]), c.at(a[i])));
+            let next = and(acc, xi);
+            let fmap = lam(bool0(), and(var(0), shift(&xi, 0, 1)));
+            let cong = cong1(&bool0(), &bool0(), &fmap, acc, t(), p);
+            let qi = app2(q, c.at(a[i]), c.at(ga[i]));
+            p = trans_proof(&bool0(), &next, &and(t(), xi), &t(), cong, qi);
+            acc = next;
+        }
+        p
+    })
+}
+
+/// `Pi x. GoodBv x -> Id(Bool0, eq (x + 1) x, false)`: one split on bit 0; the rest is conversion.
+pub fn eq_succ_lemma(n: usize) -> (Expr, Expr) {
+    let lhs = move |y: Expr| app2(eq_bv(n), app2(Op::Add.term(n), y, lit(n, 1)), y);
+    bool_lemma(n, &lhs, f(), &mut |c, a, ga| {
+        let m = c.lam(bool0(), |c, b| {
+            let bits: Vec<Expr> = (0..n).map(|i| if i == 0 { c.at(b) } else { c.at(a[i]) }).collect();
+            id(bool0(), lhs(church_tuple(&bits)), f())
+        });
+        app3(c.at(ga[0]), m, refl(f()), refl(f()))
+    })
+}
