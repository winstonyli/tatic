+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Fr {
+    /// `mem[x] := 5; g x; x + mem[x]`, with `g y = (mem[y + 1] := 7; y)`
+    Ok,
+    /// the callee writes `y`, not `y + 1`
+    CalleeHitsX,
+    /// the caller reads `x + 1` after the call
+    ReadsX1,
+    /// the right program, the proof `refl`: conversion alone
+    NoLemma,
+}
+
+/// `Pi R z x. GoodBv x -> Pi h k. caller x h k = k (x + 5) (upd (x+1) 7 (upd x 5 h))`.
+pub fn frame_law(w: Wasm, fr: Fr) -> (Expr, Expr) {
+    let n = w.n;
+    let add = Op::Add.term(n);
+    let ins_add = Ins::Op(Op::Add);
+    use Ins::{Call, Dup, Load, Push, Store};
+    let g_code = if fr == Fr::CalleeHitsX {
+        vec![Dup, Push(7), Store]
+    } else {
+        vec![Dup, Push(1), ins_add.clone(), Push(7), Store]
+    };
+    let caller_code = if fr == Fr::ReadsX1 {
+        vec![Dup, Push(5), Store, Dup, Call, Push(1), ins_add.clone(), Load, ins_add.clone()]
+    } else {
+        vec![Dup, Push(5), Store, Dup, Call, Load, ins_add.clone()]
+    };
+    let tys: Vec<Ty> = vec![
+        ty!(|_c, _x| sort(0)),
+        ty!(|c, x| c.at(x[0])),
+        ty!(|_c, _x| bv_ty(n)),
+        ty!(|c, x| app(good_bv(n), c.at(x[2]))),
+        ty!(|c, x| w.mem(c, x[0])),
+        ty!(|c, x| ret_m(w, c, x[0])),
+    ];
+    let (refl_l, succ_l) = (eq_refl_lemma(n).0, eq_succ_lemma(n).0);
+    law(&tys, |c, xs| {
+        let (r, z, x, gx, h, k) = (xs[0], xs[1], xs[2], xs[3], xs[4], xs[5]);
+        let none = c.lam(w.v(), |c, _| {
+            let heap = w.mem(c, r);
+            c.lam(heap, |c, _| {
+                let ret = ret_m(w, c, r);
+                c.lam(ret, |c, _| c.at(z))
+            })
+        });
+        let callee = app(mach_step(w, c, r, z, &g_code), none);
+        let lhs = apps(app(mach_step(w, c, r, z, &caller_code), callee), vec![c.at(x), c.at(h), c.at(k)]);
+        let x1 = app2(add, c.at(x), lit(n, 1));
+        let h1 = w.upd(c, r, c.at(x), lit(n, 5), c.at(h));
+        let h1 = c.mark(h1);
+        let h2 = w.upd(c, r, x1, lit(n, 7), c.at(h1));
+        let h2 = c.mark(h2);
+        let tgt = app2(c.at(k), app2(add, c.at(x), lit(n, 5)), c.at(h2));
+        let tgt = c.mark(tgt);
+        let kk = c.lam(w.v(), |c, v| app2(c.at(k), app2(add, c.at(x), c.at(v)), c.at(h2)));
+        let kk = c.mark(kk);
+        let stmt = id(c.at(r), lhs, c.at(tgt));
+        if fr == Fr::NoLemma {
+            return (refl(c.at(tgt)), stmt);
+        }
+        // J at `\a b _. Q b -> Q a` over Bool0, with `Q e = Id(R, e R yes no, tgt)`
+        let rewrite = |c: &mut Cx, yes: Expr, no: Expr, a: Expr, b: Expr, p: Expr, qb: Expr| {
+            let (yes, no) = (c.mark(yes), c.mark(no));
+            let q = |c: &mut Cx, e: At| id(c.at(r), app3(c.at(e), c.at(r), c.at(yes), c.at(no)), c.at(tgt));
+            let motive = c.lam(bool0(), |c, a| {
+                c.lam(bool0(), |c, b| {
+                    let e = id(bool0(), c.at(a), c.at(b));
+                    c.lam(e, |c, _| {
+                        let qb = q(c, b);
+                        arrow(qb, q(c, a))
+                    })
+                })
+            });
+            let base = c.lam(bool0(), |c, a| {
+                let qa = q(c, a);
+                c.lam(qa, |c, hq| c.at(hq))
+            });
+            app(jelim(motive, base, a, b, p), qb)
+        };
+        let k5 = app(c.at(kk), lit(n, 5));
+        let hx = app2(c.at(h), c.at(x), c.at(kk));
+        let eqxx = app2(eq_bv(n), c.at(x), c.at(x));
+        let s1 = rewrite(c, k5, hx, eqxx, t(), app2(refl_l, c.at(x), c.at(gx)), refl(c.at(tgt)));
+        let k7 = app(c.at(kk), lit(n, 7));
+        let a1 = app2(c.at(h1), c.at(x), c.at(kk));
+        let eqs = app2(eq_bv(n), app2(add, c.at(x), lit(n, 1)), c.at(x));
+        let s2 = rewrite(c, k7, a1, eqs, f(), app2(succ_l, c.at(x), c.at(gx)), s1);
+        (s2, stmt)
+    })
+}
+
+#[test]
+pub fn frame_spike() {
+    for n in [4usize, 24, 64] {
+        tatic_kernel::scoped(|| {
+            let w = Wasm { n };
+            let timed = |name: &str, (p, s): (Expr, Expr)| {
+                let t0 = Instant::now();
+                ck(&format!("{name} n={n}"), &p, &s);
+                println!("FRAME n={n} {name}: {:?}", t0.elapsed());
+            };
+            let rejected = |name: &str, (p, s): (Expr, Expr)| {
+                let sort_of = infer(&Ctx::new(), &s).map(|t| whnf(&t));
+                assert!(matches!(sort_of.as_ref().map(|t| t.node()), Ok(tatic_kernel::Node::Sort(_))), "{name}: statement is not a type: {sort_of:?}");
+                let t0 = Instant::now();
+                let e = holds(&p, &s).expect_err(&format!("{name} must be rejected at n={n}"));
+                println!("FRAME n={n} rejected {name}: {:?} ({})", t0.elapsed(), e.chars().take(80).collect::<String>());
+            };
+            timed("eq x x = true", eq_refl_lemma(n));
+            timed("eq (x+1) x = false", eq_succ_lemma(n));
+            timed("frame law", frame_law(w, Fr::Ok));
+            rejected("frame law, callee writes x", frame_law(w, Fr::CalleeHitsX));
+            rejected("frame law, reads x + 1", frame_law(w, Fr::ReadsX1));
+            rejected("frame law, refl without the lemmas", frame_law(w, Fr::NoLemma));
+        })
+    }
+}
