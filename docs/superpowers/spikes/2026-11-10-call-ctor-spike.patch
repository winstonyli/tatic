+#[test]
+pub fn call_spike() {
+    for n in [4usize, 24, 64] {
+        tatic_kernel::scoped(|| {
+            let w = Wasm { n };
+            let timed = |name: &str, (p, s): (Expr, Expr)| {
+                let t0 = Instant::now();
+                ck(&format!("{name} n={n}"), &p, &s);
+                println!("CALL n={n} {name}: {:?}", t0.elapsed());
+            };
+            let rejected = |name: &str, (p, s): (Expr, Expr)| {
+                let sort_of = infer(&Ctx::new(), &s).map(|t| whnf(&t));
+                assert!(matches!(sort_of.as_ref().map(|t| t.node()), Ok(tatic_kernel::Node::Sort(_))), "{name}: statement is not a type: {sort_of:?}");
+                let t0 = Instant::now();
+                assert!(holds(&p, &s).is_err(), "{name} must be rejected at n={n}");
+                println!("CALL n={n} rejected {name}: {:?}", t0.elapsed());
+            };
+            timed("fact 3, fuel 3, answers 6", call_run(w, CallFn::Fact, 3, 3, Some(6)));
+            timed("fact 3, fuel 2, times out", call_run(w, CallFn::Fact, 3, 2, None));
+            timed("fib 5, fuel 5, answers 5", call_run(w, CallFn::Fib, 5, 5, Some(5)));
+            timed("fib 5, fuel 4, times out", call_run(w, CallFn::Fib, 5, 4, None));
+            rejected("fib 5, fuel 5, answers 4", call_run(w, CallFn::Fib, 5, 5, Some(4)));
+            timed("fact law", call_law(w, CallFn::Fact));
+            timed("fib law", call_law(w, CallFn::Fib));
+            rejected("fact law, machine base 0", call_law(w, CallFn::FactBase0));
+            rejected("fib law, machine sub for add", call_law(w, CallFn::FibSub));
+        })
+    }
+}
