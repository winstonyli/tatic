+//! SPIKE (j2b): a closure called through its record. The closure relation (`crall`, a hypothesis of the statement) carries
+//! the record's invariant, so a function that calls a closure needs no cell hypothesis of its own when the invariant is
+//! abstract; the closure's creator and body are proven against the same relation.
+use super::*;
+
+fn cc(arg: Src, v: Src) -> Src {
+    Src::CloCall(Box::new(arg), Box::new(v))
+}
+
+/// `fnb p a = a + cell[p+8]`: the closure body, a leaf over its record, against `a + v`. The record's cell is the function's
+/// own (concrete) hypothesis; its return hands the record back (`framed`).
+pub fn fnb(clobber: bool, off: i64) -> HCase {
+    // the mutant writes the argument over the record after computing its answer: only the return's frame check can see it
+    let body = cat(vec![vec![lg(1), lg(0)], ld(off), vec![op(Op::Add)], if clobber { stv(0, 8, 1) } else { vec![] }]);
+    let spec = HeapSpec { cells: vec![(0, 8)], ptrs: vec![0], framed: true, ..Default::default() };
+    let name = if clobber { "fnb-writes-record" } else if off != 8 { "fnb-wrong-offset" } else { "fnb" };
+    (name, vec![Ins::Loop(body)], 2, 0, pr(Op::Add, p(0), Src::Cell(0)), spec)
+}
+
+/// `apply p y = clo (clo y)`: calls the closure on its record twice. With the abstract invariant the function knows nothing
+/// of the record's layout. `mid_store` is a mutant: a store between the calls.
+pub fn apply_abs(mid_store: bool) -> HCase {
+    let code = cat(vec![vec![lg(0), lg(0), lg(1), Ins::CallC], if mid_store { stv(0, 8, 1) } else { vec![] }, vec![Ins::CallC]]);
+    let spec = HeapSpec { cells: vec![(0, 8)], ptrs: vec![0], framed: true, callee: Some(8), abstract_inv: true, ..Default::default() };
+    (if mid_store { "apply-stores" } else { "apply" }, vec![Ins::Loop(code)], 2, 0, cc(cc(p(0), Src::Cell(0)), Src::Cell(0)), spec)
+}
+
+/// The same with the record's layout (offset 8) known: a per-function cell hypothesis.
+pub fn apply_cells() -> HCase {
+    let (name, code, a, t, s, mut spec) = apply_abs(false);
+    spec.abstract_inv = false;
+    (if name == "apply" { "apply-cells" } else { name }, code, a, t, s, spec)
+}
+
+/// `main x y`: allocates a record, stores the captured value `x` in it, calls the closure on `y` through it.
+pub fn main_alloc(wrong_value: bool) -> HCase {
+    let code = cat(vec![
+        vec![pu(16), Ins::Alloc, ls(2)],
+        vec![lg(2), pu(8), op(Op::Add), lg(0)],
+        if wrong_value { vec![pu(1), op(Op::Add)] } else { vec![] },
+        vec![Ins::Store, lg(2), lg(1), Ins::CallC],
+    ]);
+    let spec = HeapSpec { callee: Some(8), ..Default::default() };
+    (if wrong_value { "main-wrong-value" } else { "main-alloc" }, vec![Ins::Loop(code)], 2, 1, cc(p(1), p(0)), spec)
+}
+
+/// A copy of `main_alloc` with the store at another offset, or the closure called on `x` instead of `y`.
+fn main_mut(store_off: i64, arg_x: bool) -> HCase {
+    let code = cat(vec![
+        vec![pu(16), Ins::Alloc, ls(2)],
+        vec![lg(2), pu(store_off), op(Op::Add), lg(0), Ins::Store, lg(2), lg(if arg_x { 0 } else { 1 }), Ins::CallC],
+    ]);
+    let spec = HeapSpec { callee: Some(8), ..Default::default() };
+    (if arg_x { "main-arg-x" } else { "main-store-16" }, vec![Ins::Loop(code)], 2, 1, cc(p(1), p(0)), spec)
+}
+
+/// `apply` calling the closure once against the source's two calls.
+fn apply_once() -> HCase {
+    let mut c = apply_abs(false);
+    c.1 = vec![Ins::Loop(vec![lg(0), lg(1), Ins::CallC])];
+    c.0 = "apply-once";
+    c
+}
+
+/// `fnb` computing `a - cell` against `a + v`.
+fn fnb_sub() -> HCase {
+    let mut c = fnb(false, 8);
+    c.1 = vec![Ins::Loop(cat(vec![vec![lg(1), lg(0)], ld(8), vec![op(Op::Sub)]]))];
+    c.0 = "fnb-sub";
+    c
+}
+
+/// Every mutant must be rejected, by the walk or the kernel.
+#[test]
+fn clo_controls() {
+    let cases: Vec<(&str, HCase)> = vec![
+        ("record with a wrong captured value (x + 1 stored)", main_alloc(true)),
+        ("record cell stored at the wrong offset", main_mut(16, false)),
+        ("closure called on x, the source calls it on y", main_mut(8, true)),
+        ("callee writes the record (and returns without restoring it)", fnb(true, 8)),
+        ("callee reads the record at the wrong offset", fnb(false, 16)),
+        ("callee computes a - v against a + v", fnb_sub()),
+        ("a store between two closure calls (abstract invariant)", apply_abs(true)),
+        ("a store between two closure calls (concrete cell)", {
+            let mut c = apply_abs(true);
+            c.5.abstract_inv = false;
+            c
+        }),
+        ("one closure call against the source's two", apply_once()),
+    ];
+    let mut accepted = vec![];
+    for n in [8, 24] {
+        for (what, case) in &cases {
+            match run_h(n, case) {
+                Ok(()) => accepted.push((n, *what)),
+                Err(e) => println!("CCONTROL n={n} {what}: rejected: {}", e.chars().take(150).collect::<String>()),
+            }
+        }
+    }
+    println!("CCONTROL accepted: {accepted:?}");
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+}
+
+fn sizes() -> Vec<usize> {
+    std::env::var("HEAP_N").map(|s| s.split(',').map(|x| x.parse().unwrap()).collect()).unwrap_or(vec![8, 24, 64])
+}
+
+#[test]
+fn clo_spike() {
+    let mut failed = vec![];
+    for n in sizes() {
+        let only = std::env::var("HEAP_ONLY").ok();
+        for case in [fnb(false, 8), apply_abs(false), apply_cells(), main_alloc(false)] {
+            if only.as_deref().is_some_and(|o| o != case.0) {
+                continue;
+            }
+            if let Err(e) = run_h(n, &case) {
+                println!("HEAP n={n} {}: FAIL {}", case.0, e.chars().take(300).collect::<String>());
+                failed.push((n, case.0));
+            }
+        }
+    }
+    assert!(failed.is_empty(), "failed: {failed:?}");
+}
