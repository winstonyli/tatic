+//! SPIKE tests for the generator: `gen_spike` (six functions, three widths) and `gen_spike_controls` (mutants).
+use super::*;
+use std::time::Instant;
+
+/// The mini source language: a mirror of what a `Term` walk produces, for these tests only (the real one is
+/// `tatic::proof::gate::Source`).
+#[derive(Clone, Debug)]
+enum Src {
+    Param(usize),
+    Lit(u128),
+    /// A word operator on two operands.
+    Prim(Op, Box<Src>, Box<Src>),
+    /// `If(cmp, a, b, then, else)`: `cmp a b` chooses.
+    If(Op, Box<Src>, Box<Src>, Box<Src>, Box<Src>),
+    /// A call of the function itself (non-tail or tail).
+    SelfCall(Vec<Src>),
+    /// The value of heap cell `k` (`gen_sim_cells`).
+    Cell(usize),
+    /// SPIKE (j2b): the source closure on an argument, with a captured value: `clo arg v`.
+    CloCall(Box<Src>, Box<Src>),
+}
+
+fn cps(e: &SEnv, c: &mut Cx, s: &Src, k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+    tatic_kernel::grow(|| match s {
+        Src::Param(i) => k(c, c.at(e.params[*i])),
+        Src::Lit(v) => k(c, lit(e.n, *v & low_bits(e.n))),
+        Src::Cell(i) => k(c, c.at(e.cells[*i])),
+        Src::Prim(o, a, b) => cps(e, c, a, &|c, x| {
+            let x = c.mark(x);
+            cps(e, c, b, &|c, y| k(c, app2(o.term(e.n), c.at(x), y)))
+        }),
+        Src::If(o, a, b, t, f) => cps(e, c, a, &|c, x| {
+            let x = c.mark(x);
+            cps(e, c, b, &|c, y| {
+                let cond = app2(o.term(e.n), c.at(x), y);
+                let (t2, f2) = (cps(e, c, t, k), cps(e, c, f, k));
+                e.choose(c, cond, t2, f2)
+            })
+        }),
+        Src::SelfCall(args) => call_args(e, c, args, vec![], k),
+        Src::CloCall(a, v) => cps(e, c, a, &|c, x| {
+            let x = c.mark(x);
+            cps(e, c, v, &|c, vv| e.callc(c, c.at(x), vv, k))
+        }),
+    })
+}
+
+fn call_args(e: &SEnv, c: &mut Cx, args: &[Src], done: Vec<At>, k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+    match args.split_first() {
+        None => e.call(c, &done, k),
+        Some((a, rest)) => cps(e, c, a, &|c, x| {
+            let mut d2 = done.clone();
+            d2.push(c.mark(x));
+            call_args(e, c, rest, d2, k)
+        }),
+    }
+}
+
+fn p(i: usize) -> Src {
+    Src::Param(i)
+}
+fn l(v: u128) -> Src {
+    Src::Lit(v)
+}
+fn pr(o: Op, a: Src, b: Src) -> Src {
+    Src::Prim(o, Box::new(a), Box::new(b))
+}
+fn iff(o: Op, a: Src, b: Src, t: Src, e: Src) -> Src {
+    Src::If(o, Box::new(a), Box::new(b), Box::new(t), Box::new(e))
+}
+fn lg(i: u32) -> Ins {
+    Ins::LocalGet(i)
+}
+fn ls(i: u32) -> Ins {
+    Ins::LocalSet(i)
+}
+fn op(o: Op) -> Ins {
+    Ins::Op(o)
+}
+fn pu(v: i64) -> Ins {
+    Ins::Push(v)
+}
+/// `loop { cond; if (t) else (e) }`, the function's body.
+fn func(cond: Vec<Ins>, t: Vec<Ins>, e: Vec<Ins>) -> Vec<Ins> {
+    vec![Ins::Loop([cond, vec![Ins::If(t, e)]].concat())]
+}
+
+/// name, code, arity, temps, source
+type Case = (&'static str, Vec<Ins>, usize, usize, Src);
+
+fn sum() -> Case {
+    let cond = vec![lg(0), pu(0), op(Op::LeS)];
+    let e = vec![lg(0), pu(1), op(Op::Sub), ls(2), lg(1), lg(0), op(Op::Add), ls(3), lg(2), ls(0), lg(3), ls(1), Ins::Br(0)];
+    let src = iff(Op::LeS, p(0), l(0), p(1), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Add, p(1), p(0))]));
+    ("sum", func(cond, vec![lg(1)], e), 2, 2, src)
+}
+fn fact() -> Case {
+    let e = vec![lg(0), lg(0), pu(1), op(Op::Sub), Ins::Call, op(Op::Mul)];
+    let src = iff(Op::LeS, p(0), l(0), l(1), pr(Op::Mul, p(0), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))])));
+    ("fact", func(vec![lg(0), pu(0), op(Op::LeS)], vec![pu(1)], e), 1, 0, src)
+}
+fn fib() -> Case {
+    let e = vec![lg(0), pu(1), op(Op::Sub), Ins::Call, lg(0), pu(2), op(Op::Sub), Ins::Call, op(Op::Add)];
+    let rec = |k| Src::SelfCall(vec![pr(Op::Sub, p(0), l(k))]);
+    let src = iff(Op::LeS, p(0), l(1), p(0), pr(Op::Add, rec(1), rec(2)));
+    ("fib", func(vec![lg(0), pu(1), op(Op::LeS)], vec![lg(0)], e), 1, 0, src)
+}
+fn nest() -> Case {
+    let e = vec![lg(0), pu(1), op(Op::Sub), Ins::Call, Ins::Call];
+    let src = iff(Op::LeS, p(0), l(0), p(0), Src::SelfCall(vec![Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))])]));
+    ("nest", func(vec![lg(0), pu(0), op(Op::LeS)], vec![lg(0)], e), 1, 0, src)
+}
+/// unseen after the freeze: `tri x = if x<=0 then 0 else x + tri(x-1) + 1`
+fn tri() -> Case {
+    let e = vec![lg(0), lg(0), pu(1), op(Op::Sub), Ins::Call, op(Op::Add), pu(1), op(Op::Add)];
+    let rec = Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))]);
+    let src = iff(Op::LeS, p(0), l(0), l(0), pr(Op::Add, pr(Op::Add, p(0), rec), l(1)));
+    ("tri", func(vec![lg(0), pu(0), op(Op::LeS)], vec![pu(0)], e), 1, 0, src)
+}
+/// unseen after the freeze: `pw n acc p = if n<=0 then acc else pw (n-1) (acc+p) (p+p)`
+fn pow2sum() -> Case {
+    let e = vec![
+        lg(0), pu(1), op(Op::Sub), ls(3), lg(1), lg(2), op(Op::Add), ls(4), lg(2), lg(2), op(Op::Add), ls(2), lg(3), ls(0), lg(4),
+        ls(1), Ins::Br(0),
+    ];
+    let src = iff(
+        Op::LeS,
+        p(0),
+        l(0),
+        p(1),
+        Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Add, p(1), p(2)), pr(Op::Add, p(2), p(2))]),
+    );
+    ("pow2sum", func(vec![lg(0), pu(0), op(Op::LeS)], vec![lg(1)], e), 3, 2, src)
+}
+
+// ---- written after sim.rs was frozen (sha256 0f509c17..., 11:21): no generator change for any of these
+/// `dbl x = if x<=0 then 1 else dbl(x-1) + dbl(x-1)`
+fn dbl() -> Case {
+    let rec = || Src::SelfCall(vec![pr(Op::Sub, p(0), l(1))]);
+    let call = [lg(0), pu(1), op(Op::Sub), Ins::Call];
+    let e = [&call[..], &call[..], &[op(Op::Add)]].concat();
+    let src = iff(Op::LeS, p(0), l(0), l(1), pr(Op::Add, rec(), rec()));
+    ("dbl", func(vec![lg(0), pu(0), op(Op::LeS)], vec![pu(1)], e), 1, 0, src)
+}
+/// `mulloop n acc = if n<=0 then acc else mulloop (n-1) (acc*n)`, one temp
+fn mulloop() -> Case {
+    let e = vec![lg(0), pu(1), op(Op::Sub), ls(2), lg(1), lg(0), op(Op::Mul), ls(1), lg(2), ls(0), Ins::Br(0)];
+    let src = iff(Op::LeS, p(0), l(0), p(1), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Mul, p(1), p(0))]));
+    ("mulloop", func(vec![lg(0), pu(0), op(Op::LeS)], vec![lg(1)], e), 2, 1, src)
+}
+/// `g x = if x<=2 then x else g(g(x-2)) * x + g(x-3)`
+fn mixed() -> Case {
+    let e = vec![
+        lg(0), pu(2), op(Op::Sub), Ins::Call, Ins::Call, lg(0), op(Op::Mul), lg(0), pu(3), op(Op::Sub), Ins::Call, op(Op::Add),
+    ];
+    let rec = |k| Src::SelfCall(vec![pr(Op::Sub, p(0), l(k))]);
+    let inner = Src::SelfCall(vec![rec(2)]);
+    let src = iff(Op::LeS, p(0), l(2), p(0), pr(Op::Add, pr(Op::Mul, inner, p(0)), rec(3)));
+    ("mixed", func(vec![lg(0), pu(2), op(Op::LeS)], vec![lg(0)], e), 1, 0, src)
+}
+
+/// A proof of one function does not check against another's statement: the kernel is the judge, not the walk.
+#[test]
+fn gen_spike_kernel_rejects_a_proof_for_another_statement() {
+    std::thread::scope(|s| {
+        std::thread::Builder::new()
+            .stack_size(tatic_kernel::CHECK_STACK)
+            .spawn_scoped(s, || {
+                let ((_, a, b, c, d), (_, e, f, g, h)) = (fact(), nest());
+                let (proof, own) = gen_sim(Wasm { n: 8 }, &a, b, c, &|cx, en, k| cps(en, cx, &d, k)).unwrap();
+                let (_, other) = gen_sim(Wasm { n: 8 }, &e, f, g, &|cx, en, k| cps(en, cx, &h, k)).unwrap();
+                assert!(tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &own).is_ok());
+                let r = tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &other);
+                println!("KERNEL-NEG: {}", r.as_ref().err().map(|e| e.chars().take(100).collect::<String>()).unwrap_or_default());
+                assert!(r.is_err(), "the kernel accepted fact's proof for nest's statement");
+            })
+            .unwrap()
+            .join()
+            .unwrap()
+    })
+}
+
+/// Build and check on one `CHECK_STACK` thread (an `Expr` does not cross threads).
+fn run(n: usize, case: &Case) -> Result<(), String> {
+    std::thread::scope(|s| {
+        std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn_scoped(s, || run_here(n, case)).unwrap().join().unwrap()
+    })
+}
+
+fn run_here(n: usize, case: &Case) -> Result<(), String> {
+    let (name, code, arity, temps, src) = case;
+    let t0 = Instant::now();
+    let (proof, stmt) = gen_sim(Wasm { n }, code, *arity, *temps, &|cx, en, k| cps(en, cx, src, k))?;
+    let build = t0.elapsed();
+    let t1 = Instant::now();
+    let r = tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &stmt);
+    println!(
+        "GEN n={n} {name}: build {:.1} ms, check {:.1} ms{}",
+        build.as_secs_f64() * 1e3,
+        t1.elapsed().as_secs_f64() * 1e3,
+        if r.is_ok() { "" } else { " (CHECK FAILED)" }
+    );
+    r.map_err(|e| format!("kernel: {}", e.chars().take(300).collect::<String>()))
+}
+
+#[test]
+fn gen_spike() {
+    let mut failed = vec![];
+    for n in [4, 24, 64] {
+        for case in [sum(), fact(), fib(), nest(), tri(), pow2sum(), dbl(), mulloop(), mixed()] {
+            if let Err(e) = run(n, &case) {
+                println!("GEN n={n} {}: FAIL {}", case.0, e.chars().take(300).collect::<String>());
+                failed.push((n, case.0));
+            }
+        }
+    }
+    assert!(failed.is_empty(), "failed: {failed:?}");
+}
+
+/// the body is `[Loop([cond.., If(t, e)])]`
+fn arms(code: &mut [Ins]) -> (&mut Vec<Ins>, &mut Vec<Ins>) {
+    let Ins::Loop(b) = &mut code[0] else { panic!() };
+    let Some(Ins::If(t, e)) = b.last_mut() else { panic!() };
+    (t, e)
+}
+
+fn mutate(mut c: Case, f: &dyn Fn(&mut [Ins])) -> Case {
+    f(&mut c.1);
+    c
+}
+
+/// Mutated code against the intended source: each must be rejected, by the generator's walk or the kernel.
+#[test]
+fn gen_spike_controls() {
+    let cases: Vec<(&str, Case)> = vec![
+        (
+            "operator swapped (sum: acc+n -> acc-n)",
+            mutate(sum(), &|c| {
+                let (_, e) = arms(c);
+                let k = e.iter().position(|i| *i == Ins::Op(Op::Add)).unwrap();
+                e[k] = Ins::Op(Op::Sub);
+            }),
+        ),
+        (
+            "call dropped (fact)",
+            mutate(fact(), &|c| {
+                let (_, e) = arms(c);
+                e.retain(|i| *i != Ins::Call);
+            }),
+        ),
+        (
+            "call argument off by one (fact: n-1 -> n-2)",
+            mutate(fact(), &|c| {
+                let (_, e) = arms(c);
+                let k = e.iter().position(|i| *i == Ins::Push(1)).unwrap();
+                e[k] = Ins::Push(2);
+            }),
+        ),
+        (
+            "branches swapped (fact)",
+            mutate(fact(), &|c| {
+                let (t, e) = arms(c);
+                std::mem::swap(t, e);
+            }),
+        ),
+        (
+            "wrong local.set (sum: local.set 0 -> 2)",
+            mutate(sum(), &|c| {
+                let (_, e) = arms(c);
+                let k = e.iter().position(|i| *i == Ins::LocalSet(0)).unwrap();
+                e[k] = Ins::LocalSet(2);
+            }),
+        ),
+    ];
+    let mut accepted = vec![];
+    for n in [4, 24] {
+        for (what, case) in &cases {
+            match run(n, case) {
+                Ok(()) => accepted.push((n, *what)),
+                Err(e) => println!("CONTROL n={n} {what}: rejected: {}", e.chars().take(100).collect::<String>()),
+            }
+        }
+    }
+    assert!(accepted.is_empty(), "accepted: {accepted:?}");
+}
+
+// ---- i3: the heap. A function whose frame holds a pointer to a record; the statement is over every heap holding the
+// record's cells, and the source takes the cells' values as parameters.
+
+/// name, code, arity, temps, source, spec
+type HCase = (&'static str, Vec<Ins>, usize, usize, Src, HeapSpec);
+
+fn ld(off: i64) -> Vec<Ins> {
+    vec![pu(off), op(Op::Add), Ins::Load]
+}
+fn cat(parts: Vec<Vec<Ins>>) -> Vec<Ins> {
+    parts.into_iter().flatten().collect()
+}
+
+/// `capt p n acc = if n <= 0 then acc else capt p (n-1) (acc + cell[p+8])`, the cell read each iteration.
+fn capt() -> HCase {
+    let e = cat(vec![
+        vec![lg(1), pu(1), op(Op::Sub), ls(3), lg(2), lg(0)],
+        ld(8),
+        vec![op(Op::Add), ls(4), lg(3), ls(1), lg(4), ls(2), Ins::Br(0)],
+    ]);
+    let src = iff(Op::LeS, p(0), l(0), p(1), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Add, p(1), Src::Cell(0)), Src::Cell(0)]));
+    let spec = HeapSpec { cells: vec![(0, 8)], ptrs: vec![0], stale_hp: false, ..Default::default() };
+    ("capt", func(vec![lg(1), pu(0), op(Op::LeS)], vec![lg(2)], e), 3, 2, src, spec)
+}
+
+/// `cellread p = cell[p+8]`, no loop.
+fn cellread() -> HCase {
+    let code = vec![Ins::Loop(ld_of(vec![lg(0)], 8))];
+    let spec = HeapSpec { cells: vec![(0, 8)], ptrs: vec![0], stale_hp: false, ..Default::default() };
+    ("cellread", code, 1, 0, Src::Cell(0), spec)
+}
+/// `ptrloop p n acc`: `sum` with an unused pointer first.
+fn ptrloop() -> HCase {
+    let cond = vec![lg(1), pu(0), op(Op::LeS)];
+    let e = vec![lg(1), pu(1), op(Op::Sub), ls(3), lg(2), lg(1), op(Op::Add), ls(4), lg(3), ls(1), lg(4), ls(2), Ins::Br(0)];
+    let src = iff(Op::LeS, p(0), l(0), p(1), Src::SelfCall(vec![pr(Op::Sub, p(0), l(1)), pr(Op::Add, p(1), p(0))]));
+    ("ptrloop", func(cond, vec![lg(2)], e), 3, 2, src, HeapSpec { cells: vec![], ptrs: vec![0], stale_hp: false, ..Default::default() })
+}
+fn stv(base: u32, off: i64, val: u32) -> Vec<Ins> {
+    vec![lg(base), pu(off), op(Op::Add), lg(val), Ins::Store]
+}
+
+/// The record function `g n v = if n <= 0 then v else g (n-1) (v+n)` over a record `p` (`n` at `p+8`, `v` at `p+16`).
+/// How the else arm passes the next record is `how`.
+#[derive(Clone, Copy, PartialEq)]
+enum Pass {
+    /// a fresh record: `alloc 24`, the two cells stored, the call on it
+    Fresh,
+    /// the same plus a header word stored at the record's base, last
+    FreshHeader,
+    /// the same record, updated in place
+    InPlace,
+}
+
+struct Mut {
+    /// the condition reads this offset instead of 8
+    cond_off: i64,
+    /// the two cell stores' offsets swapped
+    swap: bool,
+    /// the first store's value is `t1 + 1`
+    wrong_value: bool,
+    /// (in place) `t2` is computed after `n` is overwritten
+    read_after_store: bool,
+    stale_hp: bool,
+}
+const NOMUT: Mut = Mut { cond_off: 8, swap: false, wrong_value: false, read_after_store: false, stale_hp: false };
+
+fn recfn(name: &'static str, how: Pass, m: Mut) -> HCase {
+    let (n_off, v_off) = if m.swap { (16, 8) } else { (8, 16) };
+    let t1 = cat(vec![vec![lg(0)], ld(8), vec![pu(1), op(Op::Sub), ls(1)]]);
+    let t1b = if m.wrong_value { vec![lg(1), pu(1), op(Op::Add), ls(1)] } else { vec![] };
+    let t2 = cat(vec![vec![lg(0)], ld(16), vec![lg(0)], ld(8), vec![op(Op::Add), ls(2)]]);
+    let rec = match how {
+        Pass::InPlace if m.read_after_store => cat(vec![t1, t1b, stv(0, 8, 1), t2, stv(0, 16, 2), vec![lg(0), Ins::Call]]),
+        Pass::InPlace => cat(vec![t1, t1b, t2, stv(0, n_off, 1), stv(0, v_off, 2), vec![lg(0), Ins::Call]]),
+        _ => cat(vec![
+            t1,
+            t1b,
+            t2,
+            vec![pu(24), Ins::Alloc, ls(3)],
+            stv(3, n_off, 1),
+            stv(3, v_off, 2),
+            if how == Pass::FreshHeader { vec![lg(3), pu(7), Ins::Store] } else { vec![] },
+            vec![lg(3), Ins::Call],
+        ]),
+    };
+    let cond = cat(vec![vec![lg(0)], ld(m.cond_off), vec![pu(0), op(Op::LeS)]]);
+    let then = cat(vec![vec![lg(0)], ld(16)]);
+    let src = iff(
+        Op::LeS,
+        Src::Cell(0),
+        l(0),
+        Src::Cell(1),
+        Src::SelfCall(vec![pr(Op::Sub, Src::Cell(0), l(1)), pr(Op::Add, Src::Cell(1), Src::Cell(0))]),
+    );
+    let spec = HeapSpec { cells: vec![(0, 8), (0, 16)], ptrs: vec![0], stale_hp: m.stale_hp, ..Default::default() };
+    (name, func(cond, then, rec), 1, 3, src, spec)
+}
+
+fn ld_of(base: Vec<Ins>, off: i64) -> Vec<Ins> {
+    cat(vec![base, ld(off)])
+}
+
+fn run_h(n: usize, case: &HCase) -> Result<(), String> {
+    std::thread::scope(|s| {
+        std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn_scoped(s, || run_h_here(n, case)).unwrap().join().unwrap()
+    })
+}
+
+fn run_h_here(n: usize, case: &HCase) -> Result<(), String> {
+    let (name, code, arity, temps, src, spec) = case;
+    let t0 = Instant::now();
+    let (proof, stmt) = gen_sim_with(Wasm { n }, code, *arity, *temps, spec, &|cx, en, k| cps(en, cx, src, k))?;
+    let build = t0.elapsed();
+    let t1 = Instant::now();
+    let r = tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &stmt);
+    println!(
+        "HEAP n={n} {name}: build {:.1} ms, check {:.1} ms{}",
+        build.as_secs_f64() * 1e3,
+        t1.elapsed().as_secs_f64() * 1e3,
+        if r.is_ok() { "" } else { " (CHECK FAILED)" }
+    );
+    if let Err(e) = &r {
+        if std::env::var("HEAP_FULL").is_ok() {
+            println!("KERNEL-ERR-LEN {}", e.len());
+            if let Ok(p) = std::env::var("HEAP_DUMP") {
+                std::fs::write(p, e).unwrap();
+            }
+            let i = e.find("expected").unwrap_or(0);
+            println!("KERNEL-ERR-HEAD {}", e.chars().take(400).collect::<String>());
+            println!("KERNEL-ERR-EXPECTED {}", e.chars().skip(e[..i].chars().count()).take(900).collect::<String>());
+        }
+    }
+    r.map_err(|e| format!("kernel: {}", e.chars().take(300).collect::<String>()))
+}
+
+/// `recfn` with the cells at `p` and `p+8`, and a second allocation after the record's: a one-word object whose header is
+/// stored at its base. With the pointer bumped it lies after the record; with a stale pointer it is the record's first cell.
+fn two_alloc(name: &'static str, stale_hp: bool) -> HCase {
+    let rd = |off: i64| if off == 0 { vec![lg(0), Ins::Load] } else { ld_of(vec![lg(0)], off) };
+    let code = func(
+        cat(vec![rd(0), vec![pu(0), op(Op::LeS)]]),
+        rd(8),
+        cat(vec![
+            rd(0),
+            vec![pu(1), op(Op::Sub), ls(1)],
+            rd(8),
+            rd(0),
+            vec![op(Op::Add), ls(2), pu(16), Ins::Alloc, ls(3), lg(3), lg(1), Ins::Store],
+            stv(3, 8, 2),
+            vec![pu(8), Ins::Alloc, ls(4), lg(4), pu(7), Ins::Store, lg(3), Ins::Call],
+        ]),
+    );
+    let src = iff(
+        Op::LeS,
+        Src::Cell(0),
+        l(0),
+        Src::Cell(1),
+        Src::SelfCall(vec![pr(Op::Sub, Src::Cell(0), l(1)), pr(Op::Add, Src::Cell(1), Src::Cell(0))]),
+    );
+    (name, code, 1, 4, src, HeapSpec { cells: vec![(0, 0), (0, 8)], ptrs: vec![0], stale_hp, ..Default::default() })
+}
+
+/// `capt` with its read at another offset (`ld(16)`), or with `n-1` stored over the cell before the read.
+fn capt_mut(clobber: bool, off: i64) -> HCase {
+    let mut c = capt();
+    let e = cat(vec![
+        vec![lg(1), pu(1), op(Op::Sub), ls(3)],
+        if clobber { stv(0, 8, 3) } else { vec![] },
+        vec![lg(2), lg(0)],
+        ld(off),
+        vec![op(Op::Add), ls(4), lg(3), ls(1), lg(4), ls(2), Ins::Br(0)],
+    ]);
+    c.1 = func(vec![lg(1), pu(0), op(Op::LeS)], vec![lg(2)], e);
+    c.0 = if clobber { "capt-clobber" } else { "capt-wrong-offset" };
+    c
+}
+
+/// Mutants of the heap cases: each must be rejected, by the walk or the kernel (`stale-hp` is reported either way).
+#[test]
+fn heap_controls() {
+    let m = |f: &dyn Fn(&mut Mut)| {
+        let mut x = NOMUT;
+        f(&mut x);
+        x
+    };
+    let cases: Vec<(&str, HCase)> = vec![
+        ("loop reads the cell at the wrong offset", capt_mut(false, 16)),
+        ("loop overwrites its own cell with n-1 before reading it", capt_mut(true, 8)),
+        ("record: the condition reads the wrong offset", recfn("c-cond-off", Pass::Fresh, m(&|x| x.cond_off = 16))),
+        ("record: cell stores' offsets swapped", recfn("c-swap", Pass::Fresh, m(&|x| x.swap = true))),
+        ("record: the new n is stored one too large", recfn("c-value", Pass::Fresh, m(&|x| x.wrong_value = true))),
+        ("in place: the offsets swapped", recfn("c-ip-swap", Pass::InPlace, m(&|x| x.swap = true))),
+        ("in place: the new n is stored one too large", recfn("c-ip-value", Pass::InPlace, m(&|x| x.wrong_value = true))),
+        ("in place: n overwritten before v+n reads it", recfn("c-ip-clobber", Pass::InPlace, m(&|x| x.read_after_store = true))),
+        ("record: alloc does not bump the pointer", recfn("c-stale-hp", Pass::Fresh, m(&|x| x.stale_hp = true))),
+        ("two allocations: alloc does not bump the pointer", two_alloc("c-two-stale", true)),
+    ];
+    let mut accepted = vec![];
+    for n in [8, 24] {
+        for (what, case) in &cases {
+            match run_h(n, case) {
+                Ok(()) => accepted.push((n, *what)),
+                Err(e) => println!("HCONTROL n={n} {what}: rejected: {}", e.chars().take(140).collect::<String>()),
+            }
+        }
+    }
+    println!("HCONTROL accepted: {accepted:?}");
+    assert!(accepted.iter().all(|(_, w)| *w == "record: alloc does not bump the pointer"), "accepted: {accepted:?}");
+}
+
+mod clo;
+
+#[test]
+fn heap_spike() {
+    let sizes: Vec<usize> = std::env::var("HEAP_N").map(|s| s.split(',').map(|x| x.parse().unwrap()).collect()).unwrap_or(vec![8, 24, 64]);
+    let mut failed = vec![];
+    for n in sizes {
+        let only = std::env::var("HEAP_ONLY").ok();
+        let good = [
+            cellread(),
+            ptrloop(),
+            capt(),
+            recfn("fresh", Pass::Fresh, NOMUT),
+            recfn("fresh-header", Pass::FreshHeader, NOMUT),
+            recfn("in-place", Pass::InPlace, NOMUT),
+            two_alloc("two-alloc", false),
+        ];
+        for case in good {
+            if only.as_deref().is_some_and(|o| o != case.0) {
+                continue;
+            }
+            if let Err(e) = run_h(n, &case) {
+                println!("HEAP n={n} {}: FAIL {}", case.0, e.chars().take(300).collect::<String>());
+                failed.push((n, case.0));
+            }
+        }
+    }
+    assert!(failed.is_empty(), "failed: {failed:?}");
+}
