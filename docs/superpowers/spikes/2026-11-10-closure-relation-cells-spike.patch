+++ b/crates/tatic-wasm/src/wasm/sim.rs
@@ -0,0 +1,1211 @@
+//! SPIKE (throwaway, 2026-11-10, e1): ONE generator of simulation proofs for a function body with `Loop`/`Br`/`Call`.
+//!
+//! `gen_sim(w, code, arity, temps, src)` returns `(proof, statement)` for every fuel `N` with `GoodNat N`, every `R`, `z`,
+//! arguments `x_i`, heap `h`, machine continuation `km` and source continuation `ks`:
+//!
+//! ```text
+//! (Pi a mu. km a mu = ks a) -> M_N (frame x.., h) km = S_N x.. ks
+//! ```
+//!
+//! `M_N = N H timeout Bm` runs `code` through `prog`, with `call` and the function's own top-level `loop`/`br` both
+//! going through the one environment `env : H = State -> Ret -> R`. `S_N` is the source's step unrolled by the same fuel.
+//!
+//! The proof is `GoodNat`'s induction on fuel. In the step, both sides are put in weak head normal form and walked in
+//! lockstep as kernel terms (`Sim::sim`), with no match on the instruction list or the function:
+//!   - `km a mu` against `ks a'`: the relation hypothesis;
+//!   - `CH R w t e` against `CH R w' t' e'` (`CH` is the probe standing for `choose`): J through the shared choice;
+//!   - a stuck read of a parameter's slot `loc i K`: the slot hypothesis, then on;
+//!   - the fuel variable applied to a state, a continuation (a `br` or a `call`: one rule): the induction hypothesis at
+//!     the arguments read off the source side, the state and continuation read off the machine side as built, and the
+//!     continuation relation generated by walking the two continuations under their binders.
+//! `CH` is a bound variable of the proof only: the statement uses the real `choose`, and the proof is applied to it.
+use super::addr::{cancel_law, eq_comm_law, eq_refl_lemma, region_law, Rg};
+use super::*;
+use std::cell::{OnceCell, RefCell};
+
+/// What a source builder is given: the answer sort `r`, the function's own fixpoint variable `g`, its parameters, and
+/// the probe `ch` that stands for `choose` (the statement uses the real one: `None`).
+pub struct SEnv {
+    pub n: usize,
+    pub r: At,
+    pub g: At,
+    pub params: Vec<At>,
+    /// The source's parameters after `params`: the value of each heap cell the statement fixes (`HeapSpec`), one per cell.
+    /// The source passes them on in its own calls, so a call says what each cell holds afterwards.
+    pub cells: Vec<At>,
+    pub ch: Option<At>,
+    /// SPIKE (j2b): the source closure's body `clo a v ks` (the closure's captured value `v` is its source-side environment).
+    pub clo: Option<At>,
+}
+
+impl SEnv {
+    /// `choose R cond t f`, through the probe in the proof.
+    pub fn choose(&self, c: &Cx, cond: Expr, t: Expr, f: Expr) -> Expr {
+        match self.ch {
+            Some(h) => apps(c.at(h), vec![c.at(self.r), cond, t, f]),
+            None => choose(c.at(self.r), cond, t, f),
+        }
+    }
+    /// A call of the source closure on the argument `a` with captured value `v`, its answer passed to `k`.
+    pub fn callc(&self, c: &mut Cx, a: Expr, v: Expr, k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+        let kont = c.lam(bv_ty(self.n), |c, res| k(c, c.at(res)));
+        apps(c.at(self.clo.expect("a source closure")), vec![a, v, kont])
+    }
+    /// A call of the function itself on `args`, its answer passed to `k`: `g args (\res. k res)`.
+    pub fn call(&self, c: &mut Cx, args: &[At], k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+        let kont = c.lam(bv_ty(self.n), |c, res| k(c, c.at(res)));
+        let mut xs: Vec<Expr> = args.iter().map(|a| c.at(*a)).collect();
+        xs.push(kont);
+        apps(c.at(self.g), xs)
+    }
+}
+
+/// The source in continuation-passing form: given the environment and the final continuation, `cps src`.
+pub type SrcFn<'a> = dyn Fn(&mut Cx, &SEnv, &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr + 'a;
+
+/// `CH : Pi R:Sort0. Bv1 -> R -> R -> R`.
+fn ch_ty() -> Expr {
+    pi(sort(0), arrow(bv_ty(1), arrow(var(0), arrow(var(0), var(0)))))
+}
+/// The real choice, `\R w x y. choose R w x y`.
+fn choose_fn() -> Expr {
+    Cx::default().lam(sort(0), |c, r| {
+        c.lam(bv_ty(1), |c, w| {
+            c.lam(c.at(r), |c, x| c.lam(c.at(r), |c, y| choose(c.at(r), c.at(w), c.at(x), c.at(y))))
+        })
+    })
+}
+
+/// `p : a = b`, `q : b = c` give `a = c`.
+fn trans(c: &mut Cx, r: At, (a, b, cc): (Expr, Expr, Expr), p: Expr, q: Expr) -> Expr {
+    let a = c.mark(a);
+    let motive = c.lam(c.at(r), |c, u| {
+        c.lam(c.at(r), |c, v| {
+            let ty = id(c.at(r), c.at(u), c.at(v));
+            c.lam(ty, |c, _| arrow(id(c.at(r), c.at(a), c.at(u)), id(c.at(r), c.at(a), c.at(v))))
+        })
+    });
+    let base = c.lam(c.at(r), |c, u| {
+        let ty = id(c.at(r), c.at(a), c.at(u));
+        c.lam(ty, |c, h| c.at(h))
+    });
+    app(jelim(motive, base, b, cc, q), p)
+}
+
+/// `Id(R, CH R w t e, CH R w t' e')` from `Id(R, t, t')` and `Id(R, e, e')`: J on each branch.
+fn cong(c: &mut Cx, r: At, ch: At, cd: At, (t, t2, pt): (Expr, Expr, Expr), (e, e2, pe): (Expr, Expr, Expr)) -> Expr {
+    let pick = |c: &Cx, x: Expr, y: Expr| apps(c.at(ch), vec![c.at(r), c.at(cd), x, y]);
+    let (e, e2, pe) = (c.mark(e), c.mark(e2), c.mark(pe));
+    let outer_m = c.lam(c.at(r), |c, a| {
+        c.lam(c.at(r), |c, b| {
+            let ty = id(c.at(r), c.at(a), c.at(b));
+            c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(e)), pick(c, c.at(b), c.at(e2))))
+        })
+    });
+    let outer_b = c.lam(c.at(r), |c, a| {
+        let inner_m = c.lam(c.at(r), |c, y| {
+            c.lam(c.at(r), |c, y2| {
+                let ty = id(c.at(r), c.at(y), c.at(y2));
+                c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(y)), pick(c, c.at(a), c.at(y2))))
+            })
+        });
+        let inner_b = c.lam(c.at(r), |c, y| refl(pick(c, c.at(a), c.at(y))));
+        jelim(inner_m, inner_b, c.at(e), c.at(e2), c.at(pe))
+    });
+    jelim(outer_m, outer_b, t, t2, pt)
+}
+
+fn spine(e: &Expr) -> (Expr, Vec<Expr>) {
+    let (mut args, mut cur) = (vec![], *e);
+    while let tatic_kernel::Node::App(f, a) = cur.node() {
+        args.push(a);
+        cur = f;
+    }
+    args.reverse();
+    (cur, args)
+}
+
+/// The sizes the generator works at.
+#[derive(Clone, Copy)]
+struct G<'a> {
+    w: Wasm,
+    n: usize,
+    m: usize,
+    /// The heap cells the statement fixes: `(parameter, offset)` is the cell at address `param + offset`.
+    cells: &'a [(usize, u128)],
+    /// The machine parameters the source does not take (pointers).
+    ptrs: &'a [usize],
+    /// SPIKE (j2b): `GoodBv hp` and the cells' invariant are premises of the return continuation (a caller may use them).
+    framed: bool,
+    /// `GoodBv` binders in the statement.
+    wg: bool,
+    /// The function calls a closure through the hook `fn`: `fn`, the source's `clo` and the closure relation are hypotheses.
+    callee: bool,
+    /// The record's cell offset in the closure relation's invariant (when it is the concrete cell).
+    off: u128,
+    /// The invariant `Inv R h p v` is this variable (the outermost binder of the statement), not the concrete cell.
+    inv: Option<At>,
+}
+
+impl G<'_> {
+    /// `Inv R h p v`: the heap `h` holds the closure record at `p` for the captured value `v`. A variable (abstract), or
+    /// the cell `h (p + off) = v` (concrete).
+    fn inv_ty(&self, c: &mut Cx, r: At, h: At, p: At, v: At) -> Expr {
+        match self.inv {
+            Some(i) => apps(c.at(i), vec![c.at(r), c.at(h), c.at(p), c.at(v)]),
+            None => {
+                let kt = arrow(self.v(), c.at(r));
+                c.pi(kt, |c, kk| {
+                    let addr = if self.off == 0 { c.at(p) } else { app2(Op::Add.term(self.n), c.at(p), lit(self.n, self.off)) };
+                    id(c.at(r), app2(c.at(h), addr, c.at(kk)), app(c.at(kk), c.at(v)))
+                })
+            }
+        }
+    }
+    /// `fn : V -> V -> V -> Heap -> Ret -> R`: the closure callee on the pointer, the argument, `hp`, the heap, the return.
+    fn fn_ty(&self, c: &mut Cx, r: At) -> Expr {
+        let (hl, rm) = (self.w.heap(c, r), self.ret_m(c, r));
+        let v = self.v();
+        arrow(v, arrow(v, arrow(v, arrow(hl, arrow(rm, c.at(r))))))
+    }
+    /// `clo : V -> V -> (V -> R) -> R`: the source closure on the argument and the captured value.
+    fn clo_ty(&self, c: &mut Cx, r: At) -> Expr {
+        let v = self.v();
+        arrow(v, arrow(v, arrow(self.ret_s(c, r), c.at(r))))
+    }
+    /// The closure relation: for every record pointer `p`, captured value `v`, argument `a`, `hp`, heap and continuations
+    /// related for every return heap that keeps the record, the callee on the record equals the source closure.
+    fn crall_ty(&self, c: &mut Cx, r: At, fnv: At, clov: At) -> Expr {
+        let (w, n) = (self.w, self.n);
+        let v = self.v();
+        c.pi(v, |c, p| {
+            c.pi(v, |c, cv| {
+                c.pi(v, |c, a| {
+                    c.pi(v, |c, hp| {
+                        let hl = w.heap(c, r);
+                        c.pi(hl, |c, h| {
+                            let rm = self.ret_m(c, r);
+                            c.pi(rm, |c, km| {
+                                let rs = self.ret_s(c, r);
+                                c.pi(rs, |c, ks| {
+                                    let gp = app(good_bv(n), c.at(p));
+                                    let ghp = app(good_bv(n), c.at(hp));
+                                    let inv = self.inv_ty(c, r, h, p, cv);
+                                    let rel = c.pi(v, |c, y| {
+                                        let hl = w.heap(c, r);
+                                        c.pi(hl, |c, loc| {
+                                            c.pi(v, |c, hp2| {
+                                                let hh = w.heap(c, r);
+                                                c.pi(hh, |c, h2| {
+                                                    let mu = w.mkmu(c, r, c.at(loc), c.at(hp2), c.at(h2));
+                                                    let concl = id(c.at(r), app2(c.at(km), c.at(y), mu), app(c.at(ks), c.at(y)));
+                                                    let gh2 = app(good_bv(n), c.at(hp2));
+                                                    let i2 = self.inv_ty(c, r, h2, p, cv);
+                                                    arrow(gh2, arrow(i2, concl))
+                                                })
+                                            })
+                                        })
+                                    });
+                                    let call = apps(c.at(fnv), vec![c.at(p), c.at(a), c.at(hp), c.at(h), c.at(km)]);
+                                    let src = apps(c.at(clov), vec![c.at(a), c.at(cv), c.at(ks)]);
+                                    arrow(gp, arrow(ghp, arrow(inv, arrow(rel, id(c.at(r), call, src)))))
+                                })
+                            })
+                        })
+                    })
+                })
+            })
+        })
+    }
+    fn v(&self) -> Expr {
+        self.w.v()
+    }
+    /// How many parameters the source takes: the machine's non-pointer ones, then one per cell.
+    fn nsrc(&self) -> usize {
+        self.m - self.ptrs.len() + self.cells.len()
+    }
+    /// The source's arguments from the machine's parameters and the cells' values.
+    fn src_args<T: Copy>(&self, args: &[T], cvs: &[T]) -> Vec<T> {
+        let mut v: Vec<T> = (0..self.m).filter(|i| !self.ptrs.contains(i)).map(|i| args[i]).collect();
+        v.extend_from_slice(cvs);
+        v
+    }
+    /// `Ret = V -> State -> R`.
+    fn ret_m(&self, c: &mut Cx, r: At) -> Expr {
+        let mem = self.w.mem(c, r);
+        arrow(self.v(), arrow(mem, c.at(r)))
+    }
+    /// `H = State -> Ret -> R`.
+    fn hm(&self, c: &mut Cx, r: At) -> Expr {
+        let (mem, ret) = (self.w.mem(c, r), self.ret_m(c, r));
+        arrow(mem, arrow(ret, c.at(r)))
+    }
+    fn ret_s(&self, c: &Cx, r: At) -> Expr {
+        arrow(self.v(), c.at(r))
+    }
+    /// `Hs = V^m -> (V -> R) -> R`.
+    fn hs(&self, c: &Cx, r: At) -> Expr {
+        (0..self.nsrc()).fold(arrow(self.ret_s(c, r), c.at(r)), |acc, _| arrow(self.v(), acc))
+    }
+    /// The continuation relation. When `framed` it holds only for returns with a good allocation pointer and the cells'
+    /// invariant (over `args` and `cvs`, the statement's parameters), the premises a caller's continuation may use.
+    fn rel_ty(&self, c: &mut Cx, r: At, km: At, ks: At, args: &[At], cvs: &[At]) -> Expr {
+        let w = self.w;
+        // over the components of the state, not a state variable: a `sigrec` on a variable is stuck (no eta)
+        c.pi(self.v(), |c, a| {
+            let hl = w.heap(c, r);
+            c.pi(hl, |c, loc| {
+                c.pi(self.v(), |c, hp| {
+                    let hh = w.heap(c, r);
+                    c.pi(hh, |c, h| {
+                        let mu = w.mkmu(c, r, c.at(loc), c.at(hp), c.at(h));
+                        let concl = id(c.at(r), app2(c.at(km), c.at(a), mu), app(c.at(ks), c.at(a)));
+                        if !self.framed {
+                            return concl;
+                        }
+                        let mut prem = vec![app(good_bv(self.n), c.at(hp))];
+                        for k in 0..self.cells.len() {
+                            prem.push(self.cell_ty(c, r, h, k, args, cvs[k]));
+                        }
+                        prem.into_iter().rev().fold(concl, |acc, p| arrow(p, acc))
+                    })
+                })
+            })
+        })
+    }
+    /// The address of cell `k`, `param + offset`, over the parameters `args`.
+    fn cell_addr(&self, k: usize, args: &[Expr]) -> Expr {
+        let (p, off) = self.cells[k];
+        if off == 0 {
+            return args[p];
+        }
+        app2(Op::Add.term(self.n), args[p], lit(self.n, off))
+    }
+    /// `Pi K. Id(R, h addr K, K cv)`: the heap holds `cv` at the cell's address, whatever else it holds.
+    fn cell_ty(&self, c: &mut Cx, r: At, h: At, k: usize, args: &[At], cv: At) -> Expr {
+        if self.inv.is_some() {
+            return self.inv_ty(c, r, h, args[self.cells[k].0], cv);
+        }
+        let kt = arrow(self.v(), c.at(r));
+        c.pi(kt, |c, kk| {
+            // built under the binder, so its indices count it
+            let addr = self.cell_addr(k, &args.iter().map(|a| c.at(*a)).collect::<Vec<_>>());
+            id(c.at(r), app2(c.at(h), addr, c.at(kk)), app(c.at(kk), c.at(cv)))
+        })
+    }
+    /// `Pi K. Id(R, loc i K, K a)`: slot `i` of `loc` holds `a`.
+    fn hyp_ty(&self, c: &mut Cx, r: At, loc: At, i: usize, a: At) -> Expr {
+        let n = self.n;
+        let kt = arrow(self.v(), c.at(r));
+        c.pi(kt, |c, kk| id(c.at(r), app2(c.at(loc), lit(n, i as u128), c.at(kk)), app(c.at(kk), c.at(a))))
+    }
+    /// The parameters at slots `0..m` over locals that are all 0.
+    fn frame(&self, c: &mut Cx, r: At, args: &[At]) -> Expr {
+        let blank = self.w.zero_heap(c, r);
+        args.iter().enumerate().rev().fold(blank, |acc, (i, a)| self.w.upd(c, r, lit(self.n, i as u128), c.at(*a), acc))
+    }
+    fn tm(&self, c: &mut Cx, r: At, z: At) -> Expr {
+        let w = self.w;
+        let mem = w.mem(c, r);
+        c.lam(mem, |c, _| {
+            let ret = self.ret_m(c, r);
+            c.lam(ret, |c, _| c.at(z))
+        })
+    }
+    fn ts(&self, c: &mut Cx, r: At, z: At) -> Expr {
+        let n = self.n;
+        let args: Vec<Ty> = (0..self.nsrc()).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+        tele(c, &args, &mut vec![], &lam, &mut |c, _| {
+            let rs = self.ret_s(c, r);
+            c.lam(rs, |c, _| c.at(z))
+        })
+    }
+    /// `Bm = \env mu k. M_env (prog code) 0 mu`, the body's answer passed to `k`.
+    fn bm(&self, c: &mut Cx, r: At, z: At, ch: Option<At>, code: &[Ins], stale: bool, callee: Option<At>) -> Expr {
+        let (w, n) = (self.w, self.n);
+        let hm = self.hm(c, r);
+        c.lam(hm, |c, env| {
+            let mem = w.mem(c, r);
+            c.lam(mem, |c, mu| {
+                let rm = self.ret_m(c, r);
+                c.lam(rm, |c, k| {
+                    let base = c.mark(w.v());
+                    let p = w.prog(c, code, &[], base);
+                    let p = c.mark(p);
+                    let fuel0 = c.mark(nat2_lit(0));
+                    let st_ty = prod(w.v(), c.at(base));
+                    let kk = c.lam(st_ty, |c, st| {
+                        let mem = w.mem(c, r);
+                        c.lam(mem, |c, mu2| w.split(c, r, w.v(), base, st, |c, y, _| app2(c.at(k), c.at(y), c.at(mu2))))
+                    });
+                    let kk = c.mark(kk);
+                    let restart = {
+                        let mem = w.mem(c, r);
+                        c.lam(mem, |c, m2| app2(c.at(env), c.at(m2), c.at(k)))
+                    };
+                    let restart = c.mark(restart);
+                    let hooks = Hooks { env: Some(env), lab: Some(restart), ch, stale_hp: stale, callee };
+                    let m = w.meaning_with(c, p, fuel0, r, kk, z, &hooks);
+                    app2(m, lit(n, 0), c.at(mu))
+                })
+            })
+        })
+    }
+    /// `Bs = \g x.. ks. cps src`.
+    fn bs(&self, c: &mut Cx, r: At, ch: Option<At>, clo: Option<At>, src: &SrcFn) -> Expr {
+        let n = self.n;
+        let hs = self.hs(c, r);
+        c.lam(hs, |c, g| {
+            let vs: Vec<Ty> = (0..self.nsrc()).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+            tele(c, &vs, &mut vec![], &lam, &mut |c, xs| {
+                let rs = self.ret_s(c, r);
+                c.lam(rs, |c, ks| {
+                    let mp = xs.len() - self.cells.len();
+                    let env = SEnv { n, r, g, params: xs[..mp].to_vec(), cells: xs[mp..].to_vec(), ch, clo };
+                    src(c, &env, &|c, v| app(c.at(ks), v))
+                })
+            })
+        })
+    }
+    /// The binders of the induction's motive, step and hypothesis applications, after the dummy numeral that lifts the
+    /// motive to Sort3: `d, a_0..a_{m-1}, cv_0..cv_{c-1}, loc, hp, h, km, ks, rel, slot_0..slot_{m-1}, cell_0..cell_{c-1}`.
+    fn binders(&self, c: &mut Cx, r: At, wrap: &dyn Fn(Expr, Expr) -> Expr, body: &mut dyn FnMut(&mut Cx, &[At]) -> Expr) -> Expr {
+        let (g, n, m, nc) = (self, self.n, self.m, self.cells.len());
+        let q = m + nc;
+        let mut tys: Vec<Ty> = vec![ty!(|_c, _x| nat2())];
+        tys.extend((0..q).map(|_| ty!(|_c, _x| bv_ty(n))));
+        tys.push(ty!(|c, _x| g.w.heap(c, r)));
+        tys.push(ty!(|_c, _x| bv_ty(n)));
+        tys.push(ty!(|c, _x| g.w.heap(c, r)));
+        tys.push(ty!(|c, _x| g.ret_m(c, r)));
+        tys.push(ty!(|c, _x| g.ret_s(c, r)));
+        tys.push(ty!(|c, x| g.rel_ty(c, r, x[q + 4], x[q + 5], &x[1..1 + m], &x[1 + m..1 + q])));
+        for i in 0..m {
+            tys.push(ty!(|c, x| g.hyp_ty(c, r, x[q + 1], i, x[1 + i])));
+        }
+        for k in 0..nc {
+            tys.push(ty!(|c, x| g.cell_ty(c, r, x[q + 3], k, &x[1..1 + m], x[1 + m + k])));
+        }
+        if g.wg {
+            // `GoodBv hp`: the allocation pointer is a well-formed word, for the address lemmas
+            tys.push(ty!(|c, x| app(good_bv(n), c.at(x[q + 2]))));
+            // and each pointer parameter is one
+            for &pi in g.ptrs {
+                tys.push(ty!(|c, x| app(good_bv(n), c.at(x[1 + pi]))));
+            }
+        }
+        tele(c, &tys, &mut vec![], wrap, body)
+    }
+}
+
+/// What `gen_sim` checks of the code before generating anything.
+fn check_code(code: &[Ins], arity: usize, temps: usize) -> Result<(), String> {
+    fn walk(code: &[Ins], locals: usize, top: bool) -> Result<(), String> {
+        for ins in code {
+            match ins {
+                Ins::Loop(b) if top && code.len() == 1 => walk(b, locals, false)?,
+                Ins::Loop(_) => return Err("a loop other than the function's one top-level loop".into()),
+                Ins::If(t, e) => {
+                    walk(t, locals, false)?;
+                    walk(e, locals, false)?
+                }
+                Ins::LocalGet(i) | Ins::LocalSet(i) if *i as usize >= locals => return Err(format!("local {i} out of range")),
+                Ins::Raw(s) => return Err(format!("raw line {s:?}")),
+                Ins::Dup => return Err(format!("{ins:?}: not modelled here")),
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+    walk(code, arity + temps, true)?;
+    match shape(code, vec![], &[]) {
+        Ok(Some(s)) if s == vec![K::W] => Ok(()),
+        other => Err(format!("the body does not run from [] to [word]: {other:?}")),
+    }
+}
+
+/// The heap a statement fixes beyond the locals.
+#[derive(Default, Clone)]
+pub struct HeapSpec {
+    /// SPIKE (j2b): the return continuation gets `GoodBv hp` and the cells' invariant as premises, so a caller may use them.
+    pub framed: bool,
+    /// SPIKE (j2b): the function calls a closure (`call_c`): its callee, the source closure and the closure relation are
+    /// hypotheses. The value is the record's cell offset in the relation's invariant.
+    pub callee: Option<u128>,
+    /// SPIKE (j2b): the heap invariant is a variable of the statement (`Inv`), not the concrete cells: the function knows
+    /// nothing of the record's layout. The one cell in `cells` names the pointer parameter and the captured value.
+    pub abstract_inv: bool,
+    /// `(p, off)`: a cell at address `x_p + off`. Its value is one more source parameter, after the non-pointer ones.
+    pub cells: Vec<(usize, u128)>,
+    /// The machine parameters the source does not take (pointers).
+    pub ptrs: Vec<usize>,
+    /// A control: `alloc` that does not bump the allocation pointer.
+    pub stale_hp: bool,
+}
+
+/// `gen_sim_with` over no heap.
+pub fn gen_sim(w: Wasm, code: &[Ins], arity: usize, temps: usize, src: &SrcFn) -> Result<(Expr, Expr), String> {
+    gen_sim_with(w, code, arity, temps, &HeapSpec::default(), src)
+}
+
+/// `Pi R t e. Id(R, CH R (lit1 b) t e, t or e)`: the probe's behaviour at a literal condition (applied to the real
+/// `choose` at the end, where it is `refl`).
+fn probe_ty(c: &mut Cx, ch: At, truth: bool) -> Expr {
+    c.pi(sort(0), |c, r| {
+        c.pi(c.at(r), |c, t| {
+            c.pi(c.at(r), |c, e| {
+                let pick = apps(c.at(ch), vec![c.at(r), lit(1, truth as u128), c.at(t), c.at(e)]);
+                id(c.at(r), pick, c.at(if truth { t } else { e }))
+            })
+        })
+    })
+}
+fn probe_real(truth: bool) -> Expr {
+    Cx::default().lam(sort(0), |c, r| c.lam(c.at(r), |c, t| c.lam(c.at(r), |c, e| refl(c.at(if truth { t } else { e })))))
+}
+
+/// `(proof, statement)` for `code` (a function of `arity` parameters and `temps` temporaries) against `src`, or why the
+/// two do not simulate each other. The kernel is the judge either way: an `Err` is only an early, readable reason.
+///
+/// `spec` is the heap the statement fixes: for every heap `h` and allocation pointer `hp` (`GoodBv`), each cell `(p, off)`
+/// holds its value `cv` at `x_p + off` (`Pi K. Id(R, h (x_p + off) K, K cv)`).
+pub fn gen_sim_with(w: Wasm, code: &[Ins], arity: usize, temps: usize, spec: &HeapSpec, src: &SrcFn) -> Result<(Expr, Expr), String> {
+    check_code(code, arity, temps)?;
+    let (m, nc) = (arity, spec.cells.len());
+    let q = m + nc;
+    let stale = spec.stale_hp;
+    let has_callee = spec.callee.is_some();
+    let wg = nc > 0 || has_callee || spec.framed;
+    // the abstract invariant is the statement's outermost binder; `Cx::under` hands out that variable (at depth 1) for both
+    // the statement's and the proof's build, each of which opens that binder first
+    let inv = if spec.abstract_inv { Some(Cx::default().under(|_, x| x)) } else { None };
+    let g = G { w, n: w.n, m: arity, cells: &spec.cells, ptrs: &spec.ptrs, framed: spec.framed || has_callee, wg, callee: has_callee, off: spec.callee.unwrap_or(0), inv };
+    // the late binders (outside the induction): `fn`, `clo`, the closure relation
+    let nx = 9 + q + nc + if wg { 1 + spec.ptrs.len() } else { 0 };
+    // N gn R z x_0..x_{m-1} cv_0.. hp h km ks rel cell_0.. [ghp]
+    let mut tys: Vec<Ty> = vec![
+        ty!(|_c, _x| nat2()),
+        ty!(|c, x| w.good_nat(c, x[0])),
+        ty!(|_c, _x| sort(0)),
+        ty!(|c, x| c.at(x[2])),
+    ];
+    tys.extend((0..q).map(|_| ty!(|_c, _x| bv_ty(w.n))));
+    tys.push(ty!(|_c, _x| bv_ty(w.n)));
+    tys.push(ty!(|c, x| w.heap(c, x[2])));
+    tys.push(ty!(|c, x| g.ret_m(c, x[2])));
+    tys.push(ty!(|c, x| g.ret_s(c, x[2])));
+    tys.push(ty!(|c, x| g.rel_ty(c, x[2], x[6 + q], x[7 + q], &x[4..4 + m], &x[4 + m..4 + q])));
+    for k in 0..nc {
+        tys.push(ty!(|c, x| g.cell_ty(c, x[2], x[5 + q], k, &x[4..4 + m], x[4 + m + k])));
+    }
+    if wg {
+        tys.push(ty!(|c, x| app(good_bv(w.n), c.at(x[4 + q]))));
+        for &pi in &spec.ptrs {
+            tys.push(ty!(|c, x| app(good_bv(w.n), c.at(x[4 + pi]))));
+        }
+    }
+    if has_callee {
+        tys.push(ty!(|c, x| g.fn_ty(c, x[2])));
+        tys.push(ty!(|c, x| g.clo_ty(c, x[2])));
+        tys.push(ty!(|c, x| g.crall_ty(c, x[2], x[nx], x[nx + 1])));
+    }
+    let callee_at = |x: &[At]| if has_callee { Some(x[nx]) } else { None };
+    let clo_at = |x: &[At]| if has_callee { Some(x[nx + 1]) } else { None };
+    let inv_ty0 = Cx::default().pi(sort(0), |c, r| arrow(w.heap(c, r), arrow(w.v(), arrow(w.v(), sort(INV_SORT)))));
+
+    let build_stmt = |c: &mut Cx| tele(c, &tys, &mut vec![], &pi, &mut |c, x| {
+        let (fuel, r, z) = (x[0], x[2], x[3]);
+        let args: Vec<At> = x[4..4 + m].to_vec();
+        let cvs: Vec<At> = x[4 + m..4 + q].to_vec();
+        let (hp, h, km, ks) = (x[4 + q], x[5 + q], x[6 + q], x[7 + q]);
+        let (hm, hs) = (g.hm(c, r), g.hs(c, r));
+        let (tm, bm) = (g.tm(c, r, z), g.bm(c, r, z, None, code, stale, callee_at(x)));
+        let (ts, bs) = (g.ts(c, r, z), g.bs(c, r, None, clo_at(x), src));
+        let fr = g.frame(c, r, &args);
+        let mu = w.mkmu(c, r, fr, c.at(hp), c.at(h));
+        let l = app2(apps(c.at(fuel), vec![hm, tm, bm]), mu, c.at(km));
+        let sargs: Vec<Expr> = g.src_args(&args, &cvs).iter().map(|a| c.at(*a)).collect();
+        let rhs = apps(c.at(fuel), [vec![hs, ts, bs], sargs, vec![c.at(ks)]].concat());
+        id(c.at(r), l, rhs)
+    });
+    let stmt = if spec.abstract_inv { Cx::default().pi(inv_ty0, |c, _| build_stmt(c)) } else { build_stmt(&mut Cx::default()) };
+
+    let err: RefCell<Option<String>> = RefCell::new(None);
+    let build_proof = |c: &mut Cx| c.lam(ch_ty(), |c, ch| {
+        let ht_ty = probe_ty(c, ch, true);
+        c.lam(ht_ty, |c, ht| {
+            let hf_ty = probe_ty(c, ch, false);
+            c.lam(hf_ty, |c, hf| {
+                tele(c, &tys, &mut vec![], &lam, &mut |c, x| {
+                    let (gn, r, z) = (x[1], x[2], x[3]);
+                    let args: Vec<At> = x[4..4 + m].to_vec();
+                    let cvs0: Vec<At> = x[4 + m..4 + q].to_vec();
+                    let (hp0, h, km, ks, rel) = (x[4 + q], x[5 + q], x[6 + q], x[7 + q], x[8 + q]);
+                    let cell_hyps0: Vec<At> = x[9 + q..9 + q + nc].to_vec();
+                    let (hm0, hs0) = (g.hm(c, r), g.hs(c, r));
+                    let (hm, hs) = (c.mark(hm0), c.mark(hs0));
+                    let (tm0, ts0) = (g.tm(c, r, z), g.ts(c, r, z));
+                    let (tm, ts) = (c.mark(tm0), c.mark(ts0));
+                    let bm0 = g.bm(c, r, z, Some(ch), code, stale, callee_at(x));
+                    let bm = c.mark(bm0);
+                    let bs0 = g.bs(c, r, Some(ch), clo_at(x), src);
+                    let bs = c.mark(bs0);
+                    // the motive at a fuel: the binders, then the two sides
+                    let mot = |c: &mut Cx, mm: Expr| {
+                        let mm = c.mark(mm);
+                        g.binders(c, r, &pi, &mut |c, y| {
+                            let (ya, ycv, loc, hp, hh, kmm, kss) = (&y[1..1 + m], &y[1 + m..1 + q], y[1 + q], y[2 + q], y[3 + q], y[4 + q], y[5 + q]);
+                            let mu = w.mkmu(c, r, c.at(loc), c.at(hp), c.at(hh));
+                            let l = app2(apps(c.at(mm), vec![c.at(hm), c.at(tm), c.at(bm)]), mu, c.at(kmm));
+                            let sargs: Vec<Expr> = g.src_args(ya, ycv).iter().map(|a| c.at(*a)).collect();
+                            let rhs = apps(c.at(mm), [vec![c.at(hs), c.at(ts), c.at(bs)], sargs, vec![c.at(kss)]].concat());
+                            id(c.at(r), l, rhs)
+                        })
+                    };
+                    let motive = c.lam(nat2(), |c, mm| mot(c, c.at(mm)));
+                    let hz = g.binders(c, r, &lam, &mut |c, _| refl(c.at(z)));
+                    let step = c.lam(nat2(), |c, j| {
+                        let ih_ty = mot(c, c.at(j));
+                        c.lam(ih_ty, |c, ih| {
+                            g.binders(c, r, &lam, &mut |c, y| {
+                                let sim = Sim {
+                                    g: &g,
+                                    r,
+                                    ch,
+                                    j,
+                                    ih,
+                                    d: y[0],
+                                    loc: y[1 + q],
+                                    hp: y[2 + q],
+                                    h: y[3 + q],
+                                    km: y[4 + q],
+                                    ks: y[5 + q],
+                                    rel: y[6 + q],
+                                    args: y[1..1 + m].to_vec(),
+                                    cvs: y[1 + m..1 + q].to_vec(),
+                                    hyps: y[7 + q..7 + q + m].to_vec(),
+                                    cell_hyps: y[7 + q + m..7 + q + m + nc].to_vec(),
+                                    ghp: if wg { Some(y[7 + q + m + nc]) } else { None },
+                                    gptrs: if wg { spec.ptrs.iter().enumerate().map(|(k, &pi)| (pi, y[8 + q + m + nc + k])).collect() } else { vec![] },
+                                    ht,
+                                    hf,
+                                    lem: Lemmas::default(),
+                                    fnv: callee_at(x),
+                                    clov: clo_at(x),
+                                    crall: if has_callee { Some(x[nx + 2]) } else { None },
+                                    facts: RefCell::new(
+                                        (0..nc).map(|k| Fact { h: y[3 + q], p: y[1 + spec.cells[k].0], v: y[1 + m + k], proof: y[7 + q + m + k] }).collect(),
+                                    ),
+                                    gfacts: RefCell::new(vec![]),
+                                };
+                                let mu = w.mkmu(c, r, c.at(y[1 + q]), c.at(y[2 + q]), c.at(y[3 + q]));
+                                let mj = apps(c.at(j), vec![c.at(hm), c.at(tm), c.at(bm)]);
+                                let sj = apps(c.at(j), vec![c.at(hs), c.at(ts), c.at(bs)]);
+                                let m0 = apps(c.at(bm), vec![mj, mu, c.at(y[4 + q])]);
+                                let sargs: Vec<Expr> = g.src_args(&sim.args, &sim.cvs).iter().map(|a| c.at(*a)).collect();
+                                let s0 = apps(c.at(bs), [vec![sj], sargs, vec![c.at(y[5 + q])]].concat());
+                                match sim.sim(c, m0, s0, "body") {
+                                    Ok(p) => p,
+                                    Err(e) => {
+                                        err.borrow_mut().get_or_insert(e);
+                                        refl(m0)
+                                    }
+                                }
+                            })
+                        })
+                    });
+                    let fr = g.frame(c, r, &args);
+                    let slots: Vec<Expr> = (0..m)
+                        .map(|i| {
+                            let a = args[i];
+                            c.lam(arrow(w.v(), c.at(r)), |c, kk| refl(app(c.at(kk), c.at(a))))
+                        })
+                        .collect();
+                    let mut all = vec![motive, hz, step, nat2_lit(0)];
+                    all.extend(args.iter().map(|a| c.at(*a)));
+                    all.extend(cvs0.iter().map(|a| c.at(*a)));
+                    all.extend([fr, c.at(hp0), c.at(h), c.at(km), c.at(ks), c.at(rel)]);
+                    all.extend(slots);
+                    all.extend(cell_hyps0.iter().map(|a| c.at(*a)));
+                    if wg {
+                        all.push(c.at(x[9 + q + nc]));
+                        all.extend((0..spec.ptrs.len()).map(|k| c.at(x[10 + q + nc + k])));
+                    }
+                    apps(c.at(gn), all)
+                })
+            })
+        })
+    });
+    let proof = if spec.abstract_inv { Cx::default().lam(inv_ty0, |c, _| apps(build_proof(c), vec![choose_fn(), probe_real(true), probe_real(false)])) } else {
+        apps(build_proof(&mut Cx::default()), vec![choose_fn(), probe_real(true), probe_real(false)])
+    };
+    if let Some(e) = err.into_inner() {
+        return Err(e);
+    }
+    Ok((proof, stmt))
+}
+
+/// The sort `Inv R h p v` lives in.
+const INV_SORT: u32 = 1;
+
+/// The address lemmas, built when a walk first needs one.
+#[derive(Default)]
+struct Lemmas {
+    refl: OnceCell<Expr>,
+    comm: OnceCell<Expr>,
+    region: OnceCell<Expr>,
+    cancel: OnceCell<Expr>,
+    good_add: OnceCell<Expr>,
+}
+
+/// One walk's fixed names.
+struct Sim<'g, 'a> {
+    g: &'g G<'a>,
+    r: At,
+    ch: At,
+    j: At,
+    ih: At,
+    d: At,
+    loc: At,
+    hp: At,
+    h: At,
+    km: At,
+    ks: At,
+    rel: At,
+    args: Vec<At>,
+    cvs: Vec<At>,
+    hyps: Vec<At>,
+    cell_hyps: Vec<At>,
+    ghp: Option<At>,
+    /// `(parameter, GoodBv witness)` for each pointer parameter
+    gptrs: Vec<(usize, At)>,
+    ht: At,
+    hf: At,
+    lem: Lemmas,
+    /// SPIKE (j2b): the closure callee `fn`, the source's `clo` and the closure relation (hypotheses of the statement).
+    fnv: Option<At>,
+    clov: Option<At>,
+    crall: Option<At>,
+    /// The invariant facts in scope: the statement's cells, then each return continuation's premise while it is walked.
+    facts: RefCell<Vec<Fact>>,
+    /// `GoodBv hp` witnesses of return continuations in scope: `(hp, proof)`.
+    gfacts: RefCell<Vec<(At, At)>>,
+}
+
+/// `proof : Inv h p v` (up to conversion), in scope.
+#[derive(Clone, Copy)]
+struct Fact {
+    h: At,
+    p: At,
+    v: At,
+    proof: At,
+}
+
+/// `\u. \C k. k u : Bool0 -> Bv1`: a bit as a one-bit word (`eq_bit a b` is this of `eq a b`).
+fn fmap() -> Expr {
+    lam(bool0(), lam(sort(1), lam(karrow(1), app(var(0), var(2)))))
+}
+
+impl Sim<'_, '_> {
+    /// What a term in weak head normal form is doing, for the reasons.
+    fn kind(&self, c: &Cx, head: &Expr) -> &'static str {
+        if *head == c.at(self.km) || *head == c.at(self.ks) {
+            "returns"
+        } else if *head == c.at(self.ch) {
+            "branches"
+        } else if *head == c.at(self.j) {
+            "recurses"
+        } else if *head == c.at(self.loc) {
+            "reads a local"
+        } else if *head == c.at(self.h) {
+            "reads the heap"
+        } else {
+            "is stuck"
+        }
+    }
+
+    /// A proof of `Id(R, m, s)`.
+    fn sim(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        tatic_kernel::grow(|| self.sim_step(c, m, s, path))
+    }
+
+    /// The three components of a state in weak head normal form: `(locals, hp, heap)`.
+    fn parts(st: &Expr) -> Option<(Expr, Expr, Expr)> {
+        let tatic_kernel::Node::Pair(_, loc, rest) = whnf(st).node() else { return None };
+        let tatic_kernel::Node::Pair(_, hp, heap) = whnf(&rest).node() else { return None };
+        Some((loc, hp, heap))
+    }
+
+    // ---- addresses
+
+    /// `base + off` as built (not reduced), or the whole address with no offset.
+    fn addr_parts(&self, e: &Expr) -> (Expr, Option<Expr>) {
+        let (h, a) = spine(e);
+        if a.len() == 2 && def_eq(&h, &Op::Add.term(self.g.n)) { (a[0], Some(a[1])) } else { (*e, None) }
+    }
+
+    /// The word a literal builds, if `e` is one.
+    fn as_lit(&self, e: &Expr) -> Option<u128> {
+        let tatic_kernel::Node::Lam(_, b) = e.node() else { return None };
+        let tatic_kernel::Node::Lam(_, b) = b.node() else { return None };
+        let (h, bits) = spine(&b);
+        if h != var(0) || bits.len() != self.g.n {
+            return None;
+        }
+        let mut v = 0u128;
+        for (i, bt) in bits.iter().enumerate() {
+            if def_eq(bt, &t()) {
+                v |= 1 << i;
+            } else if !def_eq(bt, &f()) {
+                return None;
+            }
+        }
+        Some(v)
+    }
+
+    /// A proof of `GoodBv e` for an address built from the allocation pointer, literals and `+`.
+    fn good_of(&self, c: &Cx, e: &Expr) -> Result<Expr, String> {
+        let n = self.g.n;
+        if let Some(gh) = self.ghp {
+            if def_eq(e, &c.at(self.hp)) {
+                return Ok(c.at(gh));
+            }
+        }
+        if let Some((_, gp)) = self.gptrs.iter().find(|(pi, _)| def_eq(e, &c.at(self.args[*pi]))) {
+            return Ok(c.at(*gp));
+        }
+        if let Some((_, pf)) = self.gfacts.borrow().iter().find(|(hp, _)| def_eq(e, &c.at(*hp))) {
+            return Ok(c.at(*pf));
+        }
+        if let Some(v) = self.as_lit(e) {
+            return Ok(good_lit(n, v));
+        }
+        let (h, a) = spine(e);
+        if a.len() == 2 && def_eq(&h, &Op::Add.term(n)) {
+            let (ga, gb) = (self.good_of(c, &a[0])?, self.good_of(c, &a[1])?);
+            let ad = self.lem.good_add.get_or_init(|| good_add(n).0);
+            return Ok(apps(*ad, vec![a[0], a[1], ga, gb]));
+        }
+        Err("an address is not built from the allocation pointer, literals and +: no GoodBv witness".into())
+    }
+
+    /// For a store at `s` read at `t`: whether the two are the same address, and a proof of
+    /// `Id(Bool0, eq s t, true or false)` (up to conversion of the right side).
+    fn decide(&self, c: &Cx, s: &Expr, t: &Expr) -> Result<(bool, Expr), String> {
+        let n = self.g.n;
+        let eq = |x: &Expr, y: &Expr| app2(eq_bv(n), *x, *y);
+        if def_eq(s, t) {
+            let g = self.good_of(c, s)?;
+            let l = self.lem.refl.get_or_init(|| eq_refl_lemma(n).0);
+            return Ok((true, apps(*l, vec![*s, g])));
+        }
+        let ((bs, os), (bt, ot)) = (self.addr_parts(s), self.addr_parts(t));
+        let zero = lit(n, 0);
+        match (os, ot) {
+            // a store at `p`, a read at `p + j`: commute, then the region lemma `eq (p + j) p = eq j 0`
+            (None, Some(j)) if def_eq(&bs, &bt) => {
+                if !def_eq(&eq(&j, &zero), &f()) {
+                    return Err("a store at p and a read at p + j, with j not a nonzero literal".into());
+                }
+                let (gs, gt, gj) = (self.good_of(c, s)?, self.good_of(c, t)?, self.good_of(c, &j)?);
+                let comm = apps(*self.lem.comm.get_or_init(|| eq_comm_law(n).0), vec![*s, *t, gs, gt]);
+                let reg = apps(*self.lem.region.get_or_init(|| region_law(n, Rg::Ok).0), vec![*s, j, gs, gj]);
+                Ok((false, trans_proof(&bool0(), &eq(s, t), &eq(t, s), &eq(&j, &zero), comm, reg)))
+            }
+            // a store at `p + j`, a read at `p`: the region lemma as it stands
+            (Some(j), None) if def_eq(&bs, t) => {
+                if !def_eq(&eq(&j, &zero), &f()) {
+                    return Err("a store at p + j and a read at p, with j not a nonzero literal".into());
+                }
+                let (gt, gj) = (self.good_of(c, t)?, self.good_of(c, &j)?);
+                Ok((false, apps(*self.lem.region.get_or_init(|| region_law(n, Rg::Ok).0), vec![*t, j, gt, gj])))
+            }
+            // two offsets from one base: cancellation `eq (p + i) (p + j) = eq i j`
+            (Some(i), Some(j)) if def_eq(&bs, &bt) => {
+                if !def_eq(&eq(&i, &j), &f()) {
+                    return Err("two offsets from one base that are not distinct literals".into());
+                }
+                let (gp, gi, gj) = (self.good_of(c, &bs)?, self.good_of(c, &i)?, self.good_of(c, &j)?);
+                Ok((false, apps(*self.lem.cancel.get_or_init(|| cancel_law(n, Rg::Ok).0), vec![bs, i, j, gp, gi, gj])))
+            }
+            _ => Err("cannot tell whether a store address and a read address are the same".into()),
+        }
+    }
+
+    /// `Id(R, CH R w x y, x or y)` from `pe : Id(Bool0, eq s t, true or false)` and `w = eq_bit s t`.
+    fn ch_by(&self, c: &mut Cx, truth: bool, (s, t): (Expr, Expr), x: Expr, y: Expr, pe: Expr) -> Expr {
+        let (r, n) = (self.r, self.g.n);
+        let w = app2(eq_bit(n), s, t);
+        let lit_b = lit(1, truth as u128);
+        let e1 = cong1(&bool0(), &bv_ty(1), &fmap(), app2(eq_bv(n), s, t), bit(truth), pe);
+        let (xm, ym) = (c.mark(x), c.mark(y));
+        let f2 = c.lam(bv_ty(1), |c, u| apps(c.at(self.ch), vec![c.at(r), c.at(u), c.at(xm), c.at(ym)]));
+        let rt = c.at(r);
+        let e2 = cong1(&bv_ty(1), &rt, &f2, w, lit_b, e1);
+        let probe = c.at(if truth { self.ht } else { self.hf });
+        let e3 = apps(probe, vec![c.at(r), x, y]);
+        let pick = |w: Expr| apps(c.at(self.ch), vec![c.at(r), w, x, y]);
+        let tup = (pick(w), pick(lit_b), if truth { x } else { y });
+        trans(c, r, tup, e2, e3)
+    }
+
+    /// A proof of `Id(R, e, K target)` for `e = heap t K` with `heap` a chain of stores over the statement's heap.
+    fn cell_pf(&self, c: &mut Cx, e: Expr, target: &Expr, kk: &Expr) -> Result<Expr, String> {
+        let n = self.g.n;
+        let w = whnf(&e);
+        let (h, a) = spine(&w);
+        if h == c.at(self.h) && a.len() == 2 {
+            let Some(k) = (0..self.g.cells.len()).find(|k| def_eq(&a[0], &self.g.cell_addr(*k, &self.arg_exprs(c)))) else {
+                return Err("a cell is read at an address the statement's cells do not fix".into());
+            };
+            if !def_eq(&c.at(self.cvs[k]), target) {
+                return Err(format!("cell {k} is not written, yet the source's call passes a different value for it"));
+            }
+            return Ok(app(c.at(self.cell_hyps[k]), a[1]));
+        }
+        if h == c.at(self.ch) && a.len() == 4 {
+            let (wh, wa) = spine(&a[1]);
+            if wa.len() != 2 || !def_eq(&wh, &eq_bit(n)) {
+                return Err("a store's address test is not `eq_bit`".into());
+            }
+            let (s, t, x, y) = (wa[0], wa[1], a[2], a[3]);
+            let (same, pe) = self.decide(c, &s, &t)?;
+            let pick = self.ch_by(c, same, (s, t), x, y, pe);
+            if same {
+                if !def_eq(&x, &app(*kk, *target)) {
+                    return Err("the last store to the cell writes a value other than the source's".into());
+                }
+                return Ok(pick);
+            }
+            let rest = self.cell_pf(c, y, target, kk)?;
+            return Ok(trans(c, self.r, (w, y, app(*kk, *target)), pick, rest));
+        }
+        Err("a cell's heap is neither the statement's heap nor a store over it".into())
+    }
+
+    /// A proof of `Inv h p v` (the concrete cell `h (p + off) = v`, or the abstract invariant): a fact in scope for that very
+    /// heap, pointer and value; else, for the concrete cell, the store chain over the heap walked down to the cell (the last
+    /// store to it must write `v`); else why not. An abstract invariant survives no store: a store gives a different heap.
+    fn inv_proof(&self, c: &mut Cx, h: &Expr, p: &Expr, v: &Expr, off: u128) -> Result<Expr, String> {
+        let n = self.g.n;
+        let hit = self.facts.borrow().iter().find(|f| def_eq(h, &c.at(f.h)) && def_eq(p, &c.at(f.p)) && def_eq(v, &c.at(f.v))).map(|f| f.proof);
+        if let Some(pf) = hit {
+            return Ok(c.at(pf));
+        }
+        if self.g.inv.is_some() {
+            return Err("the heap invariant is abstract: no fact says it holds for this heap, pointer and value (a store, an allocation or a callee that does not hand it back)".into());
+        }
+        let (hm, vm) = (c.mark(*h), c.mark(*v));
+        let addr = c.mark(if off == 0 { *p } else { app2(Op::Add.term(n), *p, lit(n, off)) });
+        let kt = arrow(self.g.v(), c.at(self.r));
+        let failed: RefCell<Option<String>> = RefCell::new(None);
+        let pf = c.lam(kt, |c, kk| {
+            let e = app2(c.at(hm), c.at(addr), c.at(kk));
+            match self.cell_pf(c, e, &c.at(vm), &c.at(kk)) {
+                Ok(p) => p,
+                Err(e) => {
+                    failed.borrow_mut().get_or_insert(e);
+                    refl(c.at(addr))
+                }
+            }
+        });
+        match failed.into_inner() {
+            Some(e) => Err(e),
+            None => Ok(pf),
+        }
+    }
+
+    /// The proofs of the cells' invariants at the heap `h2`, for the cells over parameters `args` and values `cvs`.
+    fn cells_at(&self, c: &mut Cx, h2: &Expr, args: &[Expr], cvs: &[Expr]) -> Result<Vec<Expr>, String> {
+        (0..self.g.cells.len())
+            .map(|k| {
+                let (pi, off) = self.g.cells[k];
+                self.inv_proof(c, h2, &args[pi], &cvs[k], off).map_err(|e| format!("cell {k}: {e}"))
+            })
+            .collect()
+    }
+
+    fn arg_exprs(&self, c: &Cx) -> Vec<Expr> {
+        self.args.iter().map(|a| c.at(*a)).collect()
+    }
+    /// `\cell_k. .. walk` over the cells' invariants at the heap `h` (over `args` and `cvs`), each a fact while `walk` runs.
+    fn under_cells(&self, c: &mut Cx, h: At, args: &[At], cvs: &[At], k: usize, walk: &dyn Fn(&mut Cx) -> Expr) -> Expr {
+        if k == self.g.cells.len() {
+            return walk(c);
+        }
+        let ty = self.g.cell_ty(c, self.r, h, k, args, cvs[k]);
+        c.lam(ty, |c, pv| {
+            self.facts.borrow_mut().push(Fact { h, p: args[self.g.cells[k].0], v: cvs[k], proof: pv });
+            let res = self.under_cells(c, h, args, cvs, k + 1, walk);
+            self.facts.borrow_mut().pop();
+            res
+        })
+    }
+    fn cv_exprs(&self, c: &Cx) -> Vec<Expr> {
+        self.cvs.iter().map(|a| c.at(*a)).collect()
+    }
+
+    /// The machine calls the closure callee on `p`, `x`, `hp`, the heap and a continuation; the source calls its closure
+    /// body on `a`, the captured value `v` and a continuation. The closure relation (a hypothesis) is applied to the
+    /// record pointer, the value, the argument, the allocation pointer, the heap, both continuations, the proofs that the
+    /// record and the allocation pointer are good and that the heap holds the record, and the continuations' relation, which
+    /// is generated by walking the two continuations under their binders with the callee's returned heap and its record.
+    fn call_closure(&self, c: &mut Cx, ma: &[Expr], sa: &[Expr], path: &str) -> Result<Expr, String> {
+        let (w, n) = (self.g.w, self.g.n);
+        let crall = self.crall.expect("crall");
+        if sa.len() != 3 {
+            return Err(format!("{path}: the machine calls a closure but the source's call has {} arguments", sa.len()));
+        }
+        if ma.len() != 5 {
+            return Err(format!("{path}: a closure call with {} arguments", ma.len()));
+        }
+        let (pp, xx, hp2, heap2, kont) = (ma[0], ma[1], ma[2], ma[3], ma[4]);
+        let (a_s, v_s, ks_s) = (sa[0], sa[1], sa[2]);
+        if !def_eq(&xx, &a_s) {
+            return Err(format!("{path}: the closure is called on a different argument than the source's"));
+        }
+        let gp = self.good_of(c, &pp).map_err(|e| format!("{path}: closure pointer: {e}"))?;
+        let ghp = self.good_of(c, &hp2).map_err(|e| format!("{path}: allocation pointer at a closure call: {e}"))?;
+        let inv = self.inv_proof(c, &heap2, &pp, &v_s, self.g.off).map_err(|e| format!("{path}: the record at a closure call: {e}"))?;
+        let (pm, vm, km, ksm) = (c.mark(pp), c.mark(v_s), c.mark(kont), c.mark(ks_s));
+        let failed: RefCell<Option<String>> = RefCell::new(None);
+        let r = self.r;
+        let rel = c.lam(self.g.v(), |c, y| {
+            let hl = w.heap(c, r);
+            c.lam(hl, |c, loc| {
+                c.lam(self.g.v(), |c, hpn| {
+                    let hh = w.heap(c, r);
+                    c.lam(hh, |c, hn| {
+                        let gty = app(good_bv(n), c.at(hpn));
+                        c.lam(gty, |c, gn| {
+                            let ity = self.g.inv_ty(c, r, hn, pm, vm);
+                            c.lam(ity, |c, inv_n| {
+                                self.facts.borrow_mut().push(Fact { h: hn, p: pm, v: vm, proof: inv_n });
+                                self.gfacts.borrow_mut().push((hpn, gn));
+                                let mu = w.mkmu(c, r, c.at(loc), c.at(hpn), c.at(hn));
+                                let (l, rr) = (app2(c.at(km), c.at(y), mu), app(c.at(ksm), c.at(y)));
+                                let res = self.sim(c, l, rr, &format!("{path}/after-call"));
+                                self.facts.borrow_mut().pop();
+                                self.gfacts.borrow_mut().pop();
+                                match res {
+                                    Ok(p) => p,
+                                    Err(e) => {
+                                        failed.borrow_mut().get_or_insert(e);
+                                        refl(l)
+                                    }
+                                }
+                            })
+                        })
+                    })
+                })
+            })
+        });
+        if let Some(e) = failed.into_inner() {
+            return Err(e);
+        }
+        Ok(apps(c.at(crall), vec![pp, v_s, xx, hp2, heap2, kont, ks_s, gp, ghp, inv, rel]))
+    }
+
+    fn sim_step(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        let n = self.g.n;
+        let (mw, sw) = (whnf(&m), whnf(&s));
+        let ((mh, ma), (sh, sa)) = (spine(&mw), spine(&sw));
+        let (mk, sk) = (self.kind(c, &mh), self.kind(c, &sh));
+
+        // a stuck read of a parameter's slot: rewrite by the slot hypothesis, then go on
+        if mh == c.at(self.loc) && ma.len() == 2 {
+            let Some(i) = (0..self.g.m).find(|i| def_eq(&ma[0], &lit(n, *i as u128))) else {
+                return Err(format!("{path}: reads a local that no parameter or earlier write fixes"));
+            };
+            let next = app(ma[1], c.at(self.args[i]));
+            let rest = self.sim(c, next, s, path)?;
+            let p = app(c.at(self.hyps[i]), ma[1]);
+            return Ok(trans(c, self.r, (mw, next, s), p, rest));
+        }
+        // a stuck read of the heap at a cell the statement fixes: rewrite by the cell's hypothesis, then go on
+        if mh == c.at(self.h) && ma.len() == 2 {
+            let Some(k) = (0..self.g.cells.len()).find(|k| def_eq(&ma[0], &self.g.cell_addr(*k, &self.arg_exprs(c)))) else {
+                return Err(format!("{path}: reads a heap address that no cell fixes"));
+            };
+            let next = app(ma[1], c.at(self.cvs[k]));
+            let rest = self.sim(c, next, s, path)?;
+            let p = app(c.at(self.cell_hyps[k]), ma[1]);
+            return Ok(trans(c, self.r, (mw, next, s), p, rest));
+        }
+        if mh == c.at(self.km) {
+            if sh != c.at(self.ks) {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if ma.len() != 2 || sa.len() != 1 || !def_eq(&ma[0], &sa[0]) {
+                return Err(format!("{path}: both return, with different values"));
+            }
+            let Some((loc2, hp2, h2)) = Self::parts(&ma[1]) else {
+                return Err(format!("{path}: returns in a state that is not a triple"));
+            };
+            let mut all = vec![ma[0], loc2, hp2, h2];
+            if self.g.framed {
+                // the caller's continuation may use the allocation pointer and the cells' invariant: the walk must show them
+                all.push(self.good_of(c, &hp2).map_err(|e| format!("{path}: at the return: {e}"))?);
+                let (ae, ce) = (self.arg_exprs(c), self.cv_exprs(c));
+                all.extend(self.cells_at(c, &h2, &ae, &ce).map_err(|e| format!("{path}: at the return: {e}"))?);
+            }
+            return Ok(apps(c.at(self.rel), all));
+        }
+        // a call of the closure callee: the closure relation, a hypothesis, discharges it
+        if self.fnv.is_some_and(|f| mh == c.at(f)) {
+            if !self.clov.is_some_and(|f| sh == c.at(f)) {
+                return Err(format!("{path}: the machine calls a closure but the source {sk}"));
+            }
+            return self.call_closure(c, &ma, &sa, path);
+        }
+        // a store's address test (`eq_bit s t`) in the machine alone: decide it, take the branch it picks, go on
+        if mh == c.at(self.ch) && ma.len() == 4 {
+            let (wh, wa) = spine(&ma[1]);
+            if wa.len() == 2 && def_eq(&wh, &eq_bit(n)) {
+                let (same, pe) = self.decide(c, &wa[0], &wa[1]).map_err(|e| format!("{path}: {e}"))?;
+                let pick = self.ch_by(c, same, (wa[0], wa[1]), ma[2], ma[3], pe);
+                let next = if same { ma[2] } else { ma[3] };
+                let rest = self.sim(c, next, s, path)?;
+                return Ok(trans(c, self.r, (mw, next, s), pick, rest));
+            }
+        }
+        if mh == c.at(self.ch) {
+            if sh != c.at(self.ch) || ma.len() != 4 || sa.len() != 4 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if !def_eq(&ma[1], &sa[1]) {
+                return Err(format!("{path}: the branch conditions differ"));
+            }
+            let pt = self.sim(c, ma[2], sa[2], &format!("{path}/then"))?;
+            let pe = self.sim(c, ma[3], sa[3], &format!("{path}/else"))?;
+            let cd = c.mark(ma[1]);
+            return Ok(cong(c, self.r, self.ch, cd, (ma[2], sa[2], pt), (ma[3], sa[3], pe)));
+        }
+        if mh == c.at(self.j) {
+            let (m_args, nsrc) = (self.g.m, self.g.nsrc());
+            if sh != c.at(self.j) || ma.len() != 5 || sa.len() != 3 + nsrc + 1 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            let Some((loc2, hp2, h2)) = Self::parts(&ma[3]) else {
+                return Err(format!("{path}: the state at the recursion is not a triple"));
+            };
+            let (k2, ks2) = (ma[4], sa[sa.len() - 1]);
+            let src_args = &sa[3..3 + nsrc];
+            // each machine parameter's next value: the source's argument (the slot must hold it, or be untouched with the
+            // source's argument the parameter itself), or for a pointer the machine's own, read off the new frame
+            let mut next_args: Vec<Expr> = vec![];
+            let mut untouched = vec![false; m_args];
+            let mut si = 0;
+            for i in 0..m_args {
+                if self.g.ptrs.contains(&i) {
+                    let (same, val) = c.under(|c, _| {
+                        let got = whnf(&app2(shift(&loc2, 0, 1), lit(n, i as u128), var(0)));
+                        let same = def_eq(&got, &app2(c.at(self.loc), lit(n, i as u128), var(0)));
+                        let (hd, va) = spine(&got);
+                        let val = if hd == var(0) && va.len() == 1 { Some(shift(&va[0], 0, -1)) } else { None };
+                        (same, val)
+                    });
+                    if same {
+                        next_args.push(c.at(self.args[i]));
+                        untouched[i] = true;
+                    } else if let Some(v) = val {
+                        next_args.push(v);
+                    } else {
+                        return Err(format!("{path}: at the recursion, pointer local {i} is not a plain store"));
+                    }
+                    continue;
+                }
+                let a = &src_args[si];
+                si += 1;
+                let (ok, same) = c.under(|c, _| {
+                    let (kv, l2) = (var(0), shift(&loc2, 0, 1));
+                    let got = app2(l2.clone(), lit(n, i as u128), kv.clone());
+                    let held = def_eq(&got, &app(kv.clone(), shift(a, 0, 1)));
+                    let same = def_eq(&got, &app2(c.at(self.loc), lit(n, i as u128), kv)) && def_eq(&shift(a, 0, 1), &c.at(self.args[i]));
+                    (held, same)
+                });
+                if !ok && !same {
+                    return Err(format!("{path}: at the recursion, local {i} does not hold the source's argument {si}"));
+                }
+                untouched[i] = !ok;
+                next_args.push(*a);
+            }
+            let cv_next: Vec<Expr> = src_args[si..].to_vec();
+            // the cells at the recursion: each must hold the value the source passes, in the heap the machine passes
+            let na: Vec<At> = next_args.iter().map(|a| c.mark(*a)).collect();
+            let cn: Vec<At> = cv_next.iter().map(|a| c.mark(*a)).collect();
+            let cell_proofs = {
+                let ne: Vec<Expr> = na.iter().map(|a| c.at(*a)).collect();
+                self.cells_at(c, &h2, &ne, &cv_next).map_err(|e| format!("{path}: at the recursion: {e}"))?
+            };
+            let ghp_next = if self.ghp.is_some() { Some(self.good_of(c, &hp2)?) } else { None };
+            // each pointer's next value must be good too
+            let mut gp_next: Vec<Expr> = vec![];
+            if self.ghp.is_some() {
+                for (pi, _) in &self.gptrs {
+                    gp_next.push(self.good_of(c, &c.at(na[*pi]))?);
+                }
+            }
+            // the continuation relation, from walking the two continuations under their binders
+            let (k2m, ks2m) = (c.mark(k2), c.mark(ks2));
+            let failed: RefCell<Option<String>> = RefCell::new(None);
+            let w = self.g.w;
+            let rel2 = c.lam(self.g.v(), |c, a| {
+                let hl = w.heap(c, self.r);
+                c.lam(hl, |c, loc| {
+                    c.lam(self.g.v(), |c, hp| {
+                        let hh = w.heap(c, self.r);
+                        c.lam(hh, |c, h| {
+                            let walk = |c: &mut Cx| {
+                                let mu = w.mkmu(c, self.r, c.at(loc), c.at(hp), c.at(h));
+                                let (l, r) = (app2(c.at(k2m), c.at(a), mu), app(c.at(ks2m), c.at(a)));
+                                match self.sim(c, l, r, &format!("{path}/after")) {
+                                    Ok(p) => p,
+                                    Err(e) => {
+                                        failed.borrow_mut().get_or_insert(e);
+                                        refl(l)
+                                    }
+                                }
+                            };
+                            if !self.g.framed {
+                                return walk(c);
+                            }
+                            // framed: the continuation relation holds for returns with a good `hp` and the cells' invariant
+                            let gty = app(good_bv(self.g.n), c.at(hp));
+                            c.lam(gty, |c, gn| {
+                                self.gfacts.borrow_mut().push((hp, gn));
+                                let res = self.under_cells(c, h, &na, &cn, 0, &walk);
+                                self.gfacts.borrow_mut().pop();
+                                res
+                            })
+                        })
+                    })
+                })
+            });
+            if let Some(e) = failed.into_inner() {
+                return Err(e);
+            }
+            let slots: Vec<Expr> = (0..m_args)
+                .map(|i| {
+                    let a = na[i];
+                    c.lam(arrow(self.g.v(), c.at(self.r)), |c, kk| {
+                        if untouched[i] { app(c.at(self.hyps[i]), c.at(kk)) } else { refl(app(c.at(kk), c.at(a))) }
+                    })
+                })
+                .collect();
+            let mut all = vec![c.at(self.d)];
+            all.extend(na.iter().map(|a| c.at(*a)));
+            all.extend(cn.iter().map(|a| c.at(*a)));
+            all.extend([loc2, hp2, h2, k2, ks2, rel2]);
+            all.extend(slots);
+            all.extend(cell_proofs);
+            all.extend(ghp_next);
+            all.extend(gp_next);
+            return Ok(apps(c.at(self.ih), all));
+        }
+        Err(format!("{path}: the machine {mk} but the source {sk}"))
+    }
+}
