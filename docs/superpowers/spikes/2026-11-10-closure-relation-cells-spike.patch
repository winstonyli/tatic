+pub(crate) fn sim_body(store: &TermStore, h: Hash, m: usize) -> Result<Hash, String> {
+    let mut body = match store.resolve(h) {
+        Term::Rec(inner) => *inner,
+        _ => h,
+    };
+    for _ in 0..m {
+        match store.resolve(body) {
+            Term::Abs(b) => body = *b,
+            other => return Err(format!("fewer than {m} leading lambdas: {other:?}")),
+        }
+    }
+    fn walk(store: &TermStore, h: Hash, m: usize) -> Result<(), String> {
+        match store.resolve(h) {
+            Term::Lit(_) => Ok(()),
+            Term::Var(i) if (*i as usize) < m => Ok(()),
+            Term::Var(i) => Err(format!("free variable {i}")),
+            Term::Prim(p, a, b) => match op_of(*p) {
+                Some(o) if o.kind() == K::W => walk(store, *a, m).and(walk(store, *b, m)),
+                _ => Err(format!("operator {p:?} has no word row")),
+            },
+            Term::If(c, t, e) => match store.resolve(*c) {
+                Term::Prim(p, a, b) if is_comparison(*p) => walk(store, *a, m).and(walk(store, *b, m)).and(walk(store, *t, m)).and(walk(store, *e, m)),
+                other => Err(format!("an If on {other:?}, not a comparison")),
+            },
+            Term::App(..) => {
+                let (mut args, mut cur) = (vec![], h);
+                while let Term::App(f, a) = store.resolve(cur) {
+                    args.push(*a);
+                    cur = *f;
+                }
+                match store.resolve(cur) {
+                    Term::Var(i) if *i as usize == m && args.len() == m => args.iter().try_for_each(|a| walk(store, *a, m)),
+                    other => Err(format!("an application of {other:?} that is not a saturated self-call")),
+                }
+            }
+            other => Err(format!("{other:?} is outside the generator's fragment")),
         }
     }
+    walk(store, body, m)?;
+    Ok(body)
 }
+
+/// `(proof, statement)` that `code` (a function of `m` parameters and `temps` temporaries, as the machine runs it) and
+/// `h` simulate each other at width `n`, from the generator (`tatic_wasm::wasm::sim::gen_sim`) over the real term.
+pub(crate) fn sim_statement(store: &TermStore, h: Hash, m: usize, code: &[Ins], temps: usize, n: usize) -> Result<(Expr, Expr), String> {
+    let body = sim_body(store, h, m)?;
+    gen_sim(Wasm { n }, code, m, temps, &|c, env, k| {
+        let src = Source { store, qs: env.params.clone(), r: env.r, n, sim: Some(env) };
