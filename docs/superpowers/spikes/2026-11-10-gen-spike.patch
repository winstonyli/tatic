+//! SPIKE (throwaway, 2026-11-10, e1): ONE generator of simulation proofs for a function body with `Loop`/`Br`/`Call`.
+//!
+//! `gen_sim(w, code, arity, temps, src)` returns `(proof, statement)` for every fuel `N` with `GoodNat N`, every `R`, `z`,
+//! arguments `x_i`, heap `h`, machine continuation `km` and source continuation `ks`:
+//!
+//! ```text
+//! (Pi a mu. km a mu = ks a) -> M_N (frame x.., h) km = S_N x.. ks
+//! ```
+//!
+//! `M_N = N H timeout Bm` runs `code` through `prog`, with `call` and the function's own top-level `loop`/`br` both
+//! going through the one environment `env : H = State -> Ret -> R`. `S_N` is the source's step unrolled by the same fuel.
+//!
+//! The proof is `GoodNat`'s induction on fuel. In the step, both sides are put in weak head normal form and walked in
+//! lockstep as kernel terms (`Sim::sim`), with no match on the instruction list or the function:
+//!   - `km a mu` against `ks a'`: the relation hypothesis;
+//!   - `CH R w t e` against `CH R w' t' e'` (`CH` is the probe standing for `choose`): J through the shared choice;
+//!   - a stuck read of a parameter's slot `loc i K`: the slot hypothesis, then on;
+//!   - the fuel variable applied to a state, a continuation (a `br` or a `call`: one rule): the induction hypothesis at
+//!     the arguments read off the source side, the state and continuation read off the machine side as built, and the
+//!     continuation relation generated by walking the two continuations under their binders.
+//! `CH` is a bound variable of the proof only: the statement uses the real `choose`, and the proof is applied to it.
+use super::*;
+use std::cell::RefCell;
+
+/// The mini source language.
+#[derive(Clone, Debug)]
+pub enum Src {
+    Param(usize),
+    Lit(u128),
+    /// A word operator on two operands.
+    Prim(Op, Box<Src>, Box<Src>),
+    /// `If(cmp, a, b, then, else)`: `cmp a b` chooses.
+    If(Op, Box<Src>, Box<Src>, Box<Src>, Box<Src>),
+    /// A call of the function itself (non-tail or tail).
+    SelfCall(Vec<Src>),
+}
+
+/// The source term in continuation-passing form: `g args k` for a self-call.
+struct SEnv {
+    n: usize,
+    r: At,
+    g: At,
+    params: Vec<At>,
+    ch: Option<At>,
+}
+
+fn sel(e: &SEnv, c: &Cx, cond: Expr, t: Expr, f: Expr) -> Expr {
+    match e.ch {
+        Some(h) => apps(c.at(h), vec![c.at(e.r), cond, t, f]),
+        None => choose(c.at(e.r), cond, t, f),
+    }
+}
+
+fn cps(e: &SEnv, c: &mut Cx, s: &Src, k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+    tatic_kernel::grow(|| match s {
+        Src::Param(i) => k(c, c.at(e.params[*i])),
+        Src::Lit(v) => k(c, lit(e.n, *v & low_bits(e.n))),
+        Src::Prim(o, a, b) => cps(e, c, a, &|c, x| {
+            let x = c.mark(x);
+            cps(e, c, b, &|c, y| k(c, app2(o.term(e.n), c.at(x), y)))
+        }),
+        Src::If(o, a, b, t, f) => cps(e, c, a, &|c, x| {
+            let x = c.mark(x);
+            cps(e, c, b, &|c, y| {
+                let cond = app2(o.term(e.n), c.at(x), y);
+                let (t2, f2) = (cps(e, c, t, k), cps(e, c, f, k));
+                sel(e, c, cond, t2, f2)
+            })
+        }),
+        Src::SelfCall(args) => call_args(e, c, args, vec![], k),
+    })
+}
+
+fn call_args(e: &SEnv, c: &mut Cx, args: &[Src], done: Vec<At>, k: &dyn Fn(&mut Cx, Expr) -> Expr) -> Expr {
+    match args.split_first() {
+        None => {
+            let kont = c.lam(bv_ty(e.n), |c, res| k(c, c.at(res)));
+            let mut xs: Vec<Expr> = done.iter().map(|a| c.at(*a)).collect();
+            xs.push(kont);
+            apps(c.at(e.g), xs)
+        }
+        Some((a, rest)) => cps(e, c, a, &|c, x| {
+            let mut d2 = done.clone();
+            d2.push(c.mark(x));
+            call_args(e, c, rest, d2, k)
+        }),
+    }
+}
+
+/// `CH : Pi R:Sort0. Bv1 -> R -> R -> R`.
+fn ch_ty() -> Expr {
+    pi(sort(0), arrow(bv_ty(1), arrow(var(0), arrow(var(0), var(0)))))
+}
+/// The real choice, `\R w x y. choose R w x y`.
+fn choose_fn() -> Expr {
+    Cx::default().lam(sort(0), |c, r| {
+        c.lam(bv_ty(1), |c, w| {
+            c.lam(c.at(r), |c, x| c.lam(c.at(r), |c, y| choose(c.at(r), c.at(w), c.at(x), c.at(y))))
+        })
+    })
+}
+
+/// `p : a = b`, `q : b = c` give `a = c`.
+fn trans(c: &mut Cx, r: At, (a, b, cc): (Expr, Expr, Expr), p: Expr, q: Expr) -> Expr {
+    let a = c.mark(a);
+    let motive = c.lam(c.at(r), |c, u| {
+        c.lam(c.at(r), |c, v| {
+            let ty = id(c.at(r), c.at(u), c.at(v));
+            c.lam(ty, |c, _| arrow(id(c.at(r), c.at(a), c.at(u)), id(c.at(r), c.at(a), c.at(v))))
+        })
+    });
+    let base = c.lam(c.at(r), |c, u| {
+        let ty = id(c.at(r), c.at(a), c.at(u));
+        c.lam(ty, |c, h| c.at(h))
+    });
+    app(jelim(motive, base, b, cc, q), p)
+}
+
+/// `Id(R, CH R w t e, CH R w t' e')` from `Id(R, t, t')` and `Id(R, e, e')`: J on each branch.
+fn cong(c: &mut Cx, r: At, ch: At, cd: At, (t, t2, pt): (Expr, Expr, Expr), (e, e2, pe): (Expr, Expr, Expr)) -> Expr {
+    let pick = |c: &Cx, x: Expr, y: Expr| apps(c.at(ch), vec![c.at(r), c.at(cd), x, y]);
+    let (e, e2, pe) = (c.mark(e), c.mark(e2), c.mark(pe));
+    let outer_m = c.lam(c.at(r), |c, a| {
+        c.lam(c.at(r), |c, b| {
+            let ty = id(c.at(r), c.at(a), c.at(b));
+            c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(e)), pick(c, c.at(b), c.at(e2))))
+        })
+    });
+    let outer_b = c.lam(c.at(r), |c, a| {
+        let inner_m = c.lam(c.at(r), |c, y| {
+            c.lam(c.at(r), |c, y2| {
+                let ty = id(c.at(r), c.at(y), c.at(y2));
+                c.lam(ty, |c, _| id(c.at(r), pick(c, c.at(a), c.at(y)), pick(c, c.at(a), c.at(y2))))
+            })
+        });
+        let inner_b = c.lam(c.at(r), |c, y| refl(pick(c, c.at(a), c.at(y))));
+        jelim(inner_m, inner_b, c.at(e), c.at(e2), c.at(pe))
+    });
+    jelim(outer_m, outer_b, t, t2, pt)
+}
+
+fn spine(e: &Expr) -> (Expr, Vec<Expr>) {
+    let (mut args, mut cur) = (vec![], *e);
+    while let tatic_kernel::Node::App(f, a) = cur.node() {
+        args.push(a);
+        cur = f;
+    }
+    args.reverse();
+    (cur, args)
+}
+
+/// The sizes the generator works at.
+#[derive(Clone, Copy)]
+struct G {
+    w: Wasm,
+    n: usize,
+    m: usize,
+}
+
+impl G {
+    fn v(&self) -> Expr {
+        self.w.v()
+    }
+    /// `Ret = V -> State -> R`.
+    fn ret_m(&self, c: &mut Cx, r: At) -> Expr {
+        let mem = self.w.mem(c, r);
+        arrow(self.v(), arrow(mem, c.at(r)))
+    }
+    /// `H = State -> Ret -> R`.
+    fn hm(&self, c: &mut Cx, r: At) -> Expr {
+        let (mem, ret) = (self.w.mem(c, r), self.ret_m(c, r));
+        arrow(mem, arrow(ret, c.at(r)))
+    }
+    fn ret_s(&self, c: &Cx, r: At) -> Expr {
+        arrow(self.v(), c.at(r))
+    }
+    /// `Hs = V^m -> (V -> R) -> R`.
+    fn hs(&self, c: &Cx, r: At) -> Expr {
+        (0..self.m).fold(arrow(self.ret_s(c, r), c.at(r)), |acc, _| arrow(self.v(), acc))
+    }
+    fn rel_ty(&self, c: &mut Cx, r: At, km: At, ks: At) -> Expr {
+        let w = self.w;
+        // over the two components of the state, not a state variable: a `sigrec` on a variable is stuck (no eta)
+        c.pi(self.v(), |c, a| {
+            let hp = w.heap(c, r);
+            c.pi(hp, |c, loc| {
+                let hp = w.heap(c, r);
+                c.pi(hp, |c, h| {
+                    let mu = w.mkmu(c, r, c.at(loc), c.at(h));
+                    id(c.at(r), app2(c.at(km), c.at(a), mu), app(c.at(ks), c.at(a)))
+                })
+            })
+        })
+    }
+    /// `Pi K. Id(R, loc i K, K a)`: slot `i` of `loc` holds `a`.
+    fn hyp_ty(&self, c: &mut Cx, r: At, loc: At, i: usize, a: At) -> Expr {
+        let n = self.n;
+        let kt = arrow(self.v(), c.at(r));
+        c.pi(kt, |c, kk| id(c.at(r), app2(c.at(loc), lit(n, i as u128), c.at(kk)), app(c.at(kk), c.at(a))))
+    }
+    /// The parameters at slots `0..m` over locals that are all 0.
+    fn frame(&self, c: &mut Cx, r: At, args: &[At]) -> Expr {
+        let blank = self.w.zero_heap(c, r);
+        args.iter().enumerate().rev().fold(blank, |acc, (i, a)| self.w.upd(c, r, lit(self.n, i as u128), c.at(*a), acc))
+    }
+    fn tm(&self, c: &mut Cx, r: At, z: At) -> Expr {
+        let w = self.w;
+        let mem = w.mem(c, r);
+        c.lam(mem, |c, _| {
+            let ret = self.ret_m(c, r);
+            c.lam(ret, |c, _| c.at(z))
+        })
+    }
+    fn ts(&self, c: &mut Cx, r: At, z: At) -> Expr {
+        let tys: Vec<Ty> = (0..self.m).map(|_| ty!(|_c, _x| bv_ty(64))).collect();
+        let _ = tys;
+        let n = self.n;
+        let args: Vec<Ty> = (0..self.m).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+        tele(c, &args, &mut vec![], &lam, &mut |c, _| {
+            let rs = self.ret_s(c, r);
+            c.lam(rs, |c, _| c.at(z))
+        })
+    }
+    /// `Bm = \env mu k. M_env (prog code) 0 mu`, the body's answer passed to `k`.
+    fn bm(&self, c: &mut Cx, r: At, z: At, ch: Option<At>, code: &[Ins]) -> Expr {
+        let (w, n) = (self.w, self.n);
+        let hm = self.hm(c, r);
+        c.lam(hm, |c, env| {
+            let mem = w.mem(c, r);
+            c.lam(mem, |c, mu| {
+                let rm = self.ret_m(c, r);
+                c.lam(rm, |c, k| {
+                    let base = c.mark(w.v());
+                    let p = w.prog(c, code, &[], base);
+                    let p = c.mark(p);
+                    let fuel0 = c.mark(nat2_lit(0));
+                    let st_ty = prod(w.v(), c.at(base));
+                    let kk = c.lam(st_ty, |c, st| {
+                        let mem = w.mem(c, r);
+                        c.lam(mem, |c, mu2| w.split(c, r, w.v(), base, st, |c, y, _| app2(c.at(k), c.at(y), c.at(mu2))))
+                    });
+                    let kk = c.mark(kk);
+                    let restart = {
+                        let mem = w.mem(c, r);
+                        c.lam(mem, |c, m2| app2(c.at(env), c.at(m2), c.at(k)))
+                    };
+                    let restart = c.mark(restart);
+                    let hooks = Hooks { env: Some(env), lab: Some(restart), ch };
+                    let m = w.meaning_with(c, p, fuel0, r, kk, z, &hooks);
+                    app2(m, lit(n, 0), c.at(mu))
+                })
+            })
+        })
+    }
+    /// `Bs = \g x.. ks. cps src`.
+    fn bs(&self, c: &mut Cx, r: At, ch: Option<At>, src: &Src) -> Expr {
+        let n = self.n;
+        let hs = self.hs(c, r);
+        c.lam(hs, |c, g| {
+            let vs: Vec<Ty> = (0..self.m).map(|_| ty!(|_c, _x| bv_ty(n))).collect();
+            tele(c, &vs, &mut vec![], &lam, &mut |c, xs| {
+                let rs = self.ret_s(c, r);
+                c.lam(rs, |c, ks| {
+                    let env = SEnv { n, r, g, params: xs.to_vec(), ch };
+                    cps(&env, c, src, &|c, v| app(c.at(ks), v))
+                })
+            })
+        })
+    }
+    /// The binders of the induction's motive, step and hypothesis applications, after the dummy numeral that lifts the
+    /// motive to Sort3: `d, a_0..a_{m-1}, loc, h, km, ks, rel, slot_0..slot_{m-1}`.
+    fn binders(&self, c: &mut Cx, r: At, wrap: &dyn Fn(Expr, Expr) -> Expr, body: &mut dyn FnMut(&mut Cx, &[At]) -> Expr) -> Expr {
+        let (g, n, m) = (self, self.n, self.m);
+        let mut tys: Vec<Ty> = vec![ty!(|_c, _x| nat2())];
+        tys.extend((0..m).map(|_| ty!(|_c, _x| bv_ty(n))));
+        tys.push(ty!(|c, _x| g.w.heap(c, r)));
+        tys.push(ty!(|c, _x| g.w.heap(c, r)));
+        tys.push(ty!(|c, _x| g.ret_m(c, r)));
+        tys.push(ty!(|c, _x| g.ret_s(c, r)));
+        tys.push(ty!(|c, x| g.rel_ty(c, r, x[m + 3], x[m + 4])));
+        for i in 0..m {
+            tys.push(ty!(|c, x| g.hyp_ty(c, r, x[m + 1], i, x[1 + i])));
+        }
+        tele(c, &tys, &mut vec![], wrap, body)
+    }
+}
+
+/// What `gen_sim` checks of the code before generating anything.
+fn check_code(code: &[Ins], arity: usize, temps: usize) -> Result<(), String> {
+    fn walk(code: &[Ins], locals: usize, top: bool) -> Result<(), String> {
+        for ins in code {
+            match ins {
+                Ins::Loop(b) if top && code.len() == 1 => walk(b, locals, false)?,
+                Ins::Loop(_) => return Err("a loop other than the function's one top-level loop".into()),
+                Ins::If(t, e) => {
+                    walk(t, locals, false)?;
+                    walk(e, locals, false)?
+                }
+                Ins::LocalGet(i) | Ins::LocalSet(i) if *i as usize >= locals => return Err(format!("local {i} out of range")),
+                Ins::Raw(s) => return Err(format!("raw line {s:?}")),
+                Ins::Store | Ins::Load | Ins::Dup => return Err(format!("{ins:?}: the heap is not modelled here")),
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+    walk(code, arity + temps, true)?;
+    match shape(code, vec![], &[]) {
+        Ok(Some(s)) if s == vec![K::W] => Ok(()),
+        other => Err(format!("the body does not run from [] to [word]: {other:?}")),
+    }
+}
+
+/// `(proof, statement)` for `code` (a function of `arity` parameters and `temps` temporaries) against `src`, or why the
+/// two do not simulate each other. The kernel is the judge either way: an `Err` is only an early, readable reason.
+pub fn gen_sim(w: Wasm, code: &[Ins], arity: usize, temps: usize, src: &Src) -> Result<(Expr, Expr), String> {
+    check_code(code, arity, temps)?;
+    let g = G { w, n: w.n, m: arity };
+    let m = arity;
+    // N gn R z x_0..x_{m-1} h km ks rel
+    let mut tys: Vec<Ty> = vec![
+        ty!(|_c, _x| nat2()),
+        ty!(|c, x| w.good_nat(c, x[0])),
+        ty!(|_c, _x| sort(0)),
+        ty!(|c, x| c.at(x[2])),
+    ];
+    tys.extend((0..m).map(|_| ty!(|_c, _x| bv_ty(w.n))));
+    tys.push(ty!(|c, x| w.heap(c, x[2])));
+    tys.push(ty!(|c, x| g.ret_m(c, x[2])));
+    tys.push(ty!(|c, x| g.ret_s(c, x[2])));
+    tys.push(ty!(|c, x| g.rel_ty(c, x[2], x[5 + m], x[6 + m])));
+
+    let stmt = tele(&mut Cx::default(), &tys, &mut vec![], &pi, &mut |c, x| {
+        let (fuel, r, z) = (x[0], x[2], x[3]);
+        let args: Vec<At> = x[4..4 + m].to_vec();
+        let (h, km, ks) = (x[4 + m], x[5 + m], x[6 + m]);
+        let (hm, hs) = (g.hm(c, r), g.hs(c, r));
+        let (tm, bm) = (g.tm(c, r, z), g.bm(c, r, z, None, code));
+        let (ts, bs) = (g.ts(c, r, z), g.bs(c, r, None, src));
+        let fr = g.frame(c, r, &args);
+        let mu = w.mkmu(c, r, fr, c.at(h));
+        let l = app2(apps(c.at(fuel), vec![hm, tm, bm]), mu, c.at(km));
+        let rhs = apps(c.at(fuel), [vec![hs, ts, bs], args.iter().map(|a| c.at(*a)).collect(), vec![c.at(ks)]].concat());
+        id(c.at(r), l, rhs)
+    });
+
+    let err: RefCell<Option<String>> = RefCell::new(None);
+    let proof = Cx::default().lam(ch_ty(), |c, ch| {
+        tele(c, &tys, &mut vec![], &lam, &mut |c, x| {
+            let (fuel, gn, r, z) = (x[0], x[1], x[2], x[3]);
+            let args: Vec<At> = x[4..4 + m].to_vec();
+            let (h, km, ks, rel) = (x[4 + m], x[5 + m], x[6 + m], x[7 + m]);
+            let _ = fuel;
+            let (hm0, hs0) = (g.hm(c, r), g.hs(c, r));
+            let (hm, hs) = (c.mark(hm0), c.mark(hs0));
+            let (tm0, bm0) = (g.tm(c, r, z), g.bm(c, r, z, Some(ch), code));
+            let (tm, bm) = (c.mark(tm0), c.mark(bm0));
+            let (ts0, bs0) = (g.ts(c, r, z), g.bs(c, r, Some(ch), src));
+            let (ts, bs) = (c.mark(ts0), c.mark(bs0));
+            // the motive at a fuel: the binders, then the two sides
+            let mot = |c: &mut Cx, mm: Expr| {
+                let mm = c.mark(mm);
+                g.binders(c, r, &pi, &mut |c, y| {
+                    let (ya, loc, hp, kmm, kss) = (&y[1..1 + m], y[1 + m], y[2 + m], y[3 + m], y[4 + m]);
+                    let mu = w.mkmu(c, r, c.at(loc), c.at(hp));
+                    let l = app2(apps(c.at(mm), vec![c.at(hm), c.at(tm), c.at(bm)]), mu, c.at(kmm));
+                    let rhs = apps(
+                        c.at(mm),
+                        [vec![c.at(hs), c.at(ts), c.at(bs)], ya.iter().map(|a| c.at(*a)).collect(), vec![c.at(kss)]].concat(),
+                    );
+                    id(c.at(r), l, rhs)
+                })
+            };
+            let motive = c.lam(nat2(), |c, mm| mot(c, c.at(mm)));
+            let hz = g.binders(c, r, &lam, &mut |c, _| refl(c.at(z)));
+            let step = c.lam(nat2(), |c, j| {
+                let ih_ty = mot(c, c.at(j));
+                c.lam(ih_ty, |c, ih| {
+                    g.binders(c, r, &lam, &mut |c, y| {
+                        let sim = Sim {
+                            g: &g,
+                            r,
+                            ch,
+                            j,
+                            ih,
+                            d: y[0],
+                            loc: y[1 + m],
+                            km: y[3 + m],
+                            ks: y[4 + m],
+                            rel: y[5 + m],
+                            args: y[1..1 + m].to_vec(),
+                            hyps: y[6 + m..6 + 2 * m].to_vec(),
+                        };
+                        let mu = w.mkmu(c, r, c.at(y[1 + m]), c.at(y[2 + m]));
+                        let mj = apps(c.at(j), vec![c.at(hm), c.at(tm), c.at(bm)]);
+                        let sj = apps(c.at(j), vec![c.at(hs), c.at(ts), c.at(bs)]);
+                        let m0 = apps(c.at(bm), vec![mj, mu, c.at(y[3 + m])]);
+                        let s0 = apps(c.at(bs), [vec![sj], sim.args.iter().map(|a| c.at(*a)).collect(), vec![c.at(y[4 + m])]].concat());
+                        match sim.sim(c, m0, s0, "body") {
+                            Ok(p) => p,
+                            Err(e) => {
+                                err.borrow_mut().get_or_insert(e);
+                                refl(m0)
+                            }
+                        }
+                    })
+                })
+            });
+            let fr = g.frame(c, r, &args);
+            let slots: Vec<Expr> = (0..m)
+                .map(|i| {
+                    let a = args[i];
+                    c.lam(arrow(w.v(), c.at(r)), |c, kk| refl(app(c.at(kk), c.at(a))))
+                })
+                .collect();
+            let mut all = vec![motive, hz, step, nat2_lit(0)];
+            all.extend(args.iter().map(|a| c.at(*a)));
+            all.extend([fr, c.at(h), c.at(km), c.at(ks), c.at(rel)]);
+            all.extend(slots);
+            apps(c.at(gn), all)
+        })
+    });
+    if let Some(e) = err.into_inner() {
+        return Err(e);
+    }
+    Ok((app(proof, choose_fn()), stmt))
+}
+
+/// One walk's fixed names.
+struct Sim<'g> {
+    g: &'g G,
+    r: At,
+    ch: At,
+    j: At,
+    ih: At,
+    d: At,
+    loc: At,
+    km: At,
+    ks: At,
+    rel: At,
+    args: Vec<At>,
+    hyps: Vec<At>,
+}
+
+impl Sim<'_> {
+    /// What a term in weak head normal form is doing, for the reasons.
+    fn kind(&self, c: &Cx, head: &Expr) -> &'static str {
+        if *head == c.at(self.km) || *head == c.at(self.ks) {
+            "returns"
+        } else if *head == c.at(self.ch) {
+            "branches"
+        } else if *head == c.at(self.j) {
+            "recurses"
+        } else if *head == c.at(self.loc) {
+            "reads a local"
+        } else {
+            "is stuck"
+        }
+    }
+
+    /// A proof of `Id(R, m, s)`.
+    fn sim(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        tatic_kernel::grow(|| self.sim_step(c, m, s, path))
+    }
+
+    fn sim_step(&self, c: &mut Cx, m: Expr, s: Expr, path: &str) -> Result<Expr, String> {
+        let n = self.g.n;
+        let (mw, sw) = (whnf(&m), whnf(&s));
+        let ((mh, ma), (sh, sa)) = (spine(&mw), spine(&sw));
+        let (mk, sk) = (self.kind(c, &mh), self.kind(c, &sh));
+
+        // a stuck read of a parameter's slot: rewrite by the slot hypothesis, then go on
+        if mh == c.at(self.loc) && ma.len() == 2 {
+            let Some(i) = (0..self.g.m).find(|i| def_eq(&ma[0], &lit(n, *i as u128))) else {
+                return Err(format!("{path}: reads a local that no parameter or earlier write fixes"));
+            };
+            let next = app(ma[1], c.at(self.args[i]));
+            let rest = self.sim(c, next, s, path)?;
+            let p = app(c.at(self.hyps[i]), ma[1]);
+            return Ok(trans(c, self.r, (mw, next, s), p, rest));
+        }
+        if mh == c.at(self.km) {
+            if sh != c.at(self.ks) {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if ma.len() != 2 || sa.len() != 1 || !def_eq(&ma[0], &sa[0]) {
+                return Err(format!("{path}: both return, with different values"));
+            }
+            let tatic_kernel::Node::Pair(_, loc2, h2) = ma[1].node() else {
+                return Err(format!("{path}: returns in a state that is not a pair"));
+            };
+            return Ok(apps(c.at(self.rel), vec![ma[0], loc2, h2]));
+        }
+        if mh == c.at(self.ch) {
+            if sh != c.at(self.ch) || ma.len() != 4 || sa.len() != 4 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            if !def_eq(&ma[1], &sa[1]) {
+                return Err(format!("{path}: the branch conditions differ"));
+            }
+            let pt = self.sim(c, ma[2], sa[2], &format!("{path}/then"))?;
+            let pe = self.sim(c, ma[3], sa[3], &format!("{path}/else"))?;
+            let cd = c.mark(ma[1]);
+            return Ok(cong(c, self.r, self.ch, cd, (ma[2], sa[2], pt), (ma[3], sa[3], pe)));
+        }
+        if mh == c.at(self.j) {
+            let m_args = self.g.m;
+            if sh != c.at(self.j) || ma.len() != 5 || sa.len() != 3 + m_args + 1 {
+                return Err(format!("{path}: the machine {mk} but the source {sk}"));
+            }
+            let tatic_kernel::Node::Pair(_, loc2, h2) = ma[3].node() else {
+                return Err(format!("{path}: the state at the recursion is not a pair"));
+            };
+            let (k2, ks2) = (ma[4], sa[sa.len() - 1]);
+            let src_args = &sa[3..3 + m_args];
+            // each parameter's slot must hold the source's argument
+            // (or be untouched, and the source's argument be the parameter itself)
+            let mut untouched = vec![false; src_args.len()];
+            for (i, a) in src_args.iter().enumerate() {
+                let (ok, same) = c.under(|c, _| {
+                    let (kv, l2) = (var(0), shift(&loc2, 0, 1));
+                    let got = app2(l2.clone(), lit(n, i as u128), kv.clone());
+                    let held = def_eq(&got, &app(kv.clone(), shift(a, 0, 1)));
+                    let same = def_eq(&got, &app2(c.at(self.loc), lit(n, i as u128), kv)) && def_eq(&shift(a, 0, 1), &c.at(self.args[i]));
+                    (held, same)
+                });
+                if !ok && !same {
+                    return Err(format!("{path}: at the recursion, local {i} does not hold the source's argument {i}"));
+                }
+                untouched[i] = !ok;
+            }
+            // the continuation relation, from walking the two continuations under their binders
+            let (k2m, ks2m) = (c.mark(k2), c.mark(ks2));
+            let failed: RefCell<Option<String>> = RefCell::new(None);
+            let w = self.g.w;
+            let rel2 = c.lam(self.g.v(), |c, a| {
+                let hp = w.heap(c, self.r);
+                c.lam(hp, |c, loc| {
+                    let hp = w.heap(c, self.r);
+                    c.lam(hp, |c, h| {
+                        let mu = w.mkmu(c, self.r, c.at(loc), c.at(h));
+                        let (l, r) = (app2(c.at(k2m), c.at(a), mu), app(c.at(ks2m), c.at(a)));
+                        match self.sim(c, l, r, &format!("{path}/after")) {
+                            Ok(p) => p,
+                            Err(e) => {
+                                failed.borrow_mut().get_or_insert(e);
+                                refl(l)
+                            }
+                        }
+                    })
+                })
+            });
+            if let Some(e) = failed.into_inner() {
+                return Err(e);
+            }
+            let slots: Vec<Expr> = src_args
+                .iter()
+                .enumerate()
+                .map(|(i, a)| {
+                    let a = c.mark(*a);
+                    c.lam(arrow(self.g.v(), c.at(self.r)), |c, kk| {
+                        if untouched[i] { app(c.at(self.hyps[i]), c.at(kk)) } else { refl(app(c.at(kk), c.at(a))) }
+                    })
+                })
+                .collect();
+            let mut all = vec![c.at(self.d)];
+            all.extend(src_args.iter().copied());
+            all.extend([loc2, h2, k2, ks2, rel2]);
+            all.extend(slots);
+            return Ok(apps(c.at(self.ih), all));
+        }
+        Err(format!("{path}: the machine {mk} but the source {sk}"))
+    }
+}
