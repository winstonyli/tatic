+#[test]
+pub fn region_spike() {
+    for n in [4usize, 24, 64] {
+        tatic_kernel::scoped(|| {
+            let timed = |name: &str, build: &dyn Fn() -> (Expr, Expr)| {
+                let t0 = Instant::now();
+                let (p, s) = build();
+                let tb = t0.elapsed();
+                let t1 = Instant::now();
+                ck(&format!("{name} n={n}"), &p, &s);
+                println!("REGION n={n} {name}: build {:?}, check {:?}", tb, t1.elapsed());
+            };
+            let rejected = |name: &str, build: &dyn Fn() -> (Expr, Expr)| {
+                let (p, s) = build();
+                let sort_of = infer(&Ctx::new(), &s).map(|t| whnf(&t));
+                assert!(matches!(sort_of.as_ref().map(|t| t.node()), Ok(tatic_kernel::Node::Sort(_))), "{name}: statement is not a type: {sort_of:?}");
+                let t0 = Instant::now();
+                let e = holds(&p, &s).expect_err(&format!("{name} must be rejected at n={n}"));
+                println!("REGION n={n} rejected {name}: {:?} ({})", t0.elapsed(), e.chars().take(100).collect::<String>());
+            };
+            timed("S1 lemma", &region_s1);
+            timed("S2 lemma", &region_s2);
+            timed("d1 eq (p+j) p = eq j 0", &|| region_law(n, Rg::Ok));
+            rejected("d1 against eq (p+j) p = false", &|| region_law(n, Rg::FalseRhs));
+            rejected("d1 against sub for add", &|| region_law(n, Rg::SubStmt));
+            rejected("d1 against eq (p+j) j = eq j 0", &|| region_law(n, Rg::SwapStmt));
+            rejected("d1 refl", &|| region_law(n, Rg::Refl));
+            rejected("d1 chain with a stale carry invariant", &|| region_law(n, Rg::StaleCarry));
+            timed("d3 eq (x+2) x = false, split bits 0,1", &|| eq_lit2_lemma(n, &[0, 1]));
+            rejected("d3 split bit 0 only", &|| eq_lit2_lemma(n, &[0]));
+            rejected("d3 split bit 1 only", &|| eq_lit2_lemma(n, &[1]));
+            timed("d3 from the region lemma", &|| eq_lit2_from_region(n));
+            timed("frame law, callee writes y + 2, k=2 lemma", &|| frame_law_k(Wasm { n }, Fr::Ok, 2, eq_lit2_lemma(n, &[0, 1]).0));
+            timed("frame law, callee writes y + 2, region lemma", &|| frame_law_k(Wasm { n }, Fr::Ok, 2, eq_lit2_from_region(n).0));
+            rejected("frame law, k=2, callee writes x", &|| frame_law_k(Wasm { n }, Fr::CalleeHitsX, 2, eq_lit2_lemma(n, &[0, 1]).0));
+            rejected("frame law, k=2, caller reads x + 2 (the callee cell)", &|| frame_law_k(Wasm { n }, Fr::ReadsX1, 2, eq_lit2_lemma(n, &[0, 1]).0));
+            rejected("frame law, k=2 callee, k=1 lemma", &|| frame_law_k(Wasm { n }, Fr::Ok, 2, eq_succ_lemma(n).0));
+            cancel_checks_n(n);
+        })
+    }
+}
