+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Rg {
+    Ok,
+    /// stated as `eq (p + j) p = false`
+    FalseRhs,
+    /// `sub` for `add`
+    SubStmt,
+    /// `eq (p + j) j`
+    SwapStmt,
+    /// `refl`
+    Refl,
+    /// the carry invariant not carried: `refl false` for `and B c = false` at every step
+    StaleCarry,
+}
+
+/// `Pi p j. GoodBv p -> GoodBv j -> Id(Bool0, eq (p + j) p, eq j 0)`: both vectors opened by `GoodBv` at the Leibniz motive,
+/// the bit chain `region_chain` inside.
+pub fn region_law(n: usize, ctl: Rg) -> (Expr, Expr) {
+    let add = Op::Add.term(n);
+    let (s1, s2) = (region_s1().0, region_s2().0);
+    let tys: Vec<Ty> = vec![
+        ty!(|_c, _x| bv_ty(n)),
+        ty!(|_c, _x| bv_ty(n)),
+        ty!(|c, x| app(good_bv(n), c.at(x[0]))),
+        ty!(|c, x| app(good_bv(n), c.at(x[1]))),
+    ];
+    let lhs = move |x: Expr, y: Expr| app2(eq_bv(n), app2(add, x, y), x);
+    let rhs = move |y: Expr| app2(eq_bv(n), y, lit(n, 0));
+    let qty = arrow(bool0(), sort(1));
+    law(&tys, |c, xs| {
+        let (j, gp, gj) = (xs[1], xs[2], xs[3]);
+        let stmt = match ctl {
+            Rg::FalseRhs => id(bool0(), lhs(c.at(xs[0]), c.at(j)), f()),
+            Rg::SubStmt => id(bool0(), app2(eq_bv(n), app2(Op::Sub.term(n), c.at(xs[0]), c.at(j)), c.at(xs[0])), rhs(c.at(j))),
+            Rg::SwapStmt => id(bool0(), app2(eq_bv(n), app2(add, c.at(xs[0]), c.at(j)), c.at(j)), rhs(c.at(j))),
+            _ => id(bool0(), lhs(c.at(xs[0]), c.at(j)), rhs(c.at(j))),
+        };
+        if ctl == Rg::Refl {
+            return (refl(rhs(c.at(j))), stmt);
+        }
+        let motive_p = c.lam(bv_ty(n), |c, x| {
+            c.pi(qty, |c, q| arrow(app(c.at(q), rhs(c.at(j))), app(c.at(q), lhs(c.at(x), c.at(j)))))
+        });
+        let step_p = bind_bits(c, n, &mut vec![], &mut |c, a, ga| {
+            let mk = |c: &Cx, bits: &[At]| church_tuple(&bits.iter().map(|b| c.at(*b)).collect::<Vec<_>>());
+            let motive_j = c.lam(bv_ty(n), |c, y| {
+                c.pi(qty, |c, q| arrow(app(c.at(q), rhs(c.at(y))), app(c.at(q), lhs(mk(c, a), c.at(y)))))
+            });
+            let step_j = bind_bits(c, n, &mut vec![], &mut |c, b, gb| {
+                let pf = region_chain(c, a, ga, b, gb, s1, s2, ctl == Rg::StaleCarry);
+                let (l, r) = (lhs(mk(c, a), mk(c, b)), rhs(mk(c, b)));
+                leibniz(c, pf, l, r)
+            });
+            app2(c.at(gj), motive_j, step_j)
+        });
+        let body = app2(c.at(gp), motive_p, step_p);
+        let qid = lam(bool0(), id(bool0(), var(0), shift(&rhs(c.at(j)), 0, 1)));
+        (apps(body, vec![qid, refl(rhs(c.at(j)))]), stmt)
+    })
+}
