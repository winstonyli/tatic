+// ---- SPIKE d1/d3: the region lemma `eq (p + j) p = eq j 0` for symbolic p, j, and the literal offset 2.
+
+/// Closed `Pi v_0..v_(k-1). GoodBool v_0 -> .. -> GoodBool v_(k-1) -> body(v)`, by a nested bit split on every variable;
+/// each of the `2^k` leaves is `refl` of the literal `val(bits)` that both sides of `body` (an `Id` over `Bool0`) reach.
+fn lemma_k(k: usize, body: &dyn Fn(&[Expr]) -> Expr, val: &dyn Fn(&[bool]) -> bool) -> (Expr, Expr) {
+    let mut tys: Vec<Ty> = (0..k).map(|_| ty!(|_c, _x| bool0())).collect();
+    for i in 0..k {
+        tys.push(ty!(|c, x| app(good_bool(), c.at(x[i]))));
+    }
+    fn split(c: &mut Cx, xs: &[At], k: usize, i: usize, vals: &mut Vec<bool>, body: &dyn Fn(&[Expr]) -> Expr,
+             val: &dyn Fn(&[bool]) -> bool) -> Expr {
+        if i == k {
+            return refl(bit(val(vals)));
+        }
+        let motive = c.lam(bool0(), |c, y| {
+            let vs: Vec<Expr> = (0..k).map(|j| if j < i { bit(vals[j]) } else if j == i { c.at(y) } else { c.at(xs[j]) }).collect();
+            body(&vs)
+        });
+        vals.push(true);
+        let bt = split(c, xs, k, i + 1, vals, body, val);
+        vals.pop();
+        vals.push(false);
+        let bf = split(c, xs, k, i + 1, vals, body, val);
+        vals.pop();
+        app3(c.at(xs[k + i]), motive, bt, bf)
+    }
+    law(&tys, |c, xs| {
+        let vs: Vec<Expr> = (0..k).map(|j| c.at(xs[j])).collect();
+        (split(c, xs, k, 0, &mut vec![], body, val), body(&vs))
+    })
+}
