+/// `Pi x. GoodBv x -> Id(Bool0, eq (x + 2) x, false)` by splitting exactly the bits in `splits` (outermost first),
+/// each leaf `refl false`.
+pub fn eq_lit2_lemma(n: usize, splits: &'static [usize]) -> (Expr, Expr) {
+    let lhs = move |y: Expr| app2(eq_bv(n), app2(Op::Add.term(n), y, lit(n, 2)), y);
+    bool_lemma(n, &lhs, f(), &mut |c, a, ga| {
+        fn go(c: &mut Cx, a: &[At], ga: &[At], n: usize, splits: &[usize], vals: &mut Vec<bool>,
+              lhs: &dyn Fn(Expr) -> Expr) -> Expr {
+            let k = vals.len();
+            if k == splits.len() {
+                return refl(f());
+            }
+            let motive = c.lam(bool0(), |c, y| {
+                let bits: Vec<Expr> = (0..n).map(|i| match splits.iter().position(|s| *s == i) {
+                    Some(p) if p < k => bit(vals[p]),
+                    Some(p) if p == k => c.at(y),
+                    _ => c.at(a[i]),
+                }).collect();
+                id(bool0(), lhs(church_tuple(&bits)), f())
+            });
+            vals.push(true);
+            let bt = go(c, a, ga, n, splits, vals, lhs);
+            vals.pop();
+            vals.push(false);
+            let bf = go(c, a, ga, n, splits, vals, lhs);
+            vals.pop();
+            app3(c.at(ga[splits[k]]), motive, bt, bf)
+        }
+        go(c, a, ga, n, splits, &mut vec![], &lhs)
+    })
+}
+
+/// `Pi x. GoodBv x -> Id(Bool0, eq (x + 2) x, false)` from the region lemma at `j = 2`: `eq 2 0` converts to `false`.
+pub fn eq_lit2_from_region(n: usize) -> (Expr, Expr) {
+    let r = region_law(n, Rg::Ok).0;
+    let tys: Vec<Ty> = vec![ty!(|_c, _x| bv_ty(n)), ty!(|c, x| app(good_bv(n), c.at(x[0])))];
+    law(&tys, |c, xs| {
+        let x = c.at(xs[0]);
+        let stmt = id(bool0(), app2(eq_bv(n), app2(Op::Add.term(n), x, lit(n, 2)), x), f());
+        (apps(r, vec![c.at(xs[0]), lit(n, 2), c.at(xs[1]), good_lit(n, 2)]), stmt)
+    })
+}
