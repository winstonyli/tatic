+/// The chain proof of `Id(Bool0, eq (mk a + mk b) (mk a), eq (mk b) 0)` over the bits, by the invariant
+/// `A_i = B_i` and `and B_i c_i = false`: `A_i`, `B_i` the prefix conjunctions of the two sides, `c_i` the carry.
+fn region_chain(c: &mut Cx, a: &[At], ga: &[At], b: &[At], gb: &[At], s1: Expr, s2: Expr, stale: bool) -> Expr {
+    let n = a.len();
+    let (g_and, _) = good2(&|x, y| and(x, y), &and_truth);
+    let (g_or, _) = good2(&|x, y| or(x, y), &or_truth);
+    let (g_xor, _) = good2(&|x, y| xor(x, y), &xor_truth);
+    let (g_and_l, _) = good_and_lemma();
+    let (g_xn, _) = good_xnor_lit(false);
+    let bb0 = bool0();
+    let (mut aa, mut bb, mut cc) = (t(), t(), f());
+    let (mut gbb, mut gcc) = (good_bit(true), good_bit(false));
+    let (mut p1, mut p2) = (refl(t()), refl(f()));
+    for i in 0..n {
+        let (ai, bi, gai, gbi) = (c.at(a[i]), c.at(b[i]), c.at(ga[i]), c.at(gb[i]));
+        let x = xor(ai, bi);
+        let xi = not_(xor(xor(x, cc), ai));
+        let nb = not_(xor(bi, f()));
+        let args = vec![bb, ai, bi, cc, gbb, gai, gbi, gcc];
+        // P1: and A xi = and B xi = and B (xnor b (and B c)) = and B (xnor b false)
+        let f1 = lam(bb0, and(var(0), shift(&xi, 0, 1)));
+        let e1 = cong1(&bb0, &bb0, &f1, aa, bb, p1);
+        let e2 = apps(s1, args.clone());
+        let mid = and(bb, not_(xor(bi, and(bb, cc))));
+        let f3 = lam(bb0, and(shift(&bb, 0, 1), not_(xor(shift(&bi, 0, 1), var(0)))));
+        let e3 = cong1(&bb0, &bb0, &f3, and(bb, cc), f(), p2);
+        let t12 = trans_proof(&bb0, &and(aa, xi), &and(bb, xi), &mid, e1, e2);
+        let p1n = trans_proof(&bb0, &and(aa, xi), &mid, &and(bb, nb), t12, e3);
+        // P2: and (and B nb) c' = and (and B c) (and a nb) = and false (and a nb)
+        let w = and(ai, nb);
+        let cc1 = or(and(ai, bi), and(cc, x));
+        let e4 = apps(s2, args);
+        let f5 = lam(bb0, and(var(0), shift(&w, 0, 1)));
+        let e5 = cong1(&bb0, &bb0, &f5, and(bb, cc), f(), p2);
+        let p2n = trans_proof(&bb0, &and(and(bb, nb), cc1), &and(and(bb, cc), w), &and(f(), w), e4, e5);
+        let p2n = if stale { refl(f()) } else { p2n };
+        // the witnesses
+        let gnb = app2(g_xn, bi, gbi);
+        let gbn = apps(g_and_l, vec![bb, nb, gbb, gnb]);
+        let gx = apps(g_xor, vec![ai, bi, gai, gbi]);
+        let gab = apps(g_and, vec![ai, bi, gai, gbi]);
+        let gcx = apps(g_and, vec![cc, x, gcc, gx]);
+        let gcn = apps(g_or, vec![and(ai, bi), and(cc, x), gab, gcx]);
+        (aa, bb, cc, gbb, gcc, p1, p2) = (and(aa, xi), and(bb, nb), cc1, gbn, gcn, p1n, p2n);
+    }
+    p1
+}
