+#[test]
+pub fn sum_loop_spike() {
+    for n in [4usize, 24, 64] {
+        tatic_kernel::scoped(|| {
+            let w = Wasm { n };
+            let timed = |name: &str, (p, s): (Expr, Expr)| {
+                let t0 = Instant::now();
+                ck(&format!("{name} n={n}"), &p, &s);
+                println!("SUM n={n} {name}: {:?}", t0.elapsed());
+            };
+            let rejected = |name: &str, (p, s): (Expr, Expr)| {
+                let sort_of = infer(&Ctx::new(), &s).map(|t| whnf(&t));
+                assert!(matches!(sort_of.as_ref().map(|t| t.node()), Ok(tatic_kernel::Node::Sort(_))), "{name}: statement is not a type: {sort_of:?}");
+                let t0 = Instant::now();
+                assert!(holds(&p, &s).is_err(), "{name} must be rejected at n={n}");
+                println!("SUM n={n} rejected {name}: {:?}", t0.elapsed());
+            };
+            timed("sum 3 from 0, fuel 4, answers 6", sum_run(w, 3, 0, 4, Some(6)));
+            timed("sum 3 from 0, fuel 3, times out", sum_run(w, 3, 0, 3, None));
+            rejected("sum 3 from 0, fuel 4, answers 5", sum_run(w, 3, 0, 4, Some(5)));
+            rejected("sum 3 from 0, fuel 3, exits", sum_run(w, 3, 0, 3, Some(6)));
+            timed("sum simulation", sum_law(w, SumCtl::Ok));
+            timed("no-temps program, its own source", sum_law(w, SumCtl::NoTempsSeqSrc));
+            rejected("sub for add", sum_law(w, SumCtl::SubForAdd));
+            rejected("no-temps program, the sum's source", sum_law(w, SumCtl::NoTemps));
+        })
+    }
+}
