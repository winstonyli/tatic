+/// A run by `refl`: the machine at `fuel` from `x`, cell `A` holding 0, `km = \a h. k0 a`: `k0 want` or the timeout.
+fn module_run(w: Wasm, f: Cf, xv: u128, fuel: usize, want: Option<u128>) -> (Expr, Expr) {
+    let n = w.n;
+    // R z k0 h0
+    let tys: Vec<Ty> = vec![
+        ty!(|_c, _x| sort(0)),
+        ty!(|c, x| c.at(x[0])),
+        ty!(|c, x| arrow(bv_ty(n), c.at(x[0]))),
+        ty!(|c, x| w.mem(c, x[0])),
+    ];
+    law(&tys, |c, x| {
+        let (r, z) = (x[0], x[1]);
+        let hm = hm_ty(w, c, r);
+        let bm = mach_step(w, c, r, z, &f.code());
+        let tm = c.lam(bv_ty(n), |c, _| {
+            let heap = w.mem(c, r);
+            c.lam(heap, |c, _| {
+                let ret = ret_m(w, c, r);
+                c.lam(ret, |c, _| c.at(z))
+            })
+        });
+        let km = c.lam(bv_ty(n), |c, a| {
+            let heap = w.mem(c, r);
+            c.lam(heap, |c, _| app(c.at(x[2]), c.at(a)))
+        });
+        let h0 = w.upd(c, r, lit(n, CELL), lit(n, 0), c.at(x[3]));
+        let l = apps(apps(nat2_lit(fuel), vec![hm, tm, bm]), vec![lit(n, xv), h0, km]);
+        let want = match want {
+            Some(a) => app(c.at(x[2]), lit(n, a)),
+            None => c.at(z),
+        };
+        (refl(l.clone()), id(c.at(r), l, want))
+    })
+}
