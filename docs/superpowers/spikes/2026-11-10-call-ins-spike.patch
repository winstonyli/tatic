+#[test]
+pub fn call_ins_spike() {
+    for n in [4usize, 24, 64] {
+        tatic_kernel::scoped(|| {
+            let w = Wasm { n };
+            let timed = |name: &str, (p, s): (Expr, Expr)| {
+                let t0 = Instant::now();
+                ck(&format!("{name} n={n}"), &p, &s);
+                println!("CALLINS n={n} {name}: {:?}", t0.elapsed());
+            };
+            let rejected = |name: &str, (p, s): (Expr, Expr)| {
+                let sort_of = infer(&Ctx::new(), &s).map(|t| whnf(&t));
+                assert!(matches!(sort_of.as_ref().map(|t| t.node()), Ok(tatic_kernel::Node::Sort(_))), "{name}: statement is not a type: {sort_of:?}");
+                let t0 = Instant::now();
+                let e = holds(&p, &s).expect_err(&format!("{name} must be rejected at n={n}"));
+                println!("CALLINS n={n} rejected {name}: {:?} ({})", t0.elapsed(), e.chars().take(80).collect::<String>());
+            };
+            timed("sum 3, fuel 4, answers 6", module_run(w, Cf::Sum, 3, 4, Some(6)));
+            timed("sum 3, fuel 3, times out", module_run(w, Cf::Sum, 3, 3, None));
+            timed("nest 2, fuel 3, answers 0", module_run(w, Cf::Nest, 2, 3, Some(0)));
+            timed("nest 2, fuel 2, times out", module_run(w, Cf::Nest, 2, 2, None));
+            timed("cnt 3, fuel 4, answers 9", module_run(w, Cf::Cnt, 3, 4, Some(9)));
+            timed("cnt 3, fuel 3, times out", module_run(w, Cf::Cnt, 3, 3, None));
+            rejected("cnt 3, fuel 4, answers 8", module_run(w, Cf::Cnt, 3, 4, Some(8)));
+            timed("sum law", module_law(w, Cf::Sum));
+            timed("nest law", module_law(w, Cf::Nest));
+            timed("cnt law", module_law(w, Cf::Cnt));
+            rejected("sum law, call on x - 2", module_law(w, Cf::SumArg2));
+            rejected("sum law, call dropped", module_law(w, Cf::SumNoCall));
+            rejected("nest law, one call", module_law(w, Cf::NestOnce));
+            rejected("cnt law, no store", module_law(w, Cf::CntNoStore));
+            rejected("cnt law, reads cell A + 1", module_law(w, Cf::CntWrongCell));
+        })
+    }
+}
