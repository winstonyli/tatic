+struct Mx {
+    w: Wasm,
+    r: At,
+    hm: At,
+    hs: At,
+    tm: At,
+    ts: At,
+    bm: At,
+    bs: At,
+}
+
+impl Mx {
+    fn mach(&self, c: &mut Cx, m: At, x: Expr, h: Expr, km: Expr) -> Expr {
+        apps(apps(c.at(m), vec![c.at(self.hm), c.at(self.tm), c.at(self.bm)]), vec![x, h, km])
+    }
+    fn src(&self, c: &mut Cx, m: At, x: Expr, st: Expr, ks: Expr) -> Expr {
+        apps(apps(c.at(m), vec![c.at(self.hs), c.at(self.ts), c.at(self.bs)]), vec![x, st, ks])
+    }
+    /// The step at fuel `j + 1` for the binders `y = d x h st km ks rel inv`: the `then` branch by `rel`, the `else`
+    /// branch by the hypothesis at each call (and `inv` at each read of the cell), then J through the `choose`.
+    fn step_proof(&self, c: &mut Cx, f: Cf, j: At, ih: At, y: &[At]) -> Expr {
+        let (w, r) = (self.w, self.r);
+        let n = w.n;
+        let [d, x, h, st, km, ks, rel, inv] = [y[0], y[1], y[2], y[3], y[4], y[5], y[6], y[7]];
+        let ihx = |c: &mut Cx, args: Vec<Expr>| apps(c.at(ih), [vec![c.at(d)], args].concat());
+        let cd = c.mark(app2(Op::LeS.term(n), c.at(x), lit(n, 0)));
+        let then = (app2(c.at(km), c.at(x), c.at(h)), app2(c.at(ks), c.at(x), c.at(st)), apps(c.at(rel), vec![c.at(x), c.at(h), c.at(st), c.at(inv)]));
+        let x1 = c.mark(app2(Op::Sub.term(n), c.at(x), lit(n, 1)));
+        let el = match f {
+            Cf::Sum => {
+                let add_x = |c: &Cx, a: At| app2(Op::Add.term(n), c.at(x), c.at(a));
+                let km1 = c.lam(w.v(), |c, a| { let heap = w.mem(c, r); c.lam(heap, |c, h2| app2(c.at(km), add_x(c, a), c.at(h2))) });
+                let ks1 = c.lam(w.v(), |c, a| c.lam(w.v(), |c, s2| app2(c.at(ks), add_x(c, a), c.at(s2))));
+                let rel1 = c.lam(w.v(), |c, a| {
+                    let heap = w.mem(c, r);
+                    c.lam(heap, |c, h2| c.lam(w.v(), |c, s2| {
+                        let it = inv_ty(w, c, r, h2, s2);
+                        c.lam(it, |c, i2| apps(c.at(rel), vec![add_x(c, a), c.at(h2), c.at(s2), c.at(i2)]))
+                    }))
+                });
+                let em = self.mach(c, j, c.at(x1), c.at(h), km1.clone());
+                let es = self.src(c, j, c.at(x1), c.at(st), ks1.clone());
+                let p = ihx(c, vec![c.at(x1), c.at(h), c.at(st), km1, ks1, rel1, c.at(inv)]);
+                (em, es, p)
+            }
+            Cf::Nest => {
+                let (km1, ks1, rel1) = {
+                    // the machine's continuation of the inner call is `km` eta-expanded (no eta in conversion)
+                    let km_eta = c.lam(w.v(), |c, b| { let heap = w.mem(c, r); c.lam(heap, |c, h3| app2(c.at(km), c.at(b), c.at(h3))) });
+                    let km_eta = c.mark(km_eta);
+                    let km1 = c.lam(w.v(), |c, a| { let heap = w.mem(c, r); c.lam(heap, |c, h2| self.mach(c, j, c.at(a), c.at(h2), c.at(km_eta))) });
+                    let ks1 = c.lam(w.v(), |c, a| c.lam(w.v(), |c, s2| self.src(c, j, c.at(a), c.at(s2), c.at(ks))));
+                    let rel1 = c.lam(w.v(), |c, a| {
+                        let heap = w.mem(c, r);
+                        c.lam(heap, |c, h2| c.lam(w.v(), |c, s2| {
+                            let it = inv_ty(w, c, r, h2, s2);
+                            c.lam(it, |c, i2| ihx(c, vec![c.at(a), c.at(h2), c.at(s2), c.at(km_eta), c.at(ks), c.at(rel), c.at(i2)]))
+                        }))
+                    });
+                    (km1, ks1, rel1)
+                };
+                let em = self.mach(c, j, c.at(x1), c.at(h), km1.clone());
+                let es = self.src(c, j, c.at(x1), c.at(st), ks1.clone());
+                let p = ihx(c, vec![c.at(x1), c.at(h), c.at(st), km1, ks1, rel1, c.at(inv)]);
+                (em, es, p)
+            }
+            _ => {
+                let cell = lit(n, CELL);
+                // after the call: read the cell, add, return
+                let km1 = c.lam(w.v(), |c, a| {
+                    let heap = w.mem(c, r);
+                    c.lam(heap, |c, h2| {
+                        let kk = c.lam(w.v(), |c, m| app2(c.at(km), app2(Op::Add.term(n), c.at(a), c.at(m)), c.at(h2)));
+                        app2(c.at(h2), cell.clone(), kk)
+                    })
+                });
+                let km1 = c.mark(km1);
+                let ks1 = c.lam(w.v(), |c, a| c.lam(w.v(), |c, s2| app2(c.at(ks), app2(Op::Add.term(n), c.at(a), c.at(s2)), c.at(s2))));
+                let rel1 = c.lam(w.v(), |c, a| {
+                    let heap = w.mem(c, r);
+                    c.lam(heap, |c, h2| c.lam(w.v(), |c, s2| {
+                        let it = inv_ty(w, c, r, h2, s2);
+                        c.lam(it, |c, i2| {
+                            let sum = c.mark(app2(Op::Add.term(n), c.at(a), c.at(s2)));
+                            let kk = c.lam(w.v(), |c, m| app2(c.at(km), app2(Op::Add.term(n), c.at(a), c.at(m)), c.at(h2)));
+                            let lhs = app2(c.at(h2), lit(n, CELL), kk.clone());
+                            let mid = app2(c.at(km), c.at(sum), c.at(h2));
+                            let rhs = app2(c.at(ks), c.at(sum), c.at(s2));
+                            let p = app(c.at(i2), kk);
+                            let q = apps(c.at(rel), vec![c.at(sum), c.at(h2), c.at(s2), c.at(i2)]);
+                            trans(c, r, (lhs, mid, rhs), p, q)
+                        })
+                    }))
+                });
+                let st1 = c.mark(app2(Op::Add.term(n), c.at(st), lit(n, 1)));
+                let h1 = w.upd(c, r, lit(n, CELL), c.at(st1), c.at(h));
+                let h1 = c.mark(h1);
+                // the machine's else: read the cell, store it plus one, call
+                let body = c.lam(w.v(), |c, m| {
+                    let hm1 = w.upd(c, r, lit(n, CELL), app2(Op::Add.term(n), c.at(m), lit(n, 1)), c.at(h));
+                    self.mach(c, j, c.at(x1), hm1, c.at(km1))
+                });
+                let em = app2(c.at(h), lit(n, CELL), body.clone());
+                let e1 = self.mach(c, j, c.at(x1), c.at(h1), c.at(km1));
+                let es = self.src(c, j, c.at(x1), c.at(st1), ks1.clone());
+                let inv1 = c.lam(arrow(w.v(), c.at(r)), |c, kk| refl(app(c.at(kk), c.at(st1))));
+                let p1 = app(c.at(inv), body);
+                let p2 = ihx(c, vec![c.at(x1), c.at(h1), c.at(st1), c.at(km1), ks1, rel1, inv1]);
+                let p = trans(c, r, (em.clone(), e1, es.clone()), p1, p2);
+                (em, es, p)
+            }
+        };
+        cchoose_cong(c, r, cd, then, el)
+    }
+}
