+//! SPIKE (f1, 2026-11-10): the e1 generator (`tatic_wasm::wasm::sim::gen_sim`) driven from tatic's real terms and the
+//! real lowering's instruction lists, with no per-function case. `gen_real` runs the targets, `gen_real_controls` the
+//! mutants of emitted code and the kernel-level negative.
+use std::time::Instant;
+
+use tatic_wasm::ops::Op;
+use tatic_wasm::wasm::Ins;
+
+use crate::jit::compile::{compile_specialised, CompiledFragment, Item};
+use crate::lang::syntax::print;
+use crate::lang::term::{Hash, TermStore};
+use crate::proof::gate::sim_statement;
+use crate::support::samples::{capturing_closure_loop, factorial, fib, partial_application_loop, redundant_arithmetic_recursion, source, twice_inc_5};
+use crate::testing::ins_mutate::mutate;
+use crate::testing::test_corpus::let_bound_factorial_10;
+
+/// The term the gate sees (the specialised one, if `specialise` changed it) and its compiled fragment.
+fn compiled(build: &dyn Fn(&mut TermStore) -> Hash) -> (TermStore, Hash, CompiledFragment) {
+    let mut s = TermStore::new();
+    let h = build(&mut s);
+    let c = compile_specialised(&s, h).expect("compiles");
+    match c.specialised {
+        Some((s2, h2)) => (s2, h2, c.frag),
+        None => (s, h, c.frag),
+    }
+}
+
+/// The lowering's list as the machine's: its `local.set $p{k}` / `local.get $p{k}` are `LocalSet`/`LocalGet` at `k`,
+/// its `local.set $t{k}` / `local.get $t{k}` at `arity + k` (the WAT index space: parameters first, then the declared
+/// `$t` locals), and a one-parameter
+/// `call $f` is `Call`. Every other `Raw` line stays `Raw` and is pushed to `raws`.
+fn lift(code: &[Ins], arity: usize, raws: &mut Vec<String>) -> Vec<Ins> {
+    code.iter()
+        .map(|ins| match ins {
+            Ins::Loop(b) => Ins::Loop(lift(b, arity, raws)),
+            Ins::If(t, e) => Ins::If(lift(t, arity, raws), lift(e, arity, raws)),
+            Ins::Raw(s) => {
+                let temp = |p: &str| s.strip_prefix(p).and_then(|k| k.parse::<u32>().ok());
+                if let Some(k) = temp("local.set $t") {
+                    Ins::LocalSet(arity as u32 + k)
+                } else if let Some(k) = temp("local.set $p") {
+                    Ins::LocalSet(k)
+                } else if let Some(k) = temp("local.get $p") {
+                    Ins::LocalGet(k)
+                } else if let Some(k) = temp("local.get $t") {
+                    Ins::LocalGet(arity as u32 + k)
+                } else if s == "call $f" && arity == 1 {
+                    Ins::Call
+                } else {
+                    raws.push(s.clone());
+                    ins.clone()
+                }
+            }
+            other => other.clone(),
+        })
+        .collect()
+}
+
+/// `Ok((build ms, check ms))` for `n`, or why not. On one `CHECK_STACK` thread (an `Expr` does not cross threads).
+fn prove(s: &TermStore, h: Hash, arity: usize, code: &[Ins], n: usize) -> Result<(f64, f64), String> {
+    let mut raws = vec![];
+    let machine = lift(code, arity, &mut raws);
+    if !raws.is_empty() {
+        raws.dedup();
+        return Err(format!("Raw lines with no Ins: {raws:?}"));
+    }
+    let t0 = Instant::now();
+    let (proof, stmt) = sim_statement(s, h, arity, &machine, arity, n)?;
+    let build = t0.elapsed().as_secs_f64() * 1e3;
+    let t1 = Instant::now();
+    tatic_kernel::check(&tatic_kernel::Ctx::new(), &proof, &stmt).map_err(|e| format!("kernel: {}", e.chars().take(300).collect::<String>()))?;
+    Ok((build, t1.elapsed().as_secs_f64() * 1e3))
+}
+
+fn on_big_stack<R: Send>(f: impl FnOnce() -> R + Send) -> R {
+    std::thread::scope(|sc| std::thread::Builder::new().stack_size(tatic_kernel::CHECK_STACK).spawn_scoped(sc, f).unwrap().join().unwrap())
+}
+
+type Target = (&'static str, fn(&mut TermStore) -> Hash);
+
+fn targets() -> Vec<Target> {
+    vec![
+        ("sum loop (capturing_closure_loop)", capturing_closure_loop),
+        ("sum loop (partial_application_loop)", partial_application_loop),
+        ("factorial", factorial),
+        ("redundant_arithmetic_recursion", redundant_arithmetic_recursion),
+        ("fib", fib),
+        ("direct call 13 (twice_inc_5)", twice_inc_5),
+        ("direct call 34 (let_bound_factorial_10)", let_bound_factorial_10),
+    ]
+}
+
+/// Terms written after `sim.rs` was hashed (d9f576fc..., 12:31): real syntax, the real specialiser and lowering.
+fn unseen() -> Vec<Target> {
+    vec![
+        ("tri", |s| source(s, "rec f n = if n <= 0 then 0 else n + f (n - 1) + 1")),
+        ("dbl", |s| source(s, "rec f n = if n <= 0 then 1 else f (n - 1) + f (n - 1)")),
+        ("mulloop", |s| source(s, "rec f n acc = if n <= 0 then acc else f (n - 1) (acc * n)")),
+        ("mixed", |s| source(s, "rec f n = if n <= 2 then n else f (f (n - 2)) * n + f (n - 3)")),
+        ("pow2sum (3 params)", |s| source(s, "rec f n acc p = if n <= 0 then acc else f (n - 1) (acc + p) (p + p)")),
+        ("eq-guarded loop (==)", |s| source(s, "rec f a b = if a == 0 then b else f (a - 1) (b + a)")),
+        ("two guards, two base cases", |s| source(s, "rec f a b = if a == 0 then b else if b == 0 then a else f (a - 1) (b - 1) + 1")),
+    ]
+}
+
+/// Every function of the module, with its parameter count and the `Raw` lines `lift` cannot map.
+fn raw_report(name: &str, frag: &CompiledFragment) {
+    for item in &frag.module {
+        if let Item::Func { name: f, header, body } = item {
+            let arity = header.matches("(param $p").count();
+            let mut raws = vec![];
+            lift(body, arity, &mut raws);
+            raws.dedup();
+            println!("RAWS {name}: ${f} ({arity} params, header {:?}): {raws:?}", header.split_whitespace().take(6).collect::<Vec<_>>().join(" "));
+        }
+    }
+}
