+/// `a` negated when `s` is set: `(a ^ s) + s`.
+pub fn neg_if(a: &[Expr], s: Expr) -> Vec<Expr> {
+    let xs: Vec<Expr> = a.iter().map(|&x| xor(x, s)).collect();
+    let one: Vec<Expr> = (0..a.len()).map(|i| if i == 0 { s } else { f() }).collect();
