+/// SPIKE (i4): gcd, which needs `%`, a partial row: the generator over the real term and the real lowering's code, the
+/// partial row's guard on both sides. Controls by `ctrl`: 1 the machine drops the guard, 3 the machine tests the wrong
+/// operand, 4 neither side guards (cost reference).
+#[test]
+#[ignore]
+fn gen_real_gcd() {
+    use std::sync::atomic::Ordering::Relaxed;
+    use tatic_wasm::ops::CTRL;
+    let gcds: [(&str, fn(&mut TermStore) -> Hash); 2] =
+        [("gcd", crate::support::samples::gcd), ("gcd two base cases", crate::support::samples::gcd_with_two_base_cases)];
+    for ctrl in [0u8, 4, 1, 3] {
+        CTRL.store(ctrl, Relaxed);
+        for (name, build) in gcds {
+            on_big_stack(|| {
+                let (s, h, frag) = compiled(&build);
+                println!("TERM {name}: {} (arity {})", print(&s, h), frag.arity);
+                if ctrl == 0 {
+                    println!("CODE {name}: {:?}", frag.entry());
+                }
+                for n in if ctrl == 0 { vec![4usize, 24, 64] } else { vec![64] } {
+                    match prove(&s, h, frag.arity, frag.entry(), n) {
+                        Ok((b, k)) => println!("GCD ctrl={ctrl} n={n} {name}: accepted, build {b:.1} ms, check {k:.1} ms"),
+                        Err(e) => println!("GCD ctrl={ctrl} n={n} {name}: REJECTED {}", e.chars().take(300).collect::<String>()),
+                    }
+                }
+            });
+        }
+    }
+    CTRL.store(0, Relaxed);
+    // the emitted code's `%` replaced by another row
+    // (ctrl 4 first: with no guard on either side, only the value differs)
+    for ctrl in [4u8, 0] {
+        CTRL.store(ctrl, Relaxed);
+        for (what, to) in [("RemS -> Mul", Op::Mul), ("RemS -> Sub", Op::Sub)] {
+            on_big_stack(|| {
+                let (s, h, frag) = compiled(&crate::support::samples::gcd);
+                let m = mutate(frag.entry(), &|i| (i == &Ins::Op(Op::RemS)).then_some(Ins::Op(to)));
+                assert_ne!(m, frag.entry());
+                match prove(&s, h, frag.arity, &m, 64) {
+                    Ok(_) => println!("GCD ctrl={ctrl} {what}: ACCEPTED"),
+                    Err(e) => println!("GCD ctrl={ctrl} {what}: REJECTED {}", e.chars().take(200).collect::<String>()),
+                }
+            });
+        }
+    }
+    CTRL.store(0, Relaxed);
+}
