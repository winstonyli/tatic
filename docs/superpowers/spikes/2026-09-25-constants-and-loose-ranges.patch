+/// One more than the largest `Const` level in `e`, 0 when it has none.
+pub fn free_of(e: &Expr) -> u32 {
+    use Expr::*;
+    let f = |c: &Rc<Expr>| c.free();
+    match e {
+        Const(l) => l + 1,
+        Var(_) | Sort(_) => 0,
+        Pi(a, b) | Lam(a, b) | W(a, b) | Sigma(a, b) | App(a, b) | Sup(a, b) => f(a).max(f(b)),
+        Id(a, b, c) | SigRec { motive: a, step: b, target: c } | Pair(a, b, c) => f(a).max(f(b)).max(f(c)),
+        Refl(a) => f(a),
+        J { motive, base, a, b, p } => f(motive).max(f(base)).max(f(a)).max(f(b)).max(f(p)),
+        WRec { motive, children_ty, step, target } => f(motive).max(f(children_ty)).max(f(step)).max(f(target)),
+    }
+}
+
+/// `e` sits under the binders for levels `base..k` (outermost first) and
+/// `d` more of its own: `Const(l)` for `base <= l < k` becomes the `Var`
+/// for its binder. Children mentioning no such level are kept by pointer.
+fn abstract_levels(e: &Expr, base: u32, k: u32, d: u32) -> Expr {
+    abstract_levels_rec(e, base, k, d, &mut Memo::new())
+}
+fn abstract_levels_rec(e: &Expr, base: u32, k: u32, d: u32, memo: &mut Memo) -> Expr {
+    bump(&ABS_WORK);
+    let mut go = |x: &Rc<Expr>, d: u32| -> Rc<Expr> {
+        if x.free() <= base { bump(&ABS_SKIP); return x.clone(); }
+        let shared = memo_on() && Rc::strong_count(x) > 1;
+        let key = (Rc::as_ptr(x) as usize, d);
+        if shared {
+            bump(&MEMO_LOOK);
+            if let Some(r) = memo.get(&key) { bump(&MEMO_HIT); return r.clone(); }
+        }
+        let r = Rc::new(abstract_levels_rec(x, base, k, d, memo));
+        if shared { memo.insert(key, r.clone()); }
+        r
+    };
+    grow(|| match e {
+        Expr::Const(l) if *l >= base && *l < k => Expr::Var(k - 1 - l + d),
+        Expr::Const(l) => Expr::Const(*l),
+        Expr::Var(i) => Expr::Var(*i),
+        Expr::Sort(i) => Expr::Sort(*i),
+        Expr::Pi(a, b) => Expr::Pi(go(a, d), go(b, d + 1)),
+        Expr::Lam(a, b) => Expr::Lam(go(a, d), go(b, d + 1)),
+        Expr::App(f, a) => Expr::App(go(f, d), go(a, d)),
+        Expr::Id(a, x, y) => Expr::Id(go(a, d), go(x, d), go(y, d)),
+        Expr::Refl(a) => Expr::Refl(go(a, d)),
+        Expr::J { motive, base: bs, a, b, p } => Expr::J { motive: go(motive, d), base: go(bs, d), a: go(a, d), b: go(b, d), p: go(p, d) },
+        Expr::W(a, b) => Expr::W(go(a, d), go(b, d + 1)),
+        Expr::Sup(a, f) => Expr::Sup(go(a, d), go(f, d)),
+        Expr::WRec { motive, children_ty, step, target } => Expr::WRec { motive: go(motive, d), children_ty: go(children_ty, d + 1), step: go(step, d), target: go(target, d) },
+        Expr::Sigma(a, b) => Expr::Sigma(go(a, d), go(b, d + 1)),
+        Expr::Pair(fam, a, b) => Expr::Pair(go(fam, d + 1), go(a, d), go(b, d)),
+        Expr::SigRec { motive, step, target } => Expr::SigRec { motive: go(motive, d), step: go(step, d), target: go(target, d) },
+    })
+}
