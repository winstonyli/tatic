+/// `close_pi`/`close_lam` when the scope's parameters are levels.
+fn close_levels(base_len: usize, ctx: &Ctx, body: Expr, mk: fn(Expr, Expr) -> Expr) -> Expr {
+    let top = ctx.len() as u32;
+    let base = base_len as u32;
+    let body = if free_of(&body) <= base { body } else { abstract_levels(&body, base, top, 0) };
+    (base_len..ctx.len()).rev().fold(body, |acc, i| {
+        let dom = &ctx[i];
+        let dom = if free_of(dom) <= base { dom.clone() } else { abstract_levels(dom, base, i as u32, 0) };
+        mk(dom, acc)
+    })
+}
+pub struct Node<T> {
+    loose: u32,
+    free: u32,
+    #[cfg(feature = "spike_hash")]
+    hash: u64,
+    val: T,
+}
+pub struct Rc<T>(std::rc::Rc<Node<T>>);
+impl Rc<Expr> {
+    pub fn new(e: Expr) -> Self {
+        let loose = loose_of(&e);
+        let free = free_of(&e);
+        #[cfg(feature = "spike_hash")]
+        let hash = if SPIKE_HASH.with(|c| c.get()) { hash_of(&e) } else { 0 };
+        Rc(std::rc::Rc::new(Node { loose, free, #[cfg(feature = "spike_hash")] hash, val: e }))
+    }
+    pub fn loose(&self) -> u32 { self.0.loose }
+    pub fn free(&self) -> u32 { self.0.free }
+}
+impl<T> Rc<T> {
+    pub fn ptr_eq(a: &Self, b: &Self) -> bool { std::rc::Rc::ptr_eq(&a.0, &b.0) }
+    pub fn strong_count(a: &Self) -> usize { std::rc::Rc::strong_count(&a.0) }
+    pub fn as_ptr(a: &Self) -> *const T { &a.0.val as *const T }
+}
+impl<T> AsRef<T> for Rc<T> { fn as_ref(&self) -> &T { &self.0.val } }
+impl<T> Clone for Rc<T> { fn clone(&self) -> Self { Rc(self.0.clone()) } }
+impl<T> std::ops::Deref for Rc<T> { type Target = T; fn deref(&self) -> &T { &self.0.val } }
+impl<T: PartialEq> PartialEq for Rc<T> { fn eq(&self, o: &Self) -> bool { Rc::ptr_eq(self, o) || self.0.val == o.0.val } }
+impl<T: fmt::Debug> fmt::Debug for Rc<T> { fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { self.0.val.fmt(f) } }
+
+/// One more than the largest loose `Var` index in `e`, 0 when closed.
+pub fn loose_of(e: &Expr) -> u32 {
+    use Expr::*;
+    let l = |c: &Rc<Expr>| c.loose();
+    let u = |c: &Rc<Expr>| c.loose().saturating_sub(1);
+    match e {
+        Var(k) => k + 1,
+        Sort(_) | Const(_) => 0,
+        Pi(a, b) | Lam(a, b) | W(a, b) | Sigma(a, b) => l(a).max(u(b)),
+        App(a, b) | Sup(a, b) => l(a).max(l(b)),
+        Id(a, b, c) | SigRec { motive: a, step: b, target: c } => l(a).max(l(b)).max(l(c)),
+        Pair(fam, a, b) => u(fam).max(l(a)).max(l(b)),
+        Refl(a) => l(a),
+        J { motive, base, a, b, p } => l(motive).max(l(base)).max(l(a)).max(l(b)).max(l(p)),
+        WRec { motive, children_ty, step, target } => l(motive).max(u(children_ty)).max(l(step)).max(l(target)),
+    }
+}
+#[cfg(feature = "spike_hash")]
+fn hash_of(e: &Expr) -> u64 {
+    use Expr::*;
+    let mix = |h: u64, x: u64| (h.rotate_left(5) ^ x).wrapping_mul(0x517c_c1b7_2722_0a95);
+    let h = |c: &Rc<Expr>| c.0.hash;
+    match e {
+        Var(k) => mix(1, *k as u64),
+        Sort(k) => mix(2, *k as u64),
+        Const(k) => mix(3, *k as u64),
+        Pi(a, b) => mix(mix(4, h(a)), h(b)),
+        Lam(a, b) => mix(mix(5, h(a)), h(b)),
+        App(a, b) => mix(mix(6, h(a)), h(b)),
+        W(a, b) => mix(mix(7, h(a)), h(b)),
+        Sup(a, b) => mix(mix(8, h(a)), h(b)),
+        Sigma(a, b) => mix(mix(9, h(a)), h(b)),
+        Id(a, b, c) => mix(mix(mix(10, h(a)), h(b)), h(c)),
+        Pair(a, b, c) => mix(mix(mix(11, h(a)), h(b)), h(c)),
+        SigRec { motive, step, target } => mix(mix(mix(12, h(motive)), h(step)), h(target)),
+        Refl(a) => mix(13, h(a)),
+        J { motive, base, a, b, p } => mix(mix(mix(mix(mix(14, h(motive)), h(base)), h(a)), h(b)), h(p)),
+        WRec { motive, children_ty, step, target } => mix(mix(mix(mix(15, h(motive)), h(children_ty)), h(step)), h(target)),
+    }
+}
 
