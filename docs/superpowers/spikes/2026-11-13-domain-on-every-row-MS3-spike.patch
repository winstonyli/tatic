+/// PROBE: the check's kernel work for the loop programs and doubling, one line each.
+#[test]
+#[ignore]
+fn p1_probe() {
+    let progs: Vec<(&str, Box<dyn Fn(&mut TermStore) -> Hash + Send>)> = vec![
+        ("capturing_closure_loop", Box::new(capturing_closure_loop)),
+        ("straight_line", Box::new(straight_line)),
+        ("held_out_b", Box::new(crate::testing::test_corpus::held_out_b)),
+        ("doubling(6)", Box::new(|s: &mut TermStore| doubling(s, 6))),
+        ("doubling(12)", Box::new(|s: &mut TermStore| doubling(s, 12))),
+    ];
+    for (name, mk) in progs {
+        let w = big(move || {
+            let (s, h, frag) = compiled(&*mk);
+            tatic_kernel::scoped(|| {
+                let b0 = tatic_kernel::work();
+                let (p, st) = built(&s, h, &frag);
+                let b1 = tatic_kernel::work();
+                let w0 = tatic_kernel::work();
+                let ok = tatic_wasm::encoding::holds(&p, &st).is_ok();
+                (ok, tatic_kernel::work() - w0, b1 - b0)
+            })
+        });
+        println!("P1 {name} accepted={} check_work={} build_work={}", w.0, w.1, w.2);
+    }
+}
